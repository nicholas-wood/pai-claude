"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { CredentialStatusBadge } from "@/components/status-badge";
import { FobPicker, type AvailableFob } from "@/components/fob-picker";
import { SwapCredentialForm } from "@/components/swap-credential-form";

type Credential = {
  id: string;
  serialNumber: string | null;
  status: string;
  credentialTypeName: string | null;
  accessLevelName: string | null;
  expiresAt: Date | null;
  issuedAt: Date | null;
};

type IdName = { id: string; name: string };

type Props = {
  tenantSlug: string;
  memberId: string;
  credentials: Credential[];
  credentialTypes: IdName[];
  accessLevels: IdName[];
  availableFobs: AvailableFob[];
  allowFobCreationAtProgramming: boolean;
  canProgram: boolean;
  canManualAdd: boolean;
  memberAccessLevelName: string | null;
};

type ActiveAction =
  | { type: "add" }
  | { type: "revoke"; credentialId: string }
  | { type: "swap"; credentialId: string; currentCredentialTypeName: string | null; currentAccessLevelName: string | null }
  | null;

export function CredentialActions({
  tenantSlug,
  memberId,
  credentials: memberCreds,
  credentialTypes,
  accessLevels,
  availableFobs,
  allowFobCreationAtProgramming,
  canProgram,
  canManualAdd,
  memberAccessLevelName,
}: Props) {
  const router = useRouter();
  const [activeAction, setActiveAction] = useState<ActiveAction>(null);

  const activeCreds = memberCreds.filter((c) => c.status === "active");
  const inactiveCreds = memberCreds.filter((c) => c.status !== "active");

  return (
    <Card>
      <CardHeader>
        <div className="flex items-center justify-between">
          <CardTitle className="text-base">
            Credentials ({memberCreds.length})
          </CardTitle>
          {canManualAdd && activeAction === null && (
            <Button
              size="sm"
              onClick={() => setActiveAction({ type: "add" })}
            >
              Add Credential
            </Button>
          )}
        </div>
      </CardHeader>
      <CardContent className="space-y-3">
        {activeAction?.type === "add" && (
          <AddCredentialForm
            tenantSlug={tenantSlug}
            memberId={memberId}
            availableFobs={availableFobs}
            allowFobCreationAtProgramming={allowFobCreationAtProgramming}
            memberAccessLevelName={memberAccessLevelName}
            accessLevels={accessLevels}
            onDone={() => {
              setActiveAction(null);
              router.refresh();
            }}
            onCancel={() => setActiveAction(null)}
          />
        )}

        {activeAction?.type === "revoke" && (
          <RevokeCredentialForm
            tenantSlug={tenantSlug}
            credentialId={activeAction.credentialId}
            onDone={() => {
              setActiveAction(null);
              router.refresh();
            }}
            onCancel={() => setActiveAction(null)}
          />
        )}

        {activeAction?.type === "swap" && (
          <SwapCredentialForm
            tenantSlug={tenantSlug}
            credentialId={activeAction.credentialId}
            availableFobs={availableFobs}
            allowFobCreationAtProgramming={allowFobCreationAtProgramming}
            onDone={() => {
              setActiveAction(null);
              router.refresh();
            }}
            onCancel={() => setActiveAction(null)}
          />
        )}

        {/* Active credentials with action buttons */}
        {activeCreds.length === 0 && inactiveCreds.length === 0 && activeAction === null && (
          <p className="text-sm text-muted-foreground">No credentials</p>
        )}

        {activeAction === null &&
          activeCreds.map((c) => (
            <div
              key={c.id}
              className="flex items-center justify-between rounded border p-2 text-sm"
            >
              <Link
                href={`/t/${tenantSlug}/admin/fobs/${c.id}`}
                className="flex-1 transition-colors hover:text-primary"
              >
                <span className="font-medium">{c.credentialTypeName}</span>
                {c.serialNumber && (
                  <span className="ml-2 text-muted-foreground">
                    #{c.serialNumber}
                  </span>
                )}
                <p className="text-xs text-muted-foreground">
                  {c.accessLevelName ?? "No level"}
                  {c.expiresAt &&
                    ` \u00B7 Expires ${new Date(c.expiresAt).toLocaleDateString("en-AU", { timeZone: "Australia/Melbourne" })}`}
                </p>
              </Link>
              <div className="flex items-center gap-2">
                <CredentialStatusBadge status={c.status} />
                {canProgram && (
                  <>
                    <Button
                      size="sm"
                      variant="outline"
                      onClick={() =>
                        setActiveAction({
                          type: "swap",
                          credentialId: c.id,
                          currentCredentialTypeName: c.credentialTypeName,
                          currentAccessLevelName: c.accessLevelName,
                        })
                      }
                    >
                      Swap
                    </Button>
                    <Button
                      size="sm"
                      variant="destructive"
                      onClick={() =>
                        setActiveAction({ type: "revoke", credentialId: c.id })
                      }
                    >
                      Revoke
                    </Button>
                  </>
                )}
              </div>
            </div>
          ))}

        {/* Inactive credentials (read-only, no action buttons) */}
        {activeAction === null &&
          inactiveCreds.map((c) => (
            <Link
              key={c.id}
              href={`/t/${tenantSlug}/admin/fobs/${c.id}`}
              className="flex items-center justify-between rounded border p-2 text-sm opacity-60 transition-colors hover:bg-accent/50"
            >
              <div>
                <span className="font-medium">{c.credentialTypeName}</span>
                {c.serialNumber && (
                  <span className="ml-2 text-muted-foreground">
                    #{c.serialNumber}
                  </span>
                )}
                <p className="text-xs text-muted-foreground">
                  {c.accessLevelName ?? "No level"}
                  {c.expiresAt &&
                    ` \u00B7 Expires ${new Date(c.expiresAt).toLocaleDateString("en-AU", { timeZone: "Australia/Melbourne" })}`}
                </p>
              </div>
              <CredentialStatusBadge status={c.status} />
            </Link>
          ))}
      </CardContent>
    </Card>
  );
}

/* --- Add Credential Form (simplified: just fob picker) --- */

function AddCredentialForm({
  tenantSlug,
  memberId,
  availableFobs,
  allowFobCreationAtProgramming,
  memberAccessLevelName,
  accessLevels,
  onDone,
  onCancel,
}: {
  tenantSlug: string;
  memberId: string;
  availableFobs: AvailableFob[];
  allowFobCreationAtProgramming: boolean;
  memberAccessLevelName: string | null;
  accessLevels: IdName[];
  onDone: () => void;
  onCancel: () => void;
}) {
  const [selectedFobId, setSelectedFobId] = useState("");
  const [manualSerialNumber, setManualSerialNumber] = useState("");
  const [stage, setStage] = useState<"programming" | "pickup" | "issued">("programming");
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [manualAccessLevelId, setManualAccessLevelId] = useState("");
  const [manualExpiresAt, setManualExpiresAt] = useState("");

  const selectedFob = selectedFobId
    ? availableFobs.find((f) => f.id === selectedFobId) ?? null
    : null;
  const effectiveSerial = selectedFob?.serialNumber ?? manualSerialNumber;
  const needsActivation = stage === "pickup" || stage === "issued";
  const noRuleMatch = !memberAccessLevelName;
  const showManualFields = needsActivation && noRuleMatch;

  async function handleSubmit() {
    if (!effectiveSerial.trim()) return;
    if (showManualFields && !manualAccessLevelId) return;
    setSubmitting(true);
    setError(null);

    try {
      const res = await fetch(`/api/v1/t/${tenantSlug}/credentials`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ownerId: memberId,
          serialNumber: effectiveSerial.trim(),
          credentialId: selectedFob?.id,
          credentialTypeId: selectedFob?.credentialTypeId,
          stage,
          ...(showManualFields && manualAccessLevelId ? { accessLevelId: manualAccessLevelId } : {}),
          ...(showManualFields && manualExpiresAt ? { expiresAt: manualExpiresAt } : {}),
        }),
      });

      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error ?? "Failed to add credential");
      }

      onDone();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Something went wrong");
      setSubmitting(false);
    }
  }

  return (
    <div className="space-y-3 rounded-lg border p-4">
      <p className="text-sm font-medium">Add Credential</p>

      <FobPicker
        availableFobs={availableFobs}
        allowFobCreationAtProgramming={allowFobCreationAtProgramming}
        selectedFobId={selectedFobId}
        manualSerialNumber={manualSerialNumber}
        onSelect={(fob) => {
          setSelectedFobId(fob?.id ?? "");
          setManualSerialNumber("");
        }}
        onManualSerialChange={(v) => {
          setManualSerialNumber(v);
          setSelectedFobId("");
        }}
      />

      {/* Reassignment warning */}
      {selectedFob?.previousOwnerName && (
        <p className="text-xs text-amber-600 rounded bg-amber-50 px-3 py-2">
          This fob was previously assigned to {selectedFob.previousOwnerName}. It will be reassigned to this member.
        </p>
      )}

      <div className="space-y-2">
        <Label className="text-xs">Stage</Label>
        <div className="space-y-1">
          {[
            { value: "programming" as const, label: "Send for Programming", desc: "Credential needs to be programmed first" },
            { value: "pickup" as const, label: "Programmed - Ready for Pickup", desc: "Already programmed, waiting for member to collect" },
            { value: "issued" as const, label: "Programmed & Issued", desc: "Already programmed and handed to the member" },
          ].map((opt) => (
            <label key={opt.value} className="flex items-start gap-2 cursor-pointer rounded border p-2 hover:bg-accent/50">
              <input
                type="radio"
                name="stage"
                value={opt.value}
                checked={stage === opt.value}
                onChange={() => setStage(opt.value)}
                className="mt-0.5"
              />
              <div>
                <p className="text-sm font-medium">{opt.label}</p>
                <p className="text-xs text-muted-foreground">{opt.desc}</p>
              </div>
            </label>
          ))}
        </div>
      </div>

      {/* When activating and rules matched: show what will be applied */}
      {needsActivation && effectiveSerial.trim() && !noRuleMatch && (
        <div className="rounded bg-blue-50 px-3 py-2 text-sm space-y-1">
          <p>Access Level: <strong>{memberAccessLevelName}</strong></p>
          <p className="text-xs text-muted-foreground">Expiry calculated automatically (Sep 1 rollover, or no expiry for staff/board)</p>
        </div>
      )}

      {/* When activating and no rules matched: manual fields */}
      {showManualFields && (
        <div className="space-y-3 rounded border border-amber-200 bg-amber-50/50 p-3">
          <p className="text-xs font-medium text-amber-700">No access level rule matched for this member. Please set manually.</p>
          <div className="space-y-2">
            <Label className="text-xs">Access Level *</Label>
            <select
              value={manualAccessLevelId}
              onChange={(e) => setManualAccessLevelId(e.target.value)}
              className="w-full rounded-md border px-3 py-1.5 text-sm"
            >
              <option value="">Select access level...</option>
              {accessLevels.map((al) => (
                <option key={al.id} value={al.id}>{al.name}</option>
              ))}
            </select>
          </div>
          <div className="space-y-2">
            <Label className="text-xs">Expiry Date (leave blank for no expiry)</Label>
            <Input
              type="date"
              value={manualExpiresAt}
              onChange={(e) => setManualExpiresAt(e.target.value)}
              className="h-8"
            />
          </div>
        </div>
      )}

      {error && <p className="text-sm text-destructive">{error}</p>}

      <div className="flex gap-2">
        <Button
          size="sm"
          onClick={handleSubmit}
          disabled={submitting || !effectiveSerial.trim() || (showManualFields && !manualAccessLevelId)}
        >
          {submitting ? "Adding..." : "Add Credential"}
        </Button>
        <Button size="sm" variant="outline" onClick={onCancel}>
          Cancel
        </Button>
      </div>
    </div>
  );
}

/* --- Revoke Credential Form --- */

function RevokeCredentialForm({
  tenantSlug,
  credentialId,
  onDone,
  onCancel,
}: {
  tenantSlug: string;
  credentialId: string;
  onDone: () => void;
  onCancel: () => void;
}) {
  const [reason, setReason] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function handleRevoke() {
    if (!reason.trim()) return;
    setSubmitting(true);
    setError(null);

    try {
      const res = await fetch(
        `/api/v1/t/${tenantSlug}/credentials/${credentialId}/revoke`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reason: reason.trim() }),
        }
      );

      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error ?? "Failed to revoke credential");
      }

      onDone();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Something went wrong");
      setSubmitting(false);
    }
  }

  return (
    <div className="space-y-3 rounded-lg border border-destructive/30 p-4">
      <p className="text-sm font-medium text-destructive">Revoke Credential</p>

      <div className="space-y-2">
        <Label className="text-xs">Reason *</Label>
        <Textarea
          value={reason}
          onChange={(e) => setReason(e.target.value)}
          placeholder="Why is this credential being revoked?"
          rows={3}
        />
      </div>

      {error && <p className="text-sm text-destructive">{error}</p>}

      <div className="flex gap-2">
        <Button
          size="sm"
          variant="destructive"
          onClick={handleRevoke}
          disabled={submitting || !reason.trim()}
        >
          {submitting ? "Revoking..." : "Confirm Revoke"}
        </Button>
        <Button size="sm" variant="outline" onClick={onCancel}>
          Cancel
        </Button>
      </div>
    </div>
  );
}

