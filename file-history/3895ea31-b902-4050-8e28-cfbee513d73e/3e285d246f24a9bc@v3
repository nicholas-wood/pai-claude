import { NextResponse } from "next/server";
import { eq, and, isNull, or, inArray, sql } from "drizzle-orm";
import { randomBytes } from "crypto";
import {
  Permission,
  CredentialStatus,
  manualAddCredentialSchema,
  AuditEntityType,
  AuditAction,
  RequestType,
  RequestStatus,
  type TenantSettings,
} from "@accessbuddy/shared";
import {
  tenantMemberships,
  credentials,
  credentialTypes,
  accessLevels,
  fobRequests,
  users,
  attestationRequests,
} from "@accessbuddy/db";
import { withTenantAuth, type TenantApiContext } from "@/lib/api";
import { withTenant } from "@/lib/with-tenant";
import { createAuditEntry } from "@/lib/services/audit";
import { sendTemplatedEmail, buildEmailConfig } from "@/lib/services/email";
import { nextTokenExpiry } from "@/lib/attestation-resend-logic";
import { membershipYearExpiry, parseDateWithTimezone } from "@/lib/timezone";
import { clientEnv } from "@/env";

/**
 * A refusal the admin can act on (wrong fob state, missing row, bad date).
 * Thrown inside the transaction so nothing is written, then mapped to a 400
 * with the message. Anything else that throws still surfaces as the
 * wrapper's 500.
 */
class ManualAddRefused extends Error {}

/** Statuses a fob the member still holds can be re-added from. */
const EXPIRY_UPDATE_ELIGIBLE_STATUSES: string[] = [
  CredentialStatus.EXPIRED,
  CredentialStatus.DEACTIVATED,
  CredentialStatus.RETURNED,
];

function humaniseStatus(status: string): string {
  return status.replace(/_/g, " ");
}

export const POST = withTenantAuth(
  async ({ auth, tenant, request }: TenantApiContext) => {
    // Check manual_add permission
    const { checkPermission } = await import("@/lib/permissions");
    const permResult = checkPermission(auth, tenant.id, Permission.MANUAL_ADD);
    if (!permResult.granted) {
      return NextResponse.json({ error: permResult.reason }, { status: 403 });
    }
    const body = await request.json();
    const parsed = manualAddCredentialSchema.safeParse(body);
    if (!parsed.success) {
      return NextResponse.json(
        { error: "Validation failed", details: parsed.error.flatten() },
        { status: 400 }
      );
    }

    const {
      ownerId,
      credentialTypeId: explicitCredentialTypeId,
      accessLevelId: explicitAccessLevelId,
      serialNumber,
      accessStartsAt,
      expiresAt,
      stage,
    } = parsed.data;

    const settings = tenant.settings as TenantSettings;
    const allowFobCreationAtProgramming =
      settings.allowFobCreationAtProgramming ?? false;

    let result;
    try {
      result = await withTenant(tenant.id, async (tx) => {
      const [membership] = await tx
        .select()
        .from(tenantMemberships)
        .where(
          and(
            eq(tenantMemberships.userId, ownerId),
            eq(tenantMemberships.tenantId, tenant.id)
          )
        )
        .limit(1);

      if (!membership) {
        throw new Error("Owner is not a member of this organisation");
      }

      // Resolve accessLevelId: use explicit if provided, otherwise inherit from membership
      const accessLevelId = explicitAccessLevelId ?? membership.accessLevelId;

      // If assigning from an existing unallocated fob, infer credentialTypeId from the fob
      let credentialTypeId = explicitCredentialTypeId;
      if (!credentialTypeId) {
        const [existingFob] = await tx
          .select({ credentialTypeId: credentials.credentialTypeId })
          .from(credentials)
          .where(eq(credentials.serialNumber, serialNumber))
          .limit(1);
        credentialTypeId = existingFob?.credentialTypeId;
      }

      if (!credentialTypeId) {
        throw new Error(
          "Credential type is required when not assigning an existing fob"
        );
      }

      const [ct] = await tx
        .select()
        .from(credentialTypes)
        .where(
          and(
            eq(credentialTypes.id, credentialTypeId),
            eq(credentialTypes.isActive, true)
          )
        )
        .limit(1);

      if (!ct) {
        throw new Error("Credential type not found or inactive");
      }

      // Look up access level name for the response
      let accessLevelName: string | null = null;
      if (accessLevelId) {
        const [al] = await tx
          .select()
          .from(accessLevels)
          .where(
            and(
              eq(accessLevels.id, accessLevelId),
              eq(accessLevels.isActive, true)
            )
          )
          .limit(1);

        if (!al) {
          throw new Error("Access level not found or inactive");
        }
        accessLevelName = al.name;
      }

      const now = new Date();

      let parsedAccessStartsAt: Date | undefined;
      if (accessStartsAt) {
        parsedAccessStartsAt = parseDateWithTimezone(
          accessStartsAt,
          tenant.timezone
        );
      }

      let parsedExpiresAt: Date | undefined;
      if (expiresAt) {
        parsedExpiresAt = parseDateWithTimezone(expiresAt, tenant.timezone);
      }

      // --- Expiry update: the member already holds this fob ---
      // No new fob, no tracking request, no pickup. Re-attach the existing
      // row and email the member a confirmation scoped to this one fob. Only
      // when they confirm does the attestation handler stage the season
      // expiry and flag the programmer; confirm-programming then promotes
      // the date, reactivates the credential and emails the member. Any
      // `expiresAt` in the body is ignored for this stage: the expiry is the
      // season end, as for every other renewal.
      if (stage === "expiry_update") {
        return stageExpiryUpdate(tx, {
          tenant,
          actorId: auth.user.id,
          ownerId,
          serialNumber,
          credentialTypeId,
          credentialTypeName: ct.name,
          accessLevelId: accessLevelId ?? null,
          accessLevelName,
          tokenExpiryDays: settings.attestationTokenExpiryDays ?? 7,
          now,
        });
      }

      // --- Calculate expiry for pickup/issued stages ---
      let calculatedExpiresAt: Date | null = parsedExpiresAt ?? null;

      if (
        (stage === "pickup" || stage === "issued") &&
        !parsedExpiresAt
      ) {
        // Check if staff or board member
        const isStaffOrBoard =
          membership.isStaff || membership.isBoardMember;

        if (!isStaffOrBoard) {
          // Membership-year expiry (Sep 1 rollover) in the tenant's timezone
          calculatedExpiresAt = membershipYearExpiry(
            tenant.timezone ?? "Australia/Melbourne"
          );
        }
        // Staff/board: calculatedExpiresAt stays null
      }

      // --- Determine request and credential status based on stage ---
      const requestStatusMap: Record<string, string> = {
        programming: RequestStatus.AWAITING_PROGRAMMING,
        pickup: RequestStatus.AWAITING_PICKUP,
        issued: RequestStatus.ISSUED,
      };
      const credStatusMap: Record<string, string> = {
        programming: CredentialStatus.PENDING_PROGRAMMING,
        pickup: CredentialStatus.ACTIVE,
        issued: CredentialStatus.ACTIVE,
      };
      const requestStatus = requestStatusMap[stage];
      const credStatus = credStatusMap[stage];

      // Create the tracking request
      const [fobRequest] = await tx
        .insert(fobRequests)
        .values({
          tenantId: tenant.id,
          requesterId: ownerId,
          credentialTypeId,
          accessLevelId: accessLevelId ?? null,
          requestType: RequestType.NEW,
          status: requestStatus,
          serialNumber,
          submittedAt: now,
          credentialExpiresAt: calculatedExpiresAt,
          ...(stage === "pickup" || stage === "issued"
            ? { programmedAt: now, programmedBy: auth.user.id }
            : {}),
          ...(stage === "issued"
            ? { issuedAt: now, issuedBy: auth.user.id }
            : {}),
        })
        .returning();

      // Check if a credential with this serial + type already exists (unallocated or deactivated)
      const [existingFob] = await tx
        .select({
          id: credentials.id,
          ownerId: credentials.ownerId,
          status: credentials.status,
        })
        .from(credentials)
        .where(
          and(
            eq(credentials.credentialTypeId, credentialTypeId),
            eq(credentials.serialNumber, serialNumber),
            or(
              isNull(credentials.ownerId),
              eq(credentials.status, "deactivated")
            )
          )
        )
        .limit(1);

      // Guard: if no existing fob and creation not allowed, error out
      if (!existingFob && !allowFobCreationAtProgramming) {
        throw new Error(
          "No existing fob found with this serial number. Fob creation is not enabled for this organisation."
        );
      }

      let credential;
      let wasReassignment = false;
      const previousOwnerId = existingFob?.ownerId ?? null;

      const credValues = {
        ownerId,
        credentialTypeId,
        accessLevelId: accessLevelId ?? null,
        requestId: fobRequest.id,
        status: credStatus,
        issuedAt: now,
        accessStartsAt: parsedAccessStartsAt ?? null,
        expiresAt: calculatedExpiresAt,
        updatedAt: now,
        deactivatedAt: null,
        deactivatedBy: null,
        deactivationReason: null,
      };

      if (existingFob) {
        wasReassignment =
          previousOwnerId !== null && previousOwnerId !== ownerId;

        const [updated] = await tx
          .update(credentials)
          .set(credValues)
          .where(eq(credentials.id, existingFob.id))
          .returning();
        credential = updated;
      } else {
        const [created] = await tx
          .insert(credentials)
          .values({
            tenantId: tenant.id,
            serialNumber,
            ...credValues,
          })
          .returning();
        credential = created;
      }

      // Update membership access level if one was set (either from rules or manual)
      if (accessLevelId) {
        await tx
          .update(tenantMemberships)
          .set({ accessLevelId, updatedAt: now })
          .where(
            and(
              eq(tenantMemberships.userId, ownerId),
              eq(tenantMemberships.tenantId, tenant.id)
            )
          );
      }

      // --- Audit entries ---

      // 1. Reassignment audit (existing fob with different previous owner)
      if (wasReassignment) {
        await createAuditEntry(tx, {
          tenantId: tenant.id,
          entityType: AuditEntityType.CREDENTIAL,
          entityId: credential.id,
          action: AuditAction.STATUS_CHANGE,
          fromState: "deactivated",
          toState: credStatus,
          actorId: auth.user.id,
          actorType: "user",
          metadata: {
            description: "Credential reassigned",
            previousOwnerId,
            newOwnerId: ownerId,
            reason: "manual_add",
          },
        });
      }

      // 2. Activation audit (pickup or issued)
      if (stage === "pickup" || stage === "issued") {
        await createAuditEntry(tx, {
          tenantId: tenant.id,
          entityType: AuditEntityType.CREDENTIAL,
          entityId: credential.id,
          action: wasReassignment
            ? AuditAction.UPDATE
            : AuditAction.STATUS_CHANGE,
          toState: CredentialStatus.ACTIVE,
          actorId: auth.user.id,
          actorType: "user",
          metadata: {
            description: "Credential activated",
            expiresAt: calculatedExpiresAt?.toISOString() ?? null,
            stage,
          },
        });
      }

      // 3. New allocation audit (no existing fob - brand new credential)
      if (!existingFob) {
        await createAuditEntry(tx, {
          tenantId: tenant.id,
          entityType: AuditEntityType.CREDENTIAL,
          entityId: credential.id,
          action: AuditAction.CREATE,
          toState: credStatus,
          actorId: auth.user.id,
          actorType: "user",
          metadata: {
            description: "Credential assigned",
            ownerId,
            stage,
            serialNumber,
            credentialTypeId,
            accessLevelId: accessLevelId ?? null,
          },
        });
      }

      // 4. Request audit entry
      const stageLabels: Record<string, string> = {
        programming: "Needs programming",
        pickup: "Programmed, awaiting pickup",
        issued: "Issued directly",
      };
      await createAuditEntry(tx, {
        tenantId: tenant.id,
        entityType: AuditEntityType.FOB_REQUEST,
        entityId: fobRequest.id,
        action: AuditAction.CREATE,
        toState: requestStatus,
        actorId: auth.user.id,
        actorType: "user",
        metadata: {
          action: "manual_add",
          credentialId: credential.id,
          serialNumber,
          credentialTypeName: ct.name,
          accessLevelName: accessLevelName ?? null,
          stage,
          stageDescription: stageLabels[stage] ?? stage,
        },
      });

      return {
        credential,
        expiresAt: calculatedExpiresAt?.toISOString() ?? null,
        accessLevelName,
        wasReassignment,
      };
      });
    } catch (err) {
      if (err instanceof ManualAddRefused) {
        return NextResponse.json({ error: err.message }, { status: 400 });
      }
      throw err;
    }

    return NextResponse.json(result, { status: 201 });
  },
  {}
);

type Tx = Parameters<Parameters<typeof withTenant>[1]>[0];

async function stageExpiryUpdate(
  tx: Tx,
  args: {
    tenant: TenantApiContext["tenant"];
    actorId: string;
    ownerId: string;
    serialNumber: string;
    credentialTypeId: string;
    credentialTypeName: string;
    accessLevelId: string | null;
    accessLevelName: string | null;
    tokenExpiryDays: number;
    now: Date;
  }
) {
  const {
    tenant,
    actorId,
    ownerId,
    serialNumber,
    credentialTypeId,
    credentialTypeName,
    accessLevelId,
    accessLevelName,
    tokenExpiryDays,
    now,
  } = args;
  const tenantId = tenant.id;
  const timezone = tenant.timezone ?? "Australia/Melbourne";

  // The fob must already be known: a serial the system has never seen is a
  // programming job for the "Send for Programming" stage, not an expiry
  // update. Explicit tenant predicate alongside RLS (belt and braces).
  const [existing] = await tx
    .select({
      id: credentials.id,
      ownerId: credentials.ownerId,
      status: credentials.status,
      requestId: credentials.requestId,
      expiresAt: credentials.expiresAt,
      programmingRequired: credentials.programmingRequired,
      programmingReason: credentials.programmingReason,
      deactivatedAt: credentials.deactivatedAt,
      deactivatedBy: credentials.deactivatedBy,
      deactivationReason: credentials.deactivationReason,
    })
    .from(credentials)
    .where(
      and(
        eq(credentials.tenantId, tenantId),
        eq(credentials.credentialTypeId, credentialTypeId),
        eq(credentials.serialNumber, serialNumber)
      )
    )
    .limit(1);

  if (!existing) {
    const otherTypes = await tx
      .select({ name: credentialTypes.name })
      .from(credentials)
      .innerJoin(
        credentialTypes,
        eq(credentials.credentialTypeId, credentialTypes.id)
      )
      .where(
        and(
          eq(credentials.tenantId, tenantId),
          eq(credentials.serialNumber, serialNumber)
        )
      );
    if (otherTypes.length > 0) {
      throw new ManualAddRefused(
        `Serial #${serialNumber} is recorded as ${otherTypes
          .map((t) => t.name)
          .join(", ")}, not ${credentialTypeName}. Pick the fob from the list or choose the matching type.`
      );
    }
    throw new ManualAddRefused(
      `No ${credentialTypeName} with serial #${serialNumber} exists. A fob the system has never seen needs the "Send for Programming" stage.`
    );
  }

  if (existing.status === CredentialStatus.ACTIVE) {
    throw new ManualAddRefused(
      existing.ownerId === ownerId
        ? `${credentialTypeName} #${serialNumber} is already active on this member. Edit the credential to change its expiry.`
        : existing.ownerId
          ? `${credentialTypeName} #${serialNumber} is already active on another member. Revoke or edit that credential first.`
          : `${credentialTypeName} #${serialNumber} is already active and unassigned. Use one of the other stages to issue it.`
    );
  }

  if (existing.programmingRequired) {
    throw new ManualAddRefused(
      `${credentialTypeName} #${serialNumber} already has an outstanding programming change (${existing.programmingReason ?? "no reason recorded"}). Confirm or cancel it on the programmer dashboard or the fob page first.`
    );
  }

  if (!EXPIRY_UPDATE_ELIGIBLE_STATUSES.includes(existing.status)) {
    throw new ManualAddRefused(
      `${credentialTypeName} #${serialNumber} is ${humaniseStatus(existing.status)}. Only expired, deactivated or returned fobs can be re-added for an expiry update.`
    );
  }

  // An expired fob is still on its owner's record. Silently moving it to
  // another member would strip them; the admin edits that credential first.
  if (
    existing.status === CredentialStatus.EXPIRED &&
    existing.ownerId &&
    existing.ownerId !== ownerId
  ) {
    const [other] = await tx
      .select({ firstName: users.firstName, lastName: users.lastName })
      .from(users)
      .where(eq(users.id, existing.ownerId))
      .limit(1);
    const otherName =
      [other?.firstName, other?.lastName].filter(Boolean).join(" ") ||
      "another member";
    throw new ManualAddRefused(
      `${credentialTypeName} #${serialNumber} is still assigned to ${otherName} and has only expired. Edit that credential first if it has changed hands.`
    );
  }

  // Already asked and still waiting: do not send a second link.
  const [pendingScoped] = await tx
    .select({ id: attestationRequests.id })
    .from(attestationRequests)
    .where(
      and(
        eq(attestationRequests.tenantId, tenantId),
        eq(attestationRequests.status, "pending"),
        sql`${attestationRequests.credentialIds} @> ${JSON.stringify([existing.id])}::jsonb`
      )
    )
    .limit(1);
  if (pendingScoped) {
    throw new ManualAddRefused(
      `${credentialTypeName} #${serialNumber} is already waiting for the member to confirm they have it. Re-send the confirmation from the member page instead.`
    );
  }

  const ownerChanged = existing.ownerId !== ownerId;

  // The member must be reachable: the whole point of this stage is their
  // confirmation. Without an address nothing would ever move.
  const [owner] = await tx
    .select({ email: users.email, firstName: users.firstName, lastName: users.lastName })
    .from(users)
    .where(eq(users.id, ownerId))
    .limit(1);
  if (!owner?.email?.trim()) {
    throw new ManualAddRefused(
      "This member has no email address, so they cannot be asked to confirm the fob. Add an email to the member first."
    );
  }

  // Expiry is the season end, as for every other renewal; the attestation
  // handler derives the date from this season string on confirm.
  const seasonEnd = membershipYearExpiry(timezone, now);
  const season = `${seasonEnd.getUTCFullYear() - 1}/${seasonEnd.getUTCFullYear()}`;

  // Conditional write: the eligibility read above and this update are in
  // one transaction, and the predicates repeat the checks (tenant, status,
  // flag, owner rule) so a concurrent change by another admin updates
  // nothing instead of overwriting it. Nothing is flagged for the
  // programmer here; that happens when the member confirms.
  const [updated] = await tx
    .update(credentials)
    .set({
      ownerId,
      accessLevelId,
      status: CredentialStatus.EXPIRED,
      pendingExpiresAt: null,
      // Deactivation fields stay until the member confirms: the attestation
      // handler quotes the old reason to the programmer and clears them then.
      // A stale link to the previous owner's request is misleading once the
      // fob changes hands; keep it when the same member gets their fob back.
      ...(ownerChanged ? { requestId: null } : {}),
      updatedAt: now,
    })
    .where(
      and(
        eq(credentials.id, existing.id),
        eq(credentials.tenantId, tenantId),
        eq(credentials.programmingRequired, false),
        inArray(credentials.status, EXPIRY_UPDATE_ELIGIBLE_STATUSES),
        existing.ownerId
          ? eq(credentials.ownerId, existing.ownerId)
          : isNull(credentials.ownerId)
      )
    )
    .returning();

  if (!updated) {
    throw new ManualAddRefused(
      "The credential changed while this was being saved. Reload the page and try again."
    );
  }

  if (accessLevelId) {
    await tx
      .update(tenantMemberships)
      .set({ accessLevelId, updatedAt: now })
      .where(
        and(
          eq(tenantMemberships.userId, ownerId),
          eq(tenantMemberships.tenantId, tenantId)
        )
      );
  }

  // Scoped attestation: the member confirms this one fob. Same table, token
  // and page as the renewal attestation, so resend, lapse and auto-resend
  // all work unchanged; the attestation handler stages the expiry on "yes"
  // and raises a lost replacement on "no".
  const token = randomBytes(32).toString("hex");
  const [attestation] = await tx
    .insert(attestationRequests)
    .values({
      tenantId,
      userId: ownerId,
      season,
      token,
      tokenExpiresAt: nextTokenExpiry(now, tokenExpiryDays),
      status: "pending",
      initiatedBy: actorId,
      credentialIds: [updated.id],
    })
    .returning({ id: attestationRequests.id });

  let confirmationSent = false;
  if (owner.email) {
    const attestUrl = `${clientEnv.NEXT_PUBLIC_APP_URL}/t/${tenant.slug}/attest/${token}`;
    const result = await sendTemplatedEmail(
      owner.email,
      "credentialHeldConfirmation",
      {
        memberName: `${owner.firstName} ${owner.lastName}`.trim() || "Member",
        credentialType: credentialTypeName,
        serialNumber,
        attestUrl,
      },
      buildEmailConfig(tenant),
      undefined,
      {
        tx,
        tenantId,
        entityType: AuditEntityType.CREDENTIAL,
        entityId: updated.id,
        actorId,
      }
    );
    confirmationSent = !!result?.sent;
  }

  await createAuditEntry(tx, {
    tenantId,
    entityType: AuditEntityType.CREDENTIAL,
    entityId: updated.id,
    action: AuditAction.UPDATE,
    fromState: existing.status,
    toState: CredentialStatus.EXPIRED,
    actorId,
    actorType: "user",
    metadata: {
      action: "manual_expiry_update",
      description: "Re-added to member, awaiting the member's confirmation before the expiry update is staged",
      serialNumber,
      credentialTypeName,
      season,
      attestationId: attestation.id,
      awaitingMemberConfirmation: true,
      confirmationEmailSent: confirmationSent,
      previousStatus: existing.status,
      previousOwnerId: existing.ownerId,
      newOwnerId: ownerId,
      previousRequestId: existing.requestId,
      previousExpiresAt: existing.expiresAt?.toISOString() ?? null,
      previousDeactivatedAt: existing.deactivatedAt?.toISOString() ?? null,
      previousDeactivatedBy: existing.deactivatedBy,
      previousDeactivationReason: existing.deactivationReason,
      accessLevelName,
    },
  });

  return {
    credential: updated,
    expiresAt: updated.expiresAt?.toISOString() ?? null,
    season,
    attestationId: attestation.id,
    confirmationSent,
    accessLevelName,
    wasReassignment: ownerChanged && existing.ownerId !== null,
    staged: true,
  };
}
