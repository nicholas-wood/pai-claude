  it("quotes the previous deactivation reason to the programmer when the member confirms (ISC-165)", async () => {
    const serial = `REASON-${suffix}`;
    const cred = await seedCredential({ serial, ownerId: member.id, status: "deactivated" });
    expect((await stage(serial)).status).toBe(201);
    // Still on the row while the member is being asked
    expect((await load(cred.id)).deactivationReason).toBe("Revoked");
    const [att] = await pendingScopedFor(cred.id);
    expect((await attestationPost(att.token, [{ credentialId: cred.id, confirmed: true }])).status).toBe(200);
    const after = await load(cred.id);
