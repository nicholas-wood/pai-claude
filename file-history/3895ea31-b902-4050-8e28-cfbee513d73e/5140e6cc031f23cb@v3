  it("admin can cancel a pending confirmation, which unlocks staging again (ISC-167)", async () => {
    const serial = `CANCEL-${suffix}`;
    const cred = await seedCredential({ serial, ownerId: member.id, status: "expired" });
    const first = await stage(serial);
    expect(first.status).toBe(201);
    const [att] = await pendingScopedFor(cred.id);

    const cancelled = await memberAction(cancelConfirmation, member.id, "cancel-confirmation", {
      attestationId: att.id,
      reason: "Wrong fob number",
    });
    expect(cancelled.status).toBe(200);
    const [row] = await db
      .select({ status: attestationRequests.status })
      .from(attestationRequests)
      .where(eq(attestationRequests.id, att.id));
    expect(row.status).toBe("cancelled");
    // The old link is dead
    expect((await attestationGet(att.token)).status).toBe(410);
    // Cancelling twice is refused, and an unscoped id is refused
    expect((await memberAction(cancelConfirmation, member.id, "cancel-confirmation", { attestationId: att.id })).status).toBe(409);
    const credAudit = await auditRows(cred.id, "confirmation_cancelled");
    expect(credAudit).toHaveLength(1);
    expect((credAudit[0].metadata as Record<string, unknown>).reason).toBe("Wrong fob number");

    // Staging again now works and sends a fresh email
    sentTemplates.length = 0;
    const second = await stage(serial);
    expect(second.status).toBe(201);
    expect(sentTemplates).toEqual(["credentialHeldConfirmation"]);
    expect((await pendingScopedFor(cred.id)).map((r) => r.id)).toEqual([second.json.attestationId]);
  });

  it("admin can answer on the member's behalf: staged for the programmer, attestation completed, season untouched (ISC-168)", async () => {
    const serial = `BEHALF-${suffix}`;
    const cred = await seedCredential({ serial, ownerId: member.id, status: "deactivated" });
    expect((await stage(serial)).status).toBe(201);
    const [att] = await pendingScopedFor(cred.id);
    const seasonBefore = await membershipSeason(member.id);

    const res = await memberAction(confirmOnBehalf, member.id, "confirm-on-behalf", {
      attestationId: att.id,
      note: "Confirmed by phone",
    });
    expect(res.status).toBe(200);
    expect(res.json.staged).toEqual([cred.id]);

    const after = await load(cred.id);
    expect(after.programmingRequired).toBe(true);
    expect(after.pendingExpiresAt!.getTime()).toBeGreaterThan(Date.now());
    expect(after.programmingReason).toContain("Admin confirmed on the member's behalf");
    expect(after.programmingReason).toContain(`#${serial}`);
    const [row] = await db
      .select({ status: attestationRequests.status, credentialResponses: attestationRequests.credentialResponses })
      .from(attestationRequests)
      .where(eq(attestationRequests.id, att.id));
    expect(row.status).toBe("completed");
    expect(row.credentialResponses?.[0]).toMatchObject({ credentialId: cred.id, confirmed: true });
    expect(await membershipSeason(member.id)).toBe(seasonBefore);
    const staging = await auditRows(cred.id, "attestation_expiry_update");
    expect((staging[0].metadata as Record<string, unknown>).confirmedBy).toBe("admin");
    // A second attempt is refused: no longer pending
    expect((await memberAction(confirmOnBehalf, member.id, "confirm-on-behalf", { attestationId: att.id })).status).toBe(409);
  });

