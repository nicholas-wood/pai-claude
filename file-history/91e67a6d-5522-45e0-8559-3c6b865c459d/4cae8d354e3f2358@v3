  readonly envelopeId?: string;
  /** When true, list only transactions that resolve to NO envelope (unmapped). Mutually exclusive with envelopeId. */
  readonly uncategorised?: boolean;
  readonly accountId?: string;
  /**
   * Direction filter by the sign of the amount: income = amount > 0,
   * expense = amount < 0, all (default) = no direction filter.
   */
  readonly type?: "income" | "expense" | "all";
  /** Inclusive lower bound on the transaction magnitude (absolute integer cents). */
  readonly amountMin?: number;
  /** Inclusive upper bound on the transaction magnitude (absolute integer cents). */
  readonly amountMax?: number;
  /** Case-insensitive substring match on the payee. */
  readonly keyword?: string;
}

export interface TransactionsResponse {
  readonly items: readonly TransactionListItem[];
}

// ── Create envelope (ISC-87) ──────────────────────────────────────────────────

/** Add a new envelope from the budget page (ISC-87, ISC-91, ISC-94, ISC-100). */
export interface CreateEnvelopeRequest {
  readonly name: string;
  /** income | expense | saving. saving behaves as expense; income is first-class (ISC-91). */
  readonly type: EnvelopeType;
  /** Parent envelope id for an expense/saving envelope, or null for top level. */
  readonly parentId?: string | null;
  readonly rolloverRule?: RolloverRule;
  /** Initial budgeted amount (template line for expense/saving, target for income). */
  readonly budgetedCents?: number;
  /** The period the budgeted amount is entered in (ISC-94). Defaults monthly. */
  readonly period?: BudgetPeriod;
  /**
   * The rollover schedule anchor date (YYYY-MM-DD). The envelope resets at the
   * chosen interval (period) from this date. Defaults to today when omitted.
   */
  readonly rolloverStart?: string;
  /** Active flag (ISC-100). Defaults true. */
  readonly active?: boolean;
  /** Income target / budget (ISC-92), income type only. */
  readonly targetCents?: number;
  /**
   * Budget chronology: the date the envelope's first budget version takes
   * effect (YYYY-MM-DD). Defaults to open-ended back-compat ('1970-01-01').
   */
  readonly effectiveFrom?: string;
  /** Optional end date for the first budget version; absent = open-ended. */
  readonly effectiveTo?: string;
}

export interface CreateEnvelopeResponse {
  readonly id: string;
  readonly type: EnvelopeType;
}

/** Edit an existing envelope's type/period/active/capital fields (ISC-91, ISC-94, ISC-100). */
export interface EditEnvelopeRequest {
  readonly id: string;
  readonly name?: string;
  readonly type?: EnvelopeType;
  readonly parentId?: string | null;
  readonly active?: boolean;
  /** Budgeted amount for an expense/saving template line. */
  readonly budgetedCents?: number;
  /** The period the budgeted amount is entered in (ISC-94). */
  readonly period?: BudgetPeriod;
  /** Income target / budget (ISC-92), income type only. */
  readonly targetCents?: number;
  /**
   * Budget chronology (effective-dated versions): a budget/target amount change
   * is appended as a new version effective from this date (YYYY-MM-DD).
   * Defaults to the first day of the current month.
   */
  readonly effectiveFrom?: string;
  /** Optional end date for the new version (YYYY-MM-DD); absent = open-ended. */
  readonly effectiveTo?: string;
  /** Complete the previous open version(s) the day before effectiveFrom. Default true. */
  readonly completePrevious?: boolean;
}

export interface EditEnvelopeResponse {
  readonly id: string;
  readonly ok: boolean;
}

// ── Money movements history (ISC-89, ISC-90) ──────────────────────────────────

export interface MovementView {
  readonly id: string;
  readonly ts: number;
  readonly fromEnvelopeId: string;
  readonly fromEnvelopeName: string | null;
  readonly toEnvelopeId: string;
  readonly toEnvelopeName: string | null;
  readonly amountCents: number;
  readonly scope: ChangeScope;
  readonly actor: "sync" | "ui" | "agent";
  readonly correlationId: string;
}

export interface MovementsResponse {
  readonly movements: readonly MovementView[];
}

/** Manually reset an envelope's carried starting balance, recorded as a traceable event. */
export interface SetCarryoverRequest {
  readonly envelopeId: string;
  readonly carryoverCents: number;
}
export interface SetCarryoverResponse {
  readonly beforeCents: number;
  readonly afterCents: number;
}

// ── Carryover adjustment history (the carryover.reset audit trail) ────────────

/**
 * Query for GET /api/carryover/history. When envelopeId is present the entries
 * are scoped to that envelope AND its descendants — the same rollup set the
 * trend chart and the transactions drill-down use — so the envelope-detail
 * surfaces read exactly the adjustments that shaped their figures. Omitted =
 * every adjustment for the tenant.
 */
export interface CarryoverHistoryQuery {
  readonly envelopeId?: string;
}

/**
 * One manual carryover adjustment, decoded from its append-only carryover.reset
 * event (ISC-15). `on` is the budget-timezone date the reset took effect (it
 * became the new rollover start); `envelopeName` is resolved for display and is
 * null when the envelope no longer exists.
 */
export interface CarryoverHistoryEntry {
  readonly id: string;
  /** Epoch millis the event was appended. */
  readonly ts: number;
  readonly envelopeId: string;
  readonly envelopeName: string | null;
  readonly beforeCents: number;
  readonly afterCents: number;
  /** The effective date (YYYY-MM-DD) in the budget timezone. */
  readonly on: string;
  readonly actor: "sync" | "ui" | "agent";
}

export interface CarryoverHistoryResponse {
  /** Newest first. */
  readonly entries: readonly CarryoverHistoryEntry[];
}

/** Archive or unarchive an envelope, recorded as a traceable envelope.archive event. */
export interface ArchiveEnvelopeRequest {
  readonly envelopeId: string;
  readonly archived: boolean;
}
export interface ArchiveEnvelopeResponse {
  readonly envelopeId: string;
  readonly archived: boolean;
}

/**
 * Set an envelope's rollover schedule: the anchor date and the interval (period).
 * Changing it recomputes the schedule, and therefore the running balances and Left.
 */
export interface SetRolloverRequest {
  readonly envelopeId: string;
  /** The new rollover anchor date (YYYY-MM-DD). */
  readonly rolloverStart: string;
  /** The new budget period/interval. Omit to leave the period unchanged. */
  readonly period?: BudgetPeriod;
}
export interface SetRolloverResponse {
  readonly envelopeId: string;
  readonly rolloverStart: string;
  readonly period: BudgetPeriod;
}

/** A lightweight archived-envelope entry for the budget page's "Show archived" list. */
export interface ArchivedEnvelopeView {
  readonly id: string;
  readonly name: string;
  readonly type: EnvelopeType;
}
export interface ArchivedEnvelopesResponse {
  readonly envelopes: readonly ArchivedEnvelopeView[];
}

// ── Unmapped-category detection + adopt wizard ────────────────────────────────

/**
 * One PocketSmith category that appears on synced transactions but has no
 * envelope mapping yet (distinct from the grid's uncategorised summary, which
 * counts transactions with NO category at all). These are transactions that DO
 * carry a PocketSmith category whose category is not in the budget: the adopt
 * wizard turns each into a budget envelope plus a category→envelope mapping.
 */
export interface UnmappedCategory {
  readonly categoryId: string;
  /** The PocketSmith category title, or null when the payload has none/is unparseable. */
  readonly categoryName: string | null;
  readonly transactionCount: number;
  /** Signed integer cents summed across the category's unmapped transactions. */
  readonly totalCents: number;
  /** Most-recent transaction date for the category (YYYY-MM-DD). */
  readonly lastSeenDate: string;
}

/** Optional inclusive date window (YYYY-MM-DD) for GET /api/categories/unmapped. */
export interface UnmappedCategoriesQuery {
  readonly from?: string;
  readonly to?: string;
}

export interface UnmappedCategoriesResponse {
  /** Most transactions first. */
  readonly categories: readonly UnmappedCategory[];
}

/**
 * Adopt an unmapped category (POST /api/categories/adopt): create a budget
 * envelope and, in the same transaction, a category→envelope mapping so the
 * category's transactions resolve to it and it stops appearing as unmapped.
 */
export interface AdoptCategoryRequest {
  readonly categoryId: string;
  readonly name: string;
  /** income | expense | saving | envelope | working. */
  readonly type: EnvelopeType;
  readonly budgetedCents?: number;
  readonly period?: BudgetPeriod;
  readonly rolloverRule?: RolloverRule;
  readonly parentId?: string | null;
  /** Mapping (and first budget version) effective date; defaults first of the current month. */
  readonly effectiveFrom?: string;
}

export interface AdoptCategoryResponse {
  readonly envelopeId: string;
}

/**
 * The full endpoint map: method + path + request/response. Handlers and the SPA
 * client both refer to this so a contract drift is a type error, not a runtime
 * surprise.
 */
export interface ApiContract {
  "POST /api/auth/signin": { req: SignInRequest; res: SignInResponse | ApiError };
  "POST /api/auth/verify": { req: VerifyLinkRequest; res: SessionResponse | ApiError };
  "GET /api/auth/session": { req: void; res: SessionResponse };
  "POST /api/auth/signout": { req: void; res: { ok: true } };
  "POST /api/auth/change-pin": { req: ChangePinRequest; res: ChangePinResponse | ApiError };

  "GET /api/envelopes": { req: EnvelopesQuery; res: GridResponse };
  "GET /api/envelopes/as-of": { req: AsOfRequest; res: GridResponse };
  "GET /api/envelopes/detail": {
    /**
     * Optional from/to (YYYY-MM-DD) scope the envelope's four-figure row and its
     * transactions to a period range, so the detail page reads one row for a
     * selected period instead of pulling the whole grid. Omitting both is the
     * current month.
     */
    req: { id: string; from?: string; to?: string };
    res: EnvelopeDetailResponse | ApiError;
  };
  "GET /api/envelopes/trend": { req: TrendQuery; res: TrendResponse | ApiError };
  "GET /api/envelopes/versions": { req: BudgetVersionsQuery; res: BudgetVersionsResponse | ApiError };
  "POST /api/envelopes/move": { req: MoveMoneyRequest; res: MoveMoneyResponse | ApiError };
  "POST /api/envelopes/distribute": { req: DistributeRequest; res: DistributeResponse | ApiError };
  "POST /api/envelopes": { req: CreateEnvelopeRequest; res: CreateEnvelopeResponse | ApiError };
  "POST /api/envelopes/carryover": { req: SetCarryoverRequest; res: SetCarryoverResponse | ApiError };
  "POST /api/envelopes/archive": { req: ArchiveEnvelopeRequest; res: ArchiveEnvelopeResponse | ApiError };
  "POST /api/envelopes/rollover": { req: SetRolloverRequest; res: SetRolloverResponse | ApiError };
  "GET /api/envelopes/archived": { req: void; res: ArchivedEnvelopesResponse };
  "POST /api/envelopes/edit": { req: EditEnvelopeRequest; res: EditEnvelopeResponse | ApiError };
  "POST /api/move": { req: MoveMoneyRequest; res: MoveMoneyResponse | ApiError };

  "GET /api/transactions": { req: TransactionsQuery; res: TransactionsResponse };

  "GET /api/categories/unmapped": { req: UnmappedCategoriesQuery; res: UnmappedCategoriesResponse };
  "POST /api/categories/adopt": { req: AdoptCategoryRequest; res: AdoptCategoryResponse | ApiError };

  "GET /api/movements": { req: void; res: MovementsResponse };

  // Errors (401 unauthenticated, 400 bad query) are non-2xx ApiError bodies the
  // client throws as ApiCallError, so the success type stands alone (as movements).
  "GET /api/carryover/history": { req: CarryoverHistoryQuery; res: CarryoverHistoryResponse };

  "POST /api/reconcile": { req: ReconcileRequest; res: ReconcileResponse };
  "POST /api/reconcile/confirm": { req: ReconcileConfirmRequest; res: ReconcileConfirmResponse | ApiError };
  "GET /api/reconcile/last": { req: void; res: LastReconcileResponse };
  "GET /api/reconcile/balances": { req: void; res: ReconcileBalancesResponse };
  "GET /api/net-position": { req: void; res: NetPositionResponse };
  "POST /api/sync": { req: void; res: SyncNowResponse };
  "GET /api/backup/status": { req: void; res: BackupStatusResponse };

  "GET /api/budget/history": { req: void; res: BudgetHistoryResponse };
  "POST /api/budget/edit": { req: EditBudgetRequest; res: EditBudgetResponse | ApiError };

  "GET /api/settings": { req: void; res: SettingsResponse };
  "POST /api/settings/pocketsmith-key": {
    req: SetPocketSmithKeyRequest;
    res: SetPocketSmithKeyResponse | ApiError;
  };

  "GET /api/pulse": { req: void; res: PulseResponse };
}

export type ApiPath = keyof ApiContract;

/**
 * Runtime mirror of the ApiContract keys. `satisfies Record<ApiPath, true>`
 * makes this exhaustive at compile time: adding an endpoint to ApiContract
 * without listing it here (or vice versa) is a type error. The contract-parity
