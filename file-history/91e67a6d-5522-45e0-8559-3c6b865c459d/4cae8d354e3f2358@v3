/** A reallocation names source, destination, amount, and scope (ISC-66, ISC-67). */
export interface MoveMoneyRequest {
  readonly fromEnvelopeId: string;
  readonly toEnvelopeId: string;
  readonly amountCents: number;
  readonly scope: ChangeScope;
}

export interface MoveMoneyResponse {
  readonly ok: boolean;
