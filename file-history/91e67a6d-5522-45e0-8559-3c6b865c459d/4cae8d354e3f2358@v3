  /** The cadence the amount was entered in (label; the amount is monthly-equivalent). */
  readonly period: BudgetPeriod;
  /** ISO date (YYYY-MM-DD) the version takes effect. */
  readonly effectiveFrom: string;
  /** ISO date the version ends, or null when open-ended. */
  readonly effectiveTo: string | null;
  readonly status: "completed" | "active" | "scheduled";
}

/** Query for GET /api/envelopes/versions. */
export interface BudgetVersionsQuery {
  readonly envelopeId: string;
}

export interface BudgetVersionsResponse {
  readonly envelopeId: string;
  /** Most recent first (by effectiveFrom descending). */
