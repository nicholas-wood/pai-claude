 * says so plainly — never a fabricated timestamp (ISC-83, ISC-46).
 */
export interface BackupStatusResponse {
  /** True when the deployment has an app-managed backup process (local mode). */
  readonly configured: boolean;
  /** ISO timestamp of the last verified backup, or null if none recorded. */
  readonly lastBackupAt: string | null;
  /** Size in bytes of the last verified snapshot, or null. */
  readonly sizeBytes: number | null;
  /** A human-readable status note (e.g. cloud-managed backups). */
  readonly message?: string;
}

