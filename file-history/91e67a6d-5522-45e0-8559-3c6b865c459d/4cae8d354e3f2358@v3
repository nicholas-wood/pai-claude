}

// ── Budget chronology (effective-dated versions) ──────────────────────────────

/**
 * One effective-dated budget version for an envelope (or income envelope): the
 * chronology entry the edit flow renders. `status` is computed server-side
 * against the CURRENT month in the configured budget timezone:
 *
 *   completed  effectiveTo is set and its month is before the current month
 *   scheduled  effectiveFrom's month is after the current month
 *   active     otherwise (contributes to the current month)
 */
export interface BudgetVersionView {
  readonly id: string;
  readonly envelopeId: string;
  /** Monthly-equivalent amount of the version (ISC-94 normalisation upstream). */
