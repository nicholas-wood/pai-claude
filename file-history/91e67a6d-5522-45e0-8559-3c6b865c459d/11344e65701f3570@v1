import * as React from "react";
import { History, ArrowRight, Bot, RefreshCw, User, PenLine } from "lucide-react";
import type { BudgetHistoryResponse } from "@contract";
import { call } from "@/lib/api";
import { useCarryoverHistory } from "@/lib/queries";
import { cn, formatCents, formatIsoDay } from "@/lib/utils";
import { Badge } from "@/components/ui/badge";

/**
 * Budget history (ISC-77). Every change to the budget template is recorded with
 * a timestamp, before/after values, scope, and actor, and is scrollable here —
 * followed by the manual carryover adjustments (every carryover.reset event,
 * newest first) so a hand-set starting balance is never invisible history.
 */
const actorMeta = {
  ui: { icon: User, label: "You" },
  sync: { icon: RefreshCw, label: "Sync" },
  agent: { icon: Bot, label: "Agent" },
} as const;

/**
 * The "Carryover adjustments" section: the same visual idiom as the budget
 * history list (name + actor/timestamp line, before → after → delta figures).
 */
function CarryoverAdjustments() {
  const historyQ = useCarryoverHistory();
  const entries = historyQ.data?.entries ?? [];

  return (
    <div>
      <h2 className="flex items-center gap-2 text-base font-semibold tracking-tight">
        <PenLine className="h-4 w-4" /> Carryover adjustments
      </h2>
      <p className="text-sm text-muted-foreground">
        Every manual reset of an envelope's carried starting balance, newest first.
      </p>
      <div className="mt-3 rounded-lg border bg-card divide-y divide-border/40">
        {entries.length === 0 ? (
          <div className="px-4 py-8 text-center text-sm text-muted-foreground">No carryover adjustments recorded yet.</div>
        ) : (
          entries.map((e) => {
            const meta = actorMeta[e.actor] ?? { icon: History, label: e.actor };
            const ActorIcon = meta.icon;
            const delta = e.afterCents - e.beforeCents;
            return (
              <div key={e.id} className="flex items-center justify-between gap-3 px-4 py-3">
                <div className="min-w-0">
                  <div className="flex items-center gap-2">
                    <span className={cn("truncate text-sm font-medium", e.envelopeName === null && "italic text-muted-foreground")}>
                      {e.envelopeName ?? "Deleted envelope"}
                    </span>
                    <Badge variant="secondary" className="text-[10px]">Effective {formatIsoDay(e.on)}</Badge>
                  </div>
                  <div className="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                    <ActorIcon className="h-3 w-3" /> {meta.label} · {new Date(e.ts).toLocaleString("en-AU")}
                  </div>
                </div>
                <div className="flex items-center gap-2 text-sm tnum">
                  <span className="text-muted-foreground">{formatCents(e.beforeCents)}</span>
                  <ArrowRight className="h-3.5 w-3.5 text-muted-foreground" />
                  <span className="font-medium">{formatCents(e.afterCents)}</span>
                  <span className={cn("w-16 text-right", delta >= 0 ? "text-success" : "text-destructive")}>
                    {formatCents(delta, { sign: true })}
                  </span>
                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}

export function HistoryPage() {
  const [history, setHistory] = React.useState<BudgetHistoryResponse>({ entries: [] });

  React.useEffect(() => {
    void (async () => {
      try {
        setHistory(await call("GET /api/budget/history"));
      } catch {
        setHistory({ entries: [] });
      }
    })();
  }, []);

  return (
    <div className="mx-auto max-w-3xl space-y-5">
      <div>
        <h1 className="flex items-center gap-2 text-xl font-semibold tracking-tight md:text-2xl">
          <History className="h-5 w-5" /> Budget history
        </h1>
        <p className="text-sm text-muted-foreground">Every allocation change, with who changed it and when.</p>
      </div>

      <div className="rounded-lg border bg-card divide-y divide-border/40">
        {history.entries.length === 0 ? (
          <div className="px-4 py-12 text-center text-sm text-muted-foreground">No changes recorded yet.</div>
        ) : (
          history.entries.map((e) => {
            // Fall back gracefully if the server ever returns an actor outside
            // the known set (N5), rather than reading .icon off undefined.
            const meta = actorMeta[e.actor] ?? { icon: History, label: e.actor };
            const ActorIcon = meta.icon;
            const delta = e.afterCents - e.beforeCents;
            return (
              <div key={e.id} className="flex items-center justify-between gap-3 px-4 py-3">
                <div className="min-w-0">
                  <div className="flex items-center gap-2">
                    <span className="truncate text-sm font-medium">{e.envelopeName}</span>
                    <Badge variant={e.scope === "ongoing" ? "default" : "secondary"} className="text-[10px]">
                      {e.scope === "ongoing" ? "Every month" : "This month"}
                    </Badge>
                  </div>
                  <div className="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground">
                    <ActorIcon className="h-3 w-3" /> {meta.label} · {new Date(e.ts).toLocaleString("en-AU")}
                  </div>
                </div>
                <div className="flex items-center gap-2 text-sm tnum">
                  <span className="text-muted-foreground">{formatCents(e.beforeCents)}</span>
                  <ArrowRight className="h-3.5 w-3.5 text-muted-foreground" />
                  <span className="font-medium">{formatCents(e.afterCents)}</span>
                  <span className={cn("w-16 text-right", delta >= 0 ? "text-success" : "text-destructive")}>
                    {formatCents(delta, { sign: true })}
                  </span>
                </div>
              </div>
            );
          })
        )}
      </div>

      <CarryoverAdjustments />
    </div>
  );
}
