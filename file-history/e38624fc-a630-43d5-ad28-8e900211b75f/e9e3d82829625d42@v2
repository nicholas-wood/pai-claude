/**
 * Pure logic for automatic attestation resends.
 *
 * When an admin renews a member, one attestation email goes out with a
 * short-lived token. If the member ignores it the token lapses and, before
 * this module existed, nothing followed: the member's fobs were never staged
 * for the programmer and nobody was told. The nightly cron now replaces a
 * lapsed attestation with a fresh one and re-queues the email, so the member
 * hears again every `attestationTokenExpiryDays` (default 7) until they
 * complete it.
 *
 * Kept free of DB and IO so it is unit-testable. The cron composes it.
 */

export type AttestationStatus = "pending" | "completed" | "expired" | (string & {});

export type AutoResendInput = {
  /** Status of the member's most recent attestation for this season. */
  latestStatus: AttestationStatus;
  /** Token expiry of that latest attestation. */
  latestTokenExpiresAt: Date;
  /** Season the attestation was raised for, e.g. "2026/2027". */
  attestationSeason: string;
  /** Season the membership currently sits in (set by the Renew action). */
  membershipSeason: string | null;
  /** Membership status; only "active" members are re-asked. */
  membershipStatus: string;
  /** Count of the member's credentials in a status the attestation page lists (active, expired). */
  attestableCredentialCount: number;
  /** Member email; null or empty means there is nobody to send to. */
  email: string | null;
  /** Tenant setting `attestationAutoResend`; undefined is treated as enabled. */
  autoResendEnabled: boolean | undefined;
  now: Date;
};

export type AutoResendDecision = {
  resend: boolean;
  reason: string;
};

/**
 * Decide whether the member's latest attestation for a season should be
 * replaced with a fresh one right now. Every "no" carries a reason so the
 * cron can log why a member was skipped.
 */
export function shouldAutoResend(input: AutoResendInput): AutoResendDecision {
  if (input.autoResendEnabled === false) {
    return { resend: false, reason: "tenant_auto_resend_disabled" };
  }

  if (input.latestStatus === "completed") {
    return { resend: false, reason: "completed" };
  }

  if (input.latestStatus === "pending" && input.latestTokenExpiresAt > input.now) {
    return { resend: false, reason: "pending_token_live" };
  }

  if (input.latestStatus !== "expired" && input.latestStatus !== "pending") {
    return { resend: false, reason: `unknown_status:${input.latestStatus}` };
  }

  // Only the season the admin renewed the member into is re-asked. A lapsed
  // attestation from a previous season must never come back to life.
  if (!input.membershipSeason || input.membershipSeason !== input.attestationSeason) {
    return { resend: false, reason: "season_mismatch" };
  }

  if (input.membershipStatus !== "active") {
    return { resend: false, reason: "membership_not_active" };
  }

  if (input.attestableCredentialCount <= 0) {
    return { resend: false, reason: "no_attestable_credentials" };
  }

  if (!input.email || input.email.trim() === "") {
    return { resend: false, reason: "no_email" };
  }

  return { resend: true, reason: "lapsed" };
}

/**
 * Token expiry for a freshly issued attestation: `days` calendar days from
 * `now` at the same wall-clock time. Mirrors the Renew and Resend routes so
 * the automatic cadence equals the manual one.
 */
export function nextTokenExpiry(now: Date, days: number): Date {
  const expiry = new Date(now);
  expiry.setDate(expiry.getDate() + days);
  return expiry;
}

/**
 * Pick the most recent attestation per (user, season) from a list in any
 * order. The cron reads a tenant's attestations in one query and needs the
 * latest per member to decide; older rows only contribute to the cycle count.
 */
export function latestPerUserSeason<
  T extends { userId: string; season: string; createdAt: Date }
>(rows: T[]): Map<string, { latest: T; cycle: number }> {
  const out = new Map<string, { latest: T; cycle: number }>();
  for (const row of rows) {
    const key = `${row.userId}|${row.season}`;
    const existing = out.get(key);
    if (!existing) {
      out.set(key, { latest: row, cycle: 1 });
      continue;
    }
    existing.cycle += 1;
    if (row.createdAt > existing.latest.createdAt) {
      existing.latest = row;
    }
  }
  return out;
}
