#!/bin/bash
# Fire the daily cron (issues fresh attestations + queues emails) then the
# email-queue drain (sends them), and read the Cloud Run logs for the counts.
G=/opt/homebrew/bin/gcloud
P=accessbuddy-prod
L=australia-southeast1
FILTER='resource.type="cloud_run_revision" AND resource.labels.service_name="accessbuddy-production"'
T0=$(date -u +%Y-%m-%dT%H:%M:%SZ)
echo "T0=$T0"

echo "== run daily cron"
$G scheduler jobs run accessbuddy-daily-cron --location $L --project $P 2>&1 | tail -2

for i in $(seq 1 18); do
  sleep 10
  LINE=$($G logging read "$FILTER AND timestamp>=\"$T0\" AND textPayload:\"Cron daily completed\"" --project $P --limit 1 --format="value(timestamp,textPayload)" 2>/dev/null)
  if [ -n "$LINE" ]; then echo "DAILY_DONE after ~$((i*10))s"; echo "$LINE"; break; fi
done
[ -z "$LINE" ] && echo "DAILY_LOG_NOT_SEEN (3 min)"

echo "== run email queue drain"
$G scheduler jobs run accessbuddy-email-queue-drain --location $L --project $P 2>&1 | tail -2
T1=$(date -u +%Y-%m-%dT%H:%M:%SZ)
for i in $(seq 1 12); do
  sleep 10
  DLINE=$($G logging read "$FILTER AND timestamp>=\"$T1\" AND (textPayload:\"drain\" OR textPayload:\"Drain\" OR textPayload:\"queue\")" --project $P --limit 5 --format="value(timestamp,textPayload)" 2>/dev/null)
  if [ -n "$DLINE" ]; then echo "DRAIN_LOG after ~$((i*10))s"; echo "$DLINE"; break; fi
done
[ -z "$DLINE" ] && echo "DRAIN_LOG_NOT_SEEN (2 min)"

echo "== any errors since T0"
$G logging read "$FILTER AND timestamp>=\"$T0\" AND severity>=ERROR" --project $P --limit 5 --format="value(timestamp,textPayload)" 2>/dev/null | cut -c1-300
echo "== all cron/queue lines since T0"
$G logging read "$FILTER AND timestamp>=\"$T0\" AND (textPayload:\"Cron\" OR textPayload:\"queue\" OR textPayload:\"attestation\")" --project $P --limit 20 --format="value(timestamp,textPayload)" 2>/dev/null | cut -c1-400
echo "KICK_DONE"
