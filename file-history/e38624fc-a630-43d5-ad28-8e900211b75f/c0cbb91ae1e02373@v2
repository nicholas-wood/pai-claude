import { describe, it, expect } from "vitest";
import {
  shouldAutoResend,
  nextTokenExpiry,
  latestPerUserSeason,
  type AutoResendInput,
} from "../lib/attestation-resend-logic";

const NOW = new Date("2026-09-05T16:00:00.000Z"); // 2am AEST 6 Sep cron
const DAY_MS = 24 * 60 * 60 * 1000;

function lapsed(overrides: Partial<AutoResendInput> = {}): AutoResendInput {
  return {
    latestStatus: "expired",
    latestTokenExpiresAt: new Date(NOW.getTime() - 3 * DAY_MS),
    attestationSeason: "2026/2027",
    membershipSeason: "2026/2027",
    membershipStatus: "active",
    attestableCredentialCount: 2,
    email: "member@example.com",
    autoResendEnabled: true,
    now: NOW,
    ...overrides,
  };
}

// ============================================================
// shouldAutoResend
// ============================================================
describe("shouldAutoResend", () => {
  it("resends a lapsed (expired) current-season attestation", () => {
    expect(shouldAutoResend(lapsed())).toEqual({ resend: true, reason: "lapsed" });
  });

  it("never resends once the member has completed", () => {
    expect(shouldAutoResend(lapsed({ latestStatus: "completed" })).resend).toBe(false);
    expect(shouldAutoResend(lapsed({ latestStatus: "completed" })).reason).toBe("completed");
  });

  it("leaves a pending attestation alone while its token is live", () => {
    const d = shouldAutoResend(
      lapsed({ latestStatus: "pending", latestTokenExpiresAt: new Date(NOW.getTime() + DAY_MS) })
    );
    expect(d).toEqual({ resend: false, reason: "pending_token_live" });
  });

  it("resends a pending attestation whose token has already lapsed", () => {
    const d = shouldAutoResend(
      lapsed({ latestStatus: "pending", latestTokenExpiresAt: new Date(NOW.getTime() - 1000) })
    );
    expect(d.resend).toBe(true);
  });

  it("never revives a previous season's attestation", () => {
    const d = shouldAutoResend(lapsed({ attestationSeason: "2025/2026" }));
    expect(d).toEqual({ resend: false, reason: "season_mismatch" });
  });

  it("skips when the membership has no current season", () => {
    expect(shouldAutoResend(lapsed({ membershipSeason: null })).reason).toBe("season_mismatch");
  });

  it("skips inactive memberships", () => {
    expect(shouldAutoResend(lapsed({ membershipStatus: "inactive" })).reason).toBe(
      "membership_not_active"
    );
  });

  it("skips members with nothing to attest", () => {
    expect(shouldAutoResend(lapsed({ attestableCredentialCount: 0 })).reason).toBe(
      "no_attestable_credentials"
    );
  });

  it("skips members without an email address", () => {
    expect(shouldAutoResend(lapsed({ email: null })).reason).toBe("no_email");
    expect(shouldAutoResend(lapsed({ email: "   " })).reason).toBe("no_email");
  });

  it("respects the tenant kill switch", () => {
    expect(shouldAutoResend(lapsed({ autoResendEnabled: false })).reason).toBe(
      "tenant_auto_resend_disabled"
    );
  });

  it("treats an absent tenant setting as enabled", () => {
    expect(shouldAutoResend(lapsed({ autoResendEnabled: undefined })).resend).toBe(true);
  });

  it("does not resend unknown statuses", () => {
    expect(shouldAutoResend(lapsed({ latestStatus: "cancelled" })).resend).toBe(false);
  });
});

// ============================================================
// nextTokenExpiry
// ============================================================
describe("nextTokenExpiry", () => {
  it("adds the configured number of days at the same wall time", () => {
    const expiry = nextTokenExpiry(NOW, 7);
    expect(expiry.getTime() - NOW.getTime()).toBe(7 * DAY_MS);
  });

  it("does not mutate the input date", () => {
    const input = new Date(NOW);
    nextTokenExpiry(input, 7);
    expect(input.getTime()).toBe(NOW.getTime());
  });
});

// ============================================================
// latestPerUserSeason
// ============================================================
describe("latestPerUserSeason", () => {
  it("picks the newest row per member and season and counts the cycle", () => {
    const rows = [
      { id: "a", userId: "u1", season: "2026/2027", createdAt: new Date("2026-08-08") },
      { id: "b", userId: "u1", season: "2026/2027", createdAt: new Date("2026-08-22") },
      { id: "c", userId: "u1", season: "2025/2026", createdAt: new Date("2025-08-01") },
      { id: "d", userId: "u2", season: "2026/2027", createdAt: new Date("2026-09-01") },
    ];
    const m = latestPerUserSeason(rows);
    expect(m.get("u1|2026/2027")?.latest.id).toBe("b");
    expect(m.get("u1|2026/2027")?.cycle).toBe(2);
    expect(m.get("u1|2025/2026")?.latest.id).toBe("c");
    expect(m.get("u2|2026/2027")?.cycle).toBe(1);
  });

  it("is order-independent", () => {
    const newer = { id: "n", userId: "u", season: "s", createdAt: new Date("2026-09-02") };
    const older = { id: "o", userId: "u", season: "s", createdAt: new Date("2026-09-01") };
    expect(latestPerUserSeason([newer, older]).get("u|s")?.latest.id).toBe("n");
    expect(latestPerUserSeason([older, newer]).get("u|s")?.latest.id).toBe("n");
  });
});
