\set ON_ERROR_STOP off
\pset pager off
\timing off
select set_config('app.current_tenant_id', (select id::text from tenants where slug='south-melb-lsc'), false) as tenant_ctx;

\echo === Programming-flag lifecycle audit since 20 Aug
select a.created_at, left(a.entity_id::text,8) ent, a.metadata->>'action' act, left(coalesce(a.actor_id::text,''),8) actor, a.metadata->>'newExpiresAt' new_exp, a.metadata->>'reactivated' react
from audit_log a
where a.metadata->>'action' in ('attestation_expiry_update','confirm_programming','cancel_programming','attestation_force_completed','force_renew','force_renew_expiry_update','permission_expiry_reprogramming')
  and a.created_at > '2026-08-20'
order by a.created_at;

\echo === Credentials of members who completed attestation since 25 Aug
select u.first_name, u.last_name, ar.completed_at, c.serial_number, c.status, c.expires_at, c.pending_expires_at, c.programming_required
from attestation_requests ar join users u on u.id=ar.user_id
join credentials c on c.owner_id=ar.user_id and c.tenant_id=ar.tenant_id
where ar.season='2026/2027' and ar.status='completed' and ar.completed_at > '2026-08-25'
order by ar.completed_at, u.last_name;

\echo === Reprogramming section text in programmer summaries (building@)
select a.created_at, a.metadata->>'summaryFingerprint' fp,
  substring(regexp_replace(a.metadata->>'html', '<[^>]+>', ' ', 'g') from 'Credentials Awaiting Reprogramming.{0,700}') as section
from audit_log a
where a.metadata->>'templateType'='dailySummary' and a.metadata->>'to'='building@southmelbournelsc.com.au' and a.created_at > '2026-09-01'
order by a.created_at;

\echo === Cohort in Dinah state: renewed to 2026/2027 but attestation not completed
select ar.status att_status, ar.token_expires_at, u.first_name, u.last_name, u.email,
  (select count(*) from credentials c where c.owner_id=u.id and c.tenant_id=ar.tenant_id and c.status in ('active','expired')) creds,
  (select count(*) from credentials c where c.owner_id=u.id and c.tenant_id=ar.tenant_id and c.programming_required) flagged
from attestation_requests ar join users u on u.id=ar.user_id
where ar.season='2026/2027' and ar.status in ('expired','pending')
order by ar.status, ar.token_expires_at;

\echo === Attestation status totals for 2026/2027
select status, count(*) from attestation_requests where season='2026/2027' group by 1;

\echo === Memberships marked 2026/2027 vs attestations
select count(*) memberships_2026_27 from tenant_memberships where current_season='2026/2027';
