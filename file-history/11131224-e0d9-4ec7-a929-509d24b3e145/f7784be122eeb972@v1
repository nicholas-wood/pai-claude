// Default entrypoint: the Discord frontend. (For the Slack frontend: npm run start:slack)
import "dotenv/config";
import { startDiscord } from "./discordApp";

const required = ["DISCORD_BOT_TOKEN", "DISCORD_GUILD_ID"];
const missing = required.filter((k) => !process.env[k]);
if (missing.length) {
  console.error(
    `Missing env vars: ${missing.join(", ")}.\n` +
      `Copy .env.example to .env and fill them in (see README — Discord setup).`
  );
  process.exit(1);
}

startDiscord();
console.log("Starting LifeOS Discord console… (logging in)");
