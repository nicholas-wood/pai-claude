  SlashCommandBuilder,
  MessageFlags,
} from "discord.js";
import type {
  TextChannel,
  CategoryChannel,
  Interaction,
} from "discord.js";
import {
  getRoster,
  findAgent,
  findAgentByName,
  buildSystemPrompt,
  readFileSafe,
