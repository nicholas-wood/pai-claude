import { query, type Options } from "@anthropic-ai/claude-agent-sdk";
import { buildSystemPrompt, type Agent } from "./roster";
import { policyFor, summarizeTool } from "./agentConfig";
import { delegationAgents } from "./delegation";
import { delegateServer, DELEGATE_TOOL_NAME, type OnDelegate } from "./delegateTool";

export type TaskEvent =
  | { kind: "text"; text: string }
  | { kind: "tool"; tool: string; summary: string; delegated: boolean }
  | { kind: "result"; text: string; costUsd: number; turns: number }
  | { kind: "error"; message: string };

export interface RunOptions {
  agent: Agent;
  prompt: string;
  onEvent: (e: TaskEvent) => void | Promise<void>;
  canUseTool: Options["canUseTool"];
  controller?: AbortController;
  /** When set on an orchestrator, gives it a `delegate` tool that runs an agent in its own channel. */
  onDelegate?: OnDelegate;
}

/**
 * Run one agent task via the Claude Agent SDK, streaming tool/skill activity and
 * the final result through `onEvent`. Uses the Claude subscription (no API key).
 */
export async function runAgentTask(
  opts: RunOptions
): Promise<{ result: string; costUsd: number }> {
  const { agent, prompt, onEvent, canUseTool, controller, onDelegate } = opts;
  const policy = policyFor(agent);

  // Orchestrator + a channel-aware onDelegate → give it the custom `delegate` tool
  // (runs the target agent in its own channel). Otherwise fall back to native subagents.
  const useChannelDelegate = policy.isOrchestrator && Boolean(onDelegate);

  const options: Options = {
    cwd: policy.cwd,
    systemPrompt: { type: "preset", preset: "claude_code", append: buildSystemPrompt(agent) },
    allowedTools: useChannelDelegate
      ? [...policy.allowedTools, DELEGATE_TOOL_NAME]
      : policy.allowedTools,
    canUseTool,
    permissionMode: "default",
    settingSources: [], // don't load the user's PAI settings/hooks into spawned sessions
    maxTurns: Number(process.env.MAX_TURNS ?? 24),
    model: process.env.AGENT_MODEL || undefined,
    abortController: controller,
    // Subscription auth (strip API key) + avoid the nested-session guard (strip CLAUDECODE).
    env: { ...process.env, ANTHROPIC_API_KEY: undefined, CLAUDECODE: undefined },
    ...(useChannelDelegate
      ? { mcpServers: { delegation: delegateServer(agent.id, onDelegate!) } }
      : policy.isOrchestrator
        ? { agents: delegationAgents(agent.id) }
        : {}),
  };

  let finalResult = "";
  let costUsd = 0;

  try {
    for await (const msg of query({ prompt, options })) {
      if (msg.type === "assistant") {
        const am = msg as any;
        const delegated = am.parent_tool_use_id != null;
        for (const block of am.message?.content ?? []) {
          if (block.type === "text" && block.text?.trim()) {
            await onEvent({ kind: "text", text: block.text });
          } else if (block.type === "tool_use") {
            await onEvent({
              kind: "tool",
              tool: block.name,
              summary: summarizeTool(block.name, block.input ?? {}),
              delegated,
            });
          }
        }
      } else if (msg.type === "result") {
        const r = msg as any;
        finalResult = typeof r.result === "string" ? r.result : finalResult;
        costUsd = r.total_cost_usd ?? 0;
        await onEvent({ kind: "result", text: finalResult, costUsd, turns: r.num_turns ?? 0 });
      }
    }
  } catch (e: any) {
    await onEvent({ kind: "error", message: e?.message ?? String(e) });
    throw e;
  }

  return { result: finalResult, costUsd };
}
