import { createSdkMcpServer, tool } from "@anthropic-ai/claude-agent-sdk";
import { z } from "zod";

// ISC-9: free-form ask_user. Lets an agent pause mid-task to ask Nick a question
// and wait for his reply, rather than only the Approve/Deny gate. The frontend
// supplies `onAskUser`, which posts the question to the conversation and resolves
// with Nick's next message.

export type OnAskUser = (question: string) => Promise<string>;

export const ASK_USER_TOOL_NAME = "mcp__askuser__ask_user";

export function askUserServer(onAskUser: OnAskUser) {
  return createSdkMcpServer({
    name: "askuser",
    version: "1.0.0",
    tools: [
      tool(
        "ask_user",
        "Ask Nick a free-form question and wait for his reply. Use when you need information " +
          "or a decision only he can give. Returns his answer as text.",
        { question: z.string().describe("The question to ask Nick") },
        async (args) => {
          const answer = await onAskUser(args.question);
          return { content: [{ type: "text" as const, text: answer }] };
        }
      ),
    ],
  });
}
