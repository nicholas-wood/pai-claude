/**
 * The typed API contract. This is the single source of truth for the wire shapes
 * exchanged between the SPA and the Hono handlers. Locking it here lets the UI and
 * the handler implementations be built in parallel against the same types.
 *
 * Conventions:
 *   - All money is integer cents (field names end in Cents).
 *   - Dates are ISO strings (YYYY-MM-DD); timestamps are epoch millis (asOf, ts).
 *   - Every response that reflects tenant state is implicitly scoped to the
 *     authenticated user_id resolved by the AuthProvider; user_id is never a
 *     request field (the session carries it).
 */

import type { BudgetPeriod, ChangeScope, EnvelopeType, RolloverRule, TargetType } from "../domain/types.ts";

/** Uniform error envelope. */
export interface ApiError {
  readonly error: string;
  readonly code: string;
}

// ── Auth ────────────────────────────────────────────────────────────────────

export interface SignInRequest {
  /** PIN for local mode, email for cloud mode. */
  readonly kind: "pin" | "email";
  readonly pin?: string;
  readonly email?: string;
}

export interface SignInResponse {
  /** "authenticated" when a session was minted (local PIN); "link_sent" for cloud. */
  readonly status: "authenticated" | "link_sent";
  readonly userId: string | null;
}

export interface VerifyLinkRequest {
  readonly token: string;
}

export interface SessionResponse {
  readonly authenticated: boolean;
  readonly userId: string | null;
  readonly idleExpiresAt: number | null;
}

// ── Envelopes grid (with rollups) ─────────────────────────────────────────────

/** One row in the Dave Ramsey grid, with the four figures and tree position. */
export interface EnvelopeRow {
  readonly id: string;
  readonly parentId: string | null;
  readonly name: string;
  readonly group: string;
  readonly rolloverRule: RolloverRule;
  readonly targetType: TargetType;
  readonly targetAmountCents: number;
  /** Envelope type (ISC-91): income, expense, or saving. */
  readonly type: EnvelopeType;
  /** Active flag (ISC-100). Inactive envelopes are excluded from the budget total. */
  readonly active: boolean;
  /** The period the budget is entered in (ISC-94): weekly, fortnightly, monthly, annual. */
  readonly period: BudgetPeriod;
  /** Starting carryover (may be negative). */
  readonly carryoverCents: number;
  /** This-period allocation. */
  readonly allocationCents: number;
  /** carryover + allocation. */
  readonly totalCents: number;
  /** total - spent. */
  readonly leftCents: number;
  /** Depth in the tree, 0 = top level. */
  readonly depth: number;
}

/** A first-class income envelope on the grid (ISC-65, ISC-88, ISC-92): target + capital. */
export interface IncomeEnvelopeView {
  readonly id: string;
  readonly name: string;
  readonly source: string;
  readonly budgetedCents: number;
  readonly actualCents: number;
  /** Income target (ISC-92). */
  readonly targetCents: number;
  /** Portion of the target routed into the shared expense-capital pool (ISC-92). */
  readonly capitalToExpenseCents: number;
  /** actual - target. Positive = surplus, negative = deficit (ISC-99). */
  readonly varianceCents: number;
  /** Carried rollover baseline on the income envelope (signed). */
  readonly carryoverCents: number;
}

export interface GridResponse {
  /** ISO YYYY-MM for the rendered period. */
  readonly period: string;
  readonly rows: readonly EnvelopeRow[];
  /** First-class income envelopes with budgeted/actual/variance (ISC-65, ISC-88). */
  readonly income: readonly IncomeEnvelopeView[];
  /**
   * False when the tenant has zero envelopes: the UI shows the empty "not set up
   * yet" state instead of a misleading zeroed balance (ISC-88).
   */
  readonly isSetUp: boolean;
  /** Total budgeted income across income envelopes (the zero-based denominator). */
  readonly budgetedIncomeCents: number;
  /** Continuous zero-based check: positive = unallocated, negative = over-allocated. */
  readonly unallocatedCents: number;
  /** True when the budget is not zero-based; an alert, never a block (ISC-30). */
  readonly zeroBasedAlert: boolean;
  /** Total expense-capital provided: sum of income capitalToExpense (ISC-92, ISC-99). */
  readonly capitalProvidedCents: number;
  /** Total budgeted out: sum of active expense+saving monthly equivalents (ISC-98, ISC-99). */
  readonly budgetedOutCents: number;
  /** capitalProvided - budgetedOut. Zero when the zero-base balances (ISC-98). */
  readonly residualCents: number;
  readonly asOf: number;
}

/** The budget-balancing (zero-base) figures, ISC-98 / ISC-99. */
export interface BudgetBalanceResponse {
  /** Sum of income capitalToExpense: the expense capital provided. */
  readonly capitalProvidedCents: number;
  /** Sum of active expense+saving monthly equivalents: the amount budgeted out. */
  readonly budgetedOutCents: number;
  /** capitalProvided - budgetedOut. Zero when balanced; the residual otherwise. */
  readonly residualCents: number;
}

/** Time-travel view: balances as at end-of-day T (ISC-36). */
export interface AsOfRequest {
  readonly date: string;
}

// ── Envelope detail ───────────────────────────────────────────────────────────

export interface TransactionView {
  readonly id: string;
  readonly date: string;
  readonly amountCents: number;
  readonly payee: string;
  readonly isPending: boolean;
  readonly isTransfer: boolean;
}

export interface EnvelopeDetailResponse {
  readonly envelope: EnvelopeRow;
  readonly transactions: readonly TransactionView[];
}

// ── Move money (reallocation) ─────────────────────────────────────────────────

/** A reallocation names source, destination, amount, and scope (ISC-66, ISC-67). */
export interface MoveMoneyRequest {
  readonly fromEnvelopeId: string;
  readonly toEnvelopeId: string;
  readonly amountCents: number;
  readonly scope: ChangeScope;
}

export interface MoveMoneyResponse {
  readonly ok: boolean;
  readonly fromLeftCents: number;
  readonly toLeftCents: number;
  /** Set when the move left the plan unbalanced (allowed, but alerted — ISC-69). */
  readonly zeroBasedAlert: boolean;
}

// ── Inbox and mapping ─────────────────────────────────────────────────────────

/** An unmapped transaction sitting in the Inbox envelope (ISC-20). */
export interface InboxItem {
  readonly transactionId: string;
  readonly date: string;
  readonly amountCents: number;
  readonly payee: string;
  readonly categoryId: string | null;
  readonly categoryName: string | null;
}

export interface InboxResponse {
  readonly items: readonly InboxItem[];
}

/** Create/replace a many-to-one effective-dated mapping (ISC-19). */
export interface MapCategoryRequest {
  readonly categoryId: string;
  readonly envelopeId: string;
  readonly effectiveFrom: string;
}

export interface MapCategoryResponse {
  readonly mappingId: string;
  readonly remappedCount: number;
}

// ── Reconcile (holding vs NAB) ────────────────────────────────────────────────

export interface ReconcileRequest {
  /** NAB statement closing balance in cents, entered by the user. */
  readonly nabStatementCents: number;
  readonly statementDate: string;
}

export interface ReconcileResponse {
  readonly holdingCents: number;
  readonly nabStatementCents: number;
  /** holding - nab; zero = in sync, non-zero = the tripwire fired. */
  readonly driftCents: number;
  readonly matched: boolean;
}

// ── Budget history and edit-budget wizard ─────────────────────────────────────

export interface BudgetHistoryEntry {
  readonly id: string;
  readonly ts: number;
  readonly envelopeId: string;
  readonly envelopeName: string;
  readonly beforeCents: number;
  readonly afterCents: number;
  readonly scope: ChangeScope;
  readonly actor: "sync" | "ui" | "agent";
}

export interface BudgetHistoryResponse {
  readonly entries: readonly BudgetHistoryEntry[];
}

/** A single line edited through the Edit Budget wizard (ISC-72). */
export interface EditBudgetLine {
  readonly envelopeId: string;
  /** Monthly-equivalent amount (the UI normalises the entered period to monthly). */
  readonly amountCents: number;
  /** The period the user entered the amount in, kept as a label (ISC-94). */
  readonly period?: BudgetPeriod;
}

export interface EditBudgetRequest {
  readonly lines: readonly EditBudgetLine[];
  readonly scope: ChangeScope;
}

export interface EditBudgetResponse {
  readonly ok: boolean;
  readonly changed: number;
  readonly zeroBasedAlert: boolean;
}

// ── Settings ──────────────────────────────────────────────────────────────────

export interface SettingsResponse {
  readonly deployMode: "local" | "cloud";
  readonly hasPocketSmithKey: boolean;
  readonly lastSyncAt: string | null;
}

/** Set the per-user PocketSmith developer key. Never echoed back (ISC-56). */
export interface SetPocketSmithKeyRequest {
  readonly developerKey: string;
}

export interface SetPocketSmithKeyResponse {
  readonly ok: boolean;
}

// ── Pulse widget ──────────────────────────────────────────────────────────────

export interface PulseTile {
  readonly label: string;
  readonly valueCents: number;
  /** Every tile carries an as-of timestamp (ISC-44). */
  readonly asOf: number;
}

export interface PulseResponse {
  /** Tile A: unallocated dollars (ISC-41). */
  readonly unallocated: PulseTile;
  /** Tile B: top three envelopes by overspend percent (ISC-42). */
  readonly topOverspends: readonly { readonly envelopeId: string; readonly name: string; readonly overspendPct: number; readonly asOf: number }[];
  /** Tile C: holding vs NAB drift (ISC-43). */
  readonly holdingDrift: PulseTile;
  readonly asOf: number;
}

// ── Transactions list (ISC-78..81) ────────────────────────────────────────────

/** One row of the Transactions screen, newest-first (ISC-78). */
export interface TransactionListItem {
  readonly id: string;
  readonly date: string;
  readonly payee: string;
  readonly amountCents: number;
  readonly accountId: string;
  readonly categoryId: string | null;
  /** The envelope the transaction resolves to (mapped or Inbox), with its name. */
  readonly envelopeId: string;
  readonly envelopeName: string | null;
  readonly isPending: boolean;
  readonly isTransfer: boolean;
}

/** Filters for GET /api/transactions; all optional and AND-combined (ISC-79, ISC-80). */
export interface TransactionsQuery {
  /** Inclusive lower date bound (YYYY-MM-DD). */
  readonly from?: string;
  /** Inclusive upper date bound (YYYY-MM-DD). */
  readonly to?: string;
  readonly envelopeId?: string;
  readonly accountId?: string;
}

export interface TransactionsResponse {
  readonly items: readonly TransactionListItem[];
}

// ── Create envelope (ISC-87) ──────────────────────────────────────────────────

/** Add a new envelope from the budget page (ISC-87, ISC-91, ISC-94, ISC-100). */
export interface CreateEnvelopeRequest {
  readonly name: string;
  /** income | expense | saving. saving behaves as expense; income is first-class (ISC-91). */
  readonly type: EnvelopeType;
  /** Parent envelope id for an expense/saving envelope, or null for top level. */
  readonly parentId?: string | null;
  readonly rolloverRule?: RolloverRule;
  /** Initial budgeted amount (template line for expense/saving, target for income). */
  readonly budgetedCents?: number;
  /** The period the budgeted amount is entered in (ISC-94). Defaults monthly. */
  readonly period?: BudgetPeriod;
  /** Active flag (ISC-100). Defaults true. */
  readonly active?: boolean;
  /** Income target (ISC-92), income type only. */
  readonly targetCents?: number;
  /** Portion of the income target routed to the expense-capital pool (ISC-92), income type only. */
  readonly capitalToExpenseCents?: number;
}

export interface CreateEnvelopeResponse {
  readonly id: string;
  readonly type: EnvelopeType;
}

/** Edit an existing envelope's type/period/active/capital fields (ISC-91, ISC-94, ISC-100). */
export interface EditEnvelopeRequest {
  readonly id: string;
  readonly name?: string;
  readonly type?: EnvelopeType;
  readonly parentId?: string | null;
  readonly active?: boolean;
  /** Budgeted amount for an expense/saving template line. */
  readonly budgetedCents?: number;
  /** The period the budgeted amount is entered in (ISC-94). */
  readonly period?: BudgetPeriod;
  /** Income target (ISC-92), income type only. */
  readonly targetCents?: number;
  /** Portion of the income target routed to the expense-capital pool (ISC-92), income type only. */
  readonly capitalToExpenseCents?: number;
}

export interface EditEnvelopeResponse {
  readonly id: string;
  readonly ok: boolean;
}

// ── Money movements history (ISC-89, ISC-90) ──────────────────────────────────

export interface MovementView {
  readonly id: string;
  readonly ts: number;
  readonly fromEnvelopeId: string;
  readonly fromEnvelopeName: string | null;
  readonly toEnvelopeId: string;
  readonly toEnvelopeName: string | null;
  readonly amountCents: number;
  readonly scope: ChangeScope;
  readonly actor: "sync" | "ui" | "agent";
  readonly correlationId: string;
}

export interface MovementsResponse {
  readonly movements: readonly MovementView[];
}

/**
 * The full endpoint map: method + path + request/response. Handlers and the SPA
 * client both refer to this so a contract drift is a type error, not a runtime
 * surprise.
 */
export interface ApiContract {
  "POST /api/auth/signin": { req: SignInRequest; res: SignInResponse | ApiError };
  "POST /api/auth/verify": { req: VerifyLinkRequest; res: SessionResponse | ApiError };
  "GET /api/auth/session": { req: void; res: SessionResponse };
  "POST /api/auth/signout": { req: void; res: { ok: true } };

  "GET /api/envelopes": { req: void; res: GridResponse };
  "GET /api/envelopes/as-of": { req: AsOfRequest; res: GridResponse };
  "GET /api/envelopes/detail": { req: { id: string }; res: EnvelopeDetailResponse | ApiError };
  "POST /api/envelopes/move": { req: MoveMoneyRequest; res: MoveMoneyResponse | ApiError };
  "POST /api/envelopes": { req: CreateEnvelopeRequest; res: CreateEnvelopeResponse | ApiError };
  "POST /api/envelopes/edit": { req: EditEnvelopeRequest; res: EditEnvelopeResponse | ApiError };
  "POST /api/move": { req: MoveMoneyRequest; res: MoveMoneyResponse | ApiError };

  "GET /api/transactions": { req: TransactionsQuery; res: TransactionsResponse };

  "GET /api/movements": { req: void; res: MovementsResponse };

  "GET /api/inbox": { req: void; res: InboxResponse };
  "POST /api/inbox/map": { req: MapCategoryRequest; res: MapCategoryResponse | ApiError };

  "POST /api/reconcile": { req: ReconcileRequest; res: ReconcileResponse };

  "GET /api/budget/history": { req: void; res: BudgetHistoryResponse };
  "POST /api/budget/edit": { req: EditBudgetRequest; res: EditBudgetResponse | ApiError };

  "GET /api/settings": { req: void; res: SettingsResponse };
  "POST /api/settings/pocketsmith-key": {
    req: SetPocketSmithKeyRequest;
    res: SetPocketSmithKeyResponse | ApiError;
  };

  "GET /api/pulse": { req: void; res: PulseResponse };
}

export type ApiPath = keyof ApiContract;
