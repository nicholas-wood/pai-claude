  }

  async listMovements(userId: UserId): Promise<MoneyMovement[]> {
    const res = await this.pool.query<MovementRow>(
      `SELECT id, ts, from_envelope_id, to_envelope_id, amount_cents, scope, actor, correlation_id
       FROM money_movements WHERE user_id = $1 ORDER BY ts DESC`,
      [userId],
    );
    return res.rows.map((r) => ({
      id: r.id,
      userId,
      ts: Number(r.ts),
      fromEnvelopeId: r.from_envelope_id,
      toEnvelopeId: r.to_envelope_id,
      amountCents: Number(r.amount_cents),
      scope: r.scope as ChangeScope,
      actor: r.actor as Actor,
      correlationId: r.correlation_id,
    }));
  }

  // --- Secret ciphertext persistence (used by the cloud KmsSecretStore) ---
  // Ciphertext only; plaintext never touches this table (ISC-56).

  async getSecretCiphertext(
    userId: UserId,
    name: string,
  ): Promise<{ ciphertext: string; wrappedKey: string } | null> {
    const res = await this.pool.query<{ ciphertext: string; wrapped_key: string }>(
      `SELECT ciphertext, wrapped_key FROM secrets WHERE user_id = $1 AND name = $2`,
      [userId, name],
    );
    const row = res.rows[0];
    if (!row) return null;
    return { ciphertext: row.ciphertext, wrappedKey: row.wrapped_key };
  }

  async putSecretCiphertext(
    userId: UserId,
    name: string,
    rec: { ciphertext: string; wrappedKey: string },
  ): Promise<void> {
    await this.pool.query(
      `INSERT INTO secrets (user_id, name, ciphertext, wrapped_key, updated_at)
       VALUES ($1, $2, $3, $4, $5)
       ON CONFLICT (user_id, name) DO UPDATE SET
         ciphertext = excluded.ciphertext,
         wrapped_key = excluded.wrapped_key,
         updated_at = excluded.updated_at`,
      [userId, name, rec.ciphertext, rec.wrappedKey, Date.now()],
    );
  }

  async deleteSecretCiphertext(userId: UserId, name: string): Promise<void> {
    await this.pool.query(`DELETE FROM secrets WHERE user_id = $1 AND name = $2`, [userId, name]);
  }

  /** Adapter-internal table introspection for the store suite (Postgres dialect). */
  async listTables(): Promise<string[]> {
    const res = await this.pool.query<{ table_name: string }>(
      `SELECT table_name FROM information_schema.tables WHERE table_schema = 'public'`,
    );
    return res.rows.map((r) => r.table_name);
  }

  async close(): Promise<void> {
    await this.pool.end();
  }
}

function toTx(r: TxRow): Tx {
  return {
    id: r.id,
    date: r.txn_date,
    amountCents: Number(r.amount_cents),
    accountId: r.account_id,
    categoryId: r.category_id,
    envelopeId: r.envelope_id,
    payee: r.payee,
    isTransfer: Number(r.is_transfer) !== 0,
    isPending: Number(r.is_pending) !== 0,
    rawJson: r.raw_json,
  };
}

function toEnvelope(r: EnvelopeRow): Envelope {
  return {
    id: r.id,
    name: r.name,
    parentId: r.parent_id,
    group: r.grp,
    rolloverRule: r.rollover_rule as Envelope["rolloverRule"],
    targetType: r.target_type as Envelope["targetType"],
    targetAmountCents: Number(r.target_amount_cents),
    type: (r.type ?? "expense") as EnvelopeType,
    active: Number(r.active) !== 0,
    archived: Number(r.archived) !== 0,
  };
}
