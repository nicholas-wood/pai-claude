/**
 * PostgresStore — the cloud persistence adapter.
 *
 * Implements the same Store contract as SqliteStore over `pg`, so flipping
 * DEPLOY_MODE to cloud is a wiring change, not a code change (ISC-58). It runs
 * the same portable DDL from schema.ts and the same `ON CONFLICT` upserts; only
 * the placeholder dialect differs ($1..$n here vs ? in SQLite). Every tenant
 * query is scoped by user_id (ISC-49).
 *
 * This adapter must COMPILE and pass the shared store suite; it is not the local
 * runtime default.
 */

import { Pool } from "pg";
import type { UserId } from "../platform/auth.ts";
import type { Tx, Envelope, LedgerEvent } from "../platform/store.ts";
import type {
  Actor,
  BudgetChange,
  BudgetPeriod,
  BudgetTemplate,
  CategoryMapping,
  ChangeScope,
  EnvelopeType,
  IncomeEnvelope,
  MoneyMovement,
} from "../domain/types.ts";
import type {
  Allocation,
  Category,
  EnvelopeCarryover,
  IncomeCarryover,
  SnapshotPoint,
} from "../envelope/ports.ts";
import type { BudgetStore } from "../budget/ports.ts";
import { ADDITIVE_COLUMNS, SCHEMA_SQL } from "./schema.ts";

