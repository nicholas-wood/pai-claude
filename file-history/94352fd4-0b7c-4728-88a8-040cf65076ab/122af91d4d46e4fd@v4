  async listSnapshots(
    userId: UserId,
    envelopeId: string,
    from: string,
    to: string,
  ): Promise<SnapshotPoint[]> {
    const res = await this.pool.query<{ snap_date: string; balance_cents: number | string }>(
      `SELECT snap_date, balance_cents FROM snapshots
       WHERE user_id = $1 AND envelope_id = $2 AND snap_date >= $3 AND snap_date <= $4
       ORDER BY snap_date ASC`,
      [userId, envelopeId, from, to],
    );
    return res.rows.map((r) => ({ date: r.snap_date, balanceCents: Number(r.balance_cents) }));
  }

  // --- Budget engine extras (recurring template + budget history) ---
  // ISC-29, ISC-76, ISC-77. Scoped by user_id (ISC-49).

  async listTemplate(userId: UserId): Promise<BudgetTemplate[]> {
    const res = await this.pool.query<TemplateRow>(
      `SELECT id, envelope_id, amount_cents, period FROM budget_template WHERE user_id = $1`,
      [userId],
    );
    return res.rows.map((r) => ({
      id: r.id,
      userId,
      envelopeId: r.envelope_id,
      amountCents: Number(r.amount_cents),
      period: (r.period ?? "monthly") as BudgetPeriod,
    }));
  }

  async putTemplateLine(userId: UserId, line: BudgetTemplate): Promise<void> {
    await this.pool.query(
      `INSERT INTO budget_template (user_id, id, envelope_id, amount_cents, period)
       VALUES ($1, $2, $3, $4, $5)
       ON CONFLICT (user_id, id) DO UPDATE SET
         envelope_id = excluded.envelope_id,
         amount_cents = excluded.amount_cents,
         period = excluded.period`,
      [userId, line.id, line.envelopeId, line.amountCents, line.period ?? "monthly"],
    );
  }

  async listBudgetHistory(userId: UserId): Promise<BudgetChange[]> {
    const res = await this.pool.query<HistoryRow>(
      `SELECT id, ts, envelope_id, before_cents, after_cents, scope, actor
       FROM budget_history WHERE user_id = $1 ORDER BY ts DESC`,
      [userId],
    );
    return res.rows.map((r) => ({
      id: r.id,
      userId,
      ts: Number(r.ts),
      envelopeId: r.envelope_id,
      beforeCents: Number(r.before_cents),
      afterCents: Number(r.after_cents),
      scope: r.scope as ChangeScope,
      actor: r.actor as Actor,
    }));
  }

  async appendBudgetHistory(userId: UserId, change: BudgetChange): Promise<void> {
    await this.pool.query(
      `INSERT INTO budget_history
         (user_id, id, ts, envelope_id, before_cents, after_cents, scope, actor)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`,
      [
        userId,
        change.id,
        change.ts,
        change.envelopeId,
        change.beforeCents,
        change.afterCents,
        change.scope,
        change.actor,
