}

// ── Create envelope (ISC-87) ──────────────────────────────────────────────────

/** Add a new envelope from the budget page (ISC-87, ISC-91, ISC-94, ISC-100). */
export interface CreateEnvelopeRequest {
  readonly name: string;
  /** income | expense | saving. saving behaves as expense; income is first-class (ISC-91). */
  readonly type: EnvelopeType;
  /** Parent envelope id for an expense/saving envelope, or null for top level. */
  readonly parentId?: string | null;
  readonly rolloverRule?: RolloverRule;
  /** Initial budgeted amount (template line for expense/saving, target for income). */
  readonly budgetedCents?: number;
  /** The period the budgeted amount is entered in (ISC-94). Defaults monthly. */
  readonly period?: BudgetPeriod;
  /** Active flag (ISC-100). Defaults true. */
  readonly active?: boolean;
  /** Income target / budget (ISC-92), income type only. */
  readonly targetCents?: number;
}

export interface CreateEnvelopeResponse {
  readonly id: string;
  readonly type: EnvelopeType;
}

/** Edit an existing envelope's type/period/active/capital fields (ISC-91, ISC-94, ISC-100). */
export interface EditEnvelopeRequest {
  readonly id: string;
  readonly name?: string;
  readonly type?: EnvelopeType;
  readonly parentId?: string | null;
  readonly active?: boolean;
  /** Budgeted amount for an expense/saving template line. */
  readonly budgetedCents?: number;
  /** The period the budgeted amount is entered in (ISC-94). */
  readonly period?: BudgetPeriod;
  /** Income target / budget (ISC-92), income type only. */
  readonly targetCents?: number;
}

export interface EditEnvelopeResponse {
  readonly id: string;
  readonly ok: boolean;
}

