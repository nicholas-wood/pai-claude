    "codegen:pocketsmith": "bun run scripts/codegen-pocketsmith.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "serve:tailscale": "tailscale serve --bg https / http://127.0.0.1:8787"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
