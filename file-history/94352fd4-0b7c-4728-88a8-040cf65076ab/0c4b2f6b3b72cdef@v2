{
  "name": "envelope-os",
  "version": "0.1.0",
  "description": "Penny — zero-based envelope budgeting over PocketSmith. Local-first, cloud-ready.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/server/index.ts",
    "backfill": "bun run scripts/backfill.ts",
    "sync": "bun run scripts/sync.ts",
