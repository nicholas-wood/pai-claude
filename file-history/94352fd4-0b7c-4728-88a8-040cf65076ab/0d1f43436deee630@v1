export class SqliteStore implements BudgetStore {
  private readonly db: Database;

  constructor(path: string) {
    this.db = new Database(path, { create: true });
    // Enforce referential integrity locally so tenant FKs actually bite.
    this.db.run("PRAGMA foreign_keys = ON");
    this.db.run("PRAGMA journal_mode = WAL");
  }

  async migrate(): Promise<void> {
    const run = this.db.transaction(() => {
      for (const stmt of SCHEMA_SQL) this.db.run(stmt);
      // Backfill additive columns on tables that predate them. SQLite has no
      // ADD COLUMN IF NOT EXISTS, so guard each ALTER on PRAGMA table_info.
      for (const { table, column, ddl } of ADDITIVE_COLUMNS) {
        const cols = this.db.query(`PRAGMA table_info(${table})`).all() as { name: string }[];
        if (!cols.some((c) => c.name === column)) {
          this.db.run(`ALTER TABLE ${table} ADD COLUMN ${column} ${ddl}`);
        }
      }
    });
    run();
  }

  /**
   * Ensure a tenant row exists. Public beyond the Store interface so test
   * harnesses and the composition root can seed users (local seeds exactly one).
   */
  async ensureUser(userId: UserId, email?: string): Promise<void> {
    this.db.run(
      `INSERT INTO users (id, email, created_at, status)
       VALUES (?, ?, ?, 'active')
       ON CONFLICT (id) DO NOTHING`,
      [userId, email ?? `${userId}@penny.local`, Date.now()],
    );
  }

  async upsertTransactions(userId: UserId, txs: readonly Tx[]): Promise<void> {
    const stmt = this.db.query(
      `INSERT INTO transactions
         (user_id, id, txn_date, amount_cents, account_id, category_id,
          envelope_id, payee, is_transfer, is_pending, raw_json)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
       ON CONFLICT (user_id, id) DO UPDATE SET
         txn_date = excluded.txn_date,
         amount_cents = excluded.amount_cents,
         account_id = excluded.account_id,
         category_id = excluded.category_id,
         envelope_id = excluded.envelope_id,
         payee = excluded.payee,
         is_transfer = excluded.is_transfer,
         is_pending = excluded.is_pending,
         raw_json = excluded.raw_json`,
    );
    const apply = this.db.transaction((rows: readonly Tx[]) => {
      for (const t of rows) {
        stmt.run(
          userId,
          t.id,
          t.date,
          t.amountCents,
          t.accountId,
          t.categoryId,
          t.envelopeId,
          t.payee,
          t.isTransfer ? 1 : 0,
          t.isPending ? 1 : 0,
          t.rawJson,
        );
      }
    });
    apply(txs);
  }

  async listTransactions(
    userId: UserId,
    opts?: {
      envelopeId?: string;
      accountId?: string;
      since?: string;
      from?: string;
      to?: string;
      newestFirst?: boolean;
    },
  ): Promise<Tx[]> {
    let sql =
      `SELECT id, txn_date, amount_cents, account_id, category_id,
              envelope_id, payee, is_transfer, is_pending, raw_json
       FROM transactions WHERE user_id = ?`;
    const params: (string | number)[] = [userId];
    if (opts?.envelopeId !== undefined) {
      sql += " AND envelope_id = ?";
      params.push(opts.envelopeId);
    }
    if (opts?.accountId !== undefined) {
      sql += " AND account_id = ?";
      params.push(opts.accountId);
    }
    const lower = opts?.from ?? opts?.since;
    if (lower !== undefined) {
      sql += " AND txn_date >= ?";
      params.push(lower);
    }
    if (opts?.to !== undefined) {
      sql += " AND txn_date <= ?";
      params.push(opts.to);
    }
    sql += opts?.newestFirst ? " ORDER BY txn_date DESC, id DESC" : " ORDER BY txn_date ASC, id ASC";
    const rows = this.db.query(sql).all(...params) as TxRow[];
    return rows.map(toTx);
  }

  async upsertEnvelope(userId: UserId, e: Envelope): Promise<void> {
    this.db.run(
      `INSERT INTO envelopes
         (user_id, id, parent_id, name, grp, rollover_rule, target_type, target_amount_cents, type, active)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
       ON CONFLICT (user_id, id) DO UPDATE SET
         parent_id = excluded.parent_id,
         name = excluded.name,
         grp = excluded.grp,
         rollover_rule = excluded.rollover_rule,
         target_type = excluded.target_type,
         target_amount_cents = excluded.target_amount_cents,
         type = excluded.type,
         active = excluded.active`,
      [
        userId,
        e.id,
        e.parentId,
        e.name,
        e.group,
        e.rolloverRule,
        e.targetType,
        e.targetAmountCents,
        e.type ?? "expense",
        e.active === false ? 0 : 1,
      ],
    );
  }

  async listEnvelopes(userId: UserId): Promise<Envelope[]> {
    const rows = this.db
      .query(
        `SELECT id, name, parent_id, grp, rollover_rule, target_type, target_amount_cents, type, active
         FROM envelopes WHERE user_id = ? ORDER BY name ASC`,
      )
      .all(userId) as EnvelopeRow[];
    return rows.map(toEnvelope);
  }

  async appendEvent(userId: UserId, e: LedgerEvent): Promise<void> {
    this.db.run(
      `INSERT INTO events (user_id, id, ts, actor, correlation_id, kind, payload_json)
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      [userId, e.id, e.ts, e.actor, e.correlationId, e.kind, e.payloadJson],
    );
  }

  async writeDailySnapshot(userId: UserId, date: string): Promise<void> {
    const envelopes = await this.listEnvelopes(userId);
    const balanceStmt = this.db.query(
      `SELECT COALESCE(SUM(amount_cents), 0) AS bal
       FROM transactions
       WHERE user_id = ? AND envelope_id = ? AND txn_date <= ?
         AND is_pending = 0 AND is_transfer = 0`,
    );
    const upsert = this.db.query(
      `INSERT INTO snapshots (user_id, envelope_id, snap_date, balance_cents)
       VALUES (?, ?, ?, ?)
       ON CONFLICT (user_id, envelope_id, snap_date) DO UPDATE SET
         balance_cents = excluded.balance_cents`,
    );
    const apply = this.db.transaction(() => {
      for (const env of envelopes) {
        const row = balanceStmt.get(userId, env.id, date) as { bal: number } | null;
        upsert.run(userId, env.id, date, row?.bal ?? 0);
      }
    });
    apply();
  }

  async getLastSyncAt(userId: UserId): Promise<string | null> {
    const row = this.db
      .query(`SELECT last_sync_at FROM sync_state WHERE user_id = ?`)
      .get(userId) as { last_sync_at: string | null } | null;
    return row?.last_sync_at ?? null;
  }

  async setLastSyncAt(userId: UserId, iso: string): Promise<void> {
    this.db.run(
      `INSERT INTO sync_state (user_id, last_sync_at) VALUES (?, ?)
       ON CONFLICT (user_id) DO UPDATE SET last_sync_at = excluded.last_sync_at`,
      [userId, iso],
    );
  }

