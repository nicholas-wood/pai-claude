/**
 * Vite config for the Penny SPA + PWA.
 *
 * root is web/ so all app source lives under web/src and the public assets
 * (manifest, service worker, icons) under web/public. The build output goes to
 * web/dist, which the Hono server serves as static assets on a single port
 * (ISC-33). server.fs.allow lets the dev server reach the shared contract types
 * that live outside web/ at src/server/contract.ts.
 */

import { defineConfig } from "vite";
import react from "@vitejs/plugin-react";
import { fileURLToPath, URL } from "node:url";
import { execSync } from "node:child_process";
import { readFileSync } from "node:fs";

// Semantic version (from package.json) plus the build's git sha and date, injected
// at build time so the running app can show exactly which version is loaded.
const pkg = JSON.parse(readFileSync(fileURLToPath(new URL("./package.json", import.meta.url)), "utf8")) as { version: string };
let sha = "dev";
try {
  sha = execSync("git rev-parse --short HEAD", { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
} catch {
  /* not a git checkout */
}
const buildDate = new Date().toISOString().slice(0, 10);
const APP_VERSION = `v${pkg.version}`;
const BUILD_INFO = `v${pkg.version} (${sha} · ${buildDate})`;

export default defineConfig({
  root: "web",
  base: "/",
  define: {
    __APP_VERSION__: JSON.stringify(APP_VERSION),
    __BUILD_INFO__: JSON.stringify(BUILD_INFO),
  },
  plugins: [react()],
  resolve: {
    alias: {
      "@": fileURLToPath(new URL("./web/src", import.meta.url)),
      "@contract": fileURLToPath(new URL("./src/server/contract.ts", import.meta.url)),
      "@domain": fileURLToPath(new URL("./src/domain/types.ts", import.meta.url)),
    },
  },
  server: {
    fs: { allow: [fileURLToPath(new URL(".", import.meta.url))] },
  },
  build: {
    outDir: "dist",
    emptyOutDir: true,
  },
});
