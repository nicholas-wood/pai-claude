/**
 * Backfill CLI (ISC-4, ISC-6).
 *
 *   bun run backfill                 # two-year default window (ISC-6)
 *   bun run backfill --since 2022-01-01
 *
 * Wires through the composition root so DEPLOY_MODE is read in exactly one place
 * (ISC-50/51). Resolves the tenant from PENNY_USER_ID (local default), pulls the
 * PocketSmith developer key for that tenant through the SecretStore (ISC-3), and
 * pages the full history into the Store (ISC-4).
 */

import { buildContainer } from "../src/composition.ts";
import { PocketSmithClient } from "../src/ingest/client.ts";
import { runBackfill } from "../src/ingest/backfill.ts";

function parseSince(argv: readonly string[]): string | undefined {
  const i = argv.indexOf("--since");
  if (i !== -1 && argv[i + 1]) return argv[i + 1];
  return undefined;
}

const since = parseSince(Bun.argv.slice(2));
const userId = process.env.PENNY_USER_ID ?? "local-principal";

const container = await buildContainer();

// Local single principal must exist for the tenant FKs to bite.
const seedable = container.store as unknown as {
  ensureUser?: (id: string, email?: string) => Promise<void>;
};
if (seedable.ensureUser) {
  await seedable.ensureUser(userId, process.env.PENNY_USER_EMAIL);
}

const client = await PocketSmithClient.forUser(container.secrets, userId);

console.log(`[backfill] user=${userId} since=${since ?? "(two-year default)"}`);
const result = await runBackfill({
  store: container.store,
  client,
  userId,
  ...(since !== undefined ? { since } : {}),
});

console.log(
  `[backfill] done: ${result.transactions} transactions across ${result.pages} pages, ` +
    `from ${result.since}, completed ${result.completedAt}`,
);

await container.store.close();
