import * as React from "react";
import { ChevronRight, ChevronsDownUp, ChevronsUpDown } from "lucide-react";
import type { LucideIcon } from "lucide-react";
import { cn } from "@/lib/utils";

/**
 * The collapsible shell shared by every budget section (Income, Savings,
 * Expenses, Envelopes). Each section header carries the section name, an item
 * count, and the rolled-up section total on the right, mirroring the totals row
 * of Nick's spreadsheet. Collapsing a section hides only its item rows — the
 * column headers and the rolled-up totals row stay visible (the section owns that
 * split via its `open` flag). Hierarchical sections also expose Expand all /
 * Collapse all to drill the parent to child rows.
 */
export function SectionShell({
  title,
  subtitle,
  icon: Icon,
  open,
  onToggleOpen,
  count,
  onExpandAll,
  onCollapseAll,
  children,
}: {
  title: string;
  subtitle?: string | undefined;
  icon: LucideIcon;
  open: boolean;
  onToggleOpen: () => void;
  count: number;
  /** Accepted for call-site compatibility but no longer shown (removed per request). */
  total?: React.ReactNode;
  onExpandAll?: (() => void) | undefined;
  onCollapseAll?: (() => void) | undefined;
  children: React.ReactNode;
}) {
  const hasHierarchyControls = Boolean(onExpandAll && onCollapseAll);
  return (
    <section className="overflow-hidden rounded-lg border bg-card">
      <div className="flex items-center gap-2 border-b bg-muted/30 px-2 py-2 md:px-3">
        <button
          type="button"
          aria-expanded={open}
          aria-label={open ? `Collapse ${title}` : `Expand ${title}`}
          onClick={onToggleOpen}
          className="flex min-w-0 flex-1 items-center gap-2 rounded-md py-1 text-left hover:opacity-80"
        >
          <ChevronRight className={cn("h-4 w-4 shrink-0 text-muted-foreground transition-transform", open && "rotate-90")} />
          <Icon className="h-4 w-4 shrink-0 text-muted-foreground" />
          <span className="truncate text-sm font-semibold tracking-tight">{title}</span>
          <span className="shrink-0 rounded-full bg-muted px-1.5 text-[10px] font-medium text-muted-foreground">
            {count}
          </span>
          {subtitle && <span className="hidden truncate text-xs text-muted-foreground sm:inline">· {subtitle}</span>}
        </button>

        {hasHierarchyControls && open && (
          <div className="flex shrink-0 items-center gap-0.5">
            <button
              type="button"
              onClick={onExpandAll}
              title="Expand all"
              aria-label={`Expand all in ${title}`}
              className="rounded p-1 text-muted-foreground hover:bg-accent hover:text-foreground"
            >
              <ChevronsUpDown className="h-3.5 w-3.5" />
            </button>
            <button
              type="button"
              onClick={onCollapseAll}
              title="Collapse all"
              aria-label={`Collapse all in ${title}`}
              className="rounded p-1 text-muted-foreground hover:bg-accent hover:text-foreground"
            >
              <ChevronsDownUp className="h-3.5 w-3.5" />
            </button>
          </div>
        )}
      </div>

      {children}
    </section>
  );
}
