import { marked } from "marked";
import { readFileSync, writeFileSync } from "fs";

const [, , inPath, outPath, title] = process.argv;
const md = readFileSync(inPath, "utf8");
const body = marked.parse(md, { gfm: true, breaks: false });

const css = `
:root { color-scheme: light; }
* { box-sizing: border-box; }
body {
  font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  font-size: 11.5pt; line-height: 1.55; color: #1a1a1a;
  max-width: 820px; margin: 0 auto; padding: 8px 4px;
}
h1 { font-size: 22pt; border-bottom: 3px solid #e3001b; padding-bottom: 6px; margin: 0 0 14px; }
h2 { font-size: 16pt; margin: 26px 0 8px; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
h3 { font-size: 13pt; margin: 18px 0 6px; color: #222; }
h4 { font-size: 11.5pt; margin: 14px 0 4px; }
p { margin: 7px 0; }
ul, ol { margin: 7px 0; padding-left: 24px; }
li { margin: 3px 0; }
strong { color: #000; }
code { font-family: "SF Mono", Consolas, "Liberation Mono", monospace; font-size: 10pt;
  background: #f3f3f3; padding: 1px 5px; border-radius: 3px; }
pre { background: #f6f8fa; border: 1px solid #e1e4e8; border-radius: 6px;
  padding: 12px 14px; overflow-x: auto; page-break-inside: avoid; }
pre code { background: none; padding: 0; font-size: 9.5pt; line-height: 1.45; }
table { border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 10.5pt; }
th, td { border: 1px solid #ccc; padding: 6px 9px; text-align: left; vertical-align: top; }
th { background: #f2f2f2; }
blockquote { border-left: 4px solid #e3001b; margin: 10px 0; padding: 2px 14px; color: #444; background: #fafafa; }
hr { border: none; border-top: 1px solid #ddd; margin: 22px 0; }
a { color: #0b5cad; text-decoration: none; }
@media print { body { padding: 0; } h2 { page-break-after: avoid; } h3 { page-break-after: avoid; } }
`;

const html = `<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<title>${title}</title><style>${css}</style></head><body>${body}</body></html>`;
writeFileSync(outPath, html);
console.log("wrote " + outPath);
