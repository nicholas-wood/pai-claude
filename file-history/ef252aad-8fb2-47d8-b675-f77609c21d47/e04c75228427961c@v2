/**
 * Attestation token flow under row-level security — regression pin.
 *
 * Context: migration 0011 added ENABLE + tenant policies + FORCE RLS to
 * attestation_requests. The public confirmation link route
 * (api/v1/t/[slug]/attestations/[token]) looked the token up with NO tenant
 * context ("the token IS the auth"), so once FORCE bound for the app role
 * every valid link 404ed. Ops dropped FORCE in prod on 2026-08-05 as a
 * mitigation; migration 0014 re-asserts it now that the route resolves the
 * tenant from the slug FIRST and runs the lookup inside withTenant.
 *
 * This file pins that behaviour by exercising the REAL exported route
 * handlers (not reimplemented logic) against a seeded tenant:
 *
 *   1. GET with the correct slug + token succeeds (the 2026-08-05 outage
 *      shape can never silently recur).
 *   2. GET with ANOTHER tenant's slug + the same token 404s — via RLS when
 *      it binds, via the defence-in-depth tenantId check when it does not.
 *   3. A context-free raw lookup of the token returns nothing WHEN the
 *      connected test role actually binds RLS. CI historically runs as a
 *      superuser/bypassing role, so this assertion is capability-probed at
 *      runtime rather than assumed (same honesty rule as
 *      tenant-isolation.test.ts).
 *   4. POST with the correct slug + token completes the attestation
 *      end to end, and the link then reports 410.
 *
 * Requires a real Postgres with migrations applied — gated on DATABASE_URL,
 * exactly like the cross-tenant suite in tenant-isolation.test.ts.
 */
import { afterAll, beforeAll, describe, expect, it } from "vitest";
import { eq, sql } from "drizzle-orm";
import { randomBytes } from "node:crypto";
import {
  RequestStatus,
  RequestType,
  CredentialStatus,
} from "@accessbuddy/shared";

const DATABASE_AVAILABLE = !!process.env.DATABASE_URL;

if (!DATABASE_AVAILABLE) {
  // eslint-disable-next-line no-console
  console.warn(
    "[attestation-token-rls.test.ts] DATABASE_URL is not set — skipping. " +
      "This suite requires a real Postgres database with migrations " +
      "applied (docker-compose's `postgres` service, or the CI test job)."
  );
}

describe.skipIf(!DATABASE_AVAILABLE)(
  "attestation token flow under RLS (real DB required)",
  () => {
    let db: typeof import("@accessbuddy/db").db;
    let tenants: typeof import("@accessbuddy/db").tenants;
    let users: typeof import("@accessbuddy/db").users;
    let tenantMemberships: typeof import("@accessbuddy/db").tenantMemberships;
    let credentialTypes: typeof import("@accessbuddy/db").credentialTypes;
    let accessLevels: typeof import("@accessbuddy/db").accessLevels;
    let fobRequests: typeof import("@accessbuddy/db").fobRequests;
    let credentials: typeof import("@accessbuddy/db").credentials;
    let attestationRequests: typeof import("@accessbuddy/db").attestationRequests;
    let auditLog: typeof import("@accessbuddy/db").auditLog;
    let withTenant: typeof import("@/lib/with-tenant").withTenant;
    let attestationGET: typeof import("@/app/api/v1/t/[slug]/attestations/[token]/route").GET;
    let attestationPOST: typeof import("@/app/api/v1/t/[slug]/attestations/[token]/route").POST;

    let tenantA: { id: string; slug: string };
    let tenantB: { id: string; slug: string };
    let member: { id: string };
    let attestationToken: string;
    let attestationId: string;
    const SEASON = "2026/2027";

    /**
     * Whether the connected role actually binds RLS on attestation_requests.
     * Superusers and BYPASSRLS roles never bind; owners bind only under
     * FORCE. Probed, not assumed — CI has historically connected as a
     * bypassing role, and asserting "0 rows" there would be a false pin.
     */
    let rlsBinds = false;

    beforeAll(async () => {
      const dbPackage = await import("@accessbuddy/db");
      db = dbPackage.db;
      tenants = dbPackage.tenants;
      users = dbPackage.users;
      tenantMemberships = dbPackage.tenantMemberships;
      credentialTypes = dbPackage.credentialTypes;
      accessLevels = dbPackage.accessLevels;
      fobRequests = dbPackage.fobRequests;
      credentials = dbPackage.credentials;
      attestationRequests = dbPackage.attestationRequests;
      auditLog = dbPackage.auditLog;

      ({ withTenant } = await import("@/lib/with-tenant"));
      ({ GET: attestationGET, POST: attestationPOST } = await import(
        "@/app/api/v1/t/[slug]/attestations/[token]/route"
      ));

      const probe = await db.execute<{
        bypasses: boolean;
        rls_enabled: boolean;
        force_rls: boolean;
        is_owner: boolean;
      }>(sql`
        SELECT
          (r.rolsuper OR r.rolbypassrls) AS bypasses,
          c.relrowsecurity AS rls_enabled,
          c.relforcerowsecurity AS force_rls,
          (pg_get_userbyid(c.relowner) = current_user) AS is_owner
        FROM pg_roles r
        CROSS JOIN pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE r.rolname = current_user
          AND n.nspname = 'public'
          AND c.relname = 'attestation_requests'
      `);
      const row = probe[0];
      rlsBinds = !!row && row.rls_enabled && !row.bypasses && (row.force_rls || !row.is_owner);
      if (!rlsBinds) {
        // eslint-disable-next-line no-console
        console.warn(
          "[attestation-token-rls.test.ts] The connected role does NOT bind " +
            "RLS on attestation_requests (superuser/BYPASSRLS, or owner " +
            "without FORCE). The context-free-lookup assertion will verify " +
            "the bypass instead of the block. Run against a non-bypassing " +
            "role (e.g. accessbuddy_app) to exercise the RLS-binding path."
        );
      }

      const suffix = `att-rls-${Date.now()}`;
      attestationToken = randomBytes(32).toString("hex");

      // tenants and users are global tables (no tenant_id) — raw inserts
      // are correct regardless of RLS binding.
      [tenantA] = await db
        .insert(tenants)
        .values({ name: `Attest Club A ${suffix}`, slug: `attest-a-${suffix}` })
        .returning({ id: tenants.id, slug: tenants.slug });
      [tenantB] = await db
        .insert(tenants)
        .values({ name: `Attest Club B ${suffix}`, slug: `attest-b-${suffix}` })
        .returning({ id: tenants.id, slug: tenants.slug });
      [member] = await db
        .insert(users)
        .values({
          firebaseUid: `fb-${suffix}`,
          email: `attest-${suffix}@example.com`,
          firstName: "Attest",
          lastName: "Member",
        })
        .returning({ id: users.id });

      // Every tenant-scoped row is seeded INSIDE withTenant so the seeding
      // itself survives both a bypassing role (CI today) and a binding one
      // (post accessbuddy_app cutover) — the INSERT policies require
      // app.current_tenant_id to be set once RLS binds.
      await withTenant(tenantA.id, async (tx) => {
        await tx.insert(tenantMemberships).values({
          tenantId: tenantA.id,
          userId: member.id,
          status: "active",
        });

        const [credType] = await tx
          .insert(credentialTypes)
          .values({ tenantId: tenantA.id, name: `Fob ${suffix}`, priceCents: 0 })
          .returning({ id: credentialTypes.id });
        const [accessLevel] = await tx
          .insert(accessLevels)
          .values({ tenantId: tenantA.id, name: `Standard ${suffix}` })
          .returning({ id: accessLevels.id });
        const [request] = await tx
          .insert(fobRequests)
          .values({
            tenantId: tenantA.id,
            requesterId: member.id,
            credentialTypeId: credType.id,
            requestType: RequestType.NEW,
            status: RequestStatus.ISSUED,
          })
          .returning({ id: fobRequests.id });
        await tx.insert(credentials).values({
          tenantId: tenantA.id,
          ownerId: member.id,
          credentialTypeId: credType.id,
          accessLevelId: accessLevel.id,
          requestId: request.id,
          status: CredentialStatus.ACTIVE,
          issuedAt: new Date(),
        });

        const [attestation] = await tx
          .insert(attestationRequests)
          .values({
            tenantId: tenantA.id,
            userId: member.id,
            season: SEASON,
            token: attestationToken,
            tokenExpiresAt: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000),
            initiatedBy: member.id,
          })
          .returning({ id: attestationRequests.id });
        attestationId = attestation.id;
      });
    });

    afterAll(async () => {
      // Children before parents; tenant-scoped deletes inside withTenant so
      // cleanup also works when RLS binds.
      if (!tenantA) return; // setup failed before seeding; nothing to clean
      await withTenant(tenantA.id, async (tx) => {
        await tx.delete(auditLog).where(eq(auditLog.tenantId, tenantA.id));
        await tx.delete(credentials).where(eq(credentials.tenantId, tenantA.id));
        await tx.delete(fobRequests).where(eq(fobRequests.tenantId, tenantA.id));
        await tx
          .delete(attestationRequests)
          .where(eq(attestationRequests.tenantId, tenantA.id));
        await tx
          .delete(tenantMemberships)
          .where(eq(tenantMemberships.tenantId, tenantA.id));
        await tx
          .delete(accessLevels)
          .where(eq(accessLevels.tenantId, tenantA.id));
        await tx
          .delete(credentialTypes)
          .where(eq(credentialTypes.tenantId, tenantA.id));
      });
      await db.delete(users).where(eq(users.id, member.id));
      await db.delete(tenants).where(eq(tenants.id, tenantA.id));
      await db.delete(tenants).where(eq(tenants.id, tenantB.id));
    });

    it("attestation_requests declares ENABLE + FORCE RLS with both tenant policies (migrations 0011/0014)", async () => {
      // Pins the declared posture in any migrated database, independent of
      // the connected role. The 2026-08-05 incident was ops dropping FORCE
      // out of band; once 0014 deploys, prod converges back to this shape
      // and this assertion documents it as the contract.
      const posture = await db.execute<{
        rowsecurity: boolean;
        forcerowsecurity: boolean;
        policycount: number;
      }>(sql`
        SELECT
          c.relrowsecurity AS rowsecurity,
          c.relforcerowsecurity AS forcerowsecurity,
          (SELECT count(*)::int FROM pg_policies p
            WHERE p.schemaname = 'public'
              AND p.tablename = 'attestation_requests') AS policycount
        FROM pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = 'public' AND c.relname = 'attestation_requests'
      `);
      const row = posture[0];
      expect(row).toBeDefined();
      expect(row.rowsecurity).toBe(true);
      expect(row.forcerowsecurity).toBe(true);
      expect(row.policycount).toBeGreaterThanOrEqual(2);
    });

    it("GET succeeds with the correct tenant slug and token (the 2026-08-05 outage shape)", async () => {
      const response = await attestationGET({} as never, {
        params: Promise.resolve({ slug: tenantA.slug, token: attestationToken }),
      });
      expect(response.status).toBe(200);
      const body = await response.json();
      expect(body.attestation.id).toBe(attestationId);
      expect(body.attestation.season).toBe(SEASON);
      expect(body.member.firstName).toBe("Attest");
      expect(body.tenant.slug).toBe(tenantA.slug);
      expect(body.credentials).toHaveLength(1);
    });

    it("GET 404s when the token is presented under a different tenant's slug", async () => {
      // When RLS binds, the scoped lookup finds nothing; when it does not,
      // the defence-in-depth tenantId check catches the mismatch. Both
      // paths must land on 404.
      const response = await attestationGET({} as never, {
        params: Promise.resolve({ slug: tenantB.slug, token: attestationToken }),
      });
      expect(response.status).toBe(404);
    });

    it("context-free raw token lookup returns nothing when the role binds RLS", async () => {
      const rows = await db
        .select({ id: attestationRequests.id })
        .from(attestationRequests)
        .where(eq(attestationRequests.token, attestationToken));

      if (rlsBinds) {
        // The regression pin: without tenant context the row is invisible.
        expect(rows).toHaveLength(0);
      } else {
        // Bypassing role (CI today): the row IS visible, which is exactly
        // why the route must set tenant context itself rather than rely on
        // the connection role's behaviour.
        expect(rows).toHaveLength(1);
      }
    });

    it("POST completes the attestation and the link then reports 410", async () => {
      const response = await attestationPOST(
        { json: async () => ({ responses: [] }) } as never,
        { params: Promise.resolve({ slug: tenantA.slug, token: attestationToken }) }
      );
      expect(response.status).toBe(200);
      const body = await response.json();
      expect(body.success).toBe(true);

      const [attestation] = await withTenant(tenantA.id, (tx) =>
        tx
          .select({
            status: attestationRequests.status,
            completedAt: attestationRequests.completedAt,
          })
          .from(attestationRequests)
          .where(eq(attestationRequests.id, attestationId))
      );
      expect(attestation.status).toBe("completed");
      expect(attestation.completedAt).not.toBeNull();

      const [membership] = await withTenant(tenantA.id, (tx) =>
        tx
          .select({ currentSeason: tenantMemberships.currentSeason })
          .from(tenantMemberships)
          .where(eq(tenantMemberships.userId, member.id))
      );
      expect(membership.currentSeason).toBe(SEASON);

      const followUp = await attestationGET({} as never, {
        params: Promise.resolve({ slug: tenantA.slug, token: attestationToken }),
      });
      expect(followUp.status).toBe(410);
    });
  }
);
