#!/usr/bin/env bun
/**
 * One-off remediation email for the 31 Jul - 2 Aug fob-expiry warning confusion.
 * Renders with the app's own branded layout() so output matches production emails.
 *
 * Sample mode:  RESEND_KEY=re_x bun remediation-send.ts --sample you@example.com
 * Real send:    RESEND_KEY=re_x bun remediation-send.ts --send recipients.json [--limit 85]
 *   recipients.json: [{ "email": "...", "firstName": "..." }, ...]
 * Sends are logged to remediation-send-log.json (idempotent: already-logged emails are skipped).
 */
import { layout, setEmailBranding } from "../../code/apps/web/src/lib/email-templates";

const KEY = process.env.RESEND_KEY;
if (!KEY) { console.error("Set RESEND_KEY"); process.exit(1); }

setEmailBranding({
  logoUrl: "https://accessbuddy.com.au/tenants/south-melb-lsc.jpg",
  primaryColour: "#d72d3e",
  secondaryColour: "#009926",
  replyToEmail: "fobs@southmelbournelsc.com.au",
});

const CLUB = "South Melbourne Life Saving Club";
const SUBJECT = "Further information about renewing your fob";

function bodyHtml(firstName: string): string {
  const p = (t: string) =>
    `<p style="color: #333333; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">${t}</p>`;
  return [
    p(`Hi ${firstName},`),
    p(`You recently received an automated email saying your fob is expiring soon. It was missing important context and we are sorry for the confusion. Here is what it actually means.`),
    p(`Memberships are now due for the new season at SMLSC. All fobs will expire on <strong>1 September 2026</strong> to give members time to renew their membership. Once you have renewed your membership, you will receive an email to confirm that you still have your fob. Once you complete this confirmation, your fob will be updated for the new season.`),
    p(`To renew, log in to the SLSA Hub at <a href="https://sls.com.au" style="color: #d72d3e;">sls.com.au</a>, select season 2026/2027, choose your membership type, and make payment. Please check the renewal email from Belinda (SMLSC Membership Manager).`),
    p(`<strong>If you have already renewed and confirmed, you can ignore this email.</strong> Your fob will stay active.`),
    p(`If you have any issues with renewal, please contact Belinda.`),
    p(`Apologies again for the earlier confusion. The automated email wording has been fixed so future reminders explain this properly. If you still have any issues or questions, please don't hesitate to reach out.`),
  ].join("\n");
}

async function send(to: string, firstName: string) {
  const res = await fetch("https://api.resend.com/emails", {
    method: "POST",
    headers: { Authorization: `Bearer ${KEY}`, "Content-Type": "application/json" },
    body: JSON.stringify({
      from: `${CLUB} <noreply@accessbuddy.com.au>`,
      reply_to: "fobs@southmelbournelsc.com.au",
      to,
      subject: SUBJECT,
      html: layout(CLUB, bodyHtml(firstName)),
    }),
  });
  const out: any = await res.json();
  if (!res.ok || out.statusCode) throw new Error(`${to}: ${JSON.stringify(out)}`);
  return out.id as string;
}

const mode = process.argv[2];
if (mode === "--sample") {
  const to = process.argv[3];
  if (!to) { console.error("Usage: --sample you@example.com"); process.exit(1); }
  const id = await send(to, "Nick");
  console.log(`Sample sent to ${to} (resend id ${id})`);
} else if (mode === "--send") {
  const listPath = process.argv[3];
  const limitIdx = process.argv.indexOf("--limit");
  const limit = limitIdx > -1 ? Number(process.argv[limitIdx + 1]) : 85;
  const recipients: { email: string; firstName: string }[] = JSON.parse(await Bun.file(listPath).text());
  const logFile = new URL("remediation-send-log.json", import.meta.url);
  const sent: Record<string, string> = (await Bun.file(logFile).exists())
    ? JSON.parse(await Bun.file(logFile).text()) : {};
  let n = 0;
  for (const r of recipients) {
    if (sent[r.email]) continue;
    if (n >= limit) { console.log(`Daily limit ${limit} reached; ${recipients.length - Object.keys(sent).length} remain.`); break; }
    sent[r.email] = await send(r.email, r.firstName);
    n++;
    await Bun.write(logFile, JSON.stringify(sent, null, 2));
    await Bun.sleep(600); // stay under Resend's per-second rate limit
  }
  console.log(`Sent ${n} this run; ${Object.keys(sent).length}/${recipients.length} total.`);
} else {
  console.error("Usage: --sample <email> | --send <recipients.json> [--limit N]");
  process.exit(1);
}
