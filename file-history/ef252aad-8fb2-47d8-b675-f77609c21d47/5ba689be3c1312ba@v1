import { sql } from "drizzle-orm";
import type { PgTransaction } from "drizzle-orm/pg-core";

/**
 * Set the current tenant context for Row-Level Security.
 *
 * Call this at the start of every tenant-scoped transaction.
 * Uses SET LOCAL so the setting is scoped to the current transaction only.
 *
 * Usage:
 *   await db.transaction(async (tx) => {
 *     await setTenantContext(tx, tenantId);
 *     // All subsequent queries in this transaction are tenant-scoped
 *   });
 */
export async function setTenantContext(
  tx: PgTransaction<any, any, any>,
  tenantId: string
): Promise<void> {
  await tx.execute(
    sql`SELECT set_config('app.current_tenant_id', ${tenantId}, true)`
  );
}

/**
 * SQL to create RLS policies for a tenant-scoped table.
 * Run this in a migration for each tenant-scoped table.
 * Only accepts table names from the RLS_TABLES allowlist.
 */
export function createRLSPolicy(tableName: (typeof RLS_TABLES)[number]): string {
  if (!RLS_TABLES.includes(tableName)) {
    throw new Error(`Table "${tableName}" is not in the RLS allowlist`);
  }
  return `
    ALTER TABLE "${tableName}" ENABLE ROW LEVEL SECURITY;

    CREATE POLICY "tenant_isolation_${tableName}" ON "${tableName}"
      USING (tenant_id = current_setting('app.current_tenant_id')::uuid);

    CREATE POLICY "tenant_insert_${tableName}" ON "${tableName}"
      FOR INSERT
      WITH CHECK (tenant_id = current_setting('app.current_tenant_id')::uuid);
  `;
}

