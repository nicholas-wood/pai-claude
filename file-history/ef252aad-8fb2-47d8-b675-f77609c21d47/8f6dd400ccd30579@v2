#!/usr/bin/env bun
/**
 * Resend send-log forensics for the 2026-08-01 incident.
 * Read-only: only GET requests. Requires a full-access (or read-capable) key:
 *   RESEND_FORENSICS_KEY=re_xxx bun resend-forensics.ts [daysBack=5]
 *
 * Pulls the email log, buckets by status, and prints:
 *  - per-day / per-status counts
 *  - the failed/bounced list (recipient, subject, created_at, status)
 *  - the delivered credentialExpiryWarning list (correction-email recipients)
 * Writes full JSON to resend-forensics-output.json alongside this script.
 */

const KEY = process.env.RESEND_FORENSICS_KEY;
if (!KEY) {
  console.error("Set RESEND_FORENSICS_KEY (create a temporary full-access key in the Resend dashboard; revoke after).");
  process.exit(1);
}

const daysBack = Number(process.argv[2] ?? 5);
const cutoff = Date.now() - daysBack * 24 * 60 * 60 * 1000;
const H = { Authorization: `Bearer ${KEY}` };

type EmailRow = {
  id: string; to: string[] | string; subject: string;
  created_at: string; last_event?: string; status?: string;
};

async function listEmails(): Promise<EmailRow[]> {
  const rows: EmailRow[] = [];
  let url: string | null = "https://api.resend.com/emails?limit=100";
  while (url) {
    const res = await fetch(url, { headers: H });
    if (res.status === 401) {
      console.error("401 — this key cannot read the email log. It must be a full-access key (the app's send keys are restricted).");
      process.exit(1);
    }
    if (!res.ok) {
      console.error(`GET ${url} → ${res.status}. If the list endpoint is unavailable on this plan, use the dashboard Emails view / export instead.`);
      console.error(await res.text());
      process.exit(1);
    }
    const body: any = await res.json();
    const page: EmailRow[] = body.data ?? body.emails ?? [];
    rows.push(...page);
    const oldest = page.at(-1);
    const oldestTs = oldest ? Date.parse(oldest.created_at) : 0;
    const nextCursor = body.next_cursor ?? body.pagination?.next ?? null;
    url = nextCursor && oldestTs > cutoff
      ? `https://api.resend.com/emails?limit=100&after=${encodeURIComponent(nextCursor)}`
      : null;
  }
  return rows.filter((r) => Date.parse(r.created_at) > cutoff);
}

const rows = await listEmails();
const status = (r: EmailRow) => r.last_event ?? r.status ?? "unknown";
const day = (r: EmailRow) => r.created_at.slice(0, 10);

const byDayStatus: Record<string, Record<string, number>> = {};
for (const r of rows) {
  ((byDayStatus[day(r)] ??= {})[status(r)] ??= 0), byDayStatus[day(r)][status(r)]++;
}
console.log(`\n=== ${rows.length} emails in the last ${daysBack} days ===`);
console.table(byDayStatus);

const bad = rows.filter((r) => /fail|bounce|error|complain/i.test(status(r)));
console.log(`\n=== Failed / bounced (${bad.length}) ===`);
for (const r of bad) console.log(`${r.created_at}  ${status(r).padEnd(10)}  ${r.to}  "${r.subject}"`);

const expiry = rows.filter(
  (r) => /expiring soon/i.test(r.subject) && /deliver|sent/i.test(status(r)),
);
console.log(`\n=== Delivered fob-expiry warnings — correction-email recipients (${expiry.length}) ===`);
for (const r of expiry) console.log(`${r.created_at}  ${r.to}`);

await Bun.write(new URL("resend-forensics-output.json", import.meta.url), JSON.stringify(rows, null, 2));
console.log(`\nFull data → resend-forensics-output.json`);
