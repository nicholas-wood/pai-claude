import * as React from "react";
import { Send, ShieldCheck, Wrench } from "lucide-react";
import type { DiagnoseResponse, DiagnoseToolCall } from "@contract";
import { call, isApiError, ApiCallError } from "@/lib/api";
import { useDiagnoseStatus } from "@/lib/queries";
import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";

/**
 * In-app diagnostic chat (v1.25.0, ISC-45.1). Lives inside the explain sheet so
 * the deterministic explanation is always on screen above it. Nothing is sent
 * until the consent box is ticked; the tick is remembered for this browser tab
 * only (sessionStorage) and every question carries consent explicitly, which
 * the server re-checks. Answers list the tools the assistant used so the owner
 * can see what it looked at.
 */

const CONSENT_KEY = "penny.ai-diagnostics.consent";

interface Turn {
  readonly role: "user" | "assistant";
  readonly text: string;
  readonly toolCalls?: readonly DiagnoseToolCall[];
  readonly error?: boolean;
}

function readConsent(): boolean {
  try {
    return sessionStorage.getItem(CONSENT_KEY) === "1";
  } catch {
    return false;
  }
}

function writeConsent(v: boolean): void {
  try {
    if (v) sessionStorage.setItem(CONSENT_KEY, "1");
    else sessionStorage.removeItem(CONSENT_KEY);
  } catch {
    // storage unavailable: the checkbox still governs this render
  }
}

const SUGGESTED = ["Why is my budget unbalanced?", "What changed since it was last reconciled?", "Which pending charges look stale or duplicated?"];

export function DiagnosticChat({ open }: { open: boolean }) {
  const { data: status } = useDiagnoseStatus(open);
  const [consent, setConsent] = React.useState<boolean>(() => readConsent());
  const [question, setQuestion] = React.useState("");
  const [turns, setTurns] = React.useState<Turn[]>([]);
  const [sessionId, setSessionId] = React.useState<string | null>(null);
  const [busy, setBusy] = React.useState(false);
  const endRef = React.useRef<HTMLDivElement | null>(null);

  React.useEffect(() => {
    endRef.current?.scrollIntoView({ block: "nearest" });
  }, [turns, busy]);

  if (!status) return null;

  const toggleConsent = (v: boolean) => {
    setConsent(v);
    writeConsent(v);
  };

  const ask = async (q: string) => {
    const text = q.trim();
    if (!text || busy || !consent || !status.available) return;
    setQuestion("");
    setTurns((t) => [...t, { role: "user", text }]);
    setBusy(true);
    try {
      const res = await call("POST /api/diagnose", { question: text, consent: true, ...(sessionId ? { sessionId } : {}) });
      if (isApiError(res)) {
        setTurns((t) => [...t, { role: "assistant", text: res.error, error: true }]);
      } else {
        const r = res as DiagnoseResponse;
        if (r.sessionId) setSessionId(r.sessionId);
        setTurns((t) => [
          ...t,
          r.ok
            ? { role: "assistant", text: r.answer, toolCalls: r.toolCalls }
            : { role: "assistant", text: r.message ?? "The assistant could not answer.", toolCalls: r.toolCalls, error: true },
        ]);
      }
    } catch (err) {
      const message = err instanceof ApiCallError ? err.message : "Could not reach the assistant.";
      setTurns((t) => [...t, { role: "assistant", text: message, error: true }]);
    } finally {
      setBusy(false);
    }
  };

  return (
    <section className="rounded-md border bg-muted/30 px-3 py-2" aria-label="Ask about this">
      <p className="text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">Ask about this</p>

      {!status.available ? (
        <p className="py-1 text-xs text-muted-foreground">{status.reason ?? "The assistant is not available here."}</p>
      ) : (
        <>
          <label className="mt-1 flex items-start gap-2 text-xs text-muted-foreground">
            <input
              type="checkbox"
              className="mt-0.5 h-3.5 w-3.5"
              checked={consent}
              onChange={(e) => toggleConsent(e.target.checked)}
              aria-describedby="ai-disclosure"
            />
            <span id="ai-disclosure">
              <ShieldCheck className="mr-1 inline h-3.5 w-3.5 align-text-bottom" />
              {status.disclosure}
            </span>
          </label>

          {turns.length === 0 && consent && (
            <div className="mt-2 flex flex-wrap gap-1.5">
              {SUGGESTED.map((s) => (
                <button
                  key={s}
                  type="button"
                  onClick={() => void ask(s)}
                  className="rounded-full border px-2.5 py-1 text-xs hover:bg-background/60"
                >
                  {s}
                </button>
              ))}
            </div>
          )}

          {turns.length > 0 && (
            <ul className="mt-2 max-h-72 space-y-2 overflow-y-auto pr-1">
              {turns.map((t, i) => (
                <li key={i} className={cn("text-sm", t.role === "user" ? "text-foreground" : "text-muted-foreground")}>
                  <span className="mr-1 text-[10px] font-semibold uppercase tracking-wide opacity-70">
                    {t.role === "user" ? "You" : "Assistant"}
                  </span>
                  <p className={cn("whitespace-pre-wrap", t.error && "text-destructive")}>{t.text.replace(/\*\*/g, "")}</p>
                  {t.toolCalls && t.toolCalls.length > 0 && (
                    <p className="mt-0.5 flex flex-wrap gap-1">
                      {t.toolCalls.map((c, j) => (
                        <span key={j} className="inline-flex items-center gap-1 rounded border px-1.5 py-0.5 font-mono text-[10px]">
                          <Wrench className="h-3 w-3" />
                          {c.name.replace(/^mcp__penny__/, "")}
                        </span>
                      ))}
                    </p>
                  )}
                </li>
              ))}
              {busy && <li className="text-xs text-muted-foreground animate-pulse">Looking at the ledger…</li>}
              <div ref={endRef} />
            </ul>
          )}

          <form
            className="mt-2 flex items-end gap-2"
            onSubmit={(e) => {
              e.preventDefault();
              void ask(question);
            }}
          >
            <textarea
              value={question}
              onChange={(e) => setQuestion(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter" && !e.shiftKey) {
                  e.preventDefault();
                  void ask(question);
                }
              }}
              rows={2}
              disabled={!consent || busy}
              placeholder={consent ? "Ask why a figure moved, what a signal means, what to do…" : "Tick the box above to enable questions"}
              className="min-h-[2.5rem] flex-1 resize-y rounded-md border bg-background px-2 py-1.5 text-sm disabled:opacity-60"
              aria-label="Your question"
            />
            <Button type="submit" size="sm" disabled={!consent || busy || question.trim().length === 0} aria-label="Ask">
              <Send className="h-4 w-4" />
            </Button>
          </form>
          <p className="mt-1 text-[10px] text-muted-foreground">Read-only. Model: {status.model}. Every question and tool call is logged.</p>
        </>
      )}
    </section>
  );
}
