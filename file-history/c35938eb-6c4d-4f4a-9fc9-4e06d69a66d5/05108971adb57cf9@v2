/**
 * Divergence explainer engine (v1.24.0). The load-bearing assertion is
 * conservation: components + residual = unexplainedDeltaCents to the cent, for
 * every input shape. The rest pins each detector to the case it was written
 * for (the Aug/Sept 2026 hand diagnoses).
 */

import { describe, test, expect } from "bun:test";
import type { Tx } from "../src/platform/store.ts";
import type { ReconciliationSnapshot } from "../src/budget/ports.ts";
import { explainDelta, RESIDUAL_ALARM_CENTS, type ExplainInputs } from "../src/reconcile/explain.ts";

const NOW = Date.parse("2026-09-08T10:00:00+10:00");
const TODAY = "2026-09-08";

function tx(over: Partial<Tx> & { id: string }): Tx {
  return {
    date: "2026-09-05",
    amountCents: -1000,
    accountId: "acc-nab",
    categoryId: "cat-1",
    envelopeId: "env-1",
    payee: "Coles",
    isTransfer: false,
    isPending: false,
    rawJson: "{}",
    ...over,
  };
}

function inputs(over: Partial<ExplainInputs> = {}): ExplainInputs {
  return {
    net: {
      cashOnHandCents: 500_000,
      cardOwedCents: 100_000,
      totalLeftCents: 401_523,
      awaitingIncomeCents: 0,
      uncategorisedActivityCents: 0,
      reconciledDeltaCents: -1523,
      unexplainedDeltaCents: -1523,
      cardPendingCents: 0,
      lastSyncAt: "2026-09-08T09:00:00+10:00",
    },
    period: "2026-09",
    periodGaps: [{ period: "2026-09", unallocatedCents: 0 }],
    visibleUncategorisedCents: 0,
    txs: [],
    carryoverResets: [],
    budgetHistory: [],
    envelopeNames: new Map([["env-1", "Groceries"]]),
    snapshots: [],
    now: NOW,
    today: TODAY,
    ...over,
  };
}

function sum(lines: readonly { cents: number }[]): number {
  return lines.reduce((s, l) => s + l.cents, 0);
}

describe("explainDelta: conservation", () => {
  test("components + residual = unexplained, with no causes", () => {
    const out = explainDelta(inputs());
    expect(out.components).toHaveLength(0);
    expect(sum(out.components) + out.residualCents).toBe(-1523);
    expect(out.reconciled).toBe(false);
  });

  test("components + residual = unexplained, with the Sept 2026 zero-base gap", () => {
    // Sept 2026: Compliance + Leasing Fees missing from the materialised month → $141.67 unallocated;
    // the widget read HIGH by exactly that (engine fact).
    const out = explainDelta(
      inputs({
        net: { ...inputs().net, reconciledDeltaCents: 14167 - 1523, unexplainedDeltaCents: 14167 - 1523 },
        periodGaps: [{ period: "2026-09", unallocatedCents: 14167 }],
      }),
    );
    const gap = out.components.find((c) => c.code === "zero-base-gap");
    expect(gap?.cents).toBe(14167);
    expect(out.residualCents).toBe(-1523);
    expect(sum(out.components) + out.residualCents).toBe(out.unexplainedDeltaCents);
  });

  test("prior-month gaps are a SIGNAL (a baseline re-strike absorbs them), so the whole figure stays residual", () => {
    const out = explainDelta(
      inputs({
        net: { ...inputs().net, unexplainedDeltaCents: 5000 },
        periodGaps: [
          { period: "2026-07", unallocatedCents: 1000 },
          { period: "2026-08", unallocatedCents: 2500 },
          { period: "2026-09", unallocatedCents: 0 },
        ],
      }),
    );
    expect(out.components).toHaveLength(0);
    expect(out.residualCents).toBe(5000);
    const sig = out.signals.find((s) => s.code === "prior-month-gaps");
    expect(sig?.cents).toBe(3500);
    expect(sig?.detail).toContain("2026-07");
  });

  test("an unpaired transfer after the last re-strike is a COMPONENT for exactly its amount (Sept 2026 ATM deposit)", () => {
    // 7 Sep 2026: $429.30 cash deposit flagged transfer, then $300 + $129.30 PayID legs that ARE paired.
    const out = explainDelta(
      inputs({
        net: { ...inputs().net, reconciledDeltaCents: 42930 - 1523, unexplainedDeltaCents: 42930 - 1523 },
        carryoverResets: [{ ts: Date.parse("2026-08-14T10:00:00+10:00"), envelopeId: "env-1", beforeCents: 0, afterCents: 30328 }],
        txs: [
          tx({ id: "dep", date: "2026-09-07", accountId: "acc-cba", amountCents: 42930, isTransfer: true, payee: "CASH DEPOSIT, CBA ATM" }),
          tx({ id: "out1", date: "2026-09-07", accountId: "acc-cba", amountCents: -30000, isTransfer: true, payee: "Transfer To NICK" }),
          tx({ id: "in1", date: "2026-09-07", accountId: "acc-anz", amountCents: 30000, isTransfer: true, payee: "PAYMENT FROM NICK" }),
          tx({ id: "out2", date: "2026-09-07", accountId: "acc-cba", amountCents: -12930, isTransfer: true, payee: "Transfer To NICK" }),
          tx({ id: "in2", date: "2026-09-08", accountId: "acc-anz", amountCents: 12930, isTransfer: true, payee: "PAYMENT FROM NICK" }),
        ],
      }),
    );
    const line = out.components.find((c) => c.code === "unpaired-transfer");
    expect(line?.cents).toBe(42930);
    expect(line?.detail).toContain("CASH DEPOSIT");
    expect(line?.label).toContain("1 transfer");
    expect(out.residualCents).toBe(-1523);
    expect(sum(out.components) + out.residualCents).toBe(out.unexplainedDeltaCents);
    expect(out.signals.some((s) => s.code === "residual-alarm")).toBe(false);
    expect(out.suggestions.some((s) => s.action === "open-transactions" && s.text.includes("no other leg"))).toBe(true);
  });

  test("paired transfers, pending transfers and a same-account opposite row are never unpaired", () => {
    const out = explainDelta(
      inputs({
        txs: [
          tx({ id: "a", date: "2026-09-01", accountId: "acc-1", amountCents: -50000, isTransfer: true }),
          tx({ id: "b", date: "2026-09-03", accountId: "acc-2", amountCents: 50000, isTransfer: true }),
          tx({ id: "p", date: "2026-09-07", accountId: "acc-1", amountCents: -999, isTransfer: true, isPending: true }),
          tx({ id: "c", date: "2026-09-02", accountId: "acc-1", amountCents: -2500, isTransfer: true }),
          tx({ id: "d", date: "2026-09-02", accountId: "acc-1", amountCents: 2500, isTransfer: true }),
        ],
      }),
    );
    // c/d are on the same account, so they are unpaired with each other; they net to zero but are still named.
    const line = out.components.find((c) => c.code === "unpaired-transfer");
    expect(line?.cents).toBe(0);
    expect(line?.label).toContain("2 transfers");
    expect(out.components.filter((c) => c.code === "unpaired-transfer")).toHaveLength(1);
    expect(sum(out.components) + out.residualCents).toBe(out.unexplainedDeltaCents);
  });

  test("an unpaired transfer on or before the last re-strike is a SIGNAL, not a component", () => {
    const out = explainDelta(
      inputs({
        net: { ...inputs().net, unexplainedDeltaCents: 5000 },
        carryoverResets: [{ ts: Date.parse("2026-08-14T10:00:00+10:00"), envelopeId: "env-1", beforeCents: 0, afterCents: 30328 }],
        txs: [tx({ id: "old", date: "2026-08-10", accountId: "acc-cba", amountCents: 5000, isTransfer: true, payee: "CASH DEPOSIT" })],
      }),
    );
    expect(out.components).toHaveLength(0);
    expect(out.residualCents).toBe(5000);
    const sig = out.signals.find((s) => s.code === "unpaired-transfer-absorbed");
    expect(sig?.cents).toBe(5000);
    expect(sig?.label).toContain("2026-08-14");
  });

  test("a one-leg transfer older than the scan window is ignored", () => {
    const out = explainDelta(
      inputs({ txs: [tx({ id: "ancient", date: "2026-01-05", accountId: "acc-cba", amountCents: 7777, isTransfer: true })] }),
    );
    expect(out.components).toHaveLength(0);
    expect(out.signals.some((s) => s.code.startsWith("unpaired-transfer"))).toBe(false);
  });

  test("reconciled within tolerance", () => {
    const out = explainDelta(inputs({ net: { ...inputs().net, unexplainedDeltaCents: 99 } }));
    expect(out.reconciled).toBe(true);
  });
});

describe("explainDelta: signals", () => {
  test("stale pending older than 7 days is named with its rows", () => {
    const out = explainDelta(
      inputs({
        txs: [
          tx({ id: "p-old", isPending: true, date: "2026-08-20", payee: "Pria Bax", amountCents: -28000 }),
          tx({ id: "p-fresh", isPending: true, date: "2026-09-07", payee: "Cafe", amountCents: -559 }),
        ],
      }),
    );
    const stale = out.signals.find((s) => s.code === "stale-pending");
    expect(stale?.cents).toBe(-28000);
    expect(stale?.detail).toContain("Pria Bax");
    // Signals never enter the conservation sum.
    expect(sum(out.components) + out.residualCents).toBe(out.unexplainedDeltaCents);
  });

  test("a pending with a posted twin (same account, amount, payee, within 5 days) is a duplicate", () => {
    const out = explainDelta(
      inputs({
        txs: [
          tx({ id: "posted", isPending: false, date: "2026-09-04", payee: "Pria Bax", amountCents: -28000 }),
          tx({ id: "ghost", isPending: true, date: "2026-09-05", payee: "Pria Bax", amountCents: -28000 }),
        ],
      }),
    );
    const dup = out.signals.find((s) => s.code === "duplicate-pending");
    expect(dup?.cents).toBe(-28000);
  });

  test("uncategorised activity outside the visible window is surfaced", () => {
    const out = explainDelta(
      inputs({
        net: { ...inputs().net, uncategorisedActivityCents: -27272 },
        visibleUncategorisedCents: -8777,
      }),
    );
    const line = out.signals.find((s) => s.code === "uncategorised-outside-window");
    expect(line?.cents).toBe(-18495);
  });

  test("card feed more than an hour behind the sync is flagged with the pending card spend", () => {
    const out = explainDelta(
      inputs({
        net: {
          ...inputs().net,
          cardPendingCents: 4321,
          feedRefreshedAt: Date.parse("2026-09-08T05:00:00+10:00"),
          lastSyncAt: "2026-09-08T09:00:00+10:00",
        },
      }),
    );
    const feed = out.signals.find((s) => s.code === "feed-staleness");
    expect(feed?.cents).toBe(4321);
    expect(feed?.label).toContain("4h");
  });

  test("recent carryover and budget edits are listed by envelope name", () => {
    const out = explainDelta(
      inputs({
        carryoverResets: [{ ts: NOW - 86_400_000, envelopeId: "env-1", beforeCents: 30328, afterCents: 182888 }],
        budgetHistory: [
          { id: "h1", userId: "u", ts: NOW - 2 * 86_400_000, envelopeId: "env-1", beforeCents: 50000, afterCents: 55000, scope: "ongoing", actor: "ui" },
          { id: "h2", userId: "u", ts: NOW - 2 * 86_400_000, envelopeId: "env-1", beforeCents: 0, afterCents: 55000, scope: "ongoing", actor: "sync" },
        ],
      }),
    );
    const carry = out.signals.find((s) => s.code === "recent-carryover-edits");
    expect(carry?.cents).toBe(152560);
    expect(carry?.detail).toContain("Groceries");
    const edits = out.signals.find((s) => s.code === "recent-budget-edits");
    expect(edits?.label).toContain("1 budget edit");
    expect(edits?.cents).toBe(5000);
  });

  test("a residual above the alarm threshold is itself a signal", () => {
    const out = explainDelta(inputs({ net: { ...inputs().net, unexplainedDeltaCents: -(RESIDUAL_ALARM_CENTS + 1) } }));
    expect(out.signals.some((s) => s.code === "residual-alarm")).toBe(true);
    expect(out.suggestions.some((s) => s.text.includes("unattributed"))).toBe(true);
  });
});

describe("explainDelta: since last balanced", () => {
  const balanced: ReconciliationSnapshot = {
    date: "2026-09-01",
    ts: Date.parse("2026-09-01T20:00:00+10:00"),
    cashOnHandCents: 480_000,
    cardOwedCents: 90_000,
    totalLeftCents: 390_000,
    awaitingIncomeCents: 0,
    uncategorisedCents: 0,
    unallocatedCents: 0,
    reconciledDeltaCents: 0,
    unexplainedDeltaCents: 0,
  };
  const later: ReconciliationSnapshot = { ...balanced, date: "2026-09-05", ts: balanced.ts + 4 * 86_400_000, unexplainedDeltaCents: -800, reconciledDeltaCents: -800 };

  test("null with no snapshots", () => {
    expect(explainDelta(inputs()).since).toBeNull();
  });

  test("anchors on the newest balanced snapshot and decomposes the change exactly", () => {
    const out = explainDelta(inputs({ snapshots: [later, balanced] }));
    expect(out.since?.anchor).toBe("balanced");
    expect(out.since?.date).toBe("2026-09-01");
    expect(out.since?.changeCents).toBe(-1523);
    // Δunexplained = Δ(cash − card) − Δ(left − awaiting) − Δuncategorised
    expect(sum(out.since!.changes)).toBe(out.since!.changeCents);
  });

  test("falls back to the earliest snapshot when none was balanced", () => {
    // A self-consistent unbalanced anchor: $3.00 less cash than the balanced fixture.
    const out = explainDelta(
      inputs({ snapshots: [later, { ...balanced, cashOnHandCents: 479_700, reconciledDeltaCents: -300, unexplainedDeltaCents: -300 }] }),
    );
    expect(out.since?.anchor).toBe("earliest");
    expect(out.since?.unexplainedThenCents).toBe(-300);
    expect(sum(out.since!.changes)).toBe(out.since!.changeCents);
  });

  test("an inconsistent snapshot surfaces as a visible unaccounted line, never a silent mismatch", () => {
    const out = explainDelta(inputs({ snapshots: [{ ...balanced, unexplainedDeltaCents: -300 }] }));
    expect(out.since!.changes.some((c) => c.code === "since-unaccounted")).toBe(true);
    expect(sum(out.since!.changes)).toBe(out.since!.changeCents);
  });

  test("activity since the anchor lists posted transactions and edits after it", () => {
    const out = explainDelta(
      inputs({
        snapshots: [balanced],
        txs: [tx({ id: "a", date: "2026-09-03", amountCents: -4200 }), tx({ id: "b", date: "2026-08-30", amountCents: -999 })],
        carryoverResets: [{ ts: balanced.ts + 1000, envelopeId: "env-1", beforeCents: 0, afterCents: 1500 }],
      }),
    );
    const posted = out.since!.activity.find((a) => a.code === "since-posted");
    expect(posted?.cents).toBe(-4200);
    expect(out.since!.activity.some((a) => a.code === "since-carryover-edits")).toBe(true);
  });
});
