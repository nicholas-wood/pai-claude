/**
 * Persistence ports for the budget engine. Extends the envelope engine's store
 * with the recurring template (ISC-29) and the budget history (ISC-77). The
 * concrete adapter satisfies all of it; the engine stays blind to bun:sqlite
 * (ISC-57) and DEPLOY_MODE (ISC-51).
 */

import type { UserId } from "../platform/auth.ts";
import type { BudgetChange, BudgetTemplate, MoneyMovement } from "../domain/types.ts";
import type { EnvelopeStore } from "../envelope/ports.ts";

/**
 * One persisted reconciliation confirmation (Phase 4). Append-only: the user has
 * checked the Holding envelope against the NAB statement and recorded it. The
 * holding balance and drift are computed server-side at write time, never taken
 * from the client, so a stored record reflects the engine's own figure.
 */
export interface ReconciliationRecord {
  readonly id: string;
  /** Epoch millis the confirmation was recorded. */
  readonly ts: number;
  readonly statementDate: string;
  readonly holdingCents: number;
  readonly nabStatementCents: number;
  readonly driftCents: number;
  readonly matched: boolean;
}

/**
 * One daily reconciliation snapshot (v1.24.0 explainer): the net-position
 * figures as the widget computed them, one row per tenant per day (last write
 * of the day wins). Powers "what changed since the widget was last balanced":
 * the explainer diffs the current figures against the newest snapshot within
 * tolerance. Written by the net-position route on every successful read, so
 * no cron is needed and the anchor exists from the first view after deploy.
 */
export interface ReconciliationSnapshot {
  /** YYYY-MM-DD in the budget timezone; the natural key with userId. */
  readonly date: string;
  /** Epoch millis of the write. */
  readonly ts: number;
  readonly cashOnHandCents: number;
  readonly cardOwedCents: number;
  readonly totalLeftCents: number;
  readonly awaitingIncomeCents: number;
  readonly uncategorisedCents: number;
  /** The current month's zero-base gap (budgeted income − allocations). */
  readonly unallocatedCents: number;
  readonly reconciledDeltaCents: number;
  readonly unexplainedDeltaCents: number;
}

/** Reads/writes the budget engine needs beyond the envelope store. */
export interface BudgetExtrasStore {
  /** Upsert the day's reconciliation snapshot (keyed by userId + date). */
  putReconciliationSnapshot(userId: UserId, snap: ReconciliationSnapshot): Promise<void>;
  /** Newest-first reconciliation snapshots, at most `limit` rows. */
  listReconciliationSnapshots(userId: UserId, limit: number): Promise<ReconciliationSnapshot[]>;

  listTemplate(userId: UserId): Promise<BudgetTemplate[]>;
  putTemplateLine(userId: UserId, line: BudgetTemplate): Promise<void>;
  deleteTemplateLine(userId: UserId, lineId: string): Promise<void>;

  listBudgetHistory(userId: UserId): Promise<BudgetChange[]>;
  appendBudgetHistory(userId: UserId, change: BudgetChange): Promise<void>;

  /** Append a traceable money movement (ISC-90); newest-first list for history. */
  appendMovement(userId: UserId, movement: MoneyMovement): Promise<void>;
  listMovements(userId: UserId): Promise<MoneyMovement[]>;

  /** Persist a reconciliation confirmation (append-only). */
  appendReconciliation(userId: UserId, rec: ReconciliationRecord): Promise<void>;
  /** The most recent persisted reconciliation confirmation, or null. */
  getLatestReconciliation(userId: UserId): Promise<ReconciliationRecord | null>;
}

/** The full persistence surface the budget engine depends on. */
export type BudgetStore = EnvelopeStore & BudgetExtrasStore;
