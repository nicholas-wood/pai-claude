/**
 * Diagnostic tool server (v1.25.0): a stdio MCP server exposing the typed,
 * read-only tools in src/diagnostics/tools.ts to the `claude -p` subprocess the
 * DiagnosticProvider spawns. Launched by the CLI from the per-question MCP
 * config; never by hand in production.
 *
 * Read-only by construction: the SQLite handle is opened SQLITE_OPEN_READONLY
 * and migrate() is never called. This process holds no PocketSmith key; the
 * figures that need PocketSmith (net position, explanation) arrive precomputed
 * in the context file the server wrote for this question.
 *
 * Env (set per server in the MCP config, not inherited from the shell):
 *   PENNY_SQLITE_PATH     the live ledger path
 *   PENNY_DIAG_USER_ID    the tenant every tool is scoped to
 *   PENNY_DIAG_CONTEXT    path to the precomputed DiagnosticContext JSON
 *   PENNY_TIMEZONE        budget calendar timezone
 *   PENNY_NAB_ACCOUNT_IDS / PENNY_HOLDING_ENVELOPE_ID  engine wiring (optional)
 *
 * Protocol: newline-delimited JSON-RPC 2.0 over stdio, the subset the CLI uses
 * (initialize, notifications/initialized, tools/list, tools/call, ping).
 */

import { SqliteStore } from "../src/store/sqlite.ts";
import { EnvelopeService } from "../src/envelope/service.ts";
import { resolveEngineConfig } from "../src/server/services.ts";
import { installEgressGuard } from "../src/security/egress.ts";
import { TOOL_DEFINITIONS, runTool, UnknownToolError, type DiagnosticContext, type ToolDeps } from "../src/diagnostics/tools.ts";

// Belt and braces: this process makes no network calls at all.
installEgressGuard("local");

const sqlitePath = process.env.PENNY_SQLITE_PATH;
const userId = process.env.PENNY_DIAG_USER_ID;
const contextPath = process.env.PENNY_DIAG_CONTEXT;
const timezone = process.env.PENNY_TIMEZONE?.trim() || "Australia/Melbourne";
if (!sqlitePath || !userId || !contextPath) {
  process.stderr.write("diagnose-mcp: PENNY_SQLITE_PATH, PENNY_DIAG_USER_ID and PENNY_DIAG_CONTEXT are required\n");
  process.exit(2);
}

const context = (await Bun.file(contextPath).json()) as DiagnosticContext;
const store = new SqliteStore(sqlitePath, { readonly: true });
const envelopes = new EnvelopeService(store, resolveEngineConfig(process.env), { timezone });
const deps: ToolDeps = { store, envelopes, userId, context };

type Json = Record<string, unknown>;
const send = (o: Json): void => {
  process.stdout.write(JSON.stringify(o) + "\n");
};
const reply = (id: unknown, result: Json): void => send({ jsonrpc: "2.0", id, result });
const fail = (id: unknown, code: number, message: string): void => send({ jsonrpc: "2.0", id, error: { code, message } });

for await (const line of console) {
  if (!line.trim()) continue;
  let msg: Json;
  try {
    msg = JSON.parse(line) as Json;
  } catch {
    continue;
  }
  const id = msg.id;
  const method = msg.method;
  const params = (msg.params ?? {}) as Json;

  if (method === "initialize") {
    reply(id, {
      protocolVersion: typeof params.protocolVersion === "string" ? params.protocolVersion : "2024-11-05",
      capabilities: { tools: {} },
      serverInfo: { name: "penny", version: "1.25.0" },
    });
    continue;
  }
  if (method === "notifications/initialized" || method === "notifications/cancelled") continue;
  if (method === "ping") {
    reply(id, {});
    continue;
  }
  if (method === "tools/list") {
    reply(id, { tools: TOOL_DEFINITIONS.map((t) => ({ name: t.name, description: t.description, inputSchema: t.inputSchema })) });
    continue;
  }
  if (method === "tools/call") {
    const name = typeof params.name === "string" ? params.name : "";
    try {
      const result = await runTool(deps, name, params.arguments);
      reply(id, { content: [{ type: "text", text: JSON.stringify(result) }] });
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      if (err instanceof UnknownToolError) fail(id, -32601, message);
      else reply(id, { content: [{ type: "text", text: `Tool error: ${message}` }], isError: true });
    }
    continue;
  }
  if (id !== undefined) fail(id, -32601, `Method not found: ${String(method)}`);
}

await store.close();
