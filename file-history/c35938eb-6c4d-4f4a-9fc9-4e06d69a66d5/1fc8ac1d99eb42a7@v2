/**
 * Net-position computation shared by GET /api/net-position (the widget) and
 * GET /api/net-position/explain (the v1.24.0 divergence explainer). One
 * function produces the figures so the explainer can never disagree with the
 * banner it explains.
 *
 * The maths (unchanged from the v1.21 handler): the real liquid position (cash
 * on hand minus what is owed on cards, live from PocketSmith) against the
 * budget's total "left" (top-level rows roll up their descendants; income
 * contributes carryover + variance so the budgeted income cancels against the
 * expense allocations under zero-base). D5 awaiting income compensates the
 * pre-payday hold-back. Uncategorised activity is KNOWN, not unexplained
 * (owner principle 2026-08-14): the banner grades on the delta after it.
 */

import type { Container } from "../composition.ts";
import type { Services } from "./services.ts";
import type { NetPositionResponse } from "./contract.ts";
import type { Tx } from "../platform/store.ts";
import type { ReconciliationSnapshot } from "../budget/ports.ts";
import type { UserId } from "../platform/auth.ts";
import type { Period } from "../domain/types.ts";
import { currentPeriod } from "./http.ts";
import { PocketSmithClient } from "../ingest/client.ts";
import { periodKey } from "../envelope/period.ts";
import { resolveIncomeBudgetForMonth } from "../budget/versions.ts";
import { todayISO } from "../platform/time.ts";
import { explainDelta, type DeltaExplanation, type PeriodGap } from "../reconcile/explain.ts";

type Grid = Awaited<ReturnType<Services["envelopes"]["getGrid"]>>;

export interface NetPositionComputation {
  readonly res: NetPositionResponse;
  /** Present only when res.ok: the grid the figures came from, and every tenant transaction. */
  readonly grid?: Grid;
  readonly txs?: readonly Tx[];
}

function failed(message: string): NetPositionResponse {
  return {
    ok: false,
    cashOnHandCents: 0,
    cardOwedCents: 0,
    totalLeftCents: 0,
    sectionLeftCents: { income: 0, saving: 0, expense: 0, envelope: 0, working: 0 },
    reconciledDeltaCents: 0,
    asOf: Date.now(),
    message,
  };
}

/** Decimal-dollar PocketSmith balance to integer cents, rounding float dust. */
function toCents(amount: number | undefined | null): number {
  return amount === undefined || amount === null || Number.isNaN(amount) ? 0 : Math.round(amount * 100);
}

/** Compute the net position for one tenant. Never throws; PocketSmith failures degrade to ok:false. */
export async function computeNetPosition(
  container: Container,
  services: Services,
  userId: UserId,
): Promise<NetPositionComputation> {
  try {
    const client = await PocketSmithClient.forUser(container.secrets, userId);
    const user = await client.getAuthenticatedUser();
    if (user.id === undefined || user.id === null) {
      return { res: failed("PocketSmith did not return an account id.") };
    }
    const accounts = await client.listTransactionAccounts(user.id);

    let cashOnHandCents = 0;
    let cardBalanceCents = 0; // signed; cards report a negative balance.
    const cardAccountIds = new Set<string>();
    let feedRefreshedAt: number | undefined;
    for (const a of accounts) {
      const isCard = (a.type ?? "").toLowerCase().includes("credit");
      const cents = toCents(a.current_balance);
      if (isCard) {
        cardBalanceCents += cents;
        cardAccountIds.add(String(a.id));
        // Oldest CARD feed refresh (ISC-265/267): the staleness that makes the
        // delta read low is the card side lagging the hourly sync.
        const updated = a.updated_at !== undefined ? Date.parse(a.updated_at) : NaN;
        if (!Number.isNaN(updated) && (feedRefreshedAt === undefined || updated < feedRefreshedAt)) {
          feedRefreshedAt = updated;
        }
      } else cashOnHandCents += cents;
    }
    // Card balances are negative; owed is the magnitude reported positive.
    const cardOwedCents = Math.abs(cardBalanceCents);

    // Pending non-transfer card spend, positive magnitude (ISC-265). Both
    // sides of the delta already include it; this is display-only.
    const txsAll = await container.store.listTransactions(userId);
    const cardPendingCents = Math.abs(
      txsAll
        .filter((t) => t.isPending && !t.isTransfer && cardAccountIds.has(t.accountId))
        .reduce((s, t) => s + t.amountCents, 0),
    );
    const lastSyncAt = await container.store.getLastSyncAt(userId);

    // Total "left": sum of TOP-LEVEL rows, whose leftCents roll up their
    // descendants — every envelope counted exactly once INCLUDING a parent's
    // OWN balance.
    const grid = await services.envelopes.getGrid(userId, currentPeriod(container.config.timezone));
    // Working envelopes sit outside the ZERO-BASE budget but still move real cash,
    // so they ARE part of the net-position reconciliation as their own section line.
    const topLevel = grid.rows.filter((r) => r.parentId === null);
    const leafLeftCents = topLevel.reduce((s, r) => s + r.leftCents, 0);
    // Income contributes carryover + surplus/deficit (variance), NOT carryover +
    // received: the budgeted income is already represented in the expense
    // allocations (zero-base), so carry + (received − budget) makes the budgets
    // cancel and the sum reconcile to cash − card.
    const incomeLeftCents = grid.income.reduce((s, i) => s + i.carryoverCents + i.varianceCents, 0);
    const totalLeftCents = leafLeftCents + incomeLeftCents;
    // D5: pre-payday, due-based variance holds back the not-yet-due income; the
    // cash hasn't arrived either, so the reconciliation compensates with the
    // awaiting total to stay exact across the expected-day boundary.
    const awaitingIncomeCents = grid.income.reduce((s, i) => s + (i.awaitingCents ?? 0), 0);

    const leftByType = (type: string): number =>
      topLevel.filter((r) => r.type === type).reduce((s, r) => s + r.leftCents, 0);
    const sectionLeftCents = {
      income: incomeLeftCents,
      saving: leftByType("saving"),
      expense: leftByType("expense"),
      envelope: leftByType("envelope"),
      working: leftByType("working"),
    };

    const reconciledDeltaCents = cashOnHandCents - cardOwedCents - (totalLeftCents - awaitingIncomeCents);
    const uncategorisedActivityCents = grid.unresolvedActivityCents ?? 0;
    const unexplainedDeltaCents = reconciledDeltaCents - uncategorisedActivityCents;
    const res: NetPositionResponse = {
      ok: true,
      cashOnHandCents,
      cardOwedCents,
      totalLeftCents,
      awaitingIncomeCents,
      sectionLeftCents,
      reconciledDeltaCents,
      uncategorisedActivityCents,
      unexplainedDeltaCents,
      cardPendingCents,
      ...(feedRefreshedAt !== undefined ? { feedRefreshedAt } : {}),
      lastSyncAt,
      asOf: Date.now(),
    };
    return { res, grid, txs: txsAll };
  } catch {
    // Never surface the underlying error verbatim: it could narrow the key.
    return { res: failed("Could not reach PocketSmith. Check the developer key in Settings.") };
  }
}

/** The day's snapshot row from a successful computation. */
export function snapshotOf(res: NetPositionResponse, grid: Grid, date: string, ts: number): ReconciliationSnapshot {
  return {
    date,
    ts,
    cashOnHandCents: res.cashOnHandCents,
    cardOwedCents: res.cardOwedCents,
    totalLeftCents: res.totalLeftCents,
    awaitingIncomeCents: res.awaitingIncomeCents ?? 0,
    uncategorisedCents: res.uncategorisedActivityCents ?? 0,
    unallocatedCents: grid.unallocatedCents,
    reconciledDeltaCents: res.reconciledDeltaCents,
    unexplainedDeltaCents: res.unexplainedDeltaCents ?? res.reconciledDeltaCents,
  };
}

function periodFromKey(key: string): Period {
  return { year: Number(key.slice(0, 4)), month: Number(key.slice(5, 7)) };
}

/**
 * Zero-base gap per materialised month, limited to months the carryover fold
 * actually reaches: from the earliest carryover anchor forward. A gap in a
 * month BEFORE every baseline was struck cannot move today's delta (the fold
 * starts at the anchor), so admitting it as a component would break the
 * conservation rule. The current month's gap is taken from the grid itself so
 * the explainer agrees with the zero-base headline to the cent.
 */
async function periodGapsFor(container: Container, userId: UserId, grid: Grid): Promise<PeriodGap[]> {
  const store = container.store;
  const [periods, carry, incomes, template, envelopes] = await Promise.all([
    store.listAllocationPeriods(userId),
    store.listEnvelopeCarryover(userId),
    store.listIncomeEnvelopes(userId),
    store.listTemplate(userId),
    store.listEnvelopes(userId),
  ]);
  const anchors = carry.map((c) => c.carryoverAnchor).filter((a): a is string => typeof a === "string" && a.length >= 7);
  const gaps: PeriodGap[] = [{ period: grid.period, unallocatedCents: grid.unallocatedCents }];
  if (anchors.length === 0) return gaps;
  const floor = anchors.sort()[0]!.slice(0, 7);
  const live = new Set(envelopes.filter((e) => e.archived !== true && e.active !== false).map((e) => e.id));
  for (const p of periods) {
    if (p < floor || p >= grid.period) continue;
    const allocations = await store.listAllocations(userId, p);
    const allocated = allocations.filter((a) => live.has(a.envelopeId)).reduce((s, a) => s + a.amountCents, 0);
    const month = periodFromKey(p);
    const budgeted = incomes.reduce((s, i) => s + resolveIncomeBudgetForMonth(template, i, month), 0);
    gaps.push({ period: p, unallocatedCents: budgeted - allocated });
  }
  return gaps;
}

/** Gather every input the explainer needs and run it. Requires a successful computation. */
export async function explainNetPosition(
  container: Container,
  services: Services,
  userId: UserId,
  computed: NetPositionComputation,
  now: number = Date.now(),
): Promise<DeltaExplanation | null> {
  const { res, grid, txs } = computed;
  if (!res.ok || grid === undefined || txs === undefined) return null;
  const store = container.store;
  const [resets, history, envelopes, incomes, snapshots, periodGaps] = await Promise.all([
    services.envelopes.listCarryoverResets(userId),
    store.listBudgetHistory(userId),
    store.listEnvelopes(userId),
    store.listIncomeEnvelopes(userId),
    store.listReconciliationSnapshots(userId, 400),
    periodGapsFor(container, userId, grid),
  ]);
  const envelopeNames = new Map<string, string>();
  for (const e of envelopes) envelopeNames.set(e.id, e.name);
  for (const i of incomes) envelopeNames.set(i.id, i.name);

  return explainDelta({
    net: {
      cashOnHandCents: res.cashOnHandCents,
      cardOwedCents: res.cardOwedCents,
      totalLeftCents: res.totalLeftCents,
      awaitingIncomeCents: res.awaitingIncomeCents ?? 0,
      uncategorisedActivityCents: res.uncategorisedActivityCents ?? 0,
      reconciledDeltaCents: res.reconciledDeltaCents,
      unexplainedDeltaCents: res.unexplainedDeltaCents ?? res.reconciledDeltaCents,
      cardPendingCents: res.cardPendingCents ?? 0,
      ...(res.feedRefreshedAt !== undefined ? { feedRefreshedAt: res.feedRefreshedAt } : {}),
      lastSyncAt: res.lastSyncAt ?? null,
    },
    period: periodKey(currentPeriod(container.config.timezone)),
    periodGaps,
    visibleUncategorisedCents: grid.uncategorisedTotalCents,
    txs,
    carryoverResets: resets.map((r) => ({ ts: r.ts, envelopeId: r.envelopeId, beforeCents: r.beforeCents, afterCents: r.afterCents })),
    budgetHistory: history,
    envelopeNames,
    snapshots,
    now,
    today: todayISO(container.config.timezone, new Date(now)),
  });
}
