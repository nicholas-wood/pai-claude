/**
 * No-egress guard (ISC-45).
 *
 * In local mode, no financial data leaves the machine for a cloud SaaS or a
 * cloud AI endpoint. The only external host the app is ever permitted to talk
 * to is PocketSmith (the bank-feed source the whole product reads from). Every
 * other outbound host — every cloud AI inference API, every third-party SaaS —
 * is denied by default.
 *
 * Two layers:
 *   1. `isEgressAllowed(host, mode)` — a pure, unit-testable policy predicate.
 *   2. `installEgressGuard(mode)` — wraps the global `fetch` so a disallowed
 *      host throws `EgressBlockedError` before a single byte leaves the process.
 *
 * The guard is installed at job/server entrypoints. It is deliberately a hard
 * stop, not a warning: a financial-data leak is not something to log and carry
 * on from. This module reads no deployment-mode env var itself; the resolved
 * mode is passed in by the composition root / the entrypoint script.
 */

export type EgressMode = "local" | "cloud";

/**
 * Hosts that are known cloud AI inference or cloud SaaS storage endpoints. This
 * list is the explicit, greppable statement of "things financial data must not
 * be posted to in local mode". The ISC-45 repo test asserts none of these
 * appears as an outbound call site in business code.
 */
export const KNOWN_CLOUD_AI_SAAS_HOSTS: readonly string[] = [
  "api.openai.com",
  "api.anthropic.com",
  "generativelanguage.googleapis.com",
  "api.cohere.ai",
  "api.mistral.ai",
  "api.groq.com",
  "api.perplexity.ai",
  "openrouter.ai",
  "api.replicate.com",
  "api.together.xyz",
  "api.deepseek.com",
  "bedrock-runtime.us-east-1.amazonaws.com",
  "api.elevenlabs.io",
  "hooks.slack.com",
  "api.notion.com",
  "sheets.googleapis.com",
];

/**
 * The sole external host the app may reach in either mode: PocketSmith. Auth is
 * the per-user X-Developer-Key; this is inbound bank-feed data, not egress of
 * the user's own ledger to a third party.
 */
export const POCKETSMITH_HOST = "api.pocketsmith.com";

/** Loopback and tailnet hosts are always local-trust and always allowed. */
function isLocalHost(host: string): boolean {
  return (
    host === "localhost" ||
    host === "127.0.0.1" ||
    host === "::1" ||
    host === "0.0.0.0" ||
    host.endsWith(".ts.net") || // tailnet (tailscale serve)
    host.endsWith(".local")
  );
}

/**
 * Policy predicate. In local mode only loopback/tailnet and PocketSmith are
 * permitted; everything else (notably every cloud AI/SaaS host) is denied. In
 * cloud mode the per-tenant deployment talks to its own infrastructure, so the
 * guard is permissive — the local-mode no-egress guarantee is the ISC.
 */
export function isEgressAllowed(host: string, mode: EgressMode): boolean {
  const h = host.toLowerCase();
  if (isLocalHost(h)) return true;
  if (h === POCKETSMITH_HOST) return true;
  if (mode === "cloud") return true;
  return false;
}

/** Thrown when the guard blocks an outbound request in local mode. */
export class EgressBlockedError extends Error {
  constructor(public readonly host: string) {
    // Never include request bodies or headers — only the host, never secrets.
    super(`Egress blocked: ${host} is not permitted in local mode (no cloud SaaS/AI egress of financial data).`);
    this.name = "EgressBlockedError";
  }
}

/**
 * ISC-45.1 (approved 2026-09-08): the ONE consented AI egress channel.
 *
 * The local-mode default is unchanged: nothing financial leaves the machine.
 * The diagnostic chat sends the user's question plus the ledger rows its typed
 * read-only tools return to Anthropic under the user's own Claude subscription,
 * through a `claude` subprocess rather than fetch, so the fetch guard above
 * cannot see it. This gate is therefore the explicit, greppable statement of
 * when that channel may open: only with the caller's per-request consent, and
 * only when the deployment has enabled the feature. Every call site of the
 * diagnostic provider goes through here; the ISC-45.1 test asserts the refusal.
 */
export const AI_EGRESS_DISCLOSURE =
  "Questions and the ledger rows needed to answer them are sent to Anthropic under your Claude subscription. Payees are masked. Nothing is sent until you tick this box, and every question and tool call is written to the audit log.";

export function assertConsentedAiEgress(input: { readonly consent: boolean; readonly featureEnabled: boolean }): void {
  if (!input.featureEnabled) throw new EgressBlockedError("ai-diagnostics (feature disabled)");
  if (input.consent !== true) throw new EgressBlockedError("ai-diagnostics (no consent)");
}

/** Resolve the hostname (no port) of a fetch input without throwing on odd inputs. */
function hostOf(input: string | URL | Request): string | null {
  try {
    const url = input instanceof Request ? input.url : input instanceof URL ? input.href : input;
    return new URL(url, "http://127.0.0.1").hostname || null;
  } catch {
    return null;
  }
}

const GUARD_TAG = Symbol.for("penny.egressGuard");

/**
 * Wrap the global `fetch` so any disallowed host throws before the request is
 * made. Idempotent and re-entrant safe: if fetch is already a guard, this is a
 * no-op. Returns a disposer that restores the fetch captured at install time
 * (used by tests). The guard never inspects or logs request bodies.
 */
export function installEgressGuard(mode: EgressMode): () => void {
  const original = globalThis.fetch;
  if ((original as { [GUARD_TAG]?: boolean })[GUARD_TAG]) return () => {};

  const guarded = (async (input: Parameters<typeof fetch>[0], init?: Parameters<typeof fetch>[1]) => {
    const host = hostOf(input as string | URL | Request);
    if (host && !isEgressAllowed(host, mode)) {
      throw new EgressBlockedError(host);
    }
    return original(input, init);
  }) as typeof fetch & { [GUARD_TAG]?: boolean };
  guarded[GUARD_TAG] = true;

  globalThis.fetch = guarded;
  return () => {
    globalThis.fetch = original;
  };
}
