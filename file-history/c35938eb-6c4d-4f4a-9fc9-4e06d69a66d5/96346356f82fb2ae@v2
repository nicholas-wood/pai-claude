// ── data minimisation ─────────────────────────────────────────────────────────

/**
 * Mask a payee so a row stays recognisable to its owner ("P••• B••") but the
 * merchant string itself never leaves the machine. Deterministic, no lookup.
 */
export function maskPayee(payee: string): string {
  const words = payee.trim().split(/\s+/).filter((w) => w.length > 0);
  if (words.length === 0) return "";
  return words
    .slice(0, 3)
    .map((w) => (w.length <= 1 ? w : w[0] + "•".repeat(Math.min(w.length - 1, 4))))
    .join(" ") + (words.length > 3 ? " …" : "");
}

const MASK_KEYS = new Set(["payee", "description", "memo", "note", "narrative", "merchant"]);
const DROP_KEYS = new Set(["rawJson", "raw_json", "raw"]);

/** Deep-sanitise any tool result: drop raw provider JSON, mask free-text merchant fields. */
export function sanitise<T>(value: T): T {
  if (Array.isArray(value)) return value.map((v) => sanitise(v)) as unknown as T;
  if (value !== null && typeof value === "object") {
    const out: Record<string, unknown> = {};
    for (const [k, v] of Object.entries(value as Record<string, unknown>)) {
      if (DROP_KEYS.has(k)) continue;
      if (MASK_KEYS.has(k) && typeof v === "string") out[k] = maskPayee(v);
      else out[k] = sanitise(v);
    }
    return out as T;
  }
  return value;
}

// ── dispatch ──────────────────────────────────────────────────────────────────

function periodFromKey(key: string): Period {
  return { year: Number(key.slice(0, 4)), month: Number(key.slice(5, 7)) };
}

function cap(input: Record<string, unknown>, fallback = MAX_ROWS): number {
  const n = typeof input.limit === "number" ? Math.floor(input.limit) : fallback;
  return Math.max(1, Math.min(MAX_ROWS, n));
}

function str(input: Record<string, unknown>, key: string): string | undefined {
  const v = input[key];
  return typeof v === "string" && v.length > 0 ? v : undefined;
}

export class UnknownToolError extends Error {}

/** Run one tool. Results are already sanitised; the caller serialises them verbatim. */
export async function runTool(deps: ToolDeps, name: string, rawInput: unknown): Promise<unknown> {
  const input = (rawInput !== null && typeof rawInput === "object" ? rawInput : {}) as Record<string, unknown>;
  const { store, envelopes, userId, context } = deps;
  const period = str(input, "period") ?? context.period;

  switch (name) {
    case "explain_delta":
      return context.explanation ?? { ok: false, message: "The explainer could not run (net position unavailable)." };

    case "net_position":
      return context.netPosition;

    case "grid": {
      const g = await envelopes.getGrid(userId, periodFromKey(period));
      return sanitise({
        period: g.period,
        from: g.from,
        to: g.to,
        unallocatedCents: g.unallocatedCents,
        budgetedIncomeCents: g.budgetedIncomeCents,
        uncategorisedCount: g.uncategorisedCount,
        uncategorisedTotalCents: g.uncategorisedTotalCents,
        unresolvedActivityCents: g.unresolvedActivityCents,
        rows: g.rows.slice(0, MAX_ROWS).map((r) => ({
          id: r.id,
          parentId: r.parentId,
          name: r.name,
          type: r.type,
          carryoverCents: r.carryoverCents,
          allocationCents: r.allocationCents,
          leftCents: r.leftCents,
          pendingCents: r.pendingCents ?? 0,
        })),
        income: g.income.map((i) => ({
          id: i.id,
          name: i.name,
          budgetedCents: i.budgetedCents,
          receivedCents: i.receivedCents,
          carryoverCents: i.carryoverCents,
          leftCents: i.leftCents,
          varianceCents: i.varianceCents,
          awaitingCents: i.awaitingCents ?? 0,
          expectedDay: i.expectedDay ?? null,
        })),
      });
    }

    case "envelope_detail": {
      const envelopeId = str(input, "envelopeId");
      if (!envelopeId) throw new Error("envelopeId is required");
      const d = await envelopes.getDetail(userId, envelopeId, periodFromKey(period));
      if (d === null) return { found: false, envelopeId };
      return sanitise({ found: true, ...(d as unknown as Record<string, unknown>) });
    }

    case "transactions": {
      const opts: { from?: string; to?: string; envelopeId?: string; accountId?: string; newestFirst: boolean } = { newestFirst: true };
      const from = str(input, "from");
      const to = str(input, "to");
      const envelopeId = str(input, "envelopeId");
      const accountId = str(input, "accountId");
      if (from) opts.from = from;
      if (to) opts.to = to;
      if (envelopeId) opts.envelopeId = envelopeId;
      if (accountId) opts.accountId = accountId;
      let rows = await store.listTransactions(userId, opts);
      if (input.pendingOnly === true) rows = rows.filter((t) => t.isPending);
      if (input.transferOnly === true) rows = rows.filter((t) => t.isTransfer);
      const limit = cap(input);
      return {
        total: rows.length,
        returned: Math.min(rows.length, limit),
        rows: rows.slice(0, limit).map((t) => ({
          id: t.id,
          date: t.date,
          amountCents: t.amountCents,
          accountId: t.accountId,
          categoryId: t.categoryId,
          envelopeId: t.envelopeId,
          payee: maskPayee(t.payee),
          isTransfer: t.isTransfer,
          isPending: t.isPending,
        })),
      };
    }

    case "movements": {
      const names = await envelopeNames(deps);
      const rows = await store.listMovements(userId);
      return rows.slice(0, cap(input, 100)).map((m) => ({
        ts: m.ts,
        from: names.get(m.fromEnvelopeId) ?? m.fromEnvelopeId,
        to: names.get(m.toEnvelopeId) ?? m.toEnvelopeId,
        amountCents: m.amountCents,
        scope: m.scope,
        actor: m.actor,
      }));
    }

    case "budget_history": {
      const names = await envelopeNames(deps);
      const envelopeId = str(input, "envelopeId");
      let rows = await store.listBudgetHistory(userId);
      if (envelopeId) rows = rows.filter((h) => h.envelopeId === envelopeId);
      return rows.slice(0, cap(input, 100)).map((h) => ({
        ts: h.ts,
        envelope: names.get(h.envelopeId) ?? h.envelopeId,
        envelopeId: h.envelopeId,
        beforeCents: h.beforeCents,
        afterCents: h.afterCents,
        scope: h.scope,
        actor: h.actor,
      }));
    }

    case "carryover_events": {
      const envelopeId = str(input, "envelopeId");
      const rows = await envelopes.listCarryoverResets(userId, envelopeId);
      return rows.slice(0, cap(input, 100)).map((r) => ({
        ts: r.ts,
        on: r.on,
        envelope: r.envelopeName ?? r.envelopeId,
        envelopeId: r.envelopeId,
        beforeCents: r.beforeCents,
        afterCents: r.afterCents,
        actor: r.actor,
      }));
    }

    case "reconciliation_snapshots":
      return store.listReconciliationSnapshots(userId, cap(input, 60));

    case "engine_facts":
      return { facts: ENGINE_FACTS, period: context.period, today: context.today, timezone: context.timezone };

    default:
      throw new UnknownToolError(`Unknown tool: ${name}`);
  }
}

async function envelopeNames(deps: ToolDeps): Promise<Map<string, string>> {
  const [envs, incomes] = await Promise.all([
    deps.store.listEnvelopes(deps.userId),
    deps.store.listIncomeEnvelopes(deps.userId),
  ]);
  const names = new Map<string, string>();
  for (const e of envs) names.set(e.id, e.name);
  for (const i of incomes) names.set(i.id, i.name);
  return names;
}
