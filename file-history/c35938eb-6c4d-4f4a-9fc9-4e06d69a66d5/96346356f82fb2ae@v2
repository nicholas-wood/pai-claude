/** Everything precomputed by the server for this question (needs PocketSmith; the MCP process has no key). */
export interface DiagnosticContext {
  readonly period: string;
  readonly today: string;
  readonly timezone: string;
  readonly netPosition: NetPositionResponse;
  readonly explanation: ExplainDeltaResponse | null;
}

export interface ToolDeps {
  readonly store: BudgetStore;
  readonly envelopes: EnvelopeService;
  readonly userId: UserId;
  readonly context: DiagnosticContext;
}

export interface ToolDefinition {
  readonly name: string;
  readonly description: string;
  readonly inputSchema: Record<string, unknown>;
}

