/**
 * GET /api/net-position/explain over the real app assembly: 401 unauthenticated,
 * and the honest ok:false envelope when PocketSmith cannot be reached (the test
 * secret store holds no developer key), mirroring the widget's own degradation.
 * The engine maths is covered in explain-delta.test.ts; the wiring is covered here.
 */

import { describe, test, expect } from "bun:test";
import type { ExplainDeltaResponse } from "../src/server/contract.ts";
import { makeTestApp, getJson } from "./server-test-app.ts";

describe("GET /api/net-position/explain", () => {
  test("rejects an unauthenticated request with 401", async () => {
    const t = await makeTestApp();
    const res = await getJson(t.app, "/api/net-position/explain");
    expect(res.status).toBe(401);
  });

  test("degrades to ok:false with a key-free message when PocketSmith is unreachable", async () => {
    const t = await makeTestApp();
    const cookie = await t.signIn();
    const res = await getJson(t.app, "/api/net-position/explain", cookie);
    expect(res.status).toBe(200);
    const body = (await res.json()) as ExplainDeltaResponse;
    expect(body.ok).toBe(false);
    expect(body.components).toEqual([]);
    expect(body.since).toBeNull();
    expect(typeof body.message).toBe("string");
    expect(body.message).not.toMatch(/key.*[A-Za-z0-9]{20,}/);
  });
});
