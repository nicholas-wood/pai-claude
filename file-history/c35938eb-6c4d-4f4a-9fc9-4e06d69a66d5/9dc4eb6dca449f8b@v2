/**
 * DiagnosticProvider (v1.25.0): the seam behind the in-app diagnostic chat.
 *
 * Mirrors AuthProvider and SecretStore: business code and route handlers depend
 * on this interface only. The local implementation drives the owner's own Claude
 * subscription through a `claude -p` subprocess (the PAI Inference.ts pattern);
 * cloud mode gets the Unavailable provider until an API-key adapter exists.
 *
 * Read-only by construction, enforced in three independent layers none of which
 * is a prompt instruction:
 *   1. the MCP tool process opens SQLite read-only (scripts/diagnose-mcp.ts);
 *   2. the CLI is launched with every built-in tool removed (`--tools ""`, plus an
 *      explicit disallow list) and only the penny MCP tools allowed;
 *   3. the stream's init event is checked at runtime: if ANY tool outside the
 *      penny MCP set is listed, the process is killed before the first turn.
 *
 * The consented-egress gate (security/egress.ts assertConsentedAiEgress) is the
 * caller's responsibility and is asserted again here so no future call site can
 * bypass it.
 */

import { mkdir, rm, writeFile, chmod } from "node:fs/promises";
import { existsSync } from "node:fs";
import type { UserId } from "../platform/auth.ts";
import { assertConsentedAiEgress } from "../security/egress.ts";
import { TOOL_NAMES, type DiagnosticContext } from "./tools.ts";

export const DIAGNOSTIC_MODEL = "sonnet";
export const MCP_SERVER_NAME = "penny";
/** Built-ins the CLI must not expose even if a future release re-enables one by default. */
export const DISALLOWED_BUILTINS = ["Bash", "Edit", "Write", "Read", "Glob", "Grep", "WebFetch", "WebSearch", "Agent", "NotebookEdit", "TodoWrite", "Task"];

export interface DiagnosticAsk {
  readonly userId: UserId;
  readonly question: string;
  readonly consent: boolean;
  readonly sessionId?: string;
  readonly context: DiagnosticContext;
}

export interface DiagnosticToolCall {
  readonly name: string;
  readonly input: string;
}

export interface DiagnosticResult {
  readonly ok: boolean;
  readonly answer: string;
  readonly sessionId: string | null;
  readonly toolCalls: readonly DiagnosticToolCall[];
  readonly model: string;
  readonly turns: number;
  readonly durationMs: number;
  readonly message?: string;
}

/** Audit hook: the handler writes each event to the ledger event log with actor "agent". */
export type DiagnosticAuditSink = (kind: "agent.tool_call" | "agent.answer" | "agent.refused", payload: Record<string, unknown>) => Promise<void>;

export interface DiagnosticProvider {
  readonly available: boolean;
  readonly reason?: string;
  readonly model: string;
  ask(input: DiagnosticAsk, audit: DiagnosticAuditSink): Promise<DiagnosticResult>;
}

export class UnavailableDiagnosticProvider implements DiagnosticProvider {
  readonly available = false;
  readonly model = DIAGNOSTIC_MODEL;
  constructor(readonly reason: string) {}
  async ask(input: DiagnosticAsk, audit: DiagnosticAuditSink): Promise<DiagnosticResult> {
    await audit("agent.refused", { reason: this.reason });
    return { ok: false, answer: "", sessionId: input.sessionId ?? null, toolCalls: [], model: this.model, turns: 0, durationMs: 0, message: this.reason };
  }
}

// ── stream parsing (pure, unit-tested) ────────────────────────────────────────

export interface StreamInit {
  readonly tools: readonly string[];
  readonly mcpServers: readonly { name: string; status: string }[];
  readonly sessionId: string | null;
  readonly model: string | null;
  readonly cliVersion: string | null;
}

export interface ParsedStream {
  readonly init: StreamInit | null;
  readonly toolCalls: DiagnosticToolCall[];
  readonly result: { text: string; isError: boolean; sessionId: string | null; turns: number } | null;
}

const MCP_PREFIX = `mcp__${MCP_SERVER_NAME}__`;

/** Every allowed tool name as the CLI spells it. */
export const ALLOWED_TOOL_NAMES: readonly string[] = TOOL_NAMES.map((n) => `${MCP_PREFIX}${n}`);

/** Parse one stream-json line into the parts the provider cares about. Unknown lines are ignored. */
export function parseStreamLine(line: string, acc: ParsedStream): ParsedStream {
  let o: Record<string, unknown>;
  try {
    o = JSON.parse(line) as Record<string, unknown>;
  } catch {
    return acc;
  }
  if (o.type === "system" && o.subtype === "init") {
    const servers = Array.isArray(o.mcp_servers) ? (o.mcp_servers as { name: string; status: string }[]) : [];
    return {
      ...acc,
      init: {
        tools: Array.isArray(o.tools) ? (o.tools as string[]) : [],
        mcpServers: servers,
        sessionId: typeof o.session_id === "string" ? o.session_id : null,
        model: typeof o.model === "string" ? o.model : null,
        cliVersion: typeof o.claude_code_version === "string" ? o.claude_code_version : null,
      },
    };
  }
  if (o.type === "assistant") {
    const msg = o.message as { content?: unknown } | undefined;
    const content = Array.isArray(msg?.content) ? (msg!.content as Record<string, unknown>[]) : [];
    const calls = content
      .filter((c) => c.type === "tool_use" && typeof c.name === "string")
      .map((c) => ({ name: String(c.name), input: JSON.stringify(c.input ?? {}) }));
    return calls.length > 0 ? { ...acc, toolCalls: [...acc.toolCalls, ...calls] } : acc;
  }
  if (o.type === "result") {
    return {
      ...acc,
      result: {
        text: typeof o.result === "string" ? o.result : "",
        isError: o.is_error === true,
        sessionId: typeof o.session_id === "string" ? o.session_id : null,
        turns: typeof o.num_turns === "number" ? o.num_turns : 0,
      },
    };
  }
  return acc;
}

export const EMPTY_STREAM: ParsedStream = { init: null, toolCalls: [], result: null };

/**
 * Runtime tool-list assertion. Returns null when the init event is acceptable,
 * else the reason to abort. Anything outside the penny MCP set, a penny server
 * that failed to connect, or a model outside the configured family aborts.
 */
export function initViolation(init: StreamInit, model: string = DIAGNOSTIC_MODEL): string | null {
  const foreign = init.tools.filter((t) => !t.startsWith(MCP_PREFIX));
  if (foreign.length > 0) return `unexpected tools exposed: ${foreign.join(", ")}`;
  const unknown = init.tools.filter((t) => !ALLOWED_TOOL_NAMES.includes(t));
  if (unknown.length > 0) return `unknown penny tools exposed: ${unknown.join(", ")}`;
  const penny = init.mcpServers.find((s) => s.name === MCP_SERVER_NAME);
  if (!penny || penny.status !== "connected") return "penny tool server not connected";
  if (init.model !== null && !init.model.includes(model)) return `unexpected model: ${init.model}`;
  return null;
}

// ── the system prompt ─────────────────────────────────────────────────────────

export function systemPrompt(ctx: DiagnosticContext): string {
  return [
    "You are BudgetBuddy's diagnostic assistant: a careful accountant explaining a zero-based envelope budget to its owner.",
    `Today is ${ctx.today} (${ctx.timezone}); the current budget month is ${ctx.period}. Currency is AUD; write amounts like $1,234.56.`,
    "",
    "Rules:",
    "- Every number you state must come from a tool result in this conversation. Never estimate or recompute a figure a tool already gives you.",
    "- For any question about the widget being off, unbalanced, unreconciled or a delta: call explain_delta first and quote its components, residual and signals.",
    "- Read engine_facts before asserting how balances are computed. If a fact contradicts your intuition, the fact wins.",
    "- Payees are masked (first letter plus dots). Refer to rows by date, amount and account; never guess a merchant.",
    "- You are read-only. You cannot change the budget, the ledger, or any code. When the owner should act, say exactly what to do in the app or in PocketSmith.",
    "- Say which tools you used. If the tools cannot answer, say so plainly rather than speculating.",
    "- Be concise: lead with the answer, then the figures, then what to do. Plain text only: no markdown, no bold or heading markers, no code fences; short paragraphs, and a dash list only when listing steps.",
  ].join("\n");
}

// ── the claude -p implementation ──────────────────────────────────────────────

export interface ClaudeCliOptions {
  readonly claudeBin: string;
  readonly bunBin: string;
  readonly projectDir: string;
  readonly mcpScript: string;
  readonly sqlitePath: string;
  readonly timezone: string;
  /** Engine wiring env forwarded to the tool process (PENNY_NAB_*, PENNY_HOLDING_*). */
  readonly engineEnv: Record<string, string>;
  /** Private scratch dir for the per-question context + MCP config files. */
  readonly scratchDir: string;
  readonly timeoutMs?: number;
  readonly maxTurns?: number;
}

export class ClaudeCliDiagnosticProvider implements DiagnosticProvider {
  readonly available: boolean;
  readonly reason?: string;
  readonly model = DIAGNOSTIC_MODEL;

  constructor(private readonly opts: ClaudeCliOptions) {
    if (!existsSync(opts.claudeBin)) {
      this.available = false;
      this.reason = "Claude CLI not found on this machine.";
    } else if (!existsSync(opts.mcpScript)) {
      this.available = false;
      this.reason = "Diagnostic tool server script missing.";
    } else {
      this.available = true;
    }
  }

  async ask(input: DiagnosticAsk, audit: DiagnosticAuditSink): Promise<DiagnosticResult> {
    const started = Date.now();
    // Asserted here as well as at the route: no call site may skip the gate.
    assertConsentedAiEgress({ consent: input.consent, featureEnabled: this.available });

    const runId = crypto.randomUUID();
    const dir = `${this.opts.scratchDir}/${runId}`;
    await mkdir(dir, { recursive: true, mode: 0o700 });
    const contextPath = `${dir}/context.json`;
    const mcpPath = `${dir}/mcp.json`;
    try {
      await writeFile(contextPath, JSON.stringify(input.context), { mode: 0o600 });
      const mcpConfig = {
        mcpServers: {
          [MCP_SERVER_NAME]: {
            command: this.opts.bunBin,
            args: ["run", this.opts.mcpScript],
            env: {
              HOME: process.env.HOME ?? "",
              PENNY_SQLITE_PATH: this.opts.sqlitePath,
              PENNY_TIMEZONE: this.opts.timezone,
              PENNY_DIAG_USER_ID: input.userId,
              PENNY_DIAG_CONTEXT: contextPath,
              ...this.opts.engineEnv,
            },
          },
        },
      };
      await writeFile(mcpPath, JSON.stringify(mcpConfig), { mode: 0o600 });
      await chmod(mcpPath, 0o600);

      // The question goes FIRST: the tool-list flags are variadic, so any
      // positional after them would be swallowed as a tool name.
      const args = [
        "-p", input.question,
        "--model", this.model,
        "--output-format", "stream-json",
        "--verbose",
        "--max-turns", String(this.opts.maxTurns ?? 15),
        // No user-level hooks/settings and no dynamic system-prompt sections: the
        // product must not depend on (or leak) whatever the owner's own Claude
        // Code setup injects.
        "--setting-sources", "project",
        "--exclude-dynamic-system-prompt-sections",
        "--system-prompt", systemPrompt(input.context),
        "--mcp-config", mcpPath,
        "--strict-mcp-config",
        "--allowedTools", ALLOWED_TOOL_NAMES.join(","),
        "--tools", "",
        "--disallowedTools", DISALLOWED_BUILTINS.join(","),
        ...(input.sessionId ? ["--resume", input.sessionId] : []),
      ];

      // Minimal, explicit environment: no PocketSmith key, no CLAUDECODE nesting flag.
      const env: Record<string, string> = {
        HOME: process.env.HOME ?? "",
        PATH: process.env.PATH ?? "/usr/bin:/bin",
        LANG: process.env.LANG ?? "C.UTF-8",
        TERM: "dumb",
      };

      const proc = Bun.spawn([this.opts.claudeBin, ...args], {
        cwd: this.opts.projectDir,
        env,
        stdin: "ignore",
        stdout: "pipe",
        stderr: "pipe",
      });

      const timeoutMs = this.opts.timeoutMs ?? 180_000;
      const timer = setTimeout(() => proc.kill(), timeoutMs);
      let parsed: ParsedStream = EMPTY_STREAM;
      let aborted: string | null = null;
      let seenCalls = 0;
      const reader = proc.stdout.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      try {
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          let nl: number;
          while ((nl = buffer.indexOf("\n")) >= 0) {
            const line = buffer.slice(0, nl).trim();
            buffer = buffer.slice(nl + 1);
            if (!line) continue;
            parsed = parseStreamLine(line, parsed);
            if (parsed.init && aborted === null) {
              const violation = initViolation(parsed.init, this.model);
              if (violation !== null) {
                aborted = violation;
                proc.kill();
              }
            }
            while (seenCalls < parsed.toolCalls.length) {
              const call = parsed.toolCalls[seenCalls]!;
              seenCalls += 1;
              await audit("agent.tool_call", { name: call.name, input: call.input.slice(0, 500), runId });
            }
          }
        }
      } finally {
        clearTimeout(timer);
        reader.releaseLock();
      }
      const stderrText = (await new Response(proc.stderr).text()).trim();
      await proc.exited;
      const durationMs = Date.now() - started;
      if (stderrText) console.warn(`[diagnose] claude stderr: ${stderrText.slice(0, 400)}`);

      if (aborted !== null) {
        await audit("agent.refused", { reason: aborted, runId });
        return { ok: false, answer: "", sessionId: null, toolCalls: parsed.toolCalls, model: this.model, turns: 0, durationMs, message: `Refused: ${aborted}.` };
      }
      if (!parsed.result) {
        const reason = durationMs >= timeoutMs
          ? "The assistant timed out."
          : `The assistant returned no result (exit ${proc.exitCode ?? "?"})${stderrText ? ": " + stderrText.slice(0, 200) : "."}`;
        await audit("agent.refused", { reason, runId });
        return { ok: false, answer: "", sessionId: parsed.init?.sessionId ?? null, toolCalls: parsed.toolCalls, model: this.model, turns: 0, durationMs, message: reason };
      }
      const sessionId = parsed.result.sessionId ?? parsed.init?.sessionId ?? null;
      await audit("agent.answer", {
        runId,
        sessionId,
        turns: parsed.result.turns,
        toolCalls: parsed.toolCalls.length,
        chars: parsed.result.text.length,
        durationMs,
        isError: parsed.result.isError,
        cliVersion: parsed.init?.cliVersion ?? null,
        model: parsed.init?.model ?? null,
      });
      if (parsed.result.isError) {
        return { ok: false, answer: "", sessionId, toolCalls: parsed.toolCalls, model: this.model, turns: parsed.result.turns, durationMs, message: parsed.result.text || "The assistant reported an error." };
      }
      return { ok: true, answer: parsed.result.text, sessionId, toolCalls: parsed.toolCalls, model: this.model, turns: parsed.result.turns, durationMs };
    } finally {
      await rm(dir, { recursive: true, force: true });
    }
  }
}
