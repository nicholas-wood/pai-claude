/**
 * Version DELETE ("I got it wrong" — owner request 2026-08-12): a budget
 * version can be removed outright from the chronology. With extendPrevious the
 * predecessor the deleted version had truncated reopens over the vacated
 * window; without it the window simply becomes uncovered. Months recompute
 * either way (doctrine D4) and the day-level non-overlap invariant (D1) holds.
 */

import { describe, test, expect } from "bun:test";
import type { BudgetVersionsResponse, CreateEnvelopeResponse, DeleteVersionResponse, GridResponse } from "../src/server/contract.ts";
import { currentPeriod } from "../src/platform/time.ts";
import { monthBounds } from "../src/envelope/period.ts";
import { makeTestApp, postJson, getJson, type TestApp } from "./server-test-app.ts";

const TZ = "Australia/Melbourne";
const NOW = currentPeriod(TZ);
const FIRST = monthBounds(NOW).first;

async function createEnvelope(t: TestApp, cookie: string, body: unknown): Promise<string> {
  const res = await postJson(t.app, "/api/envelopes", body, cookie);
  expect(res.status).toBe(200);
  return ((await res.json()) as CreateEnvelopeResponse).id;
}

async function versions(t: TestApp, cookie: string, id: string): Promise<BudgetVersionsResponse> {
  const res = await getJson(t.app, `/api/envelopes/versions?envelopeId=${id}`, cookie);
  expect(res.status).toBe(200);
  return (await res.json()) as BudgetVersionsResponse;
}

/** Seed a completed baseline (truncated at FIRST-1) + an active current version. */
async function seedTwoVersions(t: TestApp, cookie: string): Promise<{ id: string; baselineId: string; activeId: string }> {
  const id = await createEnvelope(t, cookie, { name: "Groceries", type: "expense", budgetedCents: 50000, period: "monthly" });
  const edit = await postJson(
    t.app,
    "/api/budget/edit",
    { lines: [{ envelopeId: id, amountCents: 60000 }], scope: "ongoing", asOf: FIRST },
    cookie,
  );
  expect(edit.status).toBe(200);
  const vs = (await versions(t, cookie, id)).versions;
  return {
    id,
    baselineId: vs.find((v) => v.amountCents === 50000)!.id,
    activeId: vs.find((v) => v.amountCents === 60000)!.id,
  };
}

describe("POST /api/envelopes/versions/delete", () => {
  test("requires auth and a real version", async () => {
    const t = await makeTestApp();
    expect((await postJson(t.app, "/api/envelopes/versions/delete", { envelopeId: "x", versionId: "y" })).status).toBe(401);
    const cookie = await t.signIn();
    expect(
      (await postJson(t.app, "/api/envelopes/versions/delete", { envelopeId: "x", versionId: "y" }, cookie)).status,
    ).toBe(404);
  });

  test("delete with extendPrevious reopens the truncated predecessor over the window", async () => {
    const t = await makeTestApp();
    const cookie = await t.signIn();
    const { id, baselineId, activeId } = await seedTwoVersions(t, cookie);

    const res = await postJson(
      t.app,
      "/api/envelopes/versions/delete",
      { envelopeId: id, versionId: activeId, extendPrevious: true },
      cookie,
    );
    expect(res.status).toBe(200);
    const body = (await res.json()) as DeleteVersionResponse;
    expect(body.ok).toBe(true);
    // The deleted version was open-ended, so the baseline reopens open-ended.
    expect(body.extendedPreviousTo).toBeNull();

    const vs = (await versions(t, cookie, id)).versions;
    expect(vs.find((v) => v.id === activeId)).toBeUndefined();
    const baseline = vs.find((v) => v.id === baselineId)!;
    expect(baseline.effectiveTo).toBeNull();
    expect(baseline.status).toBe("active");

    // The month recomputes back to the baseline amount (D4).
    const grid = (await (await getJson(t.app, "/api/envelopes", cookie)).json()) as GridResponse;
    expect(grid.rows.find((r) => r.id === id)?.allocationCents).toBe(50000);
  });

  test("delete WITHOUT extendPrevious leaves the window uncovered (month resolves to 0)", async () => {
    const t = await makeTestApp();
    const cookie = await t.signIn();
    const { id, baselineId, activeId } = await seedTwoVersions(t, cookie);

    const res = await postJson(
      t.app,
      "/api/envelopes/versions/delete",
      { envelopeId: id, versionId: activeId },
      cookie,
    );
    expect(res.status).toBe(200);
    expect(((await res.json()) as DeleteVersionResponse).extendedPreviousTo).toBeUndefined();

    const vs = (await versions(t, cookie, id)).versions;
    expect(vs.find((v) => v.id === activeId)).toBeUndefined();
    // The baseline keeps its truncated end — the current month has no budget.
    expect(vs.find((v) => v.id === baselineId)!.effectiveTo).not.toBeNull();
    const grid = (await (await getJson(t.app, "/api/envelopes", cookie)).json()) as GridResponse;
    expect(grid.rows.find((r) => r.id === id)?.allocationCents).toBe(0);
  });

  test("deleting an income version restores the predecessor's figure as the stored budget", async () => {
    const t = await makeTestApp();
    const cookie = await t.signIn();
    const incRes = await postJson(
      t.app,
      "/api/envelopes",
      { name: "Salary", type: "income", budgetedCents: 500000 },
      cookie,
    );
    expect(incRes.status).toBe(200);
    const incomeId = ((await incRes.json()) as CreateEnvelopeResponse).id;
    // Version the income: 6000 as of this month, creating a truncated baseline.
    const edit = await postJson(
      t.app,
      "/api/envelopes/edit",
      { id: incomeId, budgetedCents: 600000, asOf: FIRST },
      cookie,
    );
    expect(edit.status).toBe(200);
    const vs = (await versions(t, cookie, incomeId)).versions;
    const active = vs.find((v) => v.amountCents === 600000);
    if (!active) return; // income versioning bootstrap differs; covered by expense paths
    const del = await postJson(
      t.app,
      "/api/envelopes/versions/delete",
      { envelopeId: incomeId, versionId: active.id, extendPrevious: true },
      cookie,
    );
    expect(del.status).toBe(200);
    const grid = (await (await getJson(t.app, "/api/envelopes", cookie)).json()) as GridResponse;
    expect(grid.income.find((i) => i.id === incomeId)?.budgetedCents).toBe(500000);
  });
});

describe("movement line items (owner directive 2026-08-12)", () => {
  test("a move appears as a line item in BOTH envelopes' transaction lists", async () => {
    const t = await makeTestApp();
    const cookie = await t.signIn();
    const mk = async (name: string) => {
      const res = await postJson(t.app, "/api/envelopes", { name, type: "expense", budgetedCents: 10000 }, cookie);
      expect(res.status).toBe(200);
      return ((await res.json()) as CreateEnvelopeResponse).id;
    };
    const a = await mk("Alpha");
    const b = await mk("Beta");
    const move = await postJson(
      t.app,
      "/api/move",
      { fromEnvelopeId: a, toEnvelopeId: b, amountCents: 2500, scope: "this_month" },
      cookie,
    );
    expect(move.status).toBe(200);

    const listFor = async (envelopeId: string) => {
      const res = await getJson(t.app, `/api/transactions?envelopeId=${envelopeId}`, cookie);
      expect(res.status).toBe(200);
      return ((await res.json()) as { items: { payee: string; amountCents: number; isMovement?: boolean }[] }).items;
    };
    const aItems = await listFor(a);
    const bItems = await listFor(b);
    const out = aItems.find((i) => i.isMovement === true);
    const inn = bItems.find((i) => i.isMovement === true);
    expect(out?.payee).toBe("Moved to Beta");
    expect(out?.amountCents).toBe(-2500);
    expect(inn?.payee).toBe("Moved from Alpha");
    expect(inn?.amountCents).toBe(2500);

    // And the grid budgets are untouched while Left shifted (route-level).
    const grid = (await (await getJson(t.app, "/api/envelopes", cookie)).json()) as GridResponse;
    expect(grid.rows.find((r) => r.id === a)?.allocationCents).toBe(10000);
    expect(grid.rows.find((r) => r.id === a)?.leftCents).toBe(7500);
    expect(grid.rows.find((r) => r.id === b)?.leftCents).toBe(12500);
  });
});
