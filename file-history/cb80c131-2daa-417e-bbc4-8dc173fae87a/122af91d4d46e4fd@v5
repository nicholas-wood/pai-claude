  async writeDailySnapshot(userId: UserId, date: string): Promise<void> {
    const envelopes = await this.listEnvelopes(userId);
    await this.withTransaction(async () => {
      for (const env of envelopes) {
        const bal = await this.q<{ bal: number }>(
          `SELECT COALESCE(SUM(amount_cents), 0) AS bal
           FROM transactions
           WHERE user_id = $1 AND envelope_id = $2 AND txn_date <= $3
             AND is_pending = 0 AND is_transfer = 0`,
          [userId, env.id, date],
        );
        const balance = bal.rows[0]?.bal ?? 0;
        await this.q(
          `INSERT INTO snapshots (user_id, envelope_id, snap_date, balance_cents)
           VALUES ($1, $2, $3, $4)
           ON CONFLICT (user_id, envelope_id, snap_date) DO UPDATE SET
             balance_cents = excluded.balance_cents`,
          [userId, env.id, date, balance],
        );
      }
    });
  }

