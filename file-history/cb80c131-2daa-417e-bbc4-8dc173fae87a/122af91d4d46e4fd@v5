        userId,
        line.id,
        line.envelopeId,
        line.amountCents,
        line.period ?? "monthly",
        line.effectiveFrom ?? "1970-01-01",
        line.effectiveTo ?? null,
      ],
    );
  }

  async listBudgetHistory(userId: UserId): Promise<BudgetChange[]> {
    const res = await this.q<HistoryRow>(
      `SELECT id, ts, envelope_id, before_cents, after_cents, scope, actor
       FROM budget_history WHERE user_id = $1 ORDER BY ts DESC`,
      [userId],
    );
    return res.rows.map((r) => ({
      id: r.id,
      userId,
      ts: Number(r.ts),
      envelopeId: r.envelope_id,
      beforeCents: Number(r.before_cents),
      afterCents: Number(r.after_cents),
      scope: r.scope as ChangeScope,
      actor: r.actor as Actor,
    }));
  }

  async appendBudgetHistory(userId: UserId, change: BudgetChange): Promise<void> {
    await this.q(
      `INSERT INTO budget_history
         (user_id, id, ts, envelope_id, before_cents, after_cents, scope, actor)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`,
      [
        userId,
        change.id,
        change.ts,
        change.envelopeId,
        change.beforeCents,
        change.afterCents,
        change.scope,
        change.actor,
      ],
    );
  }

  // --- Money movements (ISC-89, ISC-90) ---

  async appendMovement(userId: UserId, m: MoneyMovement): Promise<void> {
    await this.q(
      `INSERT INTO money_movements
         (user_id, id, ts, from_envelope_id, to_envelope_id, amount_cents, scope, actor, correlation_id)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)`,
      [
        userId,
        m.id,
        m.ts,
        m.fromEnvelopeId,
        m.toEnvelopeId,
        m.amountCents,
        m.scope,
        m.actor,
        m.correlationId,
      ],
    );
  }

  async listMovements(userId: UserId): Promise<MoneyMovement[]> {
    const res = await this.q<MovementRow>(
      `SELECT id, ts, from_envelope_id, to_envelope_id, amount_cents, scope, actor, correlation_id
       FROM money_movements WHERE user_id = $1 ORDER BY ts DESC`,
      [userId],
    );
    return res.rows.map((r) => ({
      id: r.id,
      userId,
      ts: Number(r.ts),
      fromEnvelopeId: r.from_envelope_id,
      toEnvelopeId: r.to_envelope_id,
      amountCents: Number(r.amount_cents),
      scope: r.scope as ChangeScope,
      actor: r.actor as Actor,
      correlationId: r.correlation_id,
    }));
  }

  async appendReconciliation(userId: UserId, rec: ReconciliationRecord): Promise<void> {
    await this.q(
      `INSERT INTO reconciliations
         (user_id, id, ts, statement_date, holding_cents, nab_statement_cents, drift_cents, matched)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`,
      [
        userId,
        rec.id,
        rec.ts,
        rec.statementDate,
        rec.holdingCents,
        rec.nabStatementCents,
        rec.driftCents,
        rec.matched ? 1 : 0,
      ],
    );
  }

  async getLatestReconciliation(userId: UserId): Promise<ReconciliationRecord | null> {
    const res = await this.q<ReconciliationRow>(
      `SELECT id, ts, statement_date, holding_cents, nab_statement_cents, drift_cents, matched
       FROM reconciliations WHERE user_id = $1 ORDER BY ts DESC, id DESC LIMIT 1`,
      [userId],
    );
    const row = res.rows[0];
    if (!row) return null;
    return {
      id: row.id,
      ts: Number(row.ts),
      statementDate: row.statement_date,
      holdingCents: Number(row.holding_cents),
      nabStatementCents: Number(row.nab_statement_cents),
      driftCents: Number(row.drift_cents),
      matched: Number(row.matched) === 1,
    };
  }

  // --- Secret ciphertext persistence (used by the cloud KmsSecretStore) ---
  // Ciphertext only; plaintext never touches this table (ISC-56).

  async getSecretCiphertext(
    userId: UserId,
    name: string,
  ): Promise<{ ciphertext: string; wrappedKey: string } | null> {
    const res = await this.q<{ ciphertext: string; wrapped_key: string }>(
      `SELECT ciphertext, wrapped_key FROM secrets WHERE user_id = $1 AND name = $2`,
      [userId, name],
    );
    const row = res.rows[0];
    if (!row) return null;
    return { ciphertext: row.ciphertext, wrappedKey: row.wrapped_key };
  }

  async putSecretCiphertext(
    userId: UserId,
    name: string,
    rec: { ciphertext: string; wrappedKey: string },
  ): Promise<void> {
    await this.q(
      `INSERT INTO secrets (user_id, name, ciphertext, wrapped_key, updated_at)
       VALUES ($1, $2, $3, $4, $5)
       ON CONFLICT (user_id, name) DO UPDATE SET
         ciphertext = excluded.ciphertext,
         wrapped_key = excluded.wrapped_key,
         updated_at = excluded.updated_at`,
      [userId, name, rec.ciphertext, rec.wrappedKey, Date.now()],
    );
  }

  async deleteSecretCiphertext(userId: UserId, name: string): Promise<void> {
    await this.q(`DELETE FROM secrets WHERE user_id = $1 AND name = $2`, [userId, name]);
  }

  /** Adapter-internal table introspection for the store suite (Postgres dialect). */
  async listTables(): Promise<string[]> {
    const res = await this.q<{ table_name: string }>(
      `SELECT table_name FROM information_schema.tables WHERE table_schema = 'public'`,
    );
    return res.rows.map((r) => r.table_name);
  }

  async close(): Promise<void> {
    await this.pool.end();
  }
}

function toTx(r: TxRow): Tx {
  return {
    id: r.id,
    date: r.txn_date,
    amountCents: Number(r.amount_cents),
    accountId: r.account_id,
    categoryId: r.category_id,
    envelopeId: r.envelope_id,
    payee: r.payee,
    isTransfer: Number(r.is_transfer) !== 0,
    isPending: Number(r.is_pending) !== 0,
    rawJson: r.raw_json,
  };
}

function toEnvelope(r: EnvelopeRow): Envelope {
  return {
    id: r.id,
    name: r.name,
    parentId: r.parent_id,
    group: r.grp,
    rolloverRule: r.rollover_rule as Envelope["rolloverRule"],
    targetType: r.target_type as Envelope["targetType"],
    targetAmountCents: Number(r.target_amount_cents),
    type: (r.type ?? "expense") as EnvelopeType,
    active: Number(r.active) !== 0,
    archived: Number(r.archived) !== 0,
  };
}
