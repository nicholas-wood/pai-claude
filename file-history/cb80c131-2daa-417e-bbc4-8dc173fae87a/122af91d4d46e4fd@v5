  async setCategoryDismissed(userId: UserId, categoryId: string, dismissed: boolean, lastSeenDate = ""): Promise<void> {
    if (dismissed) {
      await this.q(
        `INSERT INTO dismissed_categories (user_id, category_id, dismissed_at, last_seen_date) VALUES ($1, $2, $3, $4)
         ON CONFLICT (user_id, category_id) DO UPDATE SET
           dismissed_at = excluded.dismissed_at,
           last_seen_date = excluded.last_seen_date`,
        [userId, categoryId, Date.now(), lastSeenDate],
      );
    } else {
      await this.q(`DELETE FROM dismissed_categories WHERE user_id = $1 AND category_id = $2`, [userId, categoryId]);
    }
  }

