    }));
  }

  /**
   * Upsert keyed ON CONFLICT (user_id, envelope_id, period) — same REPLACE
   * semantics as the SQLite adapter: amount/scope overwritten, the surviving
   * row keeps its original id.
   */
  async putAllocation(userId: UserId, a: Allocation): Promise<void> {
    await this.q(
      `INSERT INTO allocations (user_id, id, envelope_id, period, amount_cents, scope)
       VALUES ($1, $2, $3, $4, $5, $6)
       ON CONFLICT (user_id, envelope_id, period) DO UPDATE SET
         amount_cents = excluded.amount_cents,
         scope = excluded.scope`,
      [userId, a.id, a.envelopeId, a.period, a.amountCents, a.scope],
    );
  }

