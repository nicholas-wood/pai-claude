/**
 * Version-window planning: the single source of truth for the NON-OVERLAP
 * invariant (owner doctrine, 2026-08-12).
 *
 *   - At most ONE non-tombstone version window covers any calendar day of an
 *     envelope. Mid-month changeovers are allowed (day granularity); additive
 *     stacking (coexist-and-sum) is retired.
 *   - Writing a new version [from, to?] TRUNCATES the predecessor (a window
 *     straddling `from`) to the day before `from`.
 *   - A version starting ON OR AFTER `from` that the new window would cover is
 *     a SCHEDULED CONFLICT: it is never destroyed implicitly. The caller must
 *     carry an explicit supersede flag, in which case the line is tombstoned.
 *   - A tombstone (effectiveTo < effectiveFrom) contributes zero everywhere and
 *     is exempt from the invariant — it is the audit-preserving corpse of a
 *     superseded line (the template port has no delete).
 *
 * Pure functions over BudgetTemplate lines; no I/O.
 */

import type { BudgetTemplate } from "../domain/types.ts";
import { effectiveFromOf, effectiveToOf, previousDay } from "./versions.ts";

/** A superseded corpse: inverted window, resolves to zero, hidden from lists. */
export function isTombstone(line: BudgetTemplate): boolean {
  const to = effectiveToOf(line);
  return to !== null && to < effectiveFromOf(line);
}

/** Throws on an inverted REQUESTED window (tombstones are only ever derived). */
export function assertWindow(effectiveFrom: string, effectiveTo: string | null): void {
  if (effectiveTo !== null && effectiveTo < effectiveFrom) {
    throw new Error(`Invalid budget window: end ${effectiveTo} precedes start ${effectiveFrom}.`);
  }
}

export interface VersionWritePlan {
  /** Windows straddling the new start: truncated to the day before it. */
  readonly truncate: readonly BudgetTemplate[];
  /** ALREADY-STARTED windows inside the new window: silently superseded (a
   * backdated edit replacing this month's budget is the ordinary flow). */
  readonly supersede: readonly BudgetTemplate[];
  /** NOT-YET-STARTED (scheduled) windows inside the new window: destroying a
   * budget the user scheduled ahead requires an explicit flag. */
  readonly conflicts: readonly BudgetTemplate[];
}

/**
 * Plan the writes needed to insert [effectiveFrom, effectiveTo ?? open) for an
 * envelope while preserving the non-overlap invariant. `today` (ISO date, in
 * the ledger's timezone) splits covered windows into already-started (silently
 * replaceable) vs scheduled (explicit supersede required).
 */
export function planVersionWrite(
  lines: readonly BudgetTemplate[],
  envelopeId: string,
  effectiveFrom: string,
  effectiveTo: string | null,
  today: string,
): VersionWritePlan {
  const truncate: BudgetTemplate[] = [];
  const supersede: BudgetTemplate[] = [];
  const conflicts: BudgetTemplate[] = [];
  const newEnd = effectiveTo ?? "9999-12-31";
  for (const l of lines) {
    if (l.envelopeId !== envelopeId) continue;
    if (isTombstone(l)) continue;
    const from = effectiveFromOf(l);
    const to = effectiveToOf(l) ?? "9999-12-31";
    if (to < effectiveFrom) continue; // ended before the new window: untouched
    if (from < effectiveFrom) {
      truncate.push(l); // straddles the new start: predecessor to complete
    } else if (from <= newEnd) {
      (from > today ? conflicts : supersede).push(l);
    }
    // from > newEnd: a successor beyond the new window's end — untouched.
  }
  return { truncate, supersede, conflicts };
}

/** The truncated form of a predecessor: ends the day before the new start. */
export function truncated(line: BudgetTemplate, effectiveFrom: string): BudgetTemplate {
  return { ...line, effectiveFrom: effectiveFromOf(line), effectiveTo: previousDay(effectiveFrom) };
}

/**
 * The tombstoned form of a superseded line: window inverted so it contributes
 * zero to every month and drops out of the chronology, while the row survives
 * as the audit corpse.
 */
export function tombstoned(line: BudgetTemplate, effectiveFrom: string): BudgetTemplate {
  return { ...line, effectiveFrom: effectiveFromOf(line), effectiveTo: previousDay(effectiveFrom) };
}

/** Asserts the invariant over an envelope's live lines (used by tests and migration). */
export function findOverlaps(lines: readonly BudgetTemplate[]): Array<[BudgetTemplate, BudgetTemplate]> {
  const out: Array<[BudgetTemplate, BudgetTemplate]> = [];
  const byEnv = new Map<string, BudgetTemplate[]>();
  for (const l of lines) {
    if (isTombstone(l)) continue;
    const list = byEnv.get(l.envelopeId) ?? [];
    list.push(l);
    byEnv.set(l.envelopeId, list);
  }
  for (const list of byEnv.values()) {
    for (let i = 0; i < list.length; i++) {
      for (let j = i + 1; j < list.length; j++) {
        const a = list[i]!, b = list[j]!;
        const aFrom = effectiveFromOf(a), aTo = effectiveToOf(a) ?? "9999-12-31";
        const bFrom = effectiveFromOf(b), bTo = effectiveToOf(b) ?? "9999-12-31";
        if (aFrom <= bTo && bFrom <= aTo) out.push([a, b]);
      }
    }
  }
  return out;
}
