        </CardHeader>
        <CardContent>
          <p className="text-sm text-muted-foreground">
            Accounts appear here after the first PocketSmith sync. None synced yet.
          </p>
        </CardContent>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle>Income sources</CardTitle>
