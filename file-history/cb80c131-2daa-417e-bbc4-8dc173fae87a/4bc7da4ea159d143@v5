import * as React from "react";
import { Wallet, TrendingUp, PiggyBank, Mail, Plus, Save } from "lucide-react";
import type { EnvelopeRow } from "@contract";
import type { RolloverRule, EnvelopeType, BudgetPeriod } from "@domain";
import { call, isApiError, ApiCallError } from "@/lib/api";
import { useEnvelopeVersions, useInvalidateBudget } from "@/lib/queries";
import {
  cn,
  formatCents,
  normalisePeriods,
  displayInPeriod,
  todayIso,
  firstOfCurrentMonthIso,
  midMonthProrationNote,
  BUDGET_PERIODS,
  BUDGET_PERIOD_LABELS,
} from "@/lib/utils";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Switch } from "@/components/ui/switch";
import { Checkbox } from "@/components/ui/checkbox";
import { Select, SelectTrigger, SelectValue, SelectContent, SelectItem } from "@/components/ui/select";

/** A normalised edit target the modal can populate from a grid row or income view. */
export interface BudgetEditTarget {
  readonly id: string;
  readonly name: string;
  readonly type: EnvelopeType;
  readonly active: boolean;
  readonly parentId: string | null;
  /** Monthly-equivalent template line for expense/saving/envelope envelopes. */
  readonly monthlyCents: number;
  /** The row's own period, so editing keeps the per-row period selector (ISC-94). */
  readonly period?: BudgetPeriod;
  /** The rollover schedule anchor date (YYYY-MM-DD), seeded into the date input. */
  readonly rolloverStart?: string | null;
  /** Income budget — the expected income, which is itself the balancing figure (income only). */
  readonly targetCents: number;
  /** Income only (D5): expected receipt day of month (1..31), or null. */
  readonly expectedDay?: number | null;
}

interface Props {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  /** Expense parent candidates (existing envelopes the new one can sit under). */
  rows: readonly EnvelopeRow[];
  /** When set, the modal edits this envelope instead of creating a new one (ISC-91/94/100). */
  editTarget?: BudgetEditTarget | null;
}

const TYPE_OPTIONS: readonly { value: EnvelopeType; label: string; icon: typeof Wallet }[] = [
  { value: "income", label: "Income", icon: TrendingUp },
  { value: "expense", label: "Expense", icon: Wallet },
  { value: "saving", label: "Saving", icon: PiggyBank },
  { value: "envelope", label: "Envelope", icon: Mail },
];

function centsToInput(cents: number): string {
  return cents ? (cents / 100).toFixed(2) : "";
}

/**
 * Add / Edit budget modal (ISC-87, ISC-91, ISC-92, ISC-94, ISC-100).
 *
 * A four-way type toggle picks Income, Expense, Saving, or Envelope (ISC-91).
 * Saving and Envelope render like an expense (they just group differently
 * downstream). For income the field is the expected income, which is itself the
 * zero-base balancing figure (no separate capital sub-pool). For the spending
 * types the user enters a price in a chosen period and the modal live-normalises
 * it into all four periods as they type, mirroring Nick's spreadsheet. Type and
 * parent/category are editable on an existing envelope, not only at creation. An
 * Active toggle excludes an envelope from the budget total without deleting it.
 * Posts to POST /api/envelopes (create) or POST /api/envelopes/edit (edit).
 */
export function AddBudgetModal({ open, onOpenChange, rows, editTarget }: Props) {
  const invalidateBudget = useInvalidateBudget();
  const isEdit = Boolean(editTarget);
  // Edit mode: the chronology, so the window fields seed from the ACTIVE
  // version's REAL dates (owner correction 2026-08-12) — only the add-new flow
  // defaults to the first of the month.
  const versionsQuery = useEnvelopeVersions(editTarget?.id ?? "", { enabled: open && isEdit });
  const activeVersion = React.useMemo(() => {
    const data = versionsQuery.data;
    if (!data || isApiError(data) || !Array.isArray((data as { versions?: unknown }).versions)) return null;
    return data.versions.find((v) => v.status === "active") ?? null;
  }, [versionsQuery.data]);

  const [type, setType] = React.useState<EnvelopeType>("expense");
  const [name, setName] = React.useState("");
  const [parentId, setParentId] = React.useState<string>("__top__");
  const [rolloverRule, setRolloverRule] = React.useState<RolloverRule>("roll_carry");
  const [active, setActive] = React.useState(true);
  // Expense / saving: price entered in a chosen period.
  const [price, setPrice] = React.useState("");
  const [period, setPeriod] = React.useState<BudgetPeriod>("monthly");
  // The rollover schedule anchor: a new budget resets at its interval from this date,
  // and editing it re-anchors the schedule (and so the running balances + Left).
  const [rolloverStart, setRolloverStart] = React.useState<string>("");
  // Income: the expected income (the budget), which is itself the balancing figure.
  const [target, setTarget] = React.useState("");
  // D5: the day of month the income is EXPECTED to land; the month's budget
  // becomes due on that day (blank = due from day 1).
  const [expectedDay, setExpectedDay] = React.useState("");
  // Budget chronology (Feature A): the version's effective window and whether
  // the previous version is completed. Default From = first of the CURRENT
  // month; move it forward to schedule the change (e.g. income as of 1 Aug).
  const [effectiveFrom, setEffectiveFrom] = React.useState<string>(firstOfCurrentMonthIso());
  const [effectiveTo, setEffectiveTo] = React.useState<string>("");
  // 409 scheduled_conflict: the save would cover a future-scheduled budget;
  // replacing it requires this explicit retry (doctrine D3).
  const [scheduledConflict, setScheduledConflict] = React.useState<string | null>(null);
  const [busy, setBusy] = React.useState(false);
  const [error, setError] = React.useState<string | null>(null);

  // Reset the form whenever the modal opens, seeding from the edit target if any.
  React.useEffect(() => {
    if (!open) return;
    setError(null);
    setBusy(false);
    if (editTarget) {
      setType(editTarget.type);
      setName(editTarget.name);
      setParentId(editTarget.parentId ?? "__top__");
      setActive(editTarget.active);
      setRolloverRule("roll_carry");
      // Keep the row's own period (ISC-94): seed both the selector and the price
      // converted out of its stored monthly equivalent into that period.
      {
        const rowPeriod = editTarget.period ?? "monthly";
        setPeriod(rowPeriod);
        setPrice(centsToInput(displayInPeriod(editTarget.monthlyCents, rowPeriod)));
      }
      setRolloverStart(editTarget.rolloverStart ?? "");
      setTarget(centsToInput(editTarget.targetCents));
      setExpectedDay(editTarget.expectedDay != null ? String(editTarget.expectedDay) : "");
      // Seeded from the active version once the chronology loads (below); a
      // legacy open-since-forever budget stays blank (= change from this month
      // on save, preserving history) rather than showing 1970.
      setEffectiveFrom("");
      setEffectiveTo("");
      setScheduledConflict(null);
      seededWindowRef.current = false;
    } else {
      setType("expense");
      setName("");
      setParentId("__top__");
      setActive(true);
      setRolloverRule("roll_carry");
      setPeriod("monthly");
      setPrice("");
      setRolloverStart(todayIso());
      setTarget("");
      setExpectedDay("");
      setEffectiveFrom(firstOfCurrentMonthIso());
      setEffectiveTo("");
      setScheduledConflict(null);
    }
  }, [open, editTarget]);

  // Seed the window fields from the ACTIVE version exactly once per open —
  // the async chronology must never clobber dates the user already touched.
  const seededWindowRef = React.useRef(false);
  React.useEffect(() => {
    if (!open || !isEdit || seededWindowRef.current || activeVersion === null) return;
    seededWindowRef.current = true;
    if (activeVersion.effectiveFrom !== "1970-01-01") setEffectiveFrom(activeVersion.effectiveFrom);
    setEffectiveTo(activeVersion.effectiveTo ?? "");
  }, [open, isEdit, activeVersion]);

  const dollarsToCents = (v: string) => Math.round((parseFloat(v) || 0) * 100);
  const priceCents = dollarsToCents(price);
  const targetCents = dollarsToCents(target);

  // Live normalisation across all four periods (expense/saving only).
  const normalised = React.useMemo(() => normalisePeriods(priceCents, period), [priceCents, period]);

  const isIncome = type === "income";
  const canSubmit = name.trim().length > 0 && !busy;
  // Mid-month From: the first month is prorated by days (owner decision 2026-07-16).
  const prorationNote = midMonthProrationNote(effectiveFrom);

  const onSubmit = async (supersede = false) => {
    if (!canSubmit) return;
    setBusy(true);
    setError(null);
    setScheduledConflict(null);
    try {
      if (isEdit && editTarget) {
        // Persist the rollover schedule first (anchor date + interval). This is the
        // owned path for the editable rollover date; recomputes balances and Left.
        if (rolloverStart) {
          const rr = await call("POST /api/envelopes/rollover", {
            envelopeId: editTarget.id,
            rolloverStart,
            ...(isIncome ? {} : { period }),
          });
          if (isApiError(rr)) {
            setError(rr.error);
            return;
          }
        }
        // Budget chronology: the amount change lands as a new effective-dated
        // version; completePrevious ends the current one the day before.
        const res = await call("POST /api/envelopes/edit", {
          id: editTarget.id,
          name: name.trim(),
          type,
          active,
          parentId: isIncome ? null : parentId !== "__top__" ? parentId : null,
          ...(isIncome
            ? {
                targetCents,
                budgetedCents: targetCents,
                // D5: send the expected day when set; send explicit null only
                // when the opener KNEW the current value (so blanking clears
                // it deliberately). Openers that don't carry the field (e.g.
                // the detail page) omit it and the server keeps what's stored.
                ...(expectedDay
                  ? { expectedDay: Math.min(31, Math.max(1, Number(expectedDay))) }
                  : editTarget?.expectedDay != null
                    ? { expectedDay: null }
                    : {}),
              }
            : { budgetedCents: priceCents, period }),
          // A cleared date input yields "" which the strict date schema 400s —
          // omit it and the server defaults to the first of the current month.
          ...(effectiveFrom ? { effectiveFrom } : {}),
          ...(effectiveTo ? { effectiveTo } : {}),
          ...(supersede ? { supersedeScheduled: true } : {}),
        });
        if (isApiError(res)) {
          setError(res.error);
          return;
        }
      } else {
        const res = await call("POST /api/envelopes", {
          name: name.trim(),
          type,
          active,
          ...(isIncome
            ? {
                parentId: null,
                targetCents,
                budgetedCents: targetCents,
              }
            : {
                parentId: parentId !== "__top__" ? parentId : null,
                rolloverRule,
                budgetedCents: priceCents,
                period,
                ...(rolloverStart ? { rolloverStart } : {}),
                // A new envelope's first budget version starts here ("" omitted).
                ...(effectiveFrom ? { effectiveFrom } : {}),
                ...(effectiveTo ? { effectiveTo } : {}),
              }),
        });
        if (isApiError(res)) {
          setError(res.error);
          return;
        }
      }
      invalidateBudget();
      onOpenChange(false);
    } catch (e) {
      // Surface the server's ACTUAL message (call() throws ApiCallError with the
      // ApiError body's text on any non-2xx) so a rejected create — e.g. a stale
      // deploy refusing a valid envelope type — is diagnosable from the UI.
      if (e instanceof ApiCallError && e.code === "scheduled_conflict") {
        setScheduledConflict(e.message);
      } else {
        setError(e instanceof ApiCallError || e instanceof Error ? e.message : "Could not save the envelope.");
      }
    } finally {
      setBusy(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>{isEdit ? "Edit budget" : "Add budget"}</DialogTitle>
          <DialogDescription>
            Choose whether this is income you expect, an expense you spend, or money you set aside as savings.
          </DialogDescription>
        </DialogHeader>

        {/* Four-way type toggle: Income / Expense / Saving / Envelope (ISC-91) */}
        <div className="space-y-2">
          <Label>Type</Label>
          <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
            {TYPE_OPTIONS.map(({ value, label, icon: Icon }) => (
              <button
                key={value}
                type="button"
                onClick={() => setType(value)}
                className={cn(
                  "flex items-center justify-center gap-1.5 rounded-md border px-2 py-2 text-sm font-medium transition-colors",
                  type === value ? "border-primary bg-primary text-primary-foreground" : "hover:bg-accent"
                )}
              >
                <Icon className="h-4 w-4" /> {label}
              </button>
            ))}
          </div>
          {(type === "saving" || type === "envelope") && (
            <p className="text-xs text-muted-foreground">
              {type === "saving" ? "Savings are" : "Envelopes are"} budgeted out just like an expense.
            </p>
          )}
        </div>

        <div className="space-y-2">
          <Label htmlFor="env-name">Name</Label>
          <Input
            id="env-name"
            placeholder={isIncome ? "e.g. Salary — Primary" : type === "saving" ? "e.g. Holiday Fund" : "e.g. Groceries"}
            value={name}
            onChange={(e) => setName(e.target.value)}
          />
        </div>

        {/* Parent / category applies to the spending types; income is first-class.
            Editable on an existing envelope, not only at creation (ISC-91). */}
        {!isIncome && (
          <div className="space-y-2">
            <Label>Parent / category</Label>
            <Select value={parentId} onValueChange={setParentId}>
              <SelectTrigger>
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="__top__">Top level (no parent)</SelectItem>
                {rows
                  .filter((r) => r.id !== editTarget?.id)
                  .map((r) => (
                    <SelectItem key={r.id} value={r.id}>
                      {r.name}
                    </SelectItem>
                  ))}
              </SelectContent>
            </Select>
          </div>
        )}

        {isIncome ? (
          /* Income field: the expected income budget, itself the balancing figure (ISC-92) */
          <div className="space-y-2">
            <Label htmlFor="income-target">Expected income — budget (AUD)</Label>
            <Input
              id="income-target"
              type="number"
              min="0"
              step="0.01"
              inputMode="decimal"
              placeholder="0.00"
              value={target}
              onChange={(e) => setTarget(e.target.value)}
            />
            <p className="text-xs text-muted-foreground">
              The expected income for this source. It is the figure the zero-base balances against.
            </p>
            <div className="space-y-1">
              <Label htmlFor="income-expected-day">Expected on day of month (optional)</Label>
              <Input
                id="income-expected-day"
                type="number"
                min="1"
                max="31"
                inputMode="numeric"
                placeholder="e.g. 11"
                value={expectedDay}
                onChange={(e) => setExpectedDay(e.target.value)}
              />
              <p className="text-xs text-muted-foreground">
                Until this day the envelope reads carryover + received; from this day the month's income is
                due, so a missing payment shows as a deficit. Blank = due from day 1.
              </p>
            </div>
          </div>
        ) : (
          /* Expense / saving: price + period with live four-period normalisation (ISC-94) */
          <div className="space-y-3">
            <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div className="space-y-2">
                <Label htmlFor="env-price">Price (AUD)</Label>
                <Input
                  id="env-price"
                  type="number"
                  min="0"
                  step="0.01"
                  inputMode="decimal"
                  placeholder="0.00"
                  value={price}
                  onChange={(e) => setPrice(e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label>Period</Label>
                <Select value={period} onValueChange={(v) => setPeriod(v as BudgetPeriod)}>
                  <SelectTrigger>
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent>
                    {BUDGET_PERIODS.map((p) => (
                      <SelectItem key={p} value={p}>
                        {BUDGET_PERIOD_LABELS[p]}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
            </div>
            {/* Live equivalents in all four periods, recomputed as the user types. */}
            <div className="grid grid-cols-4 gap-2 rounded-md border bg-muted/40 p-2 text-center">
              {BUDGET_PERIODS.map((p) => (
                <div key={p} className={cn("rounded px-1 py-1", p === period && "bg-primary/10")}>
                  <div className="text-[10px] uppercase tracking-wide text-muted-foreground">
                    {BUDGET_PERIOD_LABELS[p]}
                  </div>
                  <div className="tnum text-sm font-medium">{formatCents(normalised[p])}</div>
                </div>
              ))}
            </div>
            {/* Rollover start date: the budget resets at the chosen interval from here. */}
            <div className="space-y-2">
              <Label htmlFor="env-rollover">Rollover start date</Label>
              <Input
                id="env-rollover"
                type="date"
                max={todayIso()}
                value={rolloverStart}
                onChange={(e) => setRolloverStart(e.target.value)}
              />
              <p className="text-xs text-muted-foreground">
                The budget resets at the chosen interval from this date (e.g. 1 July for an annual budget).
              </p>
            </div>
          </div>
        )}

        {/* Budget chronology (Feature A): when this budget version applies. The
            default From (first of the current month) matches today's edit
            semantics; a future From schedules the change (e.g. 1 Aug). Hidden
            when CREATING an income — a brand-new income has no version window,
            its chronology starts on the first edit. */}
        {!(isIncome && !isEdit) && (
        <div className="space-y-2">
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div className="space-y-2">
              <Label htmlFor="budget-from">Budget from</Label>
              <Input
                id="budget-from"
                type="date"
                value={effectiveFrom}
                onChange={(e) => setEffectiveFrom(e.target.value)}
              />
            </div>
            <div className="space-y-2">
              <Label htmlFor="budget-to">Budget until (optional)</Label>
              <Input
                id="budget-to"
                type="date"
                min={effectiveFrom}
                value={effectiveTo}
                onChange={(e) => setEffectiveTo(e.target.value)}
              />
            </div>
          </div>
          {prorationNote && <p className="text-xs text-muted-foreground">{prorationNote}</p>}
          {isEdit && activeVersion !== null && (
            <p className="text-xs text-muted-foreground">
              Currently effective{" "}
              {activeVersion.effectiveFrom === "1970-01-01" ? "since the start" : `from ${activeVersion.effectiveFrom}`}
              {activeVersion.effectiveTo ? ` until ${activeVersion.effectiveTo}` : " — ongoing"}.
              {activeVersion.effectiveFrom === "1970-01-01" &&
                " A blank From applies the change from the first of this month, keeping earlier months as they were."}
            </p>
          )}
          <p className="text-xs text-muted-foreground">
            The previous budget ends the day before this one starts — budgets never overlap. A budget
            scheduled for a future date is never replaced without asking.
          </p>
        </div>
        )}

        {/* Rollover rule applies to expense/saving only. */}
        {!isIncome && !isEdit && (
          <div className="space-y-2">
            <Label>Rollover rule</Label>
            <Select value={rolloverRule} onValueChange={(v) => setRolloverRule(v as RolloverRule)}>
              <SelectTrigger>
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="roll_carry">Roll carry</SelectItem>
                <SelectItem value="drain_to_zero">Use or lose</SelectItem>
                <SelectItem value="annual_reset">Annual reset</SelectItem>
              </SelectContent>
            </Select>
          </div>
        )}

        {/* Active toggle (ISC-100): inactive envelopes are excluded from the budget total. */}
        <div className="flex items-center justify-between rounded-md border px-3 py-2">
          <div>
            <Label className="cursor-pointer">Active</Label>
            <p className="text-xs text-muted-foreground">Inactive envelopes are kept but excluded from the budget.</p>
          </div>
          <Switch checked={active} onCheckedChange={setActive} />
        </div>

        {error && <p className="text-sm text-destructive">{error}</p>}
        {scheduledConflict && (
          <div className="space-y-2 rounded-lg border border-warning/40 bg-warning/10 px-3 py-2 text-sm">
            <p className="font-medium">{scheduledConflict}</p>
            <Button variant="outline" size="sm" disabled={busy} onClick={() => void onSubmit(true)}>
              Replace scheduled budgets and save
            </Button>
          </div>
        )}

        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)}>
            Cancel
          </Button>
          <Button onClick={() => void onSubmit()} disabled={!canSubmit}>
            {isEdit ? <Save className="h-4 w-4" /> : <Plus className="h-4 w-4" />}{" "}
            {busy ? "Saving…" : isEdit ? "Save changes" : "Add budget"}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
