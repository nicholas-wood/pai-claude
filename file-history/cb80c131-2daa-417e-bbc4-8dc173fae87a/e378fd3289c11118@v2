import * as React from "react";
import { Pencil } from "lucide-react";
import type { BudgetVersionView, NeighbourAdjustment } from "@contract";
import { call, isApiError, ApiCallError } from "@/lib/api";
import { useEnvelopeVersions, useInvalidateBudget } from "@/lib/queries";
import { cn, formatCents, BUDGET_PERIOD_LABELS } from "@/lib/utils";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";

/**
 * Budget chronology for one envelope (Phase 3): every effective-dated version
 * — completed, active, scheduled — most recent first, with date range, amount,
 * cadence, and a status chip. With `editable`, each real version opens an
 * inline editor (amount + window). Window edits that touch the neighbours come
 * back as a 409 with SUGGESTED adjustments ("end the previous budget on X so
 * they line up") and the user confirms or declines the optional ones — the
 * owner's prompt-on-save flow (2026-08-12). Data is the real versions
 * endpoint, never invented (ISC-83).
 */

const STATUS_STYLE: Record<BudgetVersionView["status"], string> = {
  active: "border-success/40 bg-success/10 text-success",
  scheduled: "border-warning/40 bg-warning/10 text-warning",
  completed: "border-border bg-muted text-muted-foreground",
};

function rangeLabel(v: BudgetVersionView): string {
  const from = v.effectiveFrom === "1970-01-01" ? "Start" : v.effectiveFrom;
  return v.effectiveTo === null ? `${from} → ongoing` : `${from} → ${v.effectiveTo}`;
}

/** The legacy synthetic income row (no stored versions yet) cannot be edited in place. */
const isSynthetic = (v: BudgetVersionView): boolean => v.id.endsWith(":current");

function VersionEditor({ envelopeId, version, onClose }: { envelopeId: string; version: BudgetVersionView; onClose: () => void }) {
  const invalidateBudget = useInvalidateBudget();
  const [amount, setAmount] = React.useState((version.amountCents / 100).toFixed(2));
  const [from, setFrom] = React.useState(version.effectiveFrom === "1970-01-01" ? "" : version.effectiveFrom);
  const [to, setTo] = React.useState(version.effectiveTo ?? "");
  const [busy, setBusy] = React.useState(false);
  const [error, setError] = React.useState<string | null>(null);
  const [adjustments, setAdjustments] = React.useState<readonly NeighbourAdjustment[] | null>(null);

  const save = async (accept?: boolean) => {
    setBusy(true);
    setError(null);
    try {
      const res = await call("POST /api/envelopes/versions/edit", {
        envelopeId,
        versionId: version.id,
        amountCents: Math.round((parseFloat(amount) || 0) * 100),
        ...(from ? { effectiveFrom: from } : {}),
        effectiveTo: to ? to : null,
        ...(accept !== undefined ? { acceptAdjustments: accept } : {}),
      });
      if (isApiError(res)) {
        if (res.code === "neighbour_adjustments" && res.adjustments) setAdjustments(res.adjustments);
        else setError(res.error);
        return;
      }
      invalidateBudget();
      onClose();
    } catch (e) {
      if (e instanceof ApiCallError && e.code === "neighbour_adjustments") {
        // The suggestions travel in the error body; surface the message and
        // let the user decide (details are in the note text).
        setAdjustments([]);
        setError(e.message);
      } else {
        setError(e instanceof Error ? e.message : "Could not save the budget version.");
      }
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="space-y-2 border-t bg-card px-4 py-3 text-xs">
      <div className="grid grid-cols-1 gap-2 sm:grid-cols-3">
        <label className="space-y-1">
          <span className="text-muted-foreground">Amount ($/mo)</span>
          <Input type="number" min="0" step="0.01" className="h-8" value={amount} onChange={(e) => setAmount(e.target.value)} />
        </label>
        <label className="space-y-1">
          <span className="text-muted-foreground">Starts</span>
          <Input type="date" className="h-8" value={from} onChange={(e) => setFrom(e.target.value)} />
        </label>
        <label className="space-y-1">
          <span className="text-muted-foreground">Ends (blank = ongoing)</span>
          <Input type="date" className="h-8" value={to} min={from || undefined} onChange={(e) => setTo(e.target.value)} />
        </label>
      </div>
      {adjustments !== null && (
        <div className="space-y-2 rounded-md border border-warning/40 bg-warning/10 px-3 py-2">
          {adjustments.length > 0 ? (
            <ul className="list-disc space-y-1 pl-4">
              {adjustments.map((a, i) => (
                <li key={i}>
                  {a.note} {a.required ? <span className="font-medium">(required)</span> : <span>(suggested)</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p>{error}</p>
          )}
          <div className="flex gap-2">
            <Button size="sm" variant="outline" disabled={busy} onClick={() => void save(true)}>
              Apply suggested updates
            </Button>
            <Button size="sm" variant="ghost" disabled={busy} onClick={() => void save(false)}>
              Save without optional updates
            </Button>
          </div>
        </div>
      )}
      {error && adjustments === null && <p className="text-destructive">{error}</p>}
      <div className="flex gap-2">
        <Button size="sm" disabled={busy} onClick={() => void save()}>
          {busy ? "Saving…" : "Save version"}
        </Button>
        <Button size="sm" variant="ghost" disabled={busy} onClick={onClose}>
          Cancel
        </Button>
      </div>
    </div>
  );
}

export function VersionChronology({ envelopeId, editable = false }: { envelopeId: string; editable?: boolean }) {
  const query = useEnvelopeVersions(envelopeId);
  const data = query.data && !isApiError(query.data) ? query.data : null;
  const [editing, setEditing] = React.useState<string | null>(null);

  if (query.isLoading) {
    return (
      <div className="px-4 py-3 text-xs text-muted-foreground animate-pulse">Loading budget history…</div>
    );
  }
  if (query.isError || (query.data && isApiError(query.data))) {
    return <div className="px-4 py-3 text-xs text-destructive">Could not load the budget history.</div>;
  }
  const versions = data?.versions ?? [];
  if (versions.length === 0) {
    return <div className="px-4 py-3 text-xs text-muted-foreground">No budget versions yet.</div>;
  }

  return (
    <ol className="divide-y divide-border/40 border-t bg-muted/20" aria-label="Budget version chronology">
      {versions.map((v) => (
        <li key={v.id}>
          <div className="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 text-xs">
            <span className="tnum min-w-0 text-muted-foreground">{rangeLabel(v)}</span>
            <span className="tnum font-medium">{formatCents(v.amountCents)}/mo</span>
            <span className="text-muted-foreground">{BUDGET_PERIOD_LABELS[v.period]}</span>
            <Badge variant="outline" className={cn("ml-auto px-1.5 py-0 text-[10px] capitalize", STATUS_STYLE[v.status])}>
              {v.status}
            </Badge>
            {editable && !isSynthetic(v) && (
              <button
                onClick={() => setEditing(editing === v.id ? null : v.id)}
                aria-label={`Edit version ${rangeLabel(v)}`}
                className="rounded p-1 text-muted-foreground hover:bg-accent"
              >
                <Pencil className="h-3.5 w-3.5" />
              </button>
            )}
          </div>
          {editing === v.id && <VersionEditor envelopeId={envelopeId} version={v} onClose={() => setEditing(null)} />}
        </li>
      ))}
    </ol>
  );
}
