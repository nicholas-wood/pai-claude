/**
 * Roll-forward carryover + bucket-to-bucket moves (owner directives 2026-08-12):
 *
 *   1. "The left value should always be how much is left in the envelope — it
 *      should roll over." A stored baseline is the OPENING carryover of its
 *      capture month (carryoverAnchor); the grid folds budget + activity +
 *      movements forward from there, so a July charge draws August's carryover
 *      down (the Rental Bond case: 1170 baseline, −1080 July charge, August
 *      shows 90 — never a frozen 1170).
 *
 *   2. "Move money should move money bucket to bucket ... it should not touch
 *      the budgets ... the moved money should be in spent." A move is a
 *      movement row folded into activity: Left shifts on both sides, Spent
 *      (total − left) includes it, allocations and the template never change.
 */

import { describe, test, expect } from "bun:test";
import { MemoryStore } from "./penny-memory-store.ts";
import { EnvelopeService } from "../src/envelope/service.ts";
import { BudgetService } from "../src/budget/service.ts";
import { env, tx, USER, CONFIG } from "./penny-fixtures.ts";

const pad2 = (n: number) => String(n).padStart(2, "0");
const TODAY = new Date().toISOString().slice(0, 10);
const CUR_Y = Number(TODAY.slice(0, 4));
const CUR_M = Number(TODAY.slice(5, 7));
const CUR = { year: CUR_Y, month: CUR_M };
const monthShift = (p: { year: number; month: number }, delta: number) => {
  const idx = p.year * 12 + (p.month - 1) + delta;
  return { year: Math.floor(idx / 12), month: (idx % 12) + 1 };
};
const PREV = monthShift(CUR, -1);
const PREV2 = monthShift(CUR, -2);
const dayOf = (p: { year: number; month: number }, d: number) => `${p.year}-${pad2(p.month)}-${pad2(d)}`;

describe("roll-forward carryover (the Rental Bond case)", () => {
  test("a charge after the baseline capture draws the NEXT month's carryover down", async () => {
    const store = new MemoryStore();
    const envSvc = new EnvelopeService(store, CONFIG);

    // No budget lines at all: a pure rollover pot, like Rental Bond.
    await store.upsertEnvelope(USER, env("bond", { name: "Rental Bond", type: "saving" }));
    // Baseline $1,170 captured two months ago (opening of that month).
    await store.setEnvelopeCarryover(USER, "bond", 117000, dayOf(PREV2, 1));
    // The charge lands the following month (our "July").
    await store.upsertTransactions(USER, [
      tx({ id: "bond-out", date: dayOf(PREV, 15), amountCents: -108000, envelopeId: "bond" }),
    ]);

    const grid = await envSvc.getGrid(USER, CUR);
    const row = grid.rows.find((r) => r.id === "bond")!;
    expect(row.carryoverCents).toBe(9000); // 1170 − 1080 = 90, rolled forward
    expect(row.leftCents).toBe(9000);
  });

  test("unspent budget rolls forward into the next month's carryover", async () => {
    const store = new MemoryStore();
    const envSvc = new EnvelopeService(store, CONFIG);
    const budget = new BudgetService(store, envSvc);

    await store.upsertEnvelope(USER, env("fuel", { name: "Fuel", type: "expense" }));
    await store.putTemplateLine(USER, { id: "bt-fuel", userId: USER, envelopeId: "fuel", amountCents: 20000, period: "monthly" });
    await store.setEnvelopeCarryover(USER, "fuel", 0, dayOf(PREV, 1));
    // Spend only $50 of last month's $200.
    await store.upsertTransactions(USER, [
      tx({ id: "fuel-1", date: dayOf(PREV, 10), amountCents: -5000, envelopeId: "fuel" }),
    ]);
    await budget.ensureMonth(USER, PREV);
    await budget.ensureMonth(USER, CUR);

    const grid = await envSvc.getGrid(USER, CUR);
    const row = grid.rows.find((r) => r.id === "fuel")!;
    expect(row.carryoverCents).toBe(15000); // 200 − 50 rolled in
    expect(row.leftCents).toBe(35000); // + this month's 200
  });
});

describe("bucket-to-bucket moves (never budgets)", () => {
  async function seedTwo() {
    const store = new MemoryStore();
    const envSvc = new EnvelopeService(store, CONFIG);
    const budget = new BudgetService(store, envSvc);
    await store.upsertEnvelope(USER, env("A", { name: "A", type: "expense" }));
    await store.upsertEnvelope(USER, env("B", { name: "B", type: "expense" }));
    await store.putTemplateLine(USER, { id: "ta", userId: USER, envelopeId: "A", amountCents: 10000, period: "monthly" });
    await store.putTemplateLine(USER, { id: "tb", userId: USER, envelopeId: "B", amountCents: 10000, period: "monthly" });
    await budget.ensureMonth(USER, CUR);
    return { store, envSvc, budget };
  }

  test("Left shifts on both sides; Spent includes the moved money; budgets untouched", async () => {
    const { store, envSvc, budget } = await seedTwo();
    const res = await budget.moveMoney(USER, CUR, {
      fromEnvelopeId: "A",
      toEnvelopeId: "B",
      amountCents: 3000,
      scope: "this_month",
    });
    expect(res.fromLeftCents).toBe(7000);
    expect(res.toLeftCents).toBe(13000);

    const grid = await envSvc.getGrid(USER, CUR);
    const a = grid.rows.find((r) => r.id === "A")!;
    const b = grid.rows.find((r) => r.id === "B")!;
    // Budgets (allocations) unchanged — the move is money, not plan.
    expect(a.allocationCents).toBe(10000);
    expect(b.allocationCents).toBe(10000);
    expect(a.leftCents).toBe(7000);
    expect(b.leftCents).toBe(13000);
    // Spent = total − left: the moved money IS in spent on the source side.
    expect(a.totalCents - a.leftCents).toBe(3000);
    expect(b.totalCents - b.leftCents).toBe(-3000);
  });

  test("a move rolls forward: next month's carryover reflects it", async () => {
    const store = new MemoryStore();
    const envSvc = new EnvelopeService(store, CONFIG);
    const budget = new BudgetService(store, envSvc);
    await store.upsertEnvelope(USER, env("A", { name: "A", type: "expense" }));
    await store.upsertEnvelope(USER, env("B", { name: "B", type: "expense" }));
    // Anchor both last month so the fold spans the move month into now.
    await store.setEnvelopeCarryover(USER, "A", 5000, dayOf(PREV, 1));
    await store.setEnvelopeCarryover(USER, "B", 0, dayOf(PREV, 1));
    // A movement that happened NOW folds into the current month; carryover
    // pre-fold covers the prior month only, so assert via current Left.
    await budget.moveMoney(USER, CUR, { fromEnvelopeId: "A", toEnvelopeId: "B", amountCents: 2000, scope: "this_month" });
    const grid = await envSvc.getGrid(USER, CUR);
    expect(grid.rows.find((r) => r.id === "A")!.leftCents).toBe(3000);
    expect(grid.rows.find((r) => r.id === "B")!.leftCents).toBe(2000);
  });
});
