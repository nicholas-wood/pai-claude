/**
 * The "new categories detected" surface on the budget page: a dismissible card
 * that lists PocketSmith categories present on transactions but not in the budget
 * yet. It renders when GET /api/categories/unmapped returns categories and is
 * absent when the list is empty. Distinct copy from the uncategorised (no-category)
 * line, so the two related-but-different surfaces never read the same.
 */
import * as React from "react";
import { describe, it, expect, mock, beforeEach } from "bun:test";
import { render, screen, waitFor } from "@testing-library/react";
import { MemoryRouter } from "react-router-dom";
import type { GridResponse, UnmappedCategory } from "@contract";
import * as realApi from "@/lib/api";
import { TestQueryProvider } from "@/test/utils";

const grid: GridResponse = {
  period: "2026-07",
  from: "2026-07-01",
  to: "2026-07-31",
  rows: [],
  income: [],
  isSetUp: true,
  budgetedIncomeCents: 0,
  unallocatedCents: 0,
  zeroBasedAlert: false,
  capitalProvidedCents: 0,
  budgetedOutCents: 0,
  residualCents: 0,
  uncategorisedCount: 0,
  uncategorisedTotalCents: 0,
  asOf: Date.now(),
};

let unmappedCategories: UnmappedCategory[] = [];

const call = mock(async (path: string) => {
  if (path === "GET /api/envelopes") return grid;
  if (path === "GET /api/categories/unmapped") return { categories: unmappedCategories };
  if (path === "GET /api/net-position") {
    return {
      ok: true,
      cashOnHandCents: 0,
      cardOwedCents: 0,
      totalLeftCents: 0,
      reconciledDeltaCents: 0,
      sectionLeftCents: { income: 0, saving: 0, expense: 0, envelope: 0, working: 0 },
    };
  }
  if (path === "GET /api/carryover/history") return { entries: [] };
  if (path === "GET /api/envelopes/archived") return { envelopes: [] };
  return {};
});
mock.module("@/lib/api", () => ({ ...realApi, call }));
// Keep the lazy recharts chunk out of the test — the card lives above the charts.
mock.module("@/components/charts/BudgetCharts", () => ({
  WhereTheMoneyGoes: () => null,
  OverUnderLeft: () => null,
}));

const { BudgetPage } = await import("@/pages/BudgetPage");

function renderPage() {
  return render(
    <TestQueryProvider>
      <MemoryRouter>
        <BudgetPage />
      </MemoryRouter>
    </TestQueryProvider>
  );
}

beforeEach(() => {
  unmappedCategories = [];
});

describe("BudgetPage — new categories detected card", () => {
  it("renders the card with each category when the hook returns some", async () => {
    unmappedCategories = [
      { categoryId: "cat-gym", categoryName: "Gym", transactionCount: 3, totalCents: -15000, lastSeenDate: "2026-07-10" },
    ];
    renderPage();
    await waitFor(() =>
      expect(screen.getByText(/PocketSmith categor.* in your budget yet/)).toBeInTheDocument()
    );
    expect(screen.getByText("Gym")).toBeInTheDocument();
    expect(screen.getByRole("button", { name: /Add to budget/ })).toBeInTheDocument();
  });

  it("is absent when there are no unmapped categories", async () => {
    unmappedCategories = [];
    renderPage();
    // Wait for the grid to settle (the zero-base headline is a set-up marker).
    await waitFor(() => expect(screen.queryByText(/Loading budget/)).toBeNull());
    expect(screen.queryByText(/in your budget yet/)).toBeNull();
  });
});
