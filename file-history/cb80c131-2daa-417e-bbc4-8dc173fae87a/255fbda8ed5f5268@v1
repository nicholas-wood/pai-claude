/**
 * Server-state hooks over the typed API client (Phase 2, M2).
 *
 * Each hook wraps `call<P>()` in a TanStack `useQuery`, keeping the contract's
 * request/response typing intact (data is inferred straight from `call`, so
 * union results like `T | ApiError` survive) while adding caching, dedupe, and
 * race-safe refetching. Mutations invalidate the relevant keys via
 * `useInvalidateBudget`, which keeps the net-position banner and the grid in sync
 * after any money move — invalidate the query, never push the value.
 */
import * as React from "react";
import { keepPreviousData, useQuery, useQueryClient } from "@tanstack/react-query";
import type { EnvelopesQuery, TransactionsQuery } from "@contract";
import { call } from "@/lib/api";
import { qk } from "@/lib/queryKeys";

/**
 * The shared budget grid for a period selector or an explicit from/to range.
 * The five this-month consumers (Balance, Edit budget, Reconcile, Settings,
 * Transactions) all pass `{ period: "this-month" }` and therefore collapse onto
 * a single cache entry and a single request. `keepPreviousData` keeps the last
 * grid on screen while a period change is in flight (no flash to a skeleton).
 */
export function useEnvelopes(query: EnvelopesQuery, options?: { enabled?: boolean }) {
  return useQuery({
    queryKey: qk.envelopes.grid(query),
    queryFn: () => call("GET /api/envelopes", query),
    enabled: options?.enabled ?? true,
    placeholderData: keepPreviousData,
  });
}

/** Time-travelled grid (balances as at end of `date`). */
export function useEnvelopesAsOf(date: string, options?: { enabled?: boolean }) {
  return useQuery({
    queryKey: qk.envelopes.asOf(date),
    queryFn: () => call("GET /api/envelopes/as-of", { date }),
    enabled: options?.enabled ?? true,
    placeholderData: keepPreviousData,
  });
}

/** Archived envelopes, fetched only when the caller opts in (e.g. a toggle). */
export function useArchivedEnvelopes(enabled: boolean) {
  return useQuery({
    queryKey: qk.envelopes.archived,
    queryFn: () => call("GET /api/envelopes/archived"),
    enabled,
  });
}

/** The net-position reconciliation banner. */
export function useNetPosition() {
  return useQuery({
    queryKey: qk.netPosition,
    queryFn: () => call("GET /api/net-position"),
  });
}

/**
 * One envelope's detail record. Disabled until an id is present. Optional
 * from/to scope the row + transactions to a period range so the detail page can
 * read one row for a selected period instead of pulling the whole grid. When a
 * range is given the query holds until both bounds are present (rangeReady).
 */
export function useEnvelopeDetail(
  id: string,
  range?: { from?: string; to?: string },
  options?: { enabled?: boolean },
) {
  const from = range?.from;
  const to = range?.to;
  const scoped = from !== undefined && to !== undefined;
  return useQuery({
    queryKey: qk.envelopeDetail(id, from, to),
    queryFn: () =>
      call("GET /api/envelopes/detail", scoped ? { id, from, to } : { id }),
    enabled: (options?.enabled ?? true) && id !== "",
    placeholderData: keepPreviousData,
  });
}

/** One envelope's spend-over-time series for a date window. */
export function useEnvelopeTrend(
  id: string,
  from: string,
  to: string,
  options?: { enabled?: boolean },
) {
  return useQuery({
    queryKey: qk.envelopeTrend(id, from, to),
    queryFn: () => call("GET /api/envelopes/trend", { id, from, to }),
    enabled: (options?.enabled ?? true) && id !== "",
  });
}

/**
 * One envelope's budget version chronology (effective-dated versions, most
 * recent first). Fetched on demand — the edit flow's History affordance opts in
 * via `enabled` — and invalidated with the budget family after any save.
 */
export function useEnvelopeVersions(envelopeId: string, options?: { enabled?: boolean }) {
  return useQuery({
    queryKey: qk.envelopeVersions(envelopeId),
    queryFn: () => call("GET /api/envelopes/versions", { envelopeId }),
    enabled: (options?.enabled ?? true) && envelopeId !== "",
  });
}

/**
 * The manual carryover-adjustment history (newest first). Unscoped it feeds the
 * History page and the budget grid's "manually set" markers; scoped by an
 * envelopeId it returns that envelope's (and its descendants') adjustments for
 * the detail page's trend-chart hover flags.
 */
export function useCarryoverHistory(envelopeId?: string, options?: { enabled?: boolean }) {
  return useQuery({
    queryKey: qk.carryoverHistory(envelopeId),
    queryFn: () =>
      call("GET /api/carryover/history", envelopeId !== undefined ? { envelopeId } : {}),
    enabled: options?.enabled ?? true,
  });
}

/** A filtered transactions list. `keepPreviousData` prevents flicker on refilter. */
export function useTransactions(query: TransactionsQuery, options?: { enabled?: boolean }) {
  return useQuery({
    queryKey: qk.transactions(query),
    queryFn: () => call("GET /api/transactions", query),
    enabled: options?.enabled ?? true,
    placeholderData: keepPreviousData,
  });
}

/**
 * Distinct PocketSmith categories present on transactions but not yet mapped to
 * a budget envelope. Optional from/to (YYYY-MM-DD) scope the scan to a period;
 * omitting both is all-time. Feeds the "new categories detected" surface and the
 * adopt wizard.
 */
export function useUnmappedCategories(
  from?: string,
  to?: string,
  options?: { enabled?: boolean },
) {
  return useQuery({
    queryKey: qk.unmappedCategories(from, to),
    queryFn: () =>
      call("GET /api/categories/unmapped", {
        ...(from ? { from } : {}),
        ...(to ? { to } : {}),
      }),
    enabled: options?.enabled ?? true,
  });
}

/**
 * Invalidate the queries adopting a category changes: the budget grid family
 * (a new envelope + mapping shifts figures), the just-shrunk unmapped-category
 * list, and every filtered transactions list (rows now resolve to the envelope).
 */
export function useInvalidateAfterAdopt(): () => void {
  const qc = useQueryClient();
  const invalidateBudget = useInvalidateBudget();
  return React.useCallback(() => {
    invalidateBudget();
    void qc.invalidateQueries({ queryKey: qk.unmappedCategoriesRoot });
    void qc.invalidateQueries({ queryKey: ["transactions"] });
  }, [qc, invalidateBudget]);
}

/** App settings (deploy mode, PocketSmith key presence, last sync). */
export function useSettings() {
  return useQuery({
    queryKey: qk.settings,
    queryFn: () => call("GET /api/settings"),
  });
}

/** The most recent persisted reconciliation confirmation (or null). */
export function useLastReconcile() {
  return useQuery({
    queryKey: qk.lastReconcile,
    queryFn: () => call("GET /api/reconcile/last"),
  });
}

/** Backup health: the real last verified backup, or null if none recorded. */
export function useBackupStatus() {
  return useQuery({
    queryKey: qk.backupStatus,
    queryFn: () => call("GET /api/backup/status"),
  });
}

/**
 * Invalidate the queries a completed sync can change: settings (lastSyncAt), the
 * budget grid, the net position, and any open detail/trend views. Used by the
 * Settings "Sync now" mutation so the surfaces refresh atomically on success.
 */
export function useInvalidateAfterSync(): () => void {
  const qc = useQueryClient();
  return React.useCallback(() => {
    void qc.invalidateQueries({ queryKey: qk.settings });
    void qc.invalidateQueries({ queryKey: qk.envelopes.root });
    void qc.invalidateQueries({ queryKey: qk.netPosition });
    void qc.invalidateQueries({ queryKey: qk.envelopeDetailRoot });
    void qc.invalidateQueries({ queryKey: qk.envelopeTrendRoot });
    // Prefix-match every filtered transactions list (all query variants).
    void qc.invalidateQueries({ queryKey: ["transactions"] });
  }, [qc]);
}

/**
 * Invalidate everything a money move can change: the budget grid (all periods),
 * the net position, and any open envelope-detail/trend views. Any mutation that
 * moves money, edits the budget, or resets a carryover calls this on success so
 * dependent queries refetch atomically. This replaces the Phase 1 refreshKey
 * shim: the widget subscribes to `['net-position']` and re-reads on invalidation
 * rather than being handed a bumped prop.
 */
export function useInvalidateBudget(): () => void {
  const qc = useQueryClient();
  return React.useCallback(() => {
    void qc.invalidateQueries({ queryKey: qk.envelopes.root });
    void qc.invalidateQueries({ queryKey: qk.netPosition });
    void qc.invalidateQueries({ queryKey: qk.envelopeDetailRoot });
    void qc.invalidateQueries({ queryKey: qk.envelopeTrendRoot });
    // A budget save can append/complete versions: refresh any open chronology.
    void qc.invalidateQueries({ queryKey: qk.envelopeVersionsRoot });
    // A carryover reset (or its undo) appends to the adjustment history: refresh
    // the History page section, the grid markers, and any trend hover flags.
    void qc.invalidateQueries({ queryKey: qk.carryoverHistoryRoot });
  }, [qc]);
}
