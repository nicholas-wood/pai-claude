/**
 * Adopt-category wizard: the type default is inferred from the transactions'
 * direction (net-positive total → income, otherwise expense), and submitting
 * posts a well-formed POST /api/categories/adopt body carrying that type.
 */
import * as React from "react";
import { describe, it, expect, mock, beforeEach } from "bun:test";
import { render, screen, fireEvent, waitFor } from "@testing-library/react";
import type { UnmappedCategory } from "@contract";
import * as realApi from "@/lib/api";
import { TestQueryProvider } from "@/test/utils";

let lastBody: Record<string, unknown> | null = null;
const call = mock(async (path: string, body?: Record<string, unknown>) => {
  if (path === "POST /api/categories/adopt") {
    lastBody = body ?? null;
    return { envelopeId: "env-new" };
  }
  return {};
});
mock.module("@/lib/api", () => ({ ...realApi, call }));

const { AdoptCategoryModal, inferDefaultType } = await import("@/components/AdoptCategoryModal");

function cat(overrides: Partial<UnmappedCategory> = {}): UnmappedCategory {
  return {
    categoryId: "cat-gym",
    categoryName: "Gym",
    transactionCount: 3,
    totalCents: -15000,
    firstSeenDate: "2026-07-01",
    lastSeenDate: "2026-07-10",
    ...overrides,
  };
}

function renderModal(category: UnmappedCategory) {
  return render(
    <TestQueryProvider>
      <AdoptCategoryModal open category={category} rows={[]} onOpenChange={() => {}} />
    </TestQueryProvider>
  );
}

beforeEach(() => {
  lastBody = null;
});

describe("inferDefaultType", () => {
  it("net-positive total is income; anything else is expense", () => {
    expect(inferDefaultType(cat({ totalCents: 500000 }))).toBe("income");
    expect(inferDefaultType(cat({ totalCents: -15000 }))).toBe("expense");
    expect(inferDefaultType(cat({ totalCents: 0 }))).toBe("expense");
  });
});

describe("AdoptCategoryModal", () => {
  it("pre-fills the name and posts the adopt body with the inferred expense type", async () => {
    renderModal(cat({ totalCents: -15000 }));
    // Name pre-filled from the category.
    expect(screen.getByLabelText("Name")).toHaveValue("Gym");

    fireEvent.click(screen.getByRole("button", { name: /Add to budget/ }));
    await waitFor(() => expect(lastBody).not.toBeNull());
    expect(lastBody).toMatchObject({
      categoryId: "cat-gym",
      name: "Gym",
      type: "expense",
    });
  });

  it("carries a start date defaulting to the first of the current month, editable, omitted when cleared", async () => {
    const { unmount } = renderModal(cat());
    const { firstOfCurrentMonthIso } = await import("@/lib/utils");
    const start = screen.getByLabelText("Start date");
    expect(start).toHaveValue(firstOfCurrentMonthIso());

    // A user-chosen date rides through the payload.
    fireEvent.change(start, { target: { value: "2026-09-01" } });
    fireEvent.click(screen.getByRole("button", { name: /Add to budget/ }));
    await waitFor(() => expect(lastBody).not.toBeNull());
    expect(lastBody).toMatchObject({ effectiveFrom: "2026-09-01" });
    unmount();

    // Cleared, the key is OMITTED (the server's strict date schema rejects "").
    lastBody = null;
    renderModal(cat());
    fireEvent.change(screen.getByLabelText("Start date"), { target: { value: "" } });
    fireEvent.click(screen.getByRole("button", { name: /Add to budget/ }));
    await waitFor(() => expect(lastBody).not.toBeNull());
    expect(Object.keys(lastBody!)).not.toContain("effectiveFrom");
  });

  it("defaults a net-positive category to income", async () => {
    renderModal(cat({ categoryId: "cat-salary", categoryName: "Salary", totalCents: 500000 }));
    fireEvent.click(screen.getByRole("button", { name: /Add to budget/ }));
    await waitFor(() => expect(lastBody).not.toBeNull());
    expect(lastBody).toMatchObject({ categoryId: "cat-salary", name: "Salary", type: "income" });
  });
});
