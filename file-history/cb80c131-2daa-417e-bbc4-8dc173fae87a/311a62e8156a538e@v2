/**
 * Legacy-line truth backfill (2026-08-12): open-1970 template lines gain their
 * REAL start — expense lines the earliest materialised month (after pre-history
 * artifact allocations are removed), income lines their rollover anchor — so
 * chronology and edit prefills show actual dates. Idempotent by construction.
 */

import { describe, test, expect } from "bun:test";
import { SqliteStore } from "../src/store/sqlite.ts";

describe("migrate(): legacy start backfill", () => {
  test("expense 1970 lines take the earliest REAL month; pre-history allocations are removed; income lines take the anchor", async () => {
    const store = new SqliteStore(":memory:");
    await store.migrate();
    await store.ensureUser("u1");

    await store.upsertEnvelope("u1", {
      id: "groceries", name: "Groceries", parentId: null, group: "",
      rolloverRule: "roll_all", targetType: "no_target", targetAmountCents: 0,
    });
    await store.putTemplateLine("u1", {
      id: "bt-groceries", userId: "u1", envelopeId: "groceries",
      amountCents: 50000, period: "monthly", effectiveFrom: "1970-01-01", effectiveTo: null,
    });
    // Transactions begin 2024-06; the 2023 allocations are typo-era artifacts.
    await store.upsertTransactions("u1", [{
      id: "t1", date: "2024-06-24", amountCents: -1000, accountId: "a",
      categoryId: null, envelopeId: "groceries", payee: "x",
      isTransfer: false, isPending: false, rawJson: "{}",
    }]);
    for (const period of ["2023-01", "2024-06", "2024-07"]) {
      await store.putAllocation("u1", { id: `al-${period}`, envelopeId: "groceries", period, amountCents: 50000, scope: "ongoing" });
    }
    await store.upsertIncomeEnvelope("u1", {
      id: "inc-rental", userId: "u1", name: "Rental", source: "Rental",
      budgetedCents: 117000, actualCents: 0, targetCents: 117000,
    });
    await store.setIncomeCarryover("u1", "inc-rental", 0, "2026-06-01");
    await store.putTemplateLine("u1", {
      id: "bt-rental", userId: "u1", envelopeId: "inc-rental",
      amountCents: 117000, period: "monthly", effectiveFrom: "1970-01-01", effectiveTo: null,
    });

    await store.migrate(); // the backfill pass (idempotent)

    const lines = await store.listTemplate("u1");
    expect(lines.find((l) => l.id === "bt-groceries")?.effectiveFrom).toBe("2024-06-01");
    expect(lines.find((l) => l.id === "bt-rental")?.effectiveFrom).toBe("2026-06-01");
    // The pre-history artifact month is gone; real months survive.
    const periods = await store.listAllocationPeriods("u1");
    expect(periods).toEqual(["2024-06", "2024-07"]);

    // Idempotent: a third run changes nothing.
    await store.migrate();
    const again = await store.listTemplate("u1");
    expect(again.find((l) => l.id === "bt-groceries")?.effectiveFrom).toBe("2024-06-01");
    await store.close();
  });
});

describe("createEnvelope into an already-materialised month", () => {
  test("the new envelope's budget materialises even though ensureMonth no-ops", async () => {
    const { makeTestApp, postJson, getJson } = await import("./server-test-app.ts");
    const t = await makeTestApp();
    const cookie = await t.signIn();
    // First envelope materialises the current month.
    const a = await postJson(t.app, "/api/envelopes", { name: "A", type: "expense", budgetedCents: 10000, period: "monthly" }, cookie);
    expect(a.status).toBe(200);
    // Second envelope arrives into the now-materialised month.
    const b = await postJson(t.app, "/api/envelopes", { name: "B", type: "expense", budgetedCents: 1600, period: "monthly" }, cookie);
    const bId = ((await b.json()) as { id: string }).id;
    const grid = (await (await getJson(t.app, "/api/envelopes", cookie)).json()) as { rows: { id: string; allocationCents: number }[] };
    expect(grid.rows.find((r) => r.id === bId)?.allocationCents).toBe(1600); // was 0 before the fix
  });
});
