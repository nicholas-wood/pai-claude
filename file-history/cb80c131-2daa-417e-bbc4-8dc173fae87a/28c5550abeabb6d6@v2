/**
 * Centralised, typed TanStack Query keys (Phase 2, M2).
 *
 * All server-state cache keys live here so query subscriptions and mutation
 * invalidations agree on exactly one shape. Two consumers requesting the same
 * resource with the same arguments (e.g. five pages each reading the budget grid
 * for `{ period: "this-month" }`) produce the same key and therefore share a
 * single cache entry and a single network request.
 *
 * Invalidation is prefix-based: invalidating `["envelopes"]` matches every grid,
 * as-of, and archived query regardless of period. Envelope detail and trend sit
 * under their own roots so they can be invalidated together with the grid.
 */
import type { EnvelopesQuery, TransactionsQuery } from "@contract";

export const qk = {
  /** The budget grid family (GET /api/envelopes and siblings). */
  envelopes: {
    /** Prefix for invalidating every grid/as-of/archived query at once. */
    root: ["envelopes"] as const,
    /** One grid for a period selector or a custom from/to range. */
    grid: (query: EnvelopesQuery) => ["envelopes", "grid", query] as const,
    /** Time-travelled grid (GET /api/envelopes/as-of). */
    asOf: (date: string) => ["envelopes", "as-of", date] as const,
    /** Archived envelopes list (GET /api/envelopes/archived). */
    archived: ["envelopes", "archived"] as const,
  },
  /**
   * Per-envelope detail (GET /api/envelopes/detail). The optional from/to scope
   * the row + transactions to a period range, so a period-scoped detail read
   * caches separately from the default (current-month) one.
   */
  envelopeDetail: (id: string, from?: string, to?: string) =>
    ["envelope-detail", id, from ?? null, to ?? null] as const,
  /** Root prefix for invalidating all envelope-detail queries. */
  envelopeDetailRoot: ["envelope-detail"] as const,
  /** Per-envelope spend-over-time series (GET /api/envelopes/trend). */
  envelopeTrend: (id: string, from?: string, to?: string) =>
    ["envelope-trend", id, from ?? null, to ?? null] as const,
  /** Root prefix for invalidating all envelope-trend queries. */
  envelopeTrendRoot: ["envelope-trend"] as const,
  /** Per-envelope budget version chronology (GET /api/envelopes/versions). */
  envelopeVersions: (envelopeId: string) => ["envelope-versions", envelopeId] as const,
  /** Root prefix for invalidating all version-chronology queries. */
  envelopeVersionsRoot: ["envelope-versions"] as const,
  /**
   * Carryover adjustment history (GET /api/carryover/history). Scoped reads
   * (per-envelope + descendants) cache separately from the unscoped list.
   */
  carryoverHistory: (envelopeId?: string) => ["carryover-history", envelopeId ?? null] as const,
  /** Root prefix for invalidating every carryover-history query. */
  carryoverHistoryRoot: ["carryover-history"] as const,
  /**
   * Unmapped PocketSmith categories (GET /api/categories/unmapped): categories
   * present on transactions but not yet in the budget. Scoped reads (from/to)
   * cache separately from the all-time list.
   */
  unmappedCategories: (from?: string, to?: string) =>
    ["unmapped-categories", from ?? null, to ?? null] as const,
  /** Root prefix for invalidating every unmapped-categories query. */
  unmappedCategoriesRoot: ["unmapped-categories"] as const,
  /** Cleared categories (GET /api/categories/dismissed) — Settings → Not synced. */
  dismissedCategories: ["dismissed-categories"] as const,
  /** The net-position reconciliation (GET /api/net-position). */
  netPosition: ["net-position"] as const,
  /** A filtered transactions list (GET /api/transactions). */
  transactions: (query: TransactionsQuery) => ["transactions", query] as const,
  /** App settings (GET /api/settings). */
  settings: ["settings"] as const,
  /** The most recent persisted reconciliation confirmation (GET /api/reconcile/last). */
  lastReconcile: ["reconcile-last"] as const,
  /** Backup health (GET /api/backup/status). */
  backupStatus: ["backup-status"] as const,
} as const;
