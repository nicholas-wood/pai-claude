/**
 * New-category detection + adopt routes. A synced transaction can carry a
 * PocketSmith category that has no envelope mapping yet (distinct from an
 * uncategorised transaction, which has NO category at all): these routes list
 * those categories and let the user adopt each into the budget.
 *
 *   GET  /api/categories/unmapped  distinct unmapped categories with aggregates
 *   POST /api/categories/adopt     create envelope + mapping in one transaction
 *
 * Every route is scoped to the authenticated user (ISC-49); the adopt body is
 * validated with zod at the boundary (../validate.ts) before it reaches the
 * ledger, and the multi-write adopt runs inside one store transaction.
 */

import { Hono } from "hono";
import type { Container } from "../../composition.ts";
import type { Services } from "../services.ts";
import type {
  AdoptCategoryResponse,
  DismissCategoryResponse,
  DismissedCategoriesResponse,
  UnmappedCategoriesResponse,
} from "../contract.ts";
import { currentPeriod, resolveSession, UNAUTHENTICATED } from "../http.ts";
import { todayISO } from "../../platform/time.ts";
import { parseBody, adoptCategorySchema, dismissCategorySchema, dateParam, dateParamResponse } from "../validate.ts";

export function registerCategories(api: Hono, container: Container, services: Services): void {
  const tz = container.config.timezone;

  // Distinct categories present on transactions but not in the budget, most
  // transactions first. Optional from/to (YYYY-MM-DD) scope the scan; read raw
  // from the query to match the neighbouring grid handler's from/to handling.
  api.get("/categories/unmapped", async (c) => {
    const session = await resolveSession(c, container);
    if (!session) return c.json(UNAUTHENTICATED, 401);
    let from: string | undefined, to: string | undefined;
    try {
      from = dateParam("from", c.req.query("from"));
      to = dateParam("to", c.req.query("to"));
    } catch (err) {
      return dateParamResponse(c, err);
    }
    const categories = await services.envelopes.listUnmappedCategories(session.userId, {
      ...(from ? { from } : {}),
      ...(to ? { to } : {}),
      tz,
    });
    const res: UnmappedCategoriesResponse = { categories };
    return c.json(res);
  });

  // The cleared categories (Settings → Not synced): same aggregates as the
  // unmapped list, restricted to dismissed ids.
  api.get("/categories/dismissed", async (c) => {
    const session = await resolveSession(c, container);
    if (!session) return c.json(UNAUTHENTICATED, 401);
    const categories = await services.envelopes.listDismissedCategories(session.userId, tz);
    const res: DismissedCategoriesResponse = { categories };
    return c.json(res);
  });

  // Clear (dismiss) or restore one detected category. Dismissed categories
  // stop appearing on the budget page and list under Settings → Not synced.
  api.post("/categories/dismiss", async (c) => {
    const session = await resolveSession(c, container);
    if (!session) return c.json(UNAUTHENTICATED, 401);
    const parsed = await parseBody(c, dismissCategorySchema);
    if (!parsed.ok) return parsed.response;
    await services.envelopes.setCategoryDismissed(session.userId, parsed.value.categoryId, parsed.value.dismissed);
    const res: DismissCategoryResponse = { ok: true };
    return c.json(res);
  });

  // Adopt one category: create the envelope and seed the category→envelope
  // mapping in a single store transaction (BudgetService.adoptCategory). The
  // handler only resolves the timezone-dependent schedule anchor default.
  api.post("/categories/adopt", async (c) => {
    const session = await resolveSession(c, container);
    if (!session) return c.json(UNAUTHENTICATED, 401);
    const parsed = await parseBody(c, adoptCategorySchema);
    if (!parsed.ok) return parsed.response;
    const req = parsed.value;
    const envelopeId = await services.budget.adoptCategory(session.userId, currentPeriod(tz), {
      categoryId: req.categoryId,
      name: req.name,
      type: req.type,
      // The rollover sequence anchors where the budget starts: the client's
      // chosen start date when given, else today (the pre-start-date default).
      rolloverStart: req.effectiveFrom ?? todayISO(tz),
      ...(req.budgetedCents !== undefined ? { budgetedCents: req.budgetedCents } : {}),
      ...(req.period !== undefined ? { period: req.period } : {}),
      ...(req.rolloverRule !== undefined ? { rolloverRule: req.rolloverRule } : {}),
      ...(req.parentId !== undefined ? { parentId: req.parentId } : {}),
      ...(req.effectiveFrom !== undefined ? { effectiveFrom: req.effectiveFrom } : {}),
      ...(req.existingEnvelopeId !== undefined ? { existingEnvelopeId: req.existingEnvelopeId } : {}),
    });
    const res: AdoptCategoryResponse = { envelopeId };
    return c.json(res);
  });
}
