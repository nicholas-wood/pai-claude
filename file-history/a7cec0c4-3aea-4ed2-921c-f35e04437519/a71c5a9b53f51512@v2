/**
 * Move money: reallocation as a conserved transfer (ISC-66, ISC-67, ISC-71).
 *
 * A reallocation names an explicit source and destination; the amount leaving
 * the source equals the amount entering the destination, so total allocation is
 * conserved by construction (ISC-66). The scope decides whether it edits the
 * recurring template (ongoing) or only the current period (this-month) (ISC-67,
 * ISC-68). An imbalanced envelope can be balanced in either direction or simply
 * left to carry (ISC-71): both source->dest and dest->source are valid plans.
 *
 * Pure. The service applies the plan against the store.
 */

import type { ChangeScope } from "../domain/types.ts";

export interface MoveRequest {
  readonly fromEnvelopeId: string;
  readonly toEnvelopeId: string;
  readonly amountCents: number;
  readonly scope: ChangeScope;
}

export interface MovePlan {
  readonly fromEnvelopeId: string;
  readonly toEnvelopeId: string;
  readonly scope: ChangeScope;
  /** Always negative: the amount leaving the source. */
  readonly fromDeltaCents: number;
  /** Always positive: the amount entering the destination. */
  readonly toDeltaCents: number;
}

/**
 * Validate and build a conserved move plan. Throws on a non-positive amount or
 * a self-move; the caller surfaces these as a 4xx. The returned deltas always
 * sum to zero (the conservation invariant asserted in tests, ISC-66).
 */
export function planMove(req: MoveRequest): MovePlan {
  if (!Number.isInteger(req.amountCents)) throw new Error("amount must be integer cents");
  if (req.amountCents <= 0) throw new Error("move amount must be positive");
  if (req.fromEnvelopeId === req.toEnvelopeId) throw new Error("source and destination must differ");
  return {
    fromEnvelopeId: req.fromEnvelopeId,
    toEnvelopeId: req.toEnvelopeId,
    scope: req.scope,
    fromDeltaCents: -req.amountCents,
    toDeltaCents: req.amountCents,
  };
}

/** The conservation invariant: a plan never creates or destroys money. */
export function isConserved(plan: MovePlan): boolean {
  return plan.fromDeltaCents + plan.toDeltaCents === 0;
}

// ── Split-source move (ISC-332..341) ──────────────────────────────────────────

/** One funding leg of a split move: the envelope the money leaves and how much. */
export interface SplitMoveSource {
  readonly envelopeId: string;
  readonly amountCents: number;
}

/**
 * A split move funds ONE destination from SEVERAL sources in one action. The
 * origin (`fromEnvelopeId`) is the envelope the user acted on — a parent — and
 * `sources` says how the total is made up across the parent's own bucket and
 * its children. The total (`amountCents`) is redundant with the legs on
 * purpose: it is the checksum the server verifies (owner request 2026-09-12).
 */
export interface SplitMoveRequest {
  readonly fromEnvelopeId: string;
  readonly toEnvelopeId: string;
  readonly amountCents: number;
  readonly scope: ChangeScope;
  readonly sources: readonly SplitMoveSource[];
}

export interface SplitMovePlan {
  readonly originEnvelopeId: string;
  readonly toEnvelopeId: string;
  readonly scope: ChangeScope;
  /** Always positive: the total entering the destination. */
  readonly totalCents: number;
  /** One leg per distinct source, each a positive amount leaving that source. */
  readonly legs: readonly SplitMoveSource[];
}

/**
 * Validate and build a conserved split plan. Throws — surfaced as a 4xx by the
 * caller — on an empty source list, a non-positive or non-integer leg, a leg
 * naming the destination, a duplicate source id (a client bug, rejected rather
 * than merged), or legs that do not sum to the stated total. Subtree
 * membership (every source is the origin or a descendant) is a data question
 * the service answers; this core is pure.
 */
export function planSplitMove(req: SplitMoveRequest): SplitMovePlan {
  if (!Number.isInteger(req.amountCents)) throw new Error("amount must be integer cents");
  if (req.amountCents <= 0) throw new Error("move amount must be positive");
  if (req.fromEnvelopeId === req.toEnvelopeId) throw new Error("source and destination must differ");
  if (!Array.isArray(req.sources) || req.sources.length === 0) {
    throw new Error("a split move needs at least one source");
  }
  const seen = new Set<string>();
  for (const s of req.sources) {
    if (typeof s?.envelopeId !== "string" || s.envelopeId.length === 0) {
      throw new Error("each source needs an envelopeId");
    }
    if (!Number.isInteger(s.amountCents)) throw new Error("each source amount must be integer cents");
    if (s.amountCents <= 0) throw new Error("each source amount must be positive");
    if (s.envelopeId === req.toEnvelopeId) throw new Error("a source cannot be the destination");
    if (seen.has(s.envelopeId)) throw new Error(`source ${s.envelopeId} is listed twice`);
    seen.add(s.envelopeId);
  }
  const sum = req.sources.reduce((acc, s) => acc + s.amountCents, 0);
  if (sum !== req.amountCents) {
    throw new Error(
      `the sources add up to $${(sum / 100).toFixed(2)} but the move total is $${(req.amountCents / 100).toFixed(2)}`,
    );
  }
  return {
    originEnvelopeId: req.fromEnvelopeId,
    toEnvelopeId: req.toEnvelopeId,
    scope: req.scope,
    totalCents: req.amountCents,
    legs: req.sources.map((s) => ({ envelopeId: s.envelopeId, amountCents: s.amountCents })),
  };
}

/** The conservation invariant for a split: what leaves the sources equals what lands. */
export function isSplitConserved(plan: SplitMovePlan): boolean {
  return plan.legs.reduce((acc, l) => acc + l.amountCents, 0) === plan.totalCents;
}
