// ── Query-param date guard ────────────────────────────────────────────────────

/**
 * Validate an optional from/to/asOf date QUERY param. GET params were read raw,
 * and browser date inputs emit partial years while the user types (0002-08-01,
 * 0020-08-01, ...) — those reached ensureMonth and materialised ~1.4M garbage
 * allocation rows spanning years 10..1015. Anything malformed or outside the
 * plausible era is a 400, never a silent read (or write) of a garbage month.
 * Returns the value (or undefined when absent); throws DateParamError.
 */
export class DateParamError extends Error {
  constructor(name: string, value: string) {
    super(`Invalid ${name} date "${value}": expected YYYY-MM-DD between 1990 and 2100.`);
  }
}

export function dateParam(name: string, value: string | undefined): string | undefined {
  if (value === undefined || value === "") return undefined;
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value) || value < "1990-01-01" || value > "2100-12-31") {
    throw new DateParamError(name, value);
  }
  return value;
}

/** Uniform 400 for a DateParamError; rethrows anything else. */
export function dateParamResponse(c: Context, err: unknown): Response {
  if (err instanceof DateParamError) {
    const body: ApiError = { error: err.message, code: "bad_request" };
    return c.json(body, 400);
  }
  throw err;
}

// ── The boundary helper ───────────────────────────────────────────────────────

export type ParsedBody<T> =
  | { readonly ok: true; readonly value: T }
  | { readonly ok: false; readonly response: Response };

/**
 * Parse and validate a JSON request body against a schema. On any failure —
 * unparseable JSON or a schema violation — returns a ready-made 400 in the
 * uniform ApiError shape, naming the first offending field (values are never
 * echoed back).
 */
export async function parseBody<S extends z.ZodTypeAny>(
  c: Context,
  schema: S,
): Promise<ParsedBody<z.infer<S>>> {
  const raw: unknown = await c.req.json().catch(() => undefined);
  const result = schema.safeParse(raw);
  if (!result.success) {
    const issue = result.error.issues[0];
    const at = issue && issue.path.length > 0 ? ` at ${issue.path.join(".")}` : "";
    const err: ApiError = {
      error: `Invalid request body${at}: ${issue?.message ?? "malformed JSON"}.`,
      code: "bad_request",
    };
    return { ok: false, response: c.json(err, 400) };
  }
  return { ok: true, value: result.data as z.infer<S> };
}

/**
 * The GET twin of parseBody: validate a request's query params against a
 * schema. Hono's c.req.query() yields Record<string, string>, so schemas here
 * describe string-shaped fields. Failures return the same uniform 400 ApiError
 * (first offending field named, values never echoed back).
 */
export function parseQuery<S extends z.ZodTypeAny>(c: Context, schema: S): ParsedBody<z.infer<S>> {
  const result = schema.safeParse(c.req.query());
  if (!result.success) {
    const issue = result.error.issues[0];
    const at = issue && issue.path.length > 0 ? ` at ${issue.path.join(".")}` : "";
    const err: ApiError = {
      error: `Invalid query${at}: ${issue?.message ?? "malformed query"}.`,
      code: "bad_request",
    };
    return { ok: false, response: c.json(err, 400) };
  }
  return { ok: true, value: result.data as z.infer<S> };
}

