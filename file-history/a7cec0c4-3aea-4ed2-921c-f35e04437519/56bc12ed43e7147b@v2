export const scheduleCadenceSchema = budgetPeriodSchema;

/** POST /api/schedules (CreateScheduleRequest). */
export const createScheduleSchema = z.object({
  fromEnvelopeId: idSchema,
  toEnvelopeId: idSchema,
  amountCents: centsSchema,
  cadence: scheduleCadenceSchema,
  anchor: eraDateSchema,
  endDate: eraDateSchema.nullable().optional(),
  note: z.string().trim().max(200).optional(),
});

/** POST /api/schedules/update (UpdateScheduleRequest). */
export const updateScheduleSchema = z.object({
  id: idSchema,
  amountCents: centsSchema.optional(),
  status: z.enum(["active", "paused"]).optional(),
  endDate: eraDateSchema.nullable().optional(),
  note: z.string().trim().max(200).optional(),
});

/** POST /api/schedules/delete (DeleteScheduleRequest). */
export const deleteScheduleSchema = z.object({ id: idSchema });

/** POST /api/schedules/run (RunSchedulesRequest). */
export const runSchedulesSchema = z.object({ asOf: eraDateSchema.optional() });
