"use client";

import { useEffect, useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

type AttestationRecord = {
  id: string;
  season: string;
  status: string;
  createdAt: string;
  tokenExpiresAt: string;
  completedAt: string | null;
  credentialResponses: { credentialId: string; confirmed: boolean; note?: string }[] | null;
  /** Set for a scoped confirmation (admin re-added a fob the member holds). */
  credentialIds?: string[] | null;
  /** Human label for a scoped confirmation, e.g. "Confirm Fob #123". */
  scopedLabel?: string | null;
};

export function AttestationSection({
  tenantSlug,
  userId,
  attestations,
  seasons,
  canRenew,
}: {
  tenantSlug: string;
  userId: string;
  attestations: AttestationRecord[];
  seasons: string[];
  canRenew: boolean;
}) {
  const [forceRenewOpen, setForceRenewOpen] = useState(false);
  const [season, setSeason] = useState("");
  const [reason, setReason] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [notice, setNotice] = useState<string | null>(null);

  // After a write, the whole page is reloaded rather than soft-refreshed:
  // a soft refresh left the credential and confirmation cards showing the
  // old state until the admin left and came back (3 Nov 2026). The notice
  // survives the reload through sessionStorage.
  const FLASH_KEY = `ab:member-confirmations-notice:${userId}`;
  useEffect(() => {
    try {
      const flash = sessionStorage.getItem(FLASH_KEY);
      if (flash) {
        sessionStorage.removeItem(FLASH_KEY);
        setNotice(flash);
      }
    } catch {
      // Storage unavailable: no notice, nothing else changes.
    }
  }, [FLASH_KEY]);

  function reloadWith(message: string) {
    try {
      sessionStorage.setItem(FLASH_KEY, message);
    } catch {
      // Storage unavailable: the reload still shows the new state.
    }
    window.location.reload();
  }

  const pendings = attestations.filter((a) => a.status === "pending");
  const pending = pendings.find((a) => !a.credentialIds?.length) ?? null;
  const scopedPendings = pendings.filter((a) => !!a.credentialIds?.length);
  const completed = attestations.filter((a) => a.status === "completed");

  async function handleForceRenew() {
    if (!season || !reason) return;
    setSubmitting(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/v1/t/${tenantSlug}/members/${userId}/force-renew`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ season, reason }),
        }
      );
      const data = (await res.json()) as {
        error?: string;
        staged?: string[];
        skipped?: string[];
      };
      if (!res.ok) {
        throw new Error(data.error ?? "Failed to force renew");
      }
      const stagedCount = data.staged?.length ?? 0;
      const skippedCount = data.skipped?.length ?? 0;
      reloadWith(
        stagedCount > 0
          ? `Membership renewed. ${stagedCount} fob${stagedCount === 1 ? "" : "s"} sent to the programmer for an expiry update.`
          : skippedCount > 0
            ? "Membership renewed. Their fobs are already at this expiry or already with the programmer, so nothing new was sent for programming."
            : "Membership renewed. No active or expired fobs on this member to send for programming."
      );
    } catch (err) {
      setError(err instanceof Error ? err.message : "Something went wrong");
      setSubmitting(false);
    }
  }

  async function scopedAction(
    row: AttestationRecord,
    action: "resend-attestation" | "cancel-confirmation" | "confirm-on-behalf"
  ) {
    setSubmitting(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/v1/t/${tenantSlug}/members/${userId}/${action}`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ attestationId: row.id }),
        }
      );
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error ?? "Something went wrong");
      }
      reloadWith(
        action === "resend-attestation"
          ? "Confirmation email re-sent to the member."
          : action === "cancel-confirmation"
            ? "Confirmation cancelled."
            : "Recorded as confirmed by the member. The fob has been sent to the programmer for an expiry update."
      );
    } catch (err) {
      setError(err instanceof Error ? err.message : "Something went wrong");
      setSubmitting(false);
    }
  }

  async function handleResend() {
    if (!pending) return;
    setSubmitting(true);
    setError(null);
    try {
      // A renewal attestation re-sends by triggering Renew again with the
      // same season.
      const res = await fetch(
        `/api/v1/t/${tenantSlug}/members/${userId}/renew`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ season: pending.season }),
        }
      );
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error ?? "Failed to re-send confirmation");
      }
      reloadWith("Confirmation email re-sent to the member.");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Something went wrong");
      setSubmitting(false);
    }
  }

  if (attestations.length === 0 && !canRenew) return null;

  const formatDate = (iso: string) =>
    new Date(iso).toLocaleDateString("en-AU", {
      timeZone: "Australia/Melbourne",
      day: "numeric",
      month: "short",
      year: "numeric",
    });

  return (
    <Card>
      <CardHeader>
        <CardTitle className="text-base">Confirmations</CardTitle>
      </CardHeader>
      <CardContent className="space-y-4">
        {/* Pending fob confirmations (admin re-added a fob the member holds) */}
        {scopedPendings.map((row) => (
          <div key={row.id} className="rounded border border-sky-200 bg-sky-50 p-3 space-y-2">
            <div>
              <Badge variant="outline" className="border-sky-400 text-sky-700">
                Awaiting member
              </Badge>
              <span className="ml-2 text-sm text-muted-foreground">
                {row.scopedLabel ?? "Fob confirmation"}
              </span>
            </div>
            <p className="text-xs text-muted-foreground">
              Sent {formatDate(row.createdAt)} &middot; Link expires {formatDate(row.tokenExpiresAt)} &middot; reminders go out weekly until answered
            </p>
            {canRenew && (
              <div className="flex flex-wrap gap-2 pt-1">
                <Button size="sm" variant="outline" disabled={submitting} onClick={() => scopedAction(row, "resend-attestation")}>
                  Re-send
                </Button>
                <Button size="sm" variant="secondary" disabled={submitting} onClick={() => scopedAction(row, "confirm-on-behalf")}>
                  Member confirmed in person
                </Button>
                <Button size="sm" variant="ghost" disabled={submitting} onClick={() => scopedAction(row, "cancel-confirmation")}>
                  Cancel confirmation
                </Button>
              </div>
            )}
          </div>
        ))}

        {/* Pending renewal attestation */}
        {pending && (
          <div className="rounded border border-amber-200 bg-amber-50 p-3 space-y-2">
            <div className="flex items-center justify-between">
              <div>
                <Badge variant="outline" className="border-amber-400 text-amber-700">
                  Pending
                </Badge>
                <span className="ml-2 text-sm text-muted-foreground">
                  Season {pending.season}
                </span>
              </div>
            </div>
            <p className="text-xs text-muted-foreground">
              Sent {formatDate(pending.createdAt)} &middot; Expires{" "}
              {formatDate(pending.tokenExpiresAt)}
            </p>
            {canRenew && (
              <div className="flex gap-2 pt-1">
                <Button
                  size="sm"
                  variant="outline"
                  onClick={handleResend}
                  disabled={submitting}
                >
                  Re-send
                </Button>
                <Button
                  size="sm"
                  variant="secondary"
                  onClick={() => setForceRenewOpen(true)}
                  disabled={submitting}
                >
                  Force Renew
                </Button>
              </div>
            )}
          </div>
        )}

        {/* Force renew form */}
        {forceRenewOpen && canRenew && (
          <div className="rounded border p-3 space-y-3">
            <p className="text-sm font-medium">Force Renew (Admin Bypass)</p>
            <p className="text-xs text-muted-foreground">
              Renews the membership without waiting for the member to confirm, and sends
              their active and expired fobs to the programmer for an expiry update. Fobs
              are reactivated when the programmer confirms the access system is updated.
            </p>
            <Select value={season} onValueChange={(v) => setSeason(v ?? "")}>
              <SelectTrigger>
                <SelectValue placeholder="Select season..." />
              </SelectTrigger>
              <SelectContent>
                {seasons.map((s) => (
                  <SelectItem key={s} value={s} label={s}>
                    {s}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
            <textarea
              value={reason}
              onChange={(e) => setReason(e.target.value)}
              placeholder="Reason for force renewal..."
              maxLength={500}
              className="w-full rounded border p-2 text-sm resize-none"
              rows={2}
            />
            {error && <p className="text-xs text-destructive">{error}</p>}
            <div className="flex gap-2">
              <Button
                size="sm"
                onClick={handleForceRenew}
                disabled={submitting || !season || !reason}
              >
                {submitting ? "..." : "Confirm Force Renew"}
              </Button>
              <Button
                size="sm"
                variant="ghost"
                onClick={() => {
                  setForceRenewOpen(false);
                  setError(null);
                }}
              >
                Cancel
              </Button>
            </div>
          </div>
        )}

        {notice && (
          <p className="text-xs text-muted-foreground" role="status">
            {notice}
          </p>
        )}

        {/* Show force renew button even without pending attestation */}
        {!pending && !forceRenewOpen && canRenew && (
          <Button
            size="sm"
            variant="outline"
            onClick={() => setForceRenewOpen(true)}
          >
            Force Renew
          </Button>
        )}

        {/* Completed attestations */}
        {completed.length > 0 && (
          <div className="space-y-2">
            <p className="text-sm font-medium text-muted-foreground">History</p>
            {completed.map((a) => {
              const confirmedCount =
                a.credentialResponses?.filter((r) => r.confirmed).length ?? 0;
              const lostCount =
                a.credentialResponses?.filter((r) => !r.confirmed).length ?? 0;
              return (
                <div
                  key={a.id}
                  className="flex items-center justify-between rounded border p-2 text-sm"
                >
                  <div>
                    <span className="font-medium">Season {a.season}</span>
                    <p className="text-xs text-muted-foreground">
                      Completed {a.completedAt ? formatDate(a.completedAt) : "-"}
                      {a.credentialResponses && (
                        <>
                          {" \u00B7 "}
                          {confirmedCount} confirmed
                          {lostCount > 0 && (
                            <span className="text-amber-600">
                              , {lostCount} reported lost
                            </span>
                          )}
                        </>
                      )}
                    </p>
                  </div>
                  <Badge variant="secondary">Completed</Badge>
                </div>
              );
            })}
          </div>
        )}

        {attestations.length === 0 && (
          <p className="text-sm text-muted-foreground">No confirmation history</p>
        )}
      </CardContent>
    </Card>
  );
}
