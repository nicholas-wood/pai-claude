import { describe, it, expect } from "vitest";
import { diffMemberUpdate, type StoredMember, type SubmittedMember } from "../lib/member-update-diff";
import { describeAttestationAction } from "../lib/audit-labels";

const ACCESS_LEVEL = "11111111-1111-4111-8111-111111111111";

function stored(overrides: Partial<StoredMember> = {}): StoredMember {
  return {
    firstName: "Sam",
    lastName: "Taylor",
    email: "sam@example.com",
    membershipCategory: "Senior",
    isOfficer: false,
    isBoardMember: true,
    isStaff: false,
    accessLevelId: ACCESS_LEVEL,
    officerExpiresAt: null,
    boardExpiresAt: new Date("2027-06-30T00:00:00.000Z"),
    ...overrides,
  };
}

// What the admin edit form sends on every save: all fields, changed or not.
function fullFormPayload(overrides: SubmittedMember = {}): SubmittedMember {
  return {
    firstName: "Sam",
    lastName: "Taylor",
    membershipCategory: "Senior",
    accessLevelId: ACCESS_LEVEL,
    isOfficer: false,
    isBoardMember: true,
    isStaff: false,
    boardExpiresAt: "2027-06-30T00:00:00.000Z",
    ...overrides,
  };
}

// ============================================================
// diffMemberUpdate
// ============================================================
describe("diffMemberUpdate", () => {
  it("logs only the email when only the email changed", () => {
    const diff = diffMemberUpdate(stored(), fullFormPayload({ email: "sam.taylor@example.com" }));
    expect(diff.lines).toEqual(["email: sam@example.com -> sam.taylor@example.com"]);
    expect([...diff.changed]).toEqual(["email"]);
  });

  it("does not flag credentials for review on an email-only edit", () => {
    const diff = diffMemberUpdate(stored(), fullFormPayload({ email: "new@example.com" }));
    expect(diff.accessAffecting).toBe(false);
  });

  it("does not treat the access level as changed when the same id is resubmitted", () => {
    const diff = diffMemberUpdate(stored(), fullFormPayload({ email: "new@example.com" }));
    expect(diff.changed.has("accessLevelId")).toBe(false);
  });

  it("reports nothing when the form is saved unchanged", () => {
    const diff = diffMemberUpdate(stored(), fullFormPayload());
    expect(diff.changed.size).toBe(0);
    expect(diff.lines).toEqual([]);
  });

  it("ignores an email that differs only by case or whitespace", () => {
    const diff = diffMemberUpdate(stored(), fullFormPayload({ email: "  Sam@Example.com " }));
    expect(diff.changed.size).toBe(0);
  });

  it("records a name change with old and new values", () => {
    const diff = diffMemberUpdate(stored(), fullFormPayload({ lastName: "Taylor-Jones" }));
    expect(diff.lines).toEqual(["name: Sam Taylor -> Sam Taylor-Jones"]);
  });

  it("records category and role flag changes and marks them access-affecting", () => {
    const diff = diffMemberUpdate(
      stored(),
      fullFormPayload({ membershipCategory: "Life Member", isOfficer: true })
    );
    expect(diff.lines).toEqual(["category: Senior -> Life Member", "officer: true"]);
    expect(diff.accessAffecting).toBe(true);
  });

  it("flags an access level change without writing its line (the route resolves names)", () => {
    const diff = diffMemberUpdate(stored(), fullFormPayload({ accessLevelId: null }));
    expect([...diff.changed]).toEqual(["accessLevelId"]);
    expect(diff.lines).toEqual([]);
    expect(diff.accessAffecting).toBe(false);
  });

  it("records an expiry change by calendar date and ignores an unchanged one", () => {
    const diff = diffMemberUpdate(
      stored(),
      fullFormPayload({ boardExpiresAt: "2028-06-30T00:00:00.000Z" })
    );
    expect(diff.lines).toEqual(["board expiry: 2027-06-30 -> 2028-06-30"]);
  });

  it("records a first-time officer expiry", () => {
    const diff = diffMemberUpdate(
      stored({ isOfficer: true }),
      fullFormPayload({ isOfficer: true, officerExpiresAt: "2027-09-30T00:00:00.000Z" })
    );
    expect(diff.lines).toEqual(["officer expiry: (none) -> 2027-09-30"]);
  });
});

// ============================================================
// describeAttestationAction
// ============================================================
describe("describeAttestationAction", () => {
  it("labels an admin resend as a confirmation resend, with the season", () => {
    expect(
      describeAttestationAction({ action: "attestation_resent", season: "2026/2027" })
    ).toBe("Credential confirmation resent (2026/2027)");
  });

  it("labels the cron auto-resend with its reminder number", () => {
    expect(
      describeAttestationAction({ action: "attestation_auto_resent", season: "2026/2027", cycle: 2 })
    ).toBe("Credential confirmation reminder #1 sent automatically (2026/2027)");
  });

  it("labels a force-complete", () => {
    expect(describeAttestationAction({ action: "attestation_force_completed" })).toBe(
      "Credential confirmation force-completed"
    );
  });

  it("labels a force renew on the member and the staged expiry update on the fob", () => {
    expect(
      describeAttestationAction({ action: "force_renew", season: "2026/2027", reason: "Paid at the desk" })
    ).toBe("Membership force-renewed (2026/2027) by admin: Paid at the desk");
    expect(
      describeAttestationAction({
        action: "force_renew_expiry_update",
        season: "2026/2027",
        pendingExpiresAt: "2027-08-31T14:00:00.000Z",
      })
    ).toBe("Force renewal (2026/2027) - expiry update staged for 1 Sept 2027, awaiting programming");
    // Rows from before the fix rewrote the live expiry and staged nothing.
    expect(
      describeAttestationAction({
        action: "force_renew_expiry_update",
        season: "2026/2027",
        newExpiresAt: "2027-08-31T14:00:00.000Z",
      })
    ).toBe("Force renewal (2026/2027) - expiry rewritten directly (no programming update staged)");
  });

  it("returns null for other member updates so existing labels still apply", () => {
    expect(describeAttestationAction({ changes: ["officer: true"] })).toBeNull();
    expect(describeAttestationAction({ action: "renew" })).toBeNull();
    expect(describeAttestationAction(null)).toBeNull();
  });
});
