import { NextRequest, NextResponse } from "next/server";
import { eq, and, inArray } from "drizzle-orm";
import {
  attestationResponseSchema,
  CredentialStatus,
  RequestStatus,
  RequestType,
  AuditEntityType,
  AuditAction,
} from "@accessbuddy/shared";
import {
  db,
  attestationRequests,
  users,
  credentials,
  credentialTypes,
  accessLevels,
  fobRequests,
  tenantMemberships,
} from "@accessbuddy/db";
import { resolveTenant, type Tenant } from "@/lib/tenant";
import { withTenant } from "@/lib/with-tenant";
import { createAuditEntry } from "@/lib/services/audit";
import { midnightInTimezone } from "@/lib/timezone";
import { formatExpiryDate } from "@/lib/format-date";

/**
 * Shared preamble for both handlers. No auth required on this route — the
 * token IS the auth for the member. The tenant, however, comes from the URL
 * slug and MUST be resolved BEFORE the token lookup: attestation_requests
 * is FORCE row-level security (migration 0011, re-asserted in 0014), so a
 * lookup without app.current_tenant_id set matches zero rows and every
 * valid confirmation link 404s. This is exactly the regression that forced
 * ops to drop FORCE in prod on 2026-08-05 — keep the ordering invariant
 * (tenant first, then token) in this one place.
 *
 * Returns the resolved tenant plus a pending, unexpired attestation, or the
 * error response to send (404 unknown tenant/token, 410 completed/expired).
 */
async function loadPendingAttestation(
  slug: string,
  token: string
): Promise<
  | { tenant: Tenant; attestation: typeof attestationRequests.$inferSelect }
  | NextResponse
> {
  const tenant = await resolveTenant(slug);
  if (!tenant) {
    return NextResponse.json({ error: "Organisation not found" }, { status: 404 });
  }

  const [attestation] = await withTenant(tenant.id, (tx) =>
    tx
      .select()
      .from(attestationRequests)
      .where(eq(attestationRequests.token, token))
      .limit(1)
  );

  if (!attestation) {
    return NextResponse.json({ error: "This confirmation link is not valid" }, { status: 404 });
  }

  // Defence in depth: RLS already scopes the lookup to the resolved tenant,
  // but if that ever regresses (e.g. FORCE dropped again operationally), a
  // token presented under the wrong tenant's slug must still be a 404.
  if (attestation.tenantId !== tenant.id) {
    return NextResponse.json({ error: "This confirmation link is not valid" }, { status: 404 });
  }

  if (attestation.status !== "pending") {
    return NextResponse.json(
      { error: "This confirmation has already been completed or the link has expired" },
      { status: 410 }
    );
  }

  if (attestation.tokenExpiresAt < new Date()) {
    return NextResponse.json({ error: "This confirmation link has expired" }, { status: 410 });
  }

  return { tenant, attestation };
}

/**
 * GET - Fetch attestation details for the public attestation page.
 * See loadPendingAttestation for the tenant-context requirement.
 */
export async function GET(
  _request: NextRequest,
  { params }: { params: Promise<{ slug: string; token: string }> }
) {
  const { slug, token } = await params;

  const result = await loadPendingAttestation(slug, token);
  if (result instanceof NextResponse) return result;
  const { tenant, attestation } = result;

  // Parallel lookups for user (global table, no RLS) and credentials
  const [userResult, memberCredentials] = await Promise.all([
    db
      .select({ firstName: users.firstName, lastName: users.lastName })
      .from(users)
      .where(eq(users.id, attestation.userId))
      .limit(1),
    // credentials table has RLS — query within tenant context
    withTenant(tenant.id, async (tx) => {
      return tx
        .select({
          id: credentials.id,
          serialNumber: credentials.serialNumber,
          credentialTypeName: credentialTypes.name,
          accessLevelName: accessLevels.name,
          status: credentials.status,
          issuedAt: credentials.issuedAt,
          expiresAt: credentials.expiresAt,
        })
        .from(credentials)
        .leftJoin(credentialTypes, eq(credentials.credentialTypeId, credentialTypes.id))
        .leftJoin(accessLevels, eq(credentials.accessLevelId, accessLevels.id))
        .where(
          and(
            eq(credentials.ownerId, attestation.userId),
            eq(credentials.tenantId, tenant.id),
            // Expired fobs stay on the list: members often attest after the
            // season rollover has expired their fob, and confirming stages a
            // renewal (pending_expires_at) that confirm-programming promotes
            // and reactivates. Lost/damaged/deactivated stay excluded.
            inArray(credentials.status, [
              CredentialStatus.ACTIVE,
              CredentialStatus.EXPIRED,
            ])
          )
        );
    }),
  ]);

  const [user] = userResult;

  if (!user) {
    return NextResponse.json({ error: "Member not found" }, { status: 404 });
  }

  return NextResponse.json({
    attestation: {
      id: attestation.id,
      season: attestation.season,
      status: attestation.status,
    },
    member: {
      firstName: user.firstName,
      lastName: user.lastName,
    },
    tenant: {
      name: tenant.name,
      slug: tenant.slug,
    },
    credentials: memberCredentials.map((c) => ({
      id: c.id,
      serialNumber: c.serialNumber,
      credentialTypeName: c.credentialTypeName,
      accessLevelName: c.accessLevelName,
      status: c.status,
      issuedAt: c.issuedAt?.toISOString() ?? null,
      expiresAt: c.expiresAt?.toISOString() ?? null,
    })),
  });
}

/**
 * POST - Submit attestation responses.
 * See loadPendingAttestation for the tenant-context requirement.
 */
export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ slug: string; token: string }> }
) {
  const { slug, token } = await params;

  const body = await request.json();
  const parsed = attestationResponseSchema.safeParse(body);
  if (!parsed.success) {
    return NextResponse.json(
      { error: "Validation failed", details: parsed.error.flatten() },
      { status: 400 }
    );
  }

  const { responses } = parsed.data;

  const result = await loadPendingAttestation(slug, token);
  if (result instanceof NextResponse) return result;
  const { tenant, attestation } = result;

  const seasonMatch = attestation.season.match(/^\d{4}\/(\d{4})$/);
  let newExpiresAt: Date | null = null;
  if (seasonMatch) {
    const endYear = parseInt(seasonMatch[1], 10);
    newExpiresAt = midnightInTimezone(endYear, 8, 1, tenant.timezone);
  }

  await withTenant(tenant.id, async (tx) => {
    await tx
      .update(attestationRequests)
      .set({
        status: "completed",
        completedAt: new Date(),
        credentialResponses: responses,
        updatedAt: new Date(),
      })
      .where(eq(attestationRequests.id, attestation.id));

    for (const response of responses) {
      if (response.confirmed) {
        // Stage the new expiry and flag for reprogramming. The live expiresAt
        // is NOT updated until a programmer confirms the access control system
        // has been updated — at that point pending_expires_at is promoted.
        const now = new Date();
        const programmingReason = `Renewal attestation (${attestation.season}) - update expiry${newExpiresAt ? ` to ${formatExpiryDate(newExpiresAt, tenant.timezone)}` : ""}`;

        await tx
          .update(credentials)
          .set({
            pendingExpiresAt: newExpiresAt ?? null,
            programmingRequired: true,
            programmingReason,
            programmingRequestedAt: now,
            updatedAt: now,
          })
          .where(
            and(
              eq(credentials.id, response.credentialId),
              eq(credentials.tenantId, attestation.tenantId)
            )
          );

        await createAuditEntry(tx, {
          tenantId: attestation.tenantId,
          entityType: AuditEntityType.CREDENTIAL,
          entityId: response.credentialId,
          action: AuditAction.UPDATE,
          metadata: {
            action: "attestation_expiry_update",
            season: attestation.season,
            attestationId: attestation.id,
            newExpiresAt: newExpiresAt?.toISOString() ?? null,
            programmingRequired: true,
          },
        });
      } else {
        // Credential not confirmed — create a lost replacement request
        const [cred] = await tx
          .select({
            credentialTypeId: credentials.credentialTypeId,
            accessLevelId: credentials.accessLevelId,
            serialNumber: credentials.serialNumber,
          })
          .from(credentials)
          .where(
            and(
              eq(credentials.id, response.credentialId),
              eq(credentials.tenantId, attestation.tenantId)
            )
          )
          .limit(1);

        if (cred) {
          // Look up membership category
          const membershipCategory = await tx
            .select({ membershipCategory: tenantMemberships.membershipCategory })
            .from(tenantMemberships)
            .where(
              and(
                eq(tenantMemberships.userId, attestation.userId),
                eq(tenantMemberships.tenantId, attestation.tenantId)
              )
            )
            .limit(1);

          const [lostRequest] = await tx
            .insert(fobRequests)
            .values({
              tenantId: attestation.tenantId,
              requesterId: attestation.userId,
              credentialTypeId: cred.credentialTypeId,
              accessLevelId: cred.accessLevelId,
              requestType: RequestType.REPLACEMENT_LOST,
              status: RequestStatus.AWAITING_PROGRAMMING,
              paymentExempt: true,
              // Link the lost credential so the PROGRAM transition flips it
              // to inactive_lost (requests.ts requires replacesCredentialId).
              replacesCredentialId: response.credentialId,
              serialNumber: cred.serialNumber,
              membershipCategory: membershipCategory[0]?.membershipCategory ?? null,
              credentialExpiresAt: newExpiresAt,
              submittedAt: new Date(),
            })
            .returning();

          await createAuditEntry(tx, {
            tenantId: attestation.tenantId,
            entityType: AuditEntityType.FOB_REQUEST,
            entityId: lostRequest.id,
            action: AuditAction.CREATE,
            metadata: {
              action: "attestation_lost_report",
              attestationId: attestation.id,
              credentialId: response.credentialId,
              note: response.note ?? null,
            },
          });
        }
      }
    }

    // Update the member's current season
    await tx
      .update(tenantMemberships)
      .set({ currentSeason: attestation.season, updatedAt: new Date() })
      .where(
        and(
          eq(tenantMemberships.userId, attestation.userId),
          eq(tenantMemberships.tenantId, attestation.tenantId)
        )
      );

    await createAuditEntry(tx, {
      tenantId: attestation.tenantId,
      entityType: AuditEntityType.MEMBER,
      entityId: attestation.userId,
      action: AuditAction.UPDATE,
      metadata: {
        action: "attestation_completed",
        attestationId: attestation.id,
        season: attestation.season,
        confirmedCount: responses.filter((r) => r.confirmed).length,
        lostCount: responses.filter((r) => !r.confirmed).length,
      },
    });
  });

  return NextResponse.json({ success: true });
}
