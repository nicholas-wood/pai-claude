import * as React from "react";
import { Link } from "react-router-dom";
import { ChevronDown, ChevronRight, Info } from "lucide-react";
import type { ExplainLine } from "@contract";
import { useNetPositionExplain } from "@/lib/queries";
import { DiagnosticChat } from "@/components/budget/DiagnosticChat";
import { cn, formatCents, formatIsoDay } from "@/lib/utils";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";

/**
 * Divergence explainer sheet (v1.24.0). Opens from the net-position banner and
 * renders GET /api/net-position/explain: the algebraic components (which sum,
 * with the residual, to the unexplained delta), the usual-suspect signals, and
 * what changed since the widget was last balanced. Every line carries the
 * evidence the engine used, expandable, so the explanation reads like a hand
 * diagnosis rather than a verdict.
 */


function actionHref(action: string | undefined): string | null {
  switch (action) {
    case "open-transactions":
      return "/transactions";
    case "open-budget":
      return "/budget/edit";
    case "open-carryover":
      return "/history";
    default:
      return null;
  }
}

function signTone(cents: number): string {
  if (cents > 0) return "text-success";
  if (cents < 0) return "text-destructive";
  return "text-muted-foreground";
}

function LineRow({ line }: { line: ExplainLine }) {
  const [open, setOpen] = React.useState(false);
  return (
    <li className="py-2">
      <button
        type="button"
        onClick={() => setOpen((v) => !v)}
        className="flex w-full items-start justify-between gap-3 text-left"
        aria-expanded={open}
      >
        <span className="flex items-start gap-1.5">
          {open ? (
            <ChevronDown className="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
          ) : (
            <ChevronRight className="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
          )}
          <span className="text-sm">{line.label}</span>
        </span>
        <span className={cn("shrink-0 text-sm tabular-nums", signTone(line.cents))}>
          {formatCents(line.cents, { sign: true })}
        </span>
      </button>
      {open && (
        <div className="ml-6 mt-1 space-y-1 text-xs text-muted-foreground">
          <p>{line.detail}</p>
          <ul className="space-y-0.5">
            {line.evidence.map((e, i) => (
              <li key={i} className="font-mono text-[11px] leading-snug">
                <span className="uppercase tracking-wide opacity-70">{e.kind}</span> {e.ref}
              </li>
            ))}
          </ul>
        </div>
      )}
    </li>
  );
}

function Section({ title, hint, children }: { title: string; hint?: string; children: React.ReactNode }) {
  return (
    <section className="rounded-md border bg-muted/30 px-3 py-2">
      <p className="text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">{title}</p>
      {hint && <p className="mb-1 text-xs text-muted-foreground">{hint}</p>}
      {children}
    </section>
  );
}

export function ExplainDeltaSheet({ open, onClose }: { open: boolean; onClose: () => void }) {
  const { data, isLoading, isError } = useNetPositionExplain(open);

  return (
    <Dialog open={open} onOpenChange={(v) => (v ? undefined : onClose())}>
      <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-lg" aria-describedby="explain-desc">
        <DialogHeader>
          <DialogTitle>Why is the budget off?</DialogTitle>
          <DialogDescription id="explain-desc">
            The unexplained delta, attributed to named causes with the ledger evidence behind each.
          </DialogDescription>
        </DialogHeader>

        {isLoading && <div className="h-24 animate-pulse rounded-md border bg-card" aria-hidden />}
        {(isError || (data && !data.ok)) && (
          <p className="text-sm text-muted-foreground">
            {data && !data.ok ? data.message : "Could not load the explanation right now."}
          </p>
        )}

        {data && data.ok && (
          <div className="space-y-3">
            <div className="flex items-center justify-between rounded-md border px-3 py-2">
              {/* Attributed: components account for the delta and the engine found nothing left worth hunting (no suspects). */}
              <span className="text-sm font-medium">
                {data.reconciled
                  ? "Reconciled"
                  : data.components.length > 0 && data.signals.length === 0
                    ? "Explained"
                    : "Unexplained delta"}
              </span>
              <span className={cn("text-sm font-semibold tabular-nums", signTone(data.unexplainedDeltaCents))}>
                {formatCents(data.unexplainedDeltaCents, { sign: true })}
              </span>
            </div>

            <Section
              title="Attributed"
              hint="Algebraic parts of the delta. These plus the residual equal the figure above to the cent."
            >
              {data.components.length === 0 ? (
                <p className="py-1 text-xs text-muted-foreground">No structural cause found; the whole figure is residual.</p>
              ) : (
                <ul className="divide-y divide-border/40">
                  {data.components.map((l) => (
                    <LineRow key={l.code} line={l} />
                  ))}
                </ul>
              )}
              <div className="flex items-center justify-between border-t border-border/40 pt-2 text-sm">
                <span className="font-medium">Residual</span>
                <span className={cn("tabular-nums font-medium", signTone(data.residualCents))}>
                  {formatCents(data.residualCents, { sign: true })}
                </span>
              </div>
            </Section>

            {data.signals.length > 0 && (
              <Section title="Usual suspects" hint="Findings that often explain a divergence. Figures shown are not part of the sum above.">
                <ul className="divide-y divide-border/40">
                  {data.signals.map((l) => (
                    <LineRow key={l.code} line={l} />
                  ))}
                </ul>
              </Section>
            )}

            {/* Only a balanced day is a meaningful anchor; a decomposition against an arbitrary earliest snapshot is noise. */}
            {data.since && data.since.anchor === "balanced" && (
              <Section
                title={`Since ${formatIsoDay(data.since.date, { year: true })}`}
                hint={`The last day the widget was balanced (${formatCents(data.since.unexplainedThenCents, { sign: true })}). The change since then, decomposed exactly.`}
              >
                <div className="flex items-center justify-between py-1 text-sm">
                  <span className="font-medium">Change</span>
                  <span className={cn("tabular-nums font-medium", signTone(data.since.changeCents))}>
                    {formatCents(data.since.changeCents, { sign: true })}
                  </span>
                </div>
                <ul className="divide-y divide-border/40">
                  {data.since.changes.map((l) => (
                    <LineRow key={l.code} line={l} />
                  ))}
                </ul>
                {data.since.activity.length > 0 && (
                  <>
                    <p className="mt-2 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">In between</p>
                    <ul className="divide-y divide-border/40">
                      {data.since.activity.map((l) => (
                        <LineRow key={l.code} line={l} />
                      ))}
                    </ul>
                  </>
                )}
              </Section>
            )}

            {(!data.since || data.since.anchor !== "balanced") && (
              <p className="flex items-start gap-2 text-xs text-muted-foreground">
                <Info className="mt-0.5 h-3.5 w-3.5 shrink-0" />
                {data.since
                  ? "No balanced day on record yet. Once the widget reconciles for a day, this sheet will show what changed since then."
                  : "No snapshot yet. From tomorrow this sheet will also show what changed since the widget was last balanced."}
              </p>
            )}

            {data.suggestions.length > 0 && (
              <Section title="What to do">
                <ul className="space-y-1.5 py-1">
                  {data.suggestions.map((s, i) => {
                    const href = actionHref(s.action);
                    return (
                      <li key={i} className="text-sm">
                        {s.text}
                        {href && (
                          <>
                            {" "}
                            <Link to={href} className="text-primary underline-offset-2 hover:underline" onClick={onClose}>
                              Open
                            </Link>
                          </>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </Section>
            )}
          </div>
        )}

        {/* v1.25.0: the consented, read-only diagnostic chat, always below the deterministic explanation. */}
        <div className="mt-3">
          <DiagnosticChat open={open} />
        </div>
      </DialogContent>
    </Dialog>
  );
}
