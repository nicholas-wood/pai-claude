/**
 * Divergence explainer (v1.24.0): attributes the net-position UNEXPLAINED delta
 * to named causes, the way the owner and the assistant have done by hand in
 * every diagnosis so far, but deterministically and inside the product.
 *
 * Two kinds of finding, kept strictly apart so the arithmetic is honest:
 *
 *   components  Algebraic parts of the CURRENT delta. Their sum plus the residual
 *               equals unexplainedDeltaCents to the cent (asserted in tests). A
 *               component is only admitted when the engine's own identity says
 *               the delta moves by exactly that amount (e.g. the zero-base gap:
 *               the widget reads high by precisely the unallocated income).
 *   signals     Findings that usually explain a divergence but are not an exact
 *               algebraic part of it (a stale pending, a duplicate hold, a
 *               feed lagging the sync, recent carryover edits). They carry a
 *               dollar figure where one exists, but never enter the conservation
 *               sum.
 *
 * A third view, `since`, answers the question the owner actually asks: what
 * changed between the last time the widget was balanced and now. It is the
 * exact difference of the reconciliation snapshots the net-position route
 * writes daily, decomposed by the delta identity:
 *
 *   Δunexplained = Δ(cash − cardOwed) − Δ(totalLeft − awaiting) − Δuncategorised
 *
 * Pure functions over already-fetched data. No I/O, no clock reads (now is an input).
 */

import type { Tx } from "../platform/store.ts";
import type { BudgetChange } from "../domain/types.ts";
import type { ReconciliationSnapshot } from "../budget/ports.ts";

/** Within this the widget is treated as reconciled (mirrors the widget). */
export const EXPLAIN_TOLERANCE_CENTS = 100;
/** A residual larger than this is itself a finding, never silently absorbed. */
export const RESIDUAL_ALARM_CENTS = 2000;
/** A pending row older than this is suspect: the v1.19 prune should have dropped it. */
export const STALE_PENDING_DAYS = 7;
/** Two rows on one account, same amount and payee, within this window read as twins. */
export const DUPLICATE_WINDOW_DAYS = 5;
/** "Recent" for edit signals. */
export const RECENT_DAYS = 30;
/** A transfer's other leg must sit on another account within this many days. */
export const TRANSFER_PAIR_WINDOW_DAYS = 4;
/** How far back posted transfers are scanned for a missing leg. */
export const TRANSFER_SCAN_DAYS = 120;

const DAY_MS = 86_400_000;

export interface ExplainEvidence {
  readonly kind: "query" | "code" | "event";
  readonly ref: string;
}

export interface ExplainLine {
  readonly code: string;
  readonly label: string;
  /** Signed cents. For components, the delta moves by exactly this. */
  readonly cents: number;
  readonly detail: string;
  readonly evidence: readonly ExplainEvidence[];
}

export interface ExplainSuggestion {
  readonly text: string;
  readonly action?: "open-transactions" | "open-budget" | "open-carryover";
}

/** The net-position figures the explainer decomposes (a narrowed NetPositionResponse). */
export interface ExplainNetFigures {
  readonly cashOnHandCents: number;
  readonly cardOwedCents: number;
  readonly totalLeftCents: number;
  readonly awaitingIncomeCents: number;
  readonly uncategorisedActivityCents: number;
  readonly reconciledDeltaCents: number;
  readonly unexplainedDeltaCents: number;
  readonly cardPendingCents: number;
  readonly feedRefreshedAt?: number;
  readonly lastSyncAt?: string | null;
}

/** One materialised month's zero-base gap: budgeted income − allocations. */
export interface PeriodGap {
  readonly period: string;
  readonly unallocatedCents: number;
}

export interface CarryoverResetLine {
  readonly ts: number;
  readonly envelopeId: string;
  readonly beforeCents: number;
  readonly afterCents: number;
}

export interface ExplainInputs {
  readonly net: ExplainNetFigures;
  /** The current period key (YYYY-MM). */
  readonly period: string;
  /** Zero-base gap per materialised month up to and including `period`. */
  readonly periodGaps: readonly PeriodGap[];
  /** Uncategorised activity inside the visible grid window (the widget's line spans era start). */
  readonly visibleUncategorisedCents: number;
  readonly txs: readonly Tx[];
  readonly carryoverResets: readonly CarryoverResetLine[];
  readonly budgetHistory: readonly BudgetChange[];
  readonly envelopeNames: ReadonlyMap<string, string>;
  /** Reconciliation snapshots, any order; the explainer sorts. */
  readonly snapshots: readonly ReconciliationSnapshot[];
  /** Epoch ms "now" and the matching ISO day, both supplied by the caller. */
  readonly now: number;
  readonly today: string;
  readonly toleranceCents?: number;
}

export interface SinceExplanation {
  /** Snapshot the comparison is anchored on. */
  readonly at: number;
  readonly date: string;
  readonly anchor: "balanced" | "earliest";
  readonly unexplainedThenCents: number;
  /** Δunexplained: now − then. */
  readonly changeCents: number;
  /** Exact decomposition: sums to changeCents. */
  readonly changes: readonly ExplainLine[];
  /** What happened in between (informational). */
  readonly activity: readonly ExplainLine[];
}

export interface DeltaExplanation {
  readonly asOf: number;
  readonly period: string;
  readonly toleranceCents: number;
  readonly unexplainedDeltaCents: number;
  readonly reconciled: boolean;
  readonly components: readonly ExplainLine[];
  readonly residualCents: number;
  readonly signals: readonly ExplainLine[];
  readonly since: SinceExplanation | null;
  readonly suggestions: readonly ExplainSuggestion[];
}

function dollars(cents: number): string {
  const sign = cents < 0 ? "−" : "";
  return `${sign}$${(Math.abs(cents) / 100).toFixed(2)}`;
}

function daysBetween(isoA: string, isoB: string): number {
  return Math.abs(Date.parse(isoA) - Date.parse(isoB)) / DAY_MS;
}

function nameOf(names: ReadonlyMap<string, string>, id: string): string {
  return names.get(id) ?? id;
}

// ── unpaired transfers ────────────────────────────────────────────────────────

/**
 * A transfer-flagged row moves the bank balance and touches no envelope, no
 * uncategorised line, nothing on the budget side (spend.ts drops transfers
 * before any envelope). That is correct when the other leg lands on another
 * tracked account and cancels it. When no leg exists (the Sept 2026 case: a
 * $429.30 ATM cash deposit PocketSmith labelled "Transfers"), the widget moves
 * by exactly the row's amount. So an unpaired transfer dated AFTER the most
 * recent carryover re-strike is an algebraic component; one dated on or before
 * it may already be absorbed by that baseline and is reported as a signal.
 *
 * Pairing: another transfer-flagged row on a different account, opposite
 * amount, within the window; each leg is consumed once. Pending candidates
 * are skipped (their leg may simply not have posted yet).
 */
function findUnpairedTransfers(inputs: ExplainInputs): Tx[] {
  const cutoffDay = daysBetween("1970-01-01", inputs.today) - TRANSFER_SCAN_DAYS;
  const transfers = inputs.txs.filter((t) => t.isTransfer);
  const used = new Set<string>();
  const out: Tx[] = [];
  const candidates = transfers
    .filter((t) => !t.isPending && daysBetween("1970-01-01", t.date) >= cutoffDay)
    .sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : a.id < b.id ? -1 : 1));
  for (const t of candidates) {
    if (used.has(t.id)) continue;
    const leg = transfers.find(
      (o) =>
        o.id !== t.id &&
        !used.has(o.id) &&
        o.accountId !== t.accountId &&
        o.amountCents === -t.amountCents &&
        daysBetween(o.date, t.date) <= TRANSFER_PAIR_WINDOW_DAYS,
    );
    if (leg) {
      used.add(t.id);
      used.add(leg.id);
    } else {
      out.push(t);
    }
  }
  return out;
}

function transferLine(code: string, rows: readonly Tx[], absorbedBy: string | null): ExplainLine {
  const cents = rows.reduce((s, t) => s + t.amountCents, 0);
  const list = rows
    .slice(0, 5)
    .map((t) => `${t.date} ${t.payee} ${dollars(t.amountCents)}`)
    .join("; ") + (rows.length > 5 ? "; …" : "");
  const n = rows.length;
  return {
    code,
    label: absorbedBy
      ? `${n} transfer${n === 1 ? "" : "s"} with no matching leg (before the ${absorbedBy} re-strike)`
      : `${n} transfer${n === 1 ? "" : "s"} with no matching leg`,
    cents,
    detail:
      `${list}. Flagged as a transfer, so the money moved the bank balance but reached no envelope and no uncategorised line; ` +
      (absorbedBy
        ? `a carryover re-strike on ${absorbedBy} may already have absorbed it, so it is listed, not summed.`
        : `the widget reads ${cents >= 0 ? "high" : "low"} by exactly ${dollars(Math.abs(cents))} until the row is categorised (a cash deposit is income or a refund) or its other leg appears.`),
    evidence: [
      {
        kind: "query",
        ref: `transactions WHERE is_transfer = 1 AND is_pending = 0 with no row on another account of opposite amount within ${TRANSFER_PAIR_WINDOW_DAYS} days`,
      },
      { kind: "code", ref: "src/envelope/spend.ts transfers are excluded from every envelope; src/ingest/map.ts isTransfer copies PocketSmith's flag" },
    ],
  };
}

// ── re-strike detection ───────────────────────────────────────────────────────

/**
 * The most recent carryover reset that was a baseline RE-STRIKE, i.e. one
 * that left the widget balanced: the reconciliation snapshot for that day
 * (written on the last view of the day) is within tolerance. A reset whose
 * day's snapshot is NOT balanced was a tidy or a partial move and absorbed
 * nothing, so it must not demote a later-dated cause (the 12 Sep 2026 $14
 * Buffer tidy must not hide the still-unpaired $129.30 leg). With no
 * snapshot on record for the day (pre-v1.24.0 resets) the reset is assumed
 * to be a re-strike, the conservative reading.
 */
function reStrikeDay(inputs: ExplainInputs, tolerance: number): string | null {
  const byDay = new Map<string, ReconciliationSnapshot>();
  for (const s of inputs.snapshots) byDay.set(s.date, s);
  const resets = [...inputs.carryoverResets].sort((a, b) => b.ts - a.ts);
  for (const r of resets) {
    const day = new Date(r.ts).toISOString().slice(0, 10);
    const snap = byDay.get(day);
    if (snap === undefined || Math.abs(snap.unexplainedDeltaCents) <= tolerance) return day;
  }
  return null;
}

// ── components ────────────────────────────────────────────────────────────────

function componentLines(inputs: ExplainInputs, lastResetDay: string | null): ExplainLine[] {
  const out: ExplainLine[] = [];
  const unpaired = findUnpairedTransfers(inputs);
  const live = unpaired.filter((t) => lastResetDay === null || t.date > lastResetDay);
  if (live.length > 0) out.push(transferLine("unpaired-transfer", live, null));
  const current = inputs.periodGaps.find((g) => g.period === inputs.period);
  const currentGap = current?.unallocatedCents ?? 0;
  if (currentGap !== 0) {
    out.push({
      code: "zero-base-gap",
      label: `Unallocated income this month (${inputs.period})`,
      cents: currentGap,
      detail:
        currentGap > 0
          ? `Budgeted income exceeds allocations by ${dollars(currentGap)}; the widget reads high by exactly that until every dollar has a job.`
          : `Allocations exceed budgeted income by ${dollars(-currentGap)}; the widget reads low by exactly that.`,
      evidence: [
        { kind: "code", ref: "src/budget/zerobased.ts zeroBasedCheck (income budgeted − allocations)" },
        { kind: "query", ref: `allocations WHERE period = '${inputs.period}' vs income budget lines effective in ${inputs.period}` },
      ],
    });
  }
  return out;
}

// ── signals ───────────────────────────────────────────────────────────────────

function pendingSignals(inputs: ExplainInputs): ExplainLine[] {
  const out: ExplainLine[] = [];
  const pendings = inputs.txs.filter((t) => t.isPending && !t.isTransfer);

  const stale = pendings.filter((t) => daysBetween(t.date, inputs.today) > STALE_PENDING_DAYS);
  if (stale.length > 0) {
    const cents = stale.reduce((s, t) => s + t.amountCents, 0);
    out.push({
      code: "stale-pending",
      label: `${stale.length} pending ${stale.length === 1 ? "hold" : "holds"} older than ${STALE_PENDING_DAYS} days`,
      cents,
      detail:
        stale
          .slice(0, 5)
          .map((t) => `${t.date} ${t.payee} ${dollars(t.amountCents)}`)
          .join("; ") + (stale.length > 5 ? "; …" : ""),
      evidence: [
        { kind: "query", ref: `transactions WHERE is_pending = 1 AND txn_date < today − ${STALE_PENDING_DAYS}d` },
        { kind: "code", ref: "src/ingest/sync.ts stale-pending prune (v1.19) should have dropped these" },
      ],
    });
  }

  // Twins: a pending with another row on the same account, same amount and
  // payee, within the window. The v1.23 diagnosis found one ("Pria Bax" $280).
  const twins: Tx[] = [];
  for (const p of pendings) {
    const twin = inputs.txs.find(
      (o) =>
        o.id !== p.id &&
        o.accountId === p.accountId &&
        o.amountCents === p.amountCents &&
        o.payee === p.payee &&
        !o.isTransfer &&
        daysBetween(o.date, p.date) <= DUPLICATE_WINDOW_DAYS,
    );
    if (twin) twins.push(p);
  }
  if (twins.length > 0) {
    const cents = twins.reduce((s, t) => s + t.amountCents, 0);
    out.push({
      code: "duplicate-pending",
      label: `${twins.length} pending ${twins.length === 1 ? "hold has" : "holds have"} a matching twin`,
      cents,
      detail:
        twins
          .slice(0, 5)
          .map((t) => `${t.date} ${t.payee} ${dollars(t.amountCents)}`)
          .join("; ") + " (a feed ghost drops at posting; a real repeat stays)",
      evidence: [
        { kind: "query", ref: `transactions pairs on one account, same amount + payee, within ${DUPLICATE_WINDOW_DAYS} days` },
      ],
    });
  }
  return out;
}

/**
 * Earlier months' zero-base gaps are a SIGNAL, not a component: a baseline
 * re-strike (a carryover reset on the buffer envelope) absorbs everything
 * before it, and the engine cannot tell which reset was a re-strike. Naming
 * them is still useful; claiming them as an exact part of today's delta is not.
 */
function priorGapSignal(inputs: ExplainInputs, lastResetDay: string | null): ExplainLine | null {
  // Months up to and including the latest carryover re-strike's month are
  // absorbed by that baseline; only later months can still bear on today.
  const floor = lastResetDay === null ? "" : lastResetDay.slice(0, 7);
  const prior = inputs.periodGaps.filter((g) => g.period < inputs.period && g.period > floor && g.unallocatedCents !== 0);
  if (prior.length === 0) return null;
  const sum = prior.reduce((s, g) => s + g.unallocatedCents, 0);
  return {
    code: "prior-month-gaps",
    label: "Unallocated income in earlier months",
    cents: sum,
    detail:
      prior.map((g) => `${g.period} ${dollars(g.unallocatedCents)}`).join(", ") +
      (lastResetDay ? ` (months after the ${lastResetDay} re-strike; earlier gaps are absorbed by it)` : " (no baseline re-strike on record to absorb them)"),
    evidence: [
      { kind: "query", ref: "allocations per materialised period vs income budget lines effective that month" },
      { kind: "code", ref: "src/budget/service.ts ensureMonth reconciles missing envelopes on view (v1.23.0)" },
    ],
  };
}

function uncategorisedSignal(inputs: ExplainInputs): ExplainLine | null {
  const outside = inputs.net.uncategorisedActivityCents - inputs.visibleUncategorisedCents;
  if (outside === 0) return null;
  return {
    code: "uncategorised-outside-window",
    label: "Uncategorised activity before the visible range",
    cents: outside,
    detail: `${dollars(outside)} of uncategorised activity sits in earlier months, so the grid's own "to be categorised" line under-states what the widget already counts as explained.`,
    evidence: [
      { kind: "code", ref: "src/envelope/service.ts unresolvedActivityCents (era start) vs uncategorisedTotalCents (visible window)" },
      { kind: "query", ref: "transactions with no envelope mapping at date, txn_date < grid.from" },
    ],
  };
}

function feedSignal(inputs: ExplainInputs): ExplainLine | null {
  const { feedRefreshedAt, lastSyncAt, cardPendingCents } = inputs.net;
  if (feedRefreshedAt === undefined || !lastSyncAt) return null;
  const sync = Date.parse(lastSyncAt);
  if (Number.isNaN(sync)) return null;
  const lagMs = sync - feedRefreshedAt;
  if (lagMs <= 60 * 60 * 1000) return null;
  const hours = Math.round(lagMs / (60 * 60 * 1000));
  return {
    code: "feed-staleness",
    label: `Card feed is ${hours}h behind the last sync`,
    cents: cardPendingCents,
    detail: `The bank's card balance counts holds immediately while the grid charges them at the next sync, so the two sides can disagree by up to the pending card spend (${dollars(cardPendingCents)}) until both refresh.`,
    evidence: [{ kind: "query", ref: "PocketSmith transaction_accounts.updated_at (card) vs sync_state.last_sync_at" }],
  };
}

function editSignals(inputs: ExplainInputs): ExplainLine[] {
  const out: ExplainLine[] = [];
  const cutoff = inputs.now - RECENT_DAYS * DAY_MS;

  const resets = inputs.carryoverResets.filter((r) => r.ts >= cutoff);
  if (resets.length > 0) {
    const net = resets.reduce((s, r) => s + (r.afterCents - r.beforeCents), 0);
    out.push({
      code: "recent-carryover-edits",
      label: `${resets.length} carryover ${resets.length === 1 ? "edit" : "edits"} in the last ${RECENT_DAYS} days`,
      cents: net,
      detail: resets
        .slice(0, 5)
        .map((r) => `${nameOf(inputs.envelopeNames, r.envelopeId)} ${dollars(r.beforeCents)} → ${dollars(r.afterCents)}`)
        .join("; "),
      evidence: [{ kind: "event", ref: "events WHERE kind = 'carryover.reset' (before/after in payload)" }],
    });
  }

  // Budget-line edits are NOT a suspect: under zero-base they move an
  // allocation and its counterpart together, so the widget never moves. They
  // stay visible in the "since" activity list only.
  return out;
}

// ── since last balanced ───────────────────────────────────────────────────────

function sinceExplanation(inputs: ExplainInputs, tolerance: number): SinceExplanation | null {
  const snaps = [...inputs.snapshots].sort((a, b) => b.ts - a.ts);
  if (snaps.length === 0) return null;
  const balanced = snaps.find((s) => Math.abs(s.unexplainedDeltaCents) <= tolerance);
  const anchor = balanced ?? snaps[snaps.length - 1]!;
  const kind: SinceExplanation["anchor"] = balanced ? "balanced" : "earliest";
  const net = inputs.net;

  const liquidThen = anchor.cashOnHandCents - anchor.cardOwedCents;
  const liquidNow = net.cashOnHandCents - net.cardOwedCents;
  const leftThen = anchor.totalLeftCents - anchor.awaitingIncomeCents;
  const leftNow = net.totalLeftCents - net.awaitingIncomeCents;

  const rawChanges: ExplainLine[] = [
    {
      code: "since-liquid",
      label: "Real money moved (cash − card owed)",
      cents: liquidNow - liquidThen,
      detail: `${dollars(liquidThen)} → ${dollars(liquidNow)}`,
      evidence: [{ kind: "query", ref: "reconciliation_snapshots cash_on_hand − card_owed, then vs now" }],
    },
    {
      code: "since-left",
      label: "Budget left moved (total left − awaiting income), sign flipped",
      cents: -(leftNow - leftThen),
      detail: `${dollars(leftThen)} → ${dollars(leftNow)}`,
      evidence: [{ kind: "query", ref: "reconciliation_snapshots total_left − awaiting_income, then vs now" }],
    },
    {
      code: "since-uncategorised",
      label: "Uncategorised line moved, sign flipped",
      cents: -(net.uncategorisedActivityCents - anchor.uncategorisedCents),
      detail: `${dollars(anchor.uncategorisedCents)} → ${dollars(net.uncategorisedActivityCents)}`,
      evidence: [{ kind: "query", ref: "reconciliation_snapshots uncategorised, then vs now" }],
    },
  ];
  const changes = rawChanges.filter((l) => l.cents !== 0);
  // Conservation guard: a snapshot written by the same computation always
  // satisfies the identity, so this line should never appear. If it does, the
  // stored figures disagree with their own delta and that is worth seeing.
  const changeCents = net.unexplainedDeltaCents - anchor.unexplainedDeltaCents;
  const accounted = changes.reduce((s, l) => s + l.cents, 0);
  if (accounted !== changeCents) {
    changes.push({
      code: "since-unaccounted",
      label: "Snapshot figures do not satisfy the delta identity",
      cents: changeCents - accounted,
      detail: "The stored snapshot's components disagree with its own unexplained delta; treat the anchor with suspicion.",
      evidence: [{ kind: "code", ref: "src/reconcile/explain.ts sinceExplanation conservation guard" }],
    });
  }

  const activity: ExplainLine[] = [];
  const posted = inputs.txs.filter((t) => !t.isPending && !t.isTransfer && t.date > anchor.date);
  if (posted.length > 0) {
    activity.push({
      code: "since-posted",
      label: `${posted.length} posted transactions since ${anchor.date}`,
      cents: posted.reduce((s, t) => s + t.amountCents, 0),
      detail: "Net of posted non-transfer activity (moves both sides equally when categorised).",
      evidence: [{ kind: "query", ref: `transactions WHERE is_pending = 0 AND is_transfer = 0 AND txn_date > '${anchor.date}'` }],
    });
  }
  const resets = inputs.carryoverResets.filter((r) => r.ts > anchor.ts);
  if (resets.length > 0) {
    activity.push({
      code: "since-carryover-edits",
      label: `${resets.length} carryover ${resets.length === 1 ? "edit" : "edits"} since ${anchor.date}`,
      cents: resets.reduce((s, r) => s + (r.afterCents - r.beforeCents), 0),
      detail: resets
        .slice(0, 5)
        .map((r) => `${nameOf(inputs.envelopeNames, r.envelopeId)} ${dollars(r.beforeCents)} → ${dollars(r.afterCents)}`)
        .join("; "),
      evidence: [{ kind: "event", ref: "events WHERE kind = 'carryover.reset' AND ts > anchor" }],
    });
  }
  const edits = inputs.budgetHistory.filter((h) => h.ts > anchor.ts && h.actor !== "sync");
  if (edits.length > 0) {
    activity.push({
      code: "since-budget-edits",
      label: `${edits.length} budget ${edits.length === 1 ? "edit" : "edits"} since ${anchor.date}`,
      cents: edits.reduce((s, h) => s + (h.afterCents - h.beforeCents), 0),
      detail: edits
        .slice(0, 5)
        .map((h) => `${nameOf(inputs.envelopeNames, h.envelopeId)} ${dollars(h.beforeCents)} → ${dollars(h.afterCents)}/mo`)
        .join("; "),
      evidence: [{ kind: "query", ref: "budget_history WHERE ts > anchor AND actor <> 'sync'" }],
    });
  }
  const gapThen = anchor.unallocatedCents;
  const gapNow = inputs.periodGaps.find((g) => g.period === inputs.period)?.unallocatedCents ?? 0;
  if (gapNow !== gapThen) {
    activity.push({
      code: "since-zero-base",
      label: "Zero-base gap moved",
      cents: gapNow - gapThen,
      detail: `${dollars(gapThen)} → ${dollars(gapNow)} unallocated`,
      evidence: [{ kind: "query", ref: "reconciliation_snapshots unallocated, then vs now" }],
    });
  }

  return {
    at: anchor.ts,
    date: anchor.date,
    anchor: kind,
    unexplainedThenCents: anchor.unexplainedDeltaCents,
    changeCents,
    changes,
    activity,
  };
}

// ── suggestions ───────────────────────────────────────────────────────────────

function suggestions(
  components: readonly ExplainLine[],
  signals: readonly ExplainLine[],
  residual: number,
  hunting: boolean,
  timingBand: number,
  tolerance: number,
): ExplainSuggestion[] {
  const out: ExplainSuggestion[] = [];
  if (!hunting && Math.abs(residual) > tolerance) {
    out.push({
      text: `${dollars(residual)} remains, inside the ${dollars(timingBand)} the bank and the grid can disagree by while card holds are pending; it moves day to day and needs no action.`,
    });
  }
  const has = (code: string) => components.some((l) => l.code === code) || signals.some((l) => l.code === code);
  if (has("unpaired-transfer") || has("unpaired-transfer-absorbed")) {
    out.push({
      text: "Each transfer named above has no other leg, so its cash counts and no envelope does. In PocketSmith, give it a real category (a cash deposit is income or a refund) or clear its transfer flag; if the other leg sits on an account PocketSmith does not track, that is the whole explanation.",
      action: "open-transactions",
    });
  }
  if (has("zero-base-gap")) {
    out.push({ text: "Give the unallocated income a job (or trim allocations) so the budget balances to zero.", action: "open-budget" });
  }
  if (has("stale-pending") || has("duplicate-pending")) {
    out.push({ text: "Check the pending rows named above; a hold the bank has dropped will clear at the next sync, a real repeat needs an envelope.", action: "open-transactions" });
  }
  if (has("feed-staleness")) {
    out.push({ text: "Wait for the card feed to refresh, or run a sync, before adjusting anything." });
  }
  if (has("recent-carryover-edits")) {
    out.push({ text: "A carryover edit moves the budget side directly; if one was a baseline re-strike, the residual is what it left behind.", action: "open-carryover" });
  }
  if (hunting) {
    out.push({ text: `${dollars(residual)} is unattributed after the known causes; that is the figure to investigate, not the headline.` });
  }
  return out;
}

// ── entry point ───────────────────────────────────────────────────────────────

/** Explain the current unexplained delta. Pure. */
export function explainDelta(inputs: ExplainInputs): DeltaExplanation {
  const tolerance = inputs.toleranceCents ?? EXPLAIN_TOLERANCE_CENTS;
  const unexplained = inputs.net.unexplainedDeltaCents;

  const lastResetDay = reStrikeDay(inputs, tolerance);
  const components = componentLines(inputs, lastResetDay);
  const attributed = components.reduce((s, l) => s + l.cents, 0);
  const residualCents = unexplained - attributed;

  // Suspects are for hunting a residual. Once the components account for the
  // delta to within dust, listing them is noise (owner, 2026-09-12: "remove the
  // rest of the noise"), so the whole list is gated on the residual alarm.
  // The floor is the larger of the alarm threshold and the pending card spend:
  // the bank counts a hold the moment it is placed while the grid charges it
  // at the next sync, so the two sides legitimately disagree by up to that
  // amount from day to day. A residual inside that band is timing, not a cause.
  const timingBand = Math.max(RESIDUAL_ALARM_CENTS, Math.abs(inputs.net.cardPendingCents));
  const hunting = Math.abs(residualCents) > timingBand;
  const unpaired = hunting ? findUnpairedTransfers(inputs) : [];
  const absorbed = lastResetDay === null ? [] : unpaired.filter((t) => t.date <= lastResetDay);
  const signals: ExplainLine[] = hunting
    ? [
        ...(absorbed.length > 0 ? [transferLine("unpaired-transfer-absorbed", absorbed, lastResetDay)] : []),
        ...pendingSignals(inputs),
        ...[priorGapSignal(inputs, lastResetDay)].filter((l): l is ExplainLine => l !== null),
        ...[uncategorisedSignal(inputs)].filter((l): l is ExplainLine => l !== null),
        ...[feedSignal(inputs)].filter((l): l is ExplainLine => l !== null),
        ...editSignals(inputs),
      ]
    : [];
  if (hunting) {
    signals.push({
      code: "residual-alarm",
      label: "Unattributed residual above threshold",
      cents: residualCents,
      detail: `${dollars(residualCents)} remains after the algebraic components. This is the figure that needs a hand diagnosis; the signals above are the usual suspects.`,
      evidence: [{ kind: "code", ref: "src/reconcile/explain.ts RESIDUAL_ALARM_CENTS" }],
    });
  }

  return {
    asOf: inputs.now,
    period: inputs.period,
    toleranceCents: tolerance,
    unexplainedDeltaCents: unexplained,
    reconciled: Math.abs(unexplained) <= tolerance,
    components,
    residualCents,
    signals,
    since: sinceExplanation(inputs, tolerance),
    suggestions: suggestions(components, signals, residualCents, hunting, timingBand, tolerance),
  };
}
