// Apply the Buffer carryover tidy through the app's own service method (audited carryover.reset event).
// Usage: PENNY_SQLITE_PATH=<db> bun buffer-reset.ts <newStoredCarryoverCents>
import { buildContainer } from "/home/nicholas-wood/Documents/workspace/projects/envelope-os/src/composition.ts";
import { buildServices } from "/home/nicholas-wood/Documents/workspace/projects/envelope-os/src/server/services.ts";
import { computeNetPosition, explainNetPosition } from "/home/nicholas-wood/Documents/workspace/projects/envelope-os/src/server/net-position.ts";
const BUFFER = "51a901bc-5ad1-45d9-82b8-6de2e7d81a0b";
const target = Number(process.argv[2]);
if (!Number.isInteger(target)) throw new Error("target cents required");
const container = await buildContainer();
const services = buildServices(container);
const userId = "local" as never;
const res = await services.envelopes.resetCarryover(userId, BUFFER, target, false);
console.log("RESET", JSON.stringify(res), "db=", process.env.PENNY_SQLITE_PATH);
const computed = await computeNetPosition(container, services, userId);
const ex = await explainNetPosition(container, services, userId, computed);
console.log("AFTER unexplained", computed.res.unexplainedDeltaCents, "residual", ex?.residualCents, "components", ex?.components.map((c) => `${c.code}:${c.cents}`).join(","), "signals", ex?.signals.length);
