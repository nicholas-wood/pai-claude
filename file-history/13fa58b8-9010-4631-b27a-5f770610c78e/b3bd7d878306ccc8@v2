// Reproduction + verification probe: Edit category → Parent picker options.
// Usage: bun parent-picker.probe.mjs [--apply]   (--apply selects Apartment Leasing and saves)
import puppeteer from "/home/nicholas-wood/.claude/PAI/TOOLS/DrawioExport/node_modules/puppeteer/lib/esm/puppeteer/puppeteer.js";

const BASE = "http://127.0.0.1:8899";
const APPLY = process.argv.includes("--apply");
const TARGET = "env-council-rates";
const PARENT_LABEL = "Apartment Leasing";

const browser = await puppeteer.launch({ headless: "new", args: ["--no-sandbox"] });
const out = {};
try {
  const page = await browser.newPage();
  await page.setViewport({ width: 390, height: 844, isMobile: true, hasTouch: true });
  const reqs = [];
  const details = [];
  page.on("request", (r) => {
    if (r.method() === "POST" && r.url().includes("/api/envelopes/edit")) reqs.push(r.postData());
  });
  page.on("response", async (r) => {
    if (r.url().includes("/api/envelopes/detail")) {
      try {
        const j = await r.json();
        details.push({ url: r.url().replace(BASE, ""), parentId: j?.envelope?.parentId ?? null, t: Date.now() });
      } catch {}
    }
  });

  await page.goto(`${BASE}/`, { waitUntil: "networkidle0" });
  if (page.url().includes("/signin")) {
    await page.waitForSelector('input[type="password"]');
    await page.type('input[type="password"]', "1234");
    await page.click('button[type="submit"]');
    await page.waitForNavigation({ waitUntil: "networkidle0" }).catch(() => {});
  }
  await page.goto(`${BASE}/envelope/${TARGET}`, { waitUntil: "networkidle0" });
  await page.waitForFunction(
    () => [...document.querySelectorAll("button")].some((b) => b.textContent.includes("Edit category")),
    { timeout: 15000 },
  );
  await page.evaluate(() => {
    [...document.querySelectorAll("button")].find((b) => b.textContent.includes("Edit category")).click();
  });
  await page.waitForSelector('[role="dialog"]', { timeout: 5000 });
  await new Promise((r) => setTimeout(r, 1200)); // let any lazy grid fetch settle

  out.dialogTitle = await page.$eval('[role="dialog"] h2', (h) => h.textContent);
  out.triggerText = await page.$eval('[role="dialog"] [role="combobox"]', (el) => el.textContent.trim());

  // Open the parent dropdown by touch tap (the gesture class that matters on Nick's phone).
  const box = await page.$eval('[role="dialog"] [role="combobox"]', (el) => {
    const r = el.getBoundingClientRect();
    return { x: r.x + r.width / 2, y: r.y + r.height / 2 };
  });
  await page.touchscreen.tap(box.x, box.y);
  await page.waitForSelector('[role="listbox"]', { timeout: 5000 });
  out.options = await page.$$eval('[role="option"]', (els) => els.map((e) => e.textContent.trim()));
  out.optionCount = out.options.length;
  out.hasApartmentLeasing = out.options.includes(PARENT_LABEL);

  if (APPLY && out.hasApartmentLeasing) {
    // Filter with the search box, then Enter commits the first match (the
    // documented fast path); avoids tapping an off-screen option.
    await page.waitForSelector('[role="listbox"] input, [role="listbox"] ~ * input, input[placeholder]', { timeout: 3000 });
    const inputHandle = await page.evaluateHandle(() =>
      [...document.querySelectorAll("input")].find((i) => i.placeholder && !i.closest('[role="dialog"] form')),
    );
    await inputHandle.asElement().focus();
    await page.keyboard.type(PARENT_LABEL, { delay: 10 });
    await new Promise((r) => setTimeout(r, 200));
    out.filteredOptions = await page.$$eval('[role="option"]', (els) => els.map((e) => e.textContent.trim()));
    await page.keyboard.press("Enter");
    await new Promise((r) => setTimeout(r, 400));
    out.listboxStillOpen = Boolean(await page.$('[role="listbox"]'));
    out.triggerAfterPick = await page.$eval('[role="dialog"] [role="combobox"]', (el) => el.textContent.trim());
    await page.evaluate(() => {
      [...document.querySelectorAll('[role="dialog"] button')].find((b) => b.textContent.includes("Save category")).click();
    });
    try {
      await page.waitForFunction(() => !document.querySelector('[role="dialog"]'), { timeout: 8000 });
      out.dialogClosed = true;
    } catch {
      out.dialogClosed = false;
      out.dialogError = await page.$eval('[role="dialog"]', (d) => d.textContent.slice(0, 300)).catch(() => null);
    }
    out.editRequests = reqs;
    await new Promise((r) => setTimeout(r, 3000));
    out.detailResponsesAfterSave = details.slice(-3);
    // Reopen and read the current parent.
    await page.evaluate(() => {
      [...document.querySelectorAll("button")].find((b) => b.textContent.includes("Edit category")).click();
    });
    await page.waitForSelector('[role="dialog"]', { timeout: 5000 });
    await new Promise((r) => setTimeout(r, 1500));
    out.triggerAfterReopen = await page.$eval('[role="dialog"] [role="combobox"]', (el) => el.textContent.trim());
    out.triggerValueAttr = await page.$eval('[role="dialog"] [role="combobox"]', (el) => el.getAttribute("data-value") ?? el.outerHTML.slice(0, 200));
  }
} catch (e) {
  out.error = String(e);
} finally {
  await browser.close();
}
console.log("RESULTS", JSON.stringify(out, null, 1));
