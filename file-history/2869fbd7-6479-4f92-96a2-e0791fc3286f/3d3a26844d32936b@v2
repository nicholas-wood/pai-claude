// Render SOP markdown onto the v1.3 LSV SOP docx shell (template surgery: keep every part, replace body).
import { readFileSync, writeFileSync, existsSync, unlinkSync, readdirSync } from "fs";
import { $ } from "bun";

const [mdPath, tplDir, outPath, footerText] = Bun.argv.slice(2);
const md = readFileSync(mdPath, "utf8");
const docPath = `${tplDir}/word/document.xml`;
const doc = readFileSync(docPath, "utf8");

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const BODY_RPR = `<w:rFonts w:eastAsia="Arial" w:cs="Arial"/><w:sz w:val="20"/><w:szCs w:val="20"/>`;

// Inline markup -> runs. Supports **bold**, *italic*.
function runs(text: string, extraRpr = "", sz?: number): string {
  const out: string[] = [];
  const re = /(\*\*[^*]+\*\*|\*[^*]+\*)/g;
  let last = 0, m: RegExpExecArray | null;
  const push = (t: string, b = false, i = false) => {
    if (!t) return;
    const rpr = `<w:rPr>${b ? "<w:b/><w:bCs/>" : ""}${i ? "<w:i/><w:iCs/>" : ""}${extraRpr}${sz ? `<w:sz w:val="${sz}"/><w:szCs w:val="${sz}"/>` : ""}</w:rPr>`;
    out.push(`<w:r>${rpr}<w:t xml:space="preserve">${esc(t)}</w:t></w:r>`);
  };
  while ((m = re.exec(text))) {
    push(text.slice(last, m.index));
    const tok = m[0];
    if (tok.startsWith("**")) push(tok.slice(2, -2), true); else push(tok.slice(1, -1), false, true);
    last = m.index + tok.length;
  }
  push(text.slice(last));
  return out.join("");
}

const para = (inner: string, ppr: string) => `<w:p><w:pPr>${ppr}</w:pPr>${inner}</w:p>`;
const bodyPpr = `<w:widowControl w:val="0"/><w:spacing w:after="120" w:line="259" w:lineRule="auto"/><w:ind w:left="119" w:right="380"/><w:rPr>${BODY_RPR}</w:rPr>`;
const listPpr = `<w:pStyle w:val="ListParagraph"/><w:widowControl w:val="0"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr><w:spacing w:after="120"/><w:ind w:left="714" w:right="380" w:hanging="357"/><w:rPr>${BODY_RPR}</w:rPr>`;
const numPpr = `<w:widowControl w:val="0"/><w:spacing w:after="60"/><w:ind w:left="714" w:right="380" w:hanging="357"/><w:rPr>${BODY_RPR}</w:rPr>`;

function title(text: string) {
  const rpr = `<w:color w:val="FFFFFF" w:themeColor="background1"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:shd w:val="clear" w:color="auto" w:fill="014F7D"/>`;
  return `<w:p><w:pPr><w:pStyle w:val="Title"/><w:rPr><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr></w:pPr><w:r><w:rPr>${rpr}</w:rPr><w:t xml:space="preserve">${esc(text)}</w:t></w:r></w:p>`;
}

function table(rows: string[][]): string {
  const cols = rows[0].length;
  const total = 9351;
  let widths: number[];
  if (cols >= 9) { const first = 2700; const w = Math.floor((total - first) / (cols - 1)); widths = [first, ...Array(cols - 1).fill(w)]; }
  else if (cols === 8) { const first = 1500; const w = Math.floor((total - first) / 7); widths = [first, ...Array(7).fill(w)]; }
  else if (cols === 4) widths = [800, 2600, 3500, 2451];
  else if (cols === 3) widths = [1400, 5000, 2951];
  else if (cols === 2) widths = [2600, 6751];
  else widths = Array(cols).fill(Math.floor(total / cols));
  const sz = cols >= 5 ? 16 : 18;
  const grid = widths.map((w) => `<w:gridCol w:w="${w}"/>`).join("");
  const tr = rows.map((cells, ri) => {
    const tcs = cells.map((c, ci) => {
      const shd = ri === 0 ? `<w:shd w:val="clear" w:color="auto" w:fill="F2F2F2" w:themeFill="background1" w:themeFillShade="F2"/>` : "";
      const jc = cols >= 9 && ci > 0 ? `<w:jc w:val="center"/>` : "";
      const inner = runs(c.trim(), ri === 0 ? "<w:b/><w:bCs/>" : "", sz);
      return `<w:tc><w:tcPr><w:tcW w:w="${widths[ci]}" w:type="dxa"/>${shd}</w:tcPr><w:p><w:pPr><w:spacing w:after="0"/>${jc}<w:rPr><w:sz w:val="${sz}"/><w:szCs w:val="${sz}"/></w:rPr></w:pPr>${inner}</w:p></w:tc>`;
    }).join("");
    const trPr = ri === 0 ? `<w:trPr><w:tblHeader/></w:trPr>` : `<w:trPr><w:cantSplit/></w:trPr>`;
    return `<w:tr>${trPr}${tcs}</w:tr>`;
  }).join("");
  return `<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="${total}" w:type="dxa"/><w:tblLook w:val="04A0" w:firstRow="1" w:lastRow="0" w:firstColumn="1" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid>${grid}</w:tblGrid>${tr}</w:tbl><w:p><w:pPr><w:spacing w:after="0"/></w:pPr></w:p>`;
}

// Parse markdown blocks
const lines = md.split("\n");
const parts: string[] = [];
let i = 0;
while (i < lines.length) {
  const l = lines[i];
  if (!l.trim()) { i++; continue; }
  if (l.startsWith("# ")) { parts.push(title(l.slice(2))); i++; continue; }
  if (l.startsWith("## ")) { parts.push(para(runs(l.slice(3)), `<w:pStyle w:val="Heading1"/>`)); i++; continue; }
  if (l.startsWith("### ")) { parts.push(para(runs(l.slice(4)), `<w:pStyle w:val="Heading2"/>`)); i++; continue; }
  if (l.trim() === "---") { parts.push(`<w:p><w:r><w:br w:type="page"/></w:r></w:p>`); i++; continue; }
  if (l.startsWith("|")) {
    const rows: string[][] = [];
    while (i < lines.length && lines[i].startsWith("|")) {
      const row = lines[i];
      if (!/^\|\s*-{3,}/.test(row)) rows.push(row.replace(/^\||\|$/g, "").split("|"));
      i++;
    }
    parts.push(table(rows)); continue;
  }
  if (l.startsWith("- ")) { parts.push(para(runs(l.slice(2)), listPpr)); i++; continue; }
  if (/^\d+\. /.test(l)) { parts.push(para(runs(l), numPpr)); i++; continue; }
  // paragraph (join wrapped lines)
  let text = l; i++;
  while (i < lines.length && lines[i].trim() && !/^(#|\||- |\d+\. |---)/.test(lines[i])) { text += " " + lines[i]; i++; }
  parts.push(para(runs(text), bodyPpr));
}

const sect = doc.match(/<w:sectPr[\s\S]*?<\/w:sectPr>/)![0];
const head = doc.slice(0, doc.indexOf("<w:body>") + "<w:body>".length);
const newDoc = `${head}${parts.join("")}${sect}</w:body></w:document>`;
writeFileSync(docPath, newDoc);

// Footer effective-date line
const fPath = `${tplDir}/word/footer1.xml`;
let footer = readFileSync(fPath, "utf8");
const startIdx = footer.indexOf("<w:t>Effe");
const endIdx = footer.indexOf(" 2025</w:t>");
if (startIdx > 0 && endIdx > 0) {
  const runStart = footer.lastIndexOf("<w:r ", startIdx) >= 0 ? Math.max(footer.lastIndexOf("<w:r ", startIdx), footer.lastIndexOf("<w:r>", startIdx)) : footer.lastIndexOf("<w:r>", startIdx);
  const runEnd = footer.indexOf("</w:r>", endIdx) + "</w:r>".length;
  const firstRun = footer.slice(runStart, footer.indexOf("</w:r>", runStart) + 6);
  const rpr = (firstRun.match(/<w:rPr>[\s\S]*?<\/w:rPr>/) || [""])[0];
  footer = footer.slice(0, runStart) + `<w:r>${rpr}<w:t xml:space="preserve">${esc(footerText || "Effective Date – Draft v2.0, not yet endorsed")}</w:t></w:r>` + footer.slice(runEnd);
  writeFileSync(fPath, footer);
  console.log("footer updated");
} else console.log("footer pattern not found", startIdx, endIdx);

// Strip comment parts (body no longer references them)
const relsPath = `${tplDir}/word/_rels/document.xml.rels`;
let rels = readFileSync(relsPath, "utf8");
rels = rels.replace(/<Relationship [^>]*Target="(comments[^"]*|people\.xml)"[^>]*\/>/g, "");
writeFileSync(relsPath, rels);
const ctPath = `${tplDir}/[Content_Types].xml`;
let ct = readFileSync(ctPath, "utf8");
ct = ct.replace(/<Override [^>]*PartName="\/word\/(comments[^"]*|people\.xml)"[^>]*\/>/g, "");
writeFileSync(ctPath, ct);
for (const f of readdirSync(`${tplDir}/word`)) if (/^comments|^people\.xml$/.test(f)) unlinkSync(`${tplDir}/word/${f}`);

if (existsSync(outPath)) unlinkSync(outPath);
await $`cd ${tplDir} && zip -q -r -X ${outPath} .`;
console.log("wrote", outPath, "blocks:", parts.length);
