/**
 * Tenant isolation regression test.
 *
 * Context: artifacts/reviews/2026-07-02-distinguished-review/ found that
 * Postgres RLS (FORCE ROW LEVEL SECURITY, packages/db/drizzle/0001_rls_policies.sql)
 * is inert in production — the app connects as a role that bypasses it — so
 * isolation currently rests entirely on app-layer tenant_id predicates.
 * Several of those predicates were missing (config-crud.ts, members
 * fob-count query, transitionRequest's fetch-by-id) and have been fixed on
 * this branch. This file is the artefact that stops the whole bug class
 * from recurring silently: it exercises the REAL exported route handlers
 * and service functions (not reimplemented logic) against two seeded
 * tenants that share a member, and asserts tenant A can never read or
 * mutate tenant B's members, credentials, requests, or config through them.
 *
 * Two independent checks live in this file:
 *
 * 1. RLS_TABLES coverage guard (schema reflection only, no DB required).
 *    Runs unconditionally, including in this sandbox.
 *
 * 2. Cross-tenant isolation suite (requires a real Postgres test DB with
 *    migrations applied — the CI job already provisions one and runs
 *    `bun run db:migrate` before `bun run test`, see .github/workflows/ci.yml).
 *    Gated on `DATABASE_URL` being set. In the environment this test was
 *    written in there is no reachable Postgres (no docker, no local
 *    postgres binary), so section 2 is SKIPPED here and has not been
 *    observed passing by this agent. It is written to run for real the
 *    next time this suite executes with DATABASE_URL pointed at a
 *    migrated database — confirm it goes green in CI or locally against
 *    docker-compose's postgres service before treating this ISC as closed.
 */
import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
import { and, eq, is } from "drizzle-orm";
import { PgTable, getTableConfig } from "drizzle-orm/pg-core";
import {
  RequestStatus,
  RequestType,
  CredentialStatus,
  AdminRoleType,
  accessLevelSchema,
  pickupLocationSchema,
} from "@accessbuddy/shared";
import type { AuthContext } from "@/lib/auth";

// ─────────────────────────────────────────────────────────────────────────
// 1. RLS coverage guard — no DB required, always runs
// ─────────────────────────────────────────────────────────────────────────

describe("RLS_TABLES coverage guard", () => {
  it("every schema table with a tenant_id column is listed in RLS_TABLES (or explicitly excluded with a reason)", async () => {
    const dbPackage = await import("@accessbuddy/db");
    const { RLS_TABLES } = dbPackage;

    // Keep this list in sync with the exclusion comment above RLS_TABLES in
    // packages/db/src/rls.ts. Anything added here without a matching, reasoned
    // comment there is a regression, not a fix.
    const DOCUMENTED_EXCLUSIONS = new Set<string>([
      "notification_templates", // nullable tenant_id for global defaults; RLS would wrongly exclude NULL rows; handled at app layer.
    ]);

    const missing: string[] = [];
    for (const value of Object.values(dbPackage)) {
      if (!is(value, PgTable)) continue;
      const config = getTableConfig(value as InstanceType<typeof PgTable>);
      const hasTenantIdColumn = config.columns.some(
        (c) => c.name === "tenant_id"
      );
      if (!hasTenantIdColumn) continue;
      if (DOCUMENTED_EXCLUSIONS.has(config.name)) continue;
      if (!(RLS_TABLES as readonly string[]).includes(config.name)) {
        missing.push(config.name);
      }
    }

    expect(missing).toEqual([]);
  });
});

// ─────────────────────────────────────────────────────────────────────────
// 2. Cross-tenant isolation — requires a real Postgres DB with migrations
//    applied. Gated on DATABASE_URL; see file header for honesty about
//    whether this has actually been run.
// ─────────────────────────────────────────────────────────────────────────

const DATABASE_AVAILABLE = !!process.env.DATABASE_URL;

if (!DATABASE_AVAILABLE) {
  // eslint-disable-next-line no-console
  console.warn(
    "[tenant-isolation.test.ts] DATABASE_URL is not set — skipping the " +
      "cross-tenant isolation suite. This suite requires a real Postgres " +
      "database with migrations applied (see docker-compose.yml's " +
      "`postgres` service, or the CI `test` job). It has not been observed " +
      "passing in this environment; run it before treating tenant isolation " +
      "as verified."
  );
}

describe.skipIf(!DATABASE_AVAILABLE)(
  "cross-tenant isolation (real DB required)",
  () => {
    let db: typeof import("@accessbuddy/db").db;
    let tenants: typeof import("@accessbuddy/db").tenants;
    let users: typeof import("@accessbuddy/db").users;
    let tenantMemberships: typeof import("@accessbuddy/db").tenantMemberships;
    let credentials: typeof import("@accessbuddy/db").credentials;
    let credentialTypes: typeof import("@accessbuddy/db").credentialTypes;
    let accessLevels: typeof import("@accessbuddy/db").accessLevels;
    let pickupLocations: typeof import("@accessbuddy/db").pickupLocations;
    let fobRequests: typeof import("@accessbuddy/db").fobRequests;
    let auditLog: typeof import("@accessbuddy/db").auditLog;
    let withTenant: typeof import("@/lib/with-tenant").withTenant;
    let transitionRequest: typeof import("@/lib/services/requests").transitionRequest;
    let membersGET: typeof import("@/app/api/v1/t/[slug]/members/route").GET;
    let accessLevelsPUT: typeof import("@/app/api/v1/t/[slug]/config/access-levels/[itemId]/route").PUT;
    let pickupLocationsDELETE: typeof import("@/app/api/v1/t/[slug]/config/pickup-locations/[itemId]/route").DELETE;
    let mockAuth: { current: AuthContext | null };

    let tenantA: { id: string; slug: string };
    let tenantB: { id: string; slug: string };
    let sharedUser: { id: string };
    let credTypeA: { id: string };
    let credTypeB: { id: string };
    let accessLevelA: { id: string };
    let accessLevelB: { id: string };
    let pickupLocA: { id: string };
    let pickupLocB: { id: string };
    let credentialA: { id: string };
    let credentialB: { id: string };
    let requestA: { id: string };
    let requestB: { id: string };

    beforeAll(async () => {
      // Mock only @/lib/auth's getAuthUser — resolveTenant, checkPermission,
      // withTenant, transitionRequest, and the route handlers themselves all
      // run unmodified, exactly as they do in production. This mock stands
      // in for "the request arrived with a valid Firebase session", nothing
      // more; it does not touch tenant resolution or permission logic.
      mockAuth = { current: null };
      vi.doMock("@/lib/auth", async (importOriginal) => {
        const actual = await importOriginal<typeof import("@/lib/auth")>();
        return {
          ...actual,
          getAuthUser: vi.fn(async () => mockAuth.current),
        };
      });

      const dbPackage = await import("@accessbuddy/db");
      db = dbPackage.db;
      tenants = dbPackage.tenants;
      users = dbPackage.users;
      tenantMemberships = dbPackage.tenantMemberships;
      credentials = dbPackage.credentials;
      credentialTypes = dbPackage.credentialTypes;
      accessLevels = dbPackage.accessLevels;
      pickupLocations = dbPackage.pickupLocations;
      fobRequests = dbPackage.fobRequests;
      auditLog = dbPackage.auditLog;

      ({ withTenant } = await import("@/lib/with-tenant"));
      ({ transitionRequest } = await import("@/lib/services/requests"));
      ({ GET: membersGET } = await import(
        "@/app/api/v1/t/[slug]/members/route"
      ));
      ({ PUT: accessLevelsPUT } = await import(
        "@/app/api/v1/t/[slug]/config/access-levels/[itemId]/route"
      ));
      ({ DELETE: pickupLocationsDELETE } = await import(
        "@/app/api/v1/t/[slug]/config/pickup-locations/[itemId]/route"
      ));

      const suffix = `iso-${Date.now()}`;

      // Seed two tenants directly (bypassing the API — seeding is setup,
      // not the thing under test).
      [tenantA] = await db
        .insert(tenants)
        .values({ name: `Test Club A ${suffix}`, slug: `test-a-${suffix}` })
        .returning({ id: tenants.id, slug: tenants.slug });
      [tenantB] = await db
        .insert(tenants)
        .values({ name: `Test Club B ${suffix}`, slug: `test-b-${suffix}` })
        .returning({ id: tenants.id, slug: tenants.slug });

      // The case that breaks naive ownerId-only queries: one real person,
      // a member of BOTH clubs.
      [sharedUser] = await db
        .insert(users)
        .values({
          firebaseUid: `fb-${suffix}`,
          email: `shared-${suffix}@example.com`,
          firstName: "Shared",
          lastName: "Member",
        })
        .returning({ id: users.id });

      await db.insert(tenantMemberships).values([
        { tenantId: tenantA.id, userId: sharedUser.id, status: "active" },
        { tenantId: tenantB.id, userId: sharedUser.id, status: "active" },
      ]);

      [credTypeA] = await db
        .insert(credentialTypes)
        .values({ tenantId: tenantA.id, name: "Fob A", priceCents: 0 })
        .returning({ id: credentialTypes.id });
      [credTypeB] = await db
        .insert(credentialTypes)
        .values({ tenantId: tenantB.id, name: "Fob B", priceCents: 0 })
        .returning({ id: credentialTypes.id });

      [accessLevelA] = await db
        .insert(accessLevels)
        .values({ tenantId: tenantA.id, name: "Standard A" })
        .returning({ id: accessLevels.id });
      [accessLevelB] = await db
        .insert(accessLevels)
        .values({ tenantId: tenantB.id, name: "Standard B" })
        .returning({ id: accessLevels.id });

      [pickupLocA] = await db
        .insert(pickupLocations)
        .values({ tenantId: tenantA.id, name: "Clubhouse A", isActive: true })
        .returning({ id: pickupLocations.id });
      [pickupLocB] = await db
        .insert(pickupLocations)
        .values({ tenantId: tenantB.id, name: "Clubhouse B", isActive: true })
        .returning({ id: pickupLocations.id });

      // The shared user holds one credential in EACH club.
      [credentialA] = await db
        .insert(credentials)
        .values({
          tenantId: tenantA.id,
          ownerId: sharedUser.id,
          credentialTypeId: credTypeA.id,
          status: CredentialStatus.ACTIVE,
          issuedAt: new Date(),
        })
        .returning({ id: credentials.id });
      [credentialB] = await db
        .insert(credentials)
        .values({
          tenantId: tenantB.id,
          ownerId: sharedUser.id,
          credentialTypeId: credTypeB.id,
          status: CredentialStatus.ACTIVE,
          issuedAt: new Date(),
        })
        .returning({ id: credentials.id });

      [requestA] = await db
        .insert(fobRequests)
        .values({
          tenantId: tenantA.id,
          requesterId: sharedUser.id,
          credentialTypeId: credTypeA.id,
          requestType: RequestType.NEW,
          status: RequestStatus.SUBMITTED,
        })
        .returning({ id: fobRequests.id });
      [requestB] = await db
        .insert(fobRequests)
        .values({
          tenantId: tenantB.id,
          requesterId: sharedUser.id,
          credentialTypeId: credTypeB.id,
          requestType: RequestType.NEW,
          status: RequestStatus.SUBMITTED,
        })
        .returning({ id: fobRequests.id });
    });

    afterAll(async () => {
      // Respect FK order: children before parents.
      await db.delete(auditLog).where(eq(auditLog.tenantId, tenantA.id));
      await db.delete(auditLog).where(eq(auditLog.tenantId, tenantB.id));
      await db.delete(fobRequests).where(eq(fobRequests.tenantId, tenantA.id));
      await db.delete(fobRequests).where(eq(fobRequests.tenantId, tenantB.id));
      await db.delete(credentials).where(eq(credentials.tenantId, tenantA.id));
      await db.delete(credentials).where(eq(credentials.tenantId, tenantB.id));
      await db
        .delete(tenantMemberships)
        .where(eq(tenantMemberships.tenantId, tenantA.id));
      await db
        .delete(tenantMemberships)
        .where(eq(tenantMemberships.tenantId, tenantB.id));
      await db
        .delete(pickupLocations)
        .where(eq(pickupLocations.tenantId, tenantA.id));
      await db
        .delete(pickupLocations)
        .where(eq(pickupLocations.tenantId, tenantB.id));
      await db
        .delete(accessLevels)
        .where(eq(accessLevels.tenantId, tenantA.id));
      await db
        .delete(accessLevels)
        .where(eq(accessLevels.tenantId, tenantB.id));
      await db
        .delete(credentialTypes)
        .where(eq(credentialTypes.tenantId, tenantA.id));
      await db
        .delete(credentialTypes)
        .where(eq(credentialTypes.tenantId, tenantB.id));
      await db.delete(users).where(eq(users.id, sharedUser.id));
      await db.delete(tenants).where(eq(tenants.id, tenantA.id));
      await db.delete(tenants).where(eq(tenants.id, tenantB.id));
    });

    function adminOf(tenantId: string): AuthContext {
      return {
        user: {
          id: "test-admin",
          firebaseUid: "test-admin-fb",
          email: "admin@example.com",
          firstName: "Admin",
          lastName: "User",
          phone: null,
        },
        memberships: [
          {
            tenantId,
            membershipCategory: null,
            status: "active",
            role: { roleType: AdminRoleType.CLUB_ADMIN, permissions: [] },
          },
        ],
      };
    }

    it("members list: tenant A admin sees the shared member's fob count scoped to tenant A only", async () => {
      mockAuth.current = adminOf(tenantA.id);

      const response = await membersGET(
        { url: `http://localhost/api/v1/t/${tenantA.slug}/members` } as any,
        { params: Promise.resolve({ slug: tenantA.slug }) }
      );
      expect(response.status).toBe(200);
      const body = await response.json();

      const sharedRow = body.members.find(
        (m: { userId: string }) => m.userId === sharedUser.id
      );
      expect(sharedRow).toBeDefined();
      // Before the fix, this summed the shared user's credentials across
      // BOTH tenants (ownerId-only filter). It must show exactly tenant A's
      // one active credential, not two.
      expect(sharedRow.fobSummary[CredentialStatus.ACTIVE]).toBe(1);
    });

    it("config PUT: tenant A admin cannot update tenant B's access level by id", async () => {
      mockAuth.current = adminOf(tenantA.id);

      const response = await accessLevelsPUT(
        {
          json: async () => accessLevelSchema.partial().parse({ name: "Hijacked" }),
        } as any,
        {
          params: Promise.resolve({
            slug: tenantA.slug,
            itemId: accessLevelB.id,
          }),
        }
      );

      expect(response.status).toBe(404);

      const [row] = await db
        .select({ name: accessLevels.name })
        .from(accessLevels)
        .where(eq(accessLevels.id, accessLevelB.id));
      expect(row?.name).toBe("Standard B");
    });

    it("config DELETE: tenant A admin cannot delete/deactivate tenant B's pickup location by id", async () => {
      mockAuth.current = adminOf(tenantA.id);

      await pickupLocationsDELETE(
        {} as any,
        {
          params: Promise.resolve({
            slug: tenantA.slug,
            itemId: pickupLocB.id,
          }),
        }
      );

      const [row] = await db
        .select({ isActive: pickupLocations.isActive })
        .from(pickupLocations)
        .where(eq(pickupLocations.id, pickupLocB.id));
      expect(row?.isActive).toBe(true);
    });

    it("transitionRequest: tenant A cannot read or transition tenant B's request by id (the primary IDOR fix)", async () => {
      await expect(
        withTenant(tenantA.id, (tx) =>
          transitionRequest(tx, {
            requestId: requestB.id,
            tenantId: tenantA.id,
            event: "CANCEL",
            actorId: null,
          })
        )
      ).rejects.toThrow("Request not found");

      const [row] = await db
        .select({ status: fobRequests.status })
        .from(fobRequests)
        .where(eq(fobRequests.id, requestB.id));
      expect(row?.status).toBe(RequestStatus.SUBMITTED);
    });

    it("tenant-scoped query pattern excludes the other tenant's audit entries", async () => {
      await withTenant(tenantA.id, (tx) =>
        transitionRequest(tx, {
          requestId: requestA.id,
          tenantId: tenantA.id,
          event: "CANCEL",
          actorId: null,
        })
      );

      const tenantARows = await db
        .select({ tenantId: auditLog.tenantId, entityId: auditLog.entityId })
        .from(auditLog)
        .where(
          and(
            eq(auditLog.tenantId, tenantA.id),
            eq(auditLog.entityId, requestA.id)
          )
        );

      expect(tenantARows.length).toBeGreaterThan(0);
      expect(tenantARows.every((r) => r.tenantId === tenantA.id)).toBe(true);

      const leakedIntoB = await db
        .select({ id: auditLog.id })
        .from(auditLog)
        .where(
          and(
            eq(auditLog.tenantId, tenantB.id),
            eq(auditLog.entityId, requestA.id)
          )
        );
      expect(leakedIntoB.length).toBe(0);
    });
  }
);
