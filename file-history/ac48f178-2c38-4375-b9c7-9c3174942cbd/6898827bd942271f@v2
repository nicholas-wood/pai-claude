ALTER TABLE "fob_requests" ADD COLUMN IF NOT EXISTS "is_orphaned" boolean DEFAULT false NOT NULL;
--> statement-breakpoint
ALTER TABLE "fob_requests" ADD COLUMN IF NOT EXISTS "orphan_email" text;
--> statement-breakpoint
ALTER TABLE "fob_requests" ADD COLUMN IF NOT EXISTS "orphan_first_name" text;
--> statement-breakpoint
ALTER TABLE "fob_requests" ADD COLUMN IF NOT EXISTS "orphan_last_name" text;
--> statement-breakpoint
ALTER TABLE "fob_requests" ADD COLUMN IF NOT EXISTS "related_request_id" uuid;
--> statement-breakpoint
ALTER TABLE "fob_requests" ADD COLUMN IF NOT EXISTS "access_update_reason" text;
--> statement-breakpoint
ALTER TABLE "fob_requests" ADD COLUMN IF NOT EXISTS "credential_expires_at" timestamp with time zone;
--> statement-breakpoint
ALTER TABLE "fob_requests" ADD COLUMN IF NOT EXISTS "hold_previous_status" text;
