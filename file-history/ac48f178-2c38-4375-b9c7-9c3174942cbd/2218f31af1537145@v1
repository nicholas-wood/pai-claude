/**
 * Postgres-backed fixed-window rate limiter (`rate_limit_buckets`).
 *
 * Replaces the previous module-level in-memory Map, which was per-instance:
 * on Cloud Run scale-out the effective ceiling multiplied by instance count,
 * and cold starts reset counters to zero. Every check now goes through one
 * atomic `INSERT ... ON CONFLICT` so concurrent requests across any number
 * of instances see a single, consistent counter.
 *
 * Kill switch: set `RATE_LIMIT_DISABLED=1` in the environment to bypass all
 * checks. Use this as a break-glass if the limiter misbehaves.
 *
 * NOT tenant-scoped: bucket keys are caller-defined strings (IP, email,
 * namespace) evaluated pre-auth. See the note in
 * packages/db/src/schema/auth-tokens.ts — this table must not get RLS
 * tenant policies.
 */

import { db } from "@accessbuddy/db";
import { rateLimitBuckets } from "@accessbuddy/db/src/schema/auth-tokens";
import { sql } from "drizzle-orm";

/**
 * Extract the client IP from the request headers. Cloud Run forwards the
 * original client IP in `x-forwarded-for` as a comma-separated list where
 * the first entry is the origin client.
 *
 * Returns `"unknown"` when no IP can be determined — those requests share a
 * single bucket, which is the strictest possible treatment.
 */
export function getClientIp(request: Request): string {
  const forwardedFor = request.headers.get("x-forwarded-for");
  if (forwardedFor) {
    const first = forwardedFor.split(",")[0]?.trim();
    if (first) return first;
  }
  const realIp = request.headers.get("x-real-ip");
  if (realIp) return realIp.trim();
  return "unknown";
}

export type RateLimitResult = {
  ok: boolean;
  remaining: number;
  /** Seconds until the current window resets. */
  retryAfter: number;
};

export type RateLimitOptions = {
  /** Logical bucket name — use one per endpoint. */
  namespace: string;
  /** Window duration in seconds. */
  windowSeconds: number;
  /** Maximum requests allowed per key within the window. */
  max: number;
};

/**
 * Increment and check the counter for `key` inside `namespace`. Returns a
 * result object describing whether the request should be allowed, how many
 * requests remain in the current window, and how long until the window
 * resets.
 *
 * The increment-and-check is a single atomic upsert: on conflict, the row is
 * reset to count=1 if the previous window has expired, otherwise the count
 * is incremented. This is race-safe under concurrent requests without a
 * separate lock.
 *
 * Respects the `RATE_LIMIT_DISABLED=1` environment variable kill switch.
 */
export async function checkRateLimit(
  key: string,
  options: RateLimitOptions
): Promise<RateLimitResult> {
  if (process.env.RATE_LIMIT_DISABLED === "1") {
    return { ok: true, remaining: options.max, retryAfter: 0 };
  }

  const bucketKey = `${options.namespace}:${key}`;
  const windowMs = options.windowSeconds * 1000;
  const now = new Date();
  const newResetAt = new Date(now.getTime() + windowMs);

  const rows = await db.execute<{ count: number; reset_at: string | Date }>(sql`
    INSERT INTO ${rateLimitBuckets} (key, count, reset_at)
    VALUES (${bucketKey}, 1, ${newResetAt})
    ON CONFLICT (key) DO UPDATE SET
      count = CASE
        WHEN ${rateLimitBuckets.resetAt} <= ${now} THEN 1
        ELSE ${rateLimitBuckets.count} + 1
      END,
      reset_at = CASE
        WHEN ${rateLimitBuckets.resetAt} <= ${now} THEN ${newResetAt}
        ELSE ${rateLimitBuckets.resetAt}
      END
    RETURNING count, reset_at
  `);

  const row = rows[0];
  if (!row) {
    // Should never happen (INSERT ... RETURNING always returns a row), but
    // fail open-with-logging rather than throw on an auth send path.
    console.error("[rate-limit] upsert returned no row for", bucketKey);
    return { ok: true, remaining: options.max - 1, retryAfter: 0 };
  }

  const resetAt = new Date(row.reset_at);
  const count = Number(row.count);

  if (count > options.max) {
    return {
      ok: false,
      remaining: 0,
      retryAfter: Math.max(1, Math.ceil((resetAt.getTime() - now.getTime()) / 1000)),
    };
  }

  return {
    ok: true,
    remaining: Math.max(0, options.max - count),
    retryAfter: 0,
  };
}

/**
 * Convenience wrapper: enforce independent rate limits keyed on both the
 * client IP and the target email, so an attacker cannot dodge the IP bucket
 * by rotating source addresses, nor dodge the email bucket by spraying many
 * targets from one IP. Returns the first failing result, or the IP result
 * if both pass.
 */
export async function checkRateLimitIpAndEmail(
  namespace: string,
  ip: string,
  email: string,
  options: { windowSeconds: number; maxPerIp: number; maxPerEmail: number }
): Promise<RateLimitResult> {
  const ipResult = await checkRateLimit(`ip:${ip}`, {
    namespace,
    windowSeconds: options.windowSeconds,
    max: options.maxPerIp,
  });
  if (!ipResult.ok) return ipResult;

  const emailResult = await checkRateLimit(`email:${email}`, {
    namespace,
    windowSeconds: options.windowSeconds,
    max: options.maxPerEmail,
  });
  return emailResult;
}

/** Test-only: clear all buckets. Not exported through the barrel. */
export async function __resetRateLimitStores(): Promise<void> {
  await db.delete(rateLimitBuckets);
}
