CREATE INDEX IF NOT EXISTS "fob_requests_stripe_payment_intent_idx" ON "fob_requests" ("stripe_payment_intent_id");
--> statement-breakpoint
CREATE INDEX IF NOT EXISTS "fob_requests_requester_idx" ON "fob_requests" ("requester_id");
--> statement-breakpoint
