import { createHmac, timingSafeEqual } from "node:crypto";
import { getSessionSigningSecret } from "@/env";

/**
 * Payment and cancel links for a request.
 *
 * The pay page (`/t/<slug>/pay/<requestId>`) is already public by request
 * UUID. The cancel link adds a signed, expiring token so a member can cancel
 * from an email without signing in, while nobody who merely knows the request
 * id can cancel it. The token is an HMAC-SHA256 over tenantId, requestId and
 * expiry, keyed with the existing SESSION_SIGNING_SECRET, so no migration and
 * no new secret are needed.
 */

export const CANCEL_TOKEN_TTL_MS = 30 * 24 * 60 * 60 * 1000; // 30 days

function cancelTokenPayload(tenantId: string, requestId: string, expiresAt: number): string {
  return `cancel:${tenantId}:${requestId}:${expiresAt}`;
}

export function signCancelToken(params: {
  tenantId: string;
  requestId: string;
  expiresAt?: number; // epoch ms
}): string {
  const expiresAt = params.expiresAt ?? Date.now() + CANCEL_TOKEN_TTL_MS;
  const secret = getSessionSigningSecret();
  const sig = createHmac("sha256", secret)
    .update(cancelTokenPayload(params.tenantId, params.requestId, expiresAt))
    .digest("base64url");
  return `${expiresAt}.${sig}`;
}

export type CancelTokenResult =
  | { valid: true }
  | { valid: false; reason: "malformed" | "expired" | "invalid" };

export function verifyCancelToken(params: {
  token: string;
  tenantId: string;
  requestId: string;
  now?: number;
}): CancelTokenResult {
  const parts = params.token.split(".");
  if (parts.length !== 2) return { valid: false, reason: "malformed" };
  const expiresAt = Number(parts[0]);
  const providedSig = parts[1];
  if (!Number.isFinite(expiresAt) || !providedSig) return { valid: false, reason: "malformed" };

  const now = params.now ?? Date.now();
  if (expiresAt <= now) return { valid: false, reason: "expired" };

  const secret = getSessionSigningSecret();
  const expectedSig = createHmac("sha256", secret)
    .update(cancelTokenPayload(params.tenantId, params.requestId, expiresAt))
    .digest("base64url");

  const providedBuf = Buffer.from(providedSig);
  const expectedBuf = Buffer.from(expectedSig);
  if (providedBuf.length !== expectedBuf.length || !timingSafeEqual(providedBuf, expectedBuf)) {
    return { valid: false, reason: "invalid" };
  }
  return { valid: true };
}

export function getAppUrl(): string {
  return process.env.NEXT_PUBLIC_APP_URL || "http://localhost:3000";
}

/**
 * Build the public pay URL and the signed cancel URL for a request. Both
 * land on the same pay page; the cancel URL carries a `cancel` query token
 * that unlocks the "cancel this request" form.
 */
export function buildPaymentLinks(params: {
  tenantSlug: string;
  tenantId: string;
  requestId: string;
}): { paymentUrl: string; cancelUrl: string } {
  const paymentUrl = `${getAppUrl()}/t/${params.tenantSlug}/pay/${params.requestId}`;
  const token = signCancelToken({ tenantId: params.tenantId, requestId: params.requestId });
  const cancelUrl = `${paymentUrl}?cancel=${encodeURIComponent(token)}`;
  return { paymentUrl, cancelUrl };
}

export function formatAmountCents(cents: number | null | undefined): string {
  return `$${((cents ?? 0) / 100).toFixed(2)}`;
}
