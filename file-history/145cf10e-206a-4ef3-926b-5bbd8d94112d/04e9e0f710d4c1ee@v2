let _resend: Resend | null = null;

function getResend(): Resend | null {
  if (_resend) return _resend;
  const env = getServerEnv();
  if (!env.RESEND_API_KEY) return null;
  _resend = new Resend(env.RESEND_API_KEY);
  return _resend;
}

type TransactionClient = Parameters<
  Parameters<typeof import("@accessbuddy/db").db.transaction>[0]
>[0];

const EMAIL_DOMAIN = "accessbuddy.com.au";
const DEFAULT_FROM_PREFIX = "noreply";

export type TenantEmailConfig = {
  clubName: string;
  fromEmailPrefix?: string;
  replyToEmail?: string;
  logoUrl?: string;
  primaryColour?: string;
  secondaryColour?: string;
  /**
   * Master send switch. When false, sendEmail no-ops (but still writes an
   * audit entry with `suppressed: true`). Defaults to true when unset so
   * existing tenants keep receiving mail.
   */
  sendEmails?: boolean;
};

/**
 * Audit context attached to an email send. When provided, sendEmail writes an
 * `email_sent` or `email_failed` entry to audit_log against the triggering
 * entity (a fob request, credential, or member). The caller must ensure the
 * transaction already has tenant RLS context set — either by being inside a
 * withTenant(...) block, or by passing the tx that is.
 */
export type EmailAuditContext = {
  tx: TransactionClient;
  tenantId: string;
  entityType: AuditEntityType;
  entityId: string;
  actorId?: string | null;
  /** Extra fields merged into the audit metadata */
  extraMetadata?: Record<string, unknown>;
};

/**
 * Build a TenantEmailConfig from a tenant row with settings.
 * Centralised so branding fields are always included.
 */
export function buildEmailConfig(tenant: {
  name: string;
  logoUrl?: string | null;
  settings?: Record<string, unknown> | null;
}): TenantEmailConfig {
  const s = (tenant.settings ?? {}) as Record<string, unknown>;
  const appUrl = process.env.NEXT_PUBLIC_APP_URL || "http://localhost:3000";

  // Logo URL must be absolute for emails
  let logoUrl: string | undefined;
  if (tenant.logoUrl) {
    logoUrl = tenant.logoUrl.startsWith("http") ? tenant.logoUrl : `${appUrl}${tenant.logoUrl}`;
  }

  // sendEmails defaults to true when unset so existing tenants keep
  // receiving mail. Set to false on a tenant to silence all outbound sends.
  const sendEmails = s.sendEmails === undefined ? true : !!s.sendEmails;

  return {
    clubName: tenant.name,
    fromEmailPrefix: s.fromEmailPrefix as string | undefined,
    replyToEmail: s.replyToEmail as string | undefined,
    logoUrl,
    primaryColour: s.emailPrimaryColour as string | undefined,
    secondaryColour: s.emailSecondaryColour as string | undefined,
    sendEmails,
  };
}

/**
 * Fetch documents from URLs and return as email attachments.
 * Skips any that fail to download.
 */
export async function fetchAttachments(
  urls: { name: string; url: string }[]
): Promise<{ filename: string; content: Buffer }[]> {
  const results: { filename: string; content: Buffer }[] = [];
  for (const { name, url } of urls) {
    try {
      const res = await fetch(url);
      if (!res.ok) continue;
      const buffer = Buffer.from(await res.arrayBuffer());
      results.push({ filename: name, content: buffer });
    } catch (err) {
      console.error(`[email] Failed to fetch attachment "${name}" from ${url}:`, err);
    }
  }
  return results;
}

function resolveFrom(config: TenantEmailConfig): string {
  const prefix = config.fromEmailPrefix || DEFAULT_FROM_PREFIX;
  return `${config.clubName} <${prefix}@${EMAIL_DOMAIN}>`;
}

function resolveReplyTo(config: TenantEmailConfig): string | undefined {
  return config.replyToEmail || undefined;
}

/**
 * Outcome of a sendEmail call.
 *
 * `sent` is true only when Resend accepted the message. `suppressed` marks an
 * intentional skip (tenant sendEmails=false); `noop` marks a missing
 * RESEND_API_KEY. `error` carries the failure reason when the send failed.
 * Existing fire-and-forget callers can keep ignoring the result; callers for
 * whom delivery matters (auth emails) must check `sent`.
 */
export type EmailSendResult = {
  sent: boolean;
  suppressed?: boolean;
  noop?: boolean;
  error?: string;
};

/**
 * Send a raw HTML email. No-ops if RESEND_API_KEY is not configured.
 *
 * When an `audit` context is supplied, an `email_sent` (or `email_failed`)
 * entry is written to audit_log against the triggering entity. The audit
 * insert runs through the caller's `tx`, which must already have tenant RLS
 * context set.
 *
 * Never throws: failures are reported via the returned EmailSendResult (and
 * captured in Sentry) so existing call sites keep their behaviour.
 */
export async function sendEmail(
  to: string,
  subject: string,
  html: string,
  config: TenantEmailConfig,
  attachments?: { filename: string; content: Buffer }[],
  audit?: EmailAuditContext,
  templateType?: string
): Promise<EmailSendResult> {
  // Tenant-level master switch. When a tenant has opted out of emails we
  // still write an audit entry marked suppressed:true so the attempted send
  // is traceable, but we never hit Resend.
  if (config.sendEmails === false) {
    if (audit) {
      await writeEmailAudit(audit, {
        success: true,
        to,
        subject,
        html,
        templateType,
        suppressed: true,
      });
    }
    return { sent: false, suppressed: true };
  }

  const resend = getResend();
  if (!resend) {
    if (audit) {
      await writeEmailAudit(audit, {
        success: true,
        to,
        subject,
        html,
        templateType,
        noop: true,
      });
    }
    return { sent: false, noop: true };
  }

  const from = resolveFrom(config);

  try {
    const result = await resend.emails.send({
      from,
      replyTo: resolveReplyTo(config),
      to,
      subject,
      html,
      ...(attachments?.length ? { attachments } : {}),
    });

    if (result.error) {
      const errorMessage = String(result.error.message ?? result.error);
      console.error(
        `[email] Failed to send "${subject}" to ${to}:`,
        result.error
      );
      Sentry.captureException(new Error(`Resend send failed: ${errorMessage}`), {
        extra: { to, subject, templateType },
      });
      if (audit) {
        await writeEmailAudit(audit, {
          success: false,
          to,
          subject,
          html,
          templateType,
          error: errorMessage,
        });
      }
      return { sent: false, error: errorMessage };
    }

    if (audit) {
      await writeEmailAudit(audit, {
        success: true,
        to,
        subject,
        html,
        templateType,
        resendId: result.data?.id ?? null,
      });
    }
    return { sent: true };
  } catch (err) {
    const errorMessage = err instanceof Error ? err.message : String(err);
    console.error(`[email] Failed to send "${subject}" to ${to}:`, err);
    Sentry.captureException(err, { extra: { to, subject, templateType } });
    if (audit) {
      await writeEmailAudit(audit, {
        success: false,
        to,
        subject,
        html,
        templateType,
        error: errorMessage,
      });
    }
    return { sent: false, error: errorMessage };
  }
}

async function writeEmailAudit(
  audit: EmailAuditContext,
  details: {
    success: boolean;
    to: string;
    subject: string;
    html?: string;
    templateType?: string;
    resendId?: string | null;
    error?: string;
    noop?: boolean;
    suppressed?: boolean;
  }
): Promise<void> {
  try {
    await createAuditEntry(audit.tx, {
      tenantId: audit.tenantId,
      entityType: audit.entityType,
      entityId: audit.entityId,
      action: details.success ? AuditAction.EMAIL_SENT : AuditAction.EMAIL_FAILED,
      actorId: audit.actorId ?? null,
      actorType: "system",
      metadata: {
        to: details.to,
        subject: details.subject,
        ...(details.templateType ? { templateType: details.templateType } : {}),
        ...(details.resendId ? { resendId: details.resendId } : {}),
        ...(details.error ? { error: details.error } : {}),
        ...(details.noop ? { noop: true } : {}),
        ...(details.suppressed ? { suppressed: true } : {}),
        ...(details.html ? { html: details.html } : {}),
        ...(audit.extraMetadata ?? {}),
      },
    });
  } catch (err) {
    // Never throw from audit failures — email delivery succeeded or already
    // failed, and we don't want to rollback callers because of audit trouble.
    console.error("[email] Failed to write audit entry:", err);
  }
}

// ---- Notification preference check ----

/**
 * Check whether a notification should be sent based on user preferences.
 *
 * Rules:
 * - Time-critical notifications always return true (cannot be disabled)
 * - If no preference record exists, return true (default: enabled)
 * - If emailEnabled is false, return false
 * - If frequency is "off", return false
 * - Otherwise return true
 *
 * The tx must already have tenant RLS context set.
 */
export async function shouldSendNotification(
  tx: TransactionClient,
  params: {
    tenantId: string;
    userId: string;
    notificationType: string;
  }
): Promise<boolean> {
  // Time-critical notifications always send
  if (
    TIME_CRITICAL_NOTIFICATIONS.includes(
      params.notificationType as NotificationType
    )
  ) {
    return true;
  }

  // Look up the user's preference for this notification type
  const [pref] = await tx
    .select({
      emailEnabled: notificationPreferences.emailEnabled,
      frequency: notificationPreferences.frequency,
    })
    .from(notificationPreferences)
    .where(
      and(
        eq(notificationPreferences.tenantId, params.tenantId),
        eq(notificationPreferences.userId, params.userId),
        eq(notificationPreferences.notificationType, params.notificationType)
      )
    )
    .limit(1);

  // No preference record = default to daily summary (not realtime)
  // The actual send/queue decision is handled by getNotificationFrequency
  if (!pref) {
    return true;
  }

  // Respect the user's preference
  if (!pref.emailEnabled) {
    return false;
  }

  if (pref.frequency === NotificationFrequency.OFF) {
    return false;
  }

  return true;
}

/**
 * Get the notification frequency for a user/type combo.
 * Returns "realtime" when no preference record exists (default).
 * Time-critical notifications always return "realtime".
 */
async function getNotificationFrequency(
  tx: TransactionClient,
  params: {
    tenantId: string;
    userId: string;
    notificationType: string;
  }
): Promise<NotificationFrequency> {
  // Time-critical notifications are always realtime
  if (
    TIME_CRITICAL_NOTIFICATIONS.includes(
      params.notificationType as NotificationType
    )
  ) {
    return NotificationFrequency.REALTIME;
  }

  const [pref] = await tx
    .select({
      emailEnabled: notificationPreferences.emailEnabled,
      frequency: notificationPreferences.frequency,
    })
    .from(notificationPreferences)
    .where(
      and(
        eq(notificationPreferences.tenantId, params.tenantId),
        eq(notificationPreferences.userId, params.userId),
        eq(notificationPreferences.notificationType, params.notificationType)
      )
    )
    .limit(1);

  if (!pref) {
    return NotificationFrequency.DAILY_SUMMARY;
  }

  if (!pref.emailEnabled) {
    return NotificationFrequency.OFF;
  }

  return pref.frequency as NotificationFrequency;
}

