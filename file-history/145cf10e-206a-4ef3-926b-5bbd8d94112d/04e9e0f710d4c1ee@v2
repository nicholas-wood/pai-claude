/**
 * Send a templated email. Renders the appropriate template and sends it.
 * No-ops if RESEND_API_KEY is not configured. Accepts an optional `audit`
 * context that is threaded through to sendEmail for audit_log writes.
 */
export async function sendTemplatedEmail<T extends keyof TemplateVariables>(
  to: string,
  templateType: T,
  variables: TemplateVariables[T],
  config: TenantEmailConfig,
  attachments?: { filename: string; content: Buffer }[],
  audit?: EmailAuditContext
): Promise<EmailSendResult> {
  const { subject, html } = renderTemplate(templateType, variables, config.clubName, {
    logoUrl: config.logoUrl,
    primaryColour: config.primaryColour,
    secondaryColour: config.secondaryColour,
    replyToEmail: config.replyToEmail,
  });
  return sendEmail(to, subject, html, config, attachments, audit, templateType as string);
}

export type EmailBranding = {
  logoUrl?: string;
  primaryColour?: string;
  secondaryColour?: string;
  replyToEmail?: string;
};

function renderTemplate<T extends keyof TemplateVariables>(
  templateType: T,
  variables: TemplateVariables[T],
  clubName: string,
  branding?: EmailBranding
): { subject: string; html: string } {
  // Set branding so the layout function picks it up
  setEmailBranding({
    logoUrl: branding?.logoUrl,
    primaryColour: branding?.primaryColour,
    secondaryColour: branding?.secondaryColour,
    replyToEmail: branding?.replyToEmail,
  });

  switch (templateType) {
    case "requestSubmitted": {
      const v = variables as TemplateVariables["requestSubmitted"];
      return {
        subject: "Your request has been received",
        html: requestSubmittedEmail(clubName, v.memberName, v.requestType, { paymentReceived: v.paymentReceived, exemptionRequested: v.exemptionRequested }),
      };
    }
    case "damagedFobReported": {
      const v = variables as TemplateVariables["damagedFobReported"];
      return {
        subject: "Your damaged fob report has been received",
        html: damagedFobReportedEmail(clubName, v.memberName),
      };
    }
    case "requestApproved": {
      const v = variables as TemplateVariables["requestApproved"];
      return {
        subject: "Your request has been approved",
        html: requestApprovedEmail(clubName, v.memberName),
      };
    }
    case "requestRejected": {
      const v = variables as TemplateVariables["requestRejected"];
      return {
        subject: "Update on your request",
        html: requestRejectedEmail(clubName, v.memberName, v.reason),
