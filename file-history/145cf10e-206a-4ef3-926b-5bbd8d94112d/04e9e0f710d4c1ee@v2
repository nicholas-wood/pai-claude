// ---- Admin notifications ----

/**
 * Send notification emails to admins who have a specific permission.
 * Looks up all admins for the tenant with the required permission and sends them an email.
 * Club admins and global admins automatically have all permissions.
 *
 * When `notificationType` is provided, each admin's notification preference is checked:
 * - realtime (or no preference): send immediately
 * - daily_summary: queue to the notifications table for batch sending
 * - off (and not time-critical): skip entirely
 */
export async function sendAdminNotification(
  tx: TransactionClient,
  params: {
    tenantId: string;
    requiredPermission: string;
    subject: string;
    html: string;
    tenantEmailConfig: TenantEmailConfig;
    notificationType?: string;
    /** Structured data stored in the notifications.data JSONB column for summary rendering */
    summaryData?: { label: string; detail: string };
    /** Audit context attached to each admin email send. */
    audit?: Omit<EmailAuditContext, "tx">;
  }
): Promise<void> {
  const {
    tenantId,
    requiredPermission,
    subject,
    html,
    tenantEmailConfig,
    notificationType,
    summaryData,
    audit,
  } = params;

  function buildAuditForAdmin(adminUserId: string): EmailAuditContext | undefined {
    if (!audit) return undefined;
    // Each admin email is audited against the MEMBER entity (the admin user).
    // This keeps admin notifications discoverable in the admin's activity feed.
    return {
      tx,
      tenantId: audit.tenantId,
      entityType: AuditEntityType.MEMBER,
      entityId: adminUserId,
      actorId: audit.actorId ?? null,
    };
  }

  // Query admin assignments for this tenant (or global admins with null tenantId)
  const assignments = await tx
    .select({
      userId: adminAssignments.userId,
      roleType: adminAssignments.roleType,
      permissions: adminAssignments.permissions,
    })
    .from(adminAssignments)
    .where(
      or(
        eq(adminAssignments.tenantId, tenantId),
        isNull(adminAssignments.tenantId)
      )
    );

  // Filter to admins who have the required permission
  const matchingAdminUserIds = assignments
    .filter((a) => {
      // Club admins and global admins have all permissions
      if (
        a.roleType === AdminRoleType.CLUB_ADMIN ||
        a.roleType === AdminRoleType.GLOBAL_ADMIN
      ) {
        return true;
      }
      // Permission-based admins must have the specific permission
      return a.permissions.includes(requiredPermission);
    })
    .map((a) => a.userId);

  if (matchingAdminUserIds.length === 0) return;

  // Look up user details for matching admins in a single query
  const adminUsers = await tx
    .select({ id: users.id, email: users.email })
    .from(users)
    .where(inArray(users.id, matchingAdminUserIds));

  const validAdmins = adminUsers.filter(
    (u): u is { id: string; email: string } => Boolean(u.email)
  );

  if (validAdmins.length === 0) return;

  // If no notification type is supplied, send immediately (legacy behaviour)
  if (!notificationType) {
    await Promise.allSettled(
      validAdmins.map((admin) =>
        sendEmail(
          admin.email,
          subject,
          html,
          tenantEmailConfig,
          undefined,
          buildAuditForAdmin(admin.id)
        )
      )
    );
    return;
  }

  // Per-admin frequency check
  const realtimeAdmins: { email: string; id: string }[] = [];
  const queuedRows: {
    tenantId: string;
    recipientId: string;
    type: string;
    channel: string;
    title: string;
    body: string;
    data: Record<string, unknown>;
  }[] = [];

  for (const admin of validAdmins) {
    const frequency = await getNotificationFrequency(tx, {
      tenantId,
      userId: admin.id,
      notificationType,
    });

    if (frequency === NotificationFrequency.OFF) {
      continue; // user opted out and it's not time-critical
    }

    if (frequency === NotificationFrequency.DAILY_SUMMARY) {
      queuedRows.push({
        tenantId,
        recipientId: admin.id,
        type: notificationType,
        channel: NotificationChannel.EMAIL,
        title: subject,
        body: html,
        data: summaryData ? { summaryItem: summaryData } : {},
      });
      continue;
    }

    // realtime — send now
    realtimeAdmins.push(admin);
  }

  // Send realtime emails
  if (realtimeAdmins.length > 0) {
    await Promise.allSettled(
      realtimeAdmins.map((admin) =>
        sendEmail(
          admin.email,
          subject,
          html,
          tenantEmailConfig,
          undefined,
          buildAuditForAdmin(admin.id)
        )
      )
    );
  }

  // Queue daily summary notifications (sentAt is left null = unsent)
  if (queuedRows.length > 0) {
    await tx.insert(notifications).values(queuedRows);
  }
}

// ---- Daily summary batching ----


/**
 * Statuses that appear in the daily summary, mapped to their section title
 * and the admin permission required to see them.
 */
const SUMMARY_SECTIONS = [
  { status: "awaiting_approval", title: "Requests Awaiting Approval", permission: "approve" },
  { status: "awaiting_exemption_review", title: "Exemption Reviews Needed", permission: "approve_exemption" },
  { status: "awaiting_programming", title: "Requests Ready for Programming", permission: "program" },
  { status: "awaiting_pickup", title: "Ready for Collection", permission: "issue" },
] as const;

/**
 * Build and send daily summary emails based on the current state of requests.
 * Queries fob_requests directly rather than reading from queued notifications,
 * so the summary always reflects what is actually outstanding right now.
 *
 * `ops` (optional, supplied by the cron) adds email-delivery visibility to
 * each summary: the tenant's outbound queue depth and today's platform-wide
 * send count. Passed in rather than computed here so this module does not
 * import the queue service (which imports this module).
 */
export async function sendDailySummaryEmails(ops?: {
  sentToday: number;
  queueDepthByTenant: Map<string, number>;
}): Promise<{
  recipientsSent: number;
  sectionsIncluded: number;
}> {
  let recipientsSent = 0;
  let sectionsIncluded = 0;

  const appUrl = clientEnv.NEXT_PUBLIC_APP_URL;

  // Get all tenants
  const allTenants = await db
    .select({
      id: tenants.id,
      name: tenants.name,
      slug: tenants.slug,
      settings: tenants.settings,
      logoUrl: tenants.logoUrl,
    })
    .from(tenants);

  for (const tenant of allTenants) {
    const emailConfig = buildEmailConfig(tenant);
    if (!emailConfig.sendEmails) continue;

    // Query all outstanding requests for this tenant in one go
    const outstanding = await db
      .select({
        id: fobRequests.id,
        status: fobRequests.status,
        requestType: fobRequests.requestType,
        serialNumber: fobRequests.serialNumber,
        requesterId: fobRequests.requesterId,
        orphanFirstName: fobRequests.orphanFirstName,
        orphanLastName: fobRequests.orphanLastName,
        requesterFirstName: users.firstName,
        requesterLastName: users.lastName,
        exemptionReason: fobRequests.exemptionReason,
        pickupLocationName: pickupLocations.name,
      })
      .from(fobRequests)
      .leftJoin(users, eq(fobRequests.requesterId, users.id))
      .leftJoin(pickupLocations, eq(fobRequests.pickupLocationId, pickupLocations.id))
      .where(
        and(
          eq(fobRequests.tenantId, tenant.id),
          inArray(
            fobRequests.status,
            SUMMARY_SECTIONS.map((s) => s.status)
          )
        )
      );

    // Credentials flagged for reprogramming (attestation expiry updates,
    // permission-expiry flags) never create a fob_request, so they are
    // invisible to the request-status sections above. Query them directly
    // so programmers hear about staged expiry updates, not just requests.
    const flaggedCredentials = await db
      .select({
        id: credentials.id,
        serialNumber: credentials.serialNumber,
        programmingReason: credentials.programmingReason,
        ownerFirstName: users.firstName,
        ownerLastName: users.lastName,
      })
      .from(credentials)
      .leftJoin(users, eq(credentials.ownerId, users.id))
      .where(
        and(
          eq(credentials.tenantId, tenant.id),
          eq(credentials.programmingRequired, true)
        )
      );

    if (outstanding.length === 0 && flaggedCredentials.length === 0) continue;

    // Group requests by status into sections
    const sectionsByStatus = new Map<string, SummarySection>();
    for (const section of SUMMARY_SECTIONS) {
      const requests = outstanding.filter((r) => r.status === section.status);
      if (requests.length === 0) continue;

      sectionsByStatus.set(section.status, {
        title: section.title,
        count: requests.length,
        items: requests.map((r) => {
          const name = r.requesterFirstName
            ? `${r.requesterFirstName} ${r.requesterLastName ?? ""}`.trim()
            : r.orphanFirstName
              ? `${r.orphanFirstName} ${r.orphanLastName ?? ""}`.trim()
              : "Unknown";

          let detail = r.requestType ?? "new";
          if (r.status === "awaiting_pickup" && r.pickupLocationName) {
            detail = r.pickupLocationName;
          } else if (r.serialNumber) {
            detail = `Serial: ${r.serialNumber}`;
          }
          if (r.status === "awaiting_exemption_review" && r.exemptionReason) {
            detail = r.exemptionReason;
          }

          return { label: name, detail };
        }),
      });
    }

    // Programming-permission section for flagged credentials. Same gate as
    // "Requests Ready for Programming"; inserted alongside it per admin.
    const credentialSection: SummarySection | null =
      flaggedCredentials.length > 0
        ? {
            title: "Credentials Awaiting Reprogramming",
            count: flaggedCredentials.length,
            items: flaggedCredentials.map((c) => {
              const name = c.ownerFirstName
                ? `${c.ownerFirstName} ${c.ownerLastName ?? ""}`.trim()
                : "Unassigned";
              const serial = c.serialNumber ? `Serial: ${c.serialNumber}` : "No serial";
              return {
                label: name,
                detail: c.programmingReason
                  ? `${serial} — ${c.programmingReason}`
                  : `${serial} — Reprogramming required`,
              };
            }),
          }
        : null;

    // Find admins for this tenant
    const assignments = await db
      .select({
        userId: adminAssignments.userId,
        roleType: adminAssignments.roleType,
        permissions: adminAssignments.permissions,
      })
      .from(adminAssignments)
      .where(
        or(
          eq(adminAssignments.tenantId, tenant.id),
          isNull(adminAssignments.tenantId)
        )
      );

    if (assignments.length === 0) continue;

    const adminUserIds = assignments.map((a) => a.userId);
    const adminUsers = await db
      .select({ id: users.id, email: users.email, firstName: users.firstName })
      .from(users)
      .where(inArray(users.id, adminUserIds));

    const adminUserMap = new Map(adminUsers.map((u) => [u.id, u]));

    // Set branding for this tenant
    setEmailBranding({
      logoUrl: emailConfig.logoUrl,
      primaryColour: emailConfig.primaryColour,
      secondaryColour: emailConfig.secondaryColour,
      replyToEmail: emailConfig.replyToEmail,
    });

    for (const assignment of assignments) {
      const user = adminUserMap.get(assignment.userId);
      if (!user?.email) continue;

      // Build sections this admin can see based on their permissions
      const isFullAdmin =
        assignment.roleType === AdminRoleType.CLUB_ADMIN ||
        assignment.roleType === AdminRoleType.GLOBAL_ADMIN;

      const canSeeProgramming =
        isFullAdmin || assignment.permissions.includes("program");

      const visibleSections: SummarySection[] = [];
      for (const sectionDef of SUMMARY_SECTIONS) {
        if (!isFullAdmin && !assignment.permissions.includes(sectionDef.permission)) {
          continue;
        }
        const section = sectionsByStatus.get(sectionDef.status);
        if (section) visibleSections.push(section);
        // Keep the two programming sections adjacent in the email.
        if (sectionDef.status === "awaiting_programming" && canSeeProgramming && credentialSection) {
          visibleSections.push(credentialSection);
        }
      }
      // The credential section must still appear when there are no
      // awaiting_programming requests (the push above is tied to that slot).
      if (canSeeProgramming && credentialSection && !visibleSections.includes(credentialSection)) {
        visibleSections.push(credentialSection);
      }

      if (visibleSections.length === 0) continue;

      // Build a fingerprint from visible item IDs to detect changes. If the
      // outstanding requests and flagged credentials haven't changed since
      // the last summary, skip sending to avoid duplicate emails. Flagged
      // credential IDs are cred:-prefixed so the two ID sets cannot collide,
      // and join the fingerprint for exactly the admins who see the section.
      const visibleRequestIds = SUMMARY_SECTIONS
        .filter((s) => isFullAdmin || assignment.permissions.includes(s.permission))
        .flatMap((s) => outstanding.filter((r) => r.status === s.status).map((r) => r.id));
      const visibleItemIds = [
        ...visibleRequestIds,
        ...(canSeeProgramming
          ? flaggedCredentials.map((c) => `cred:${c.id}`)
          : []),
      ].sort();
      const fingerprint = createHash("sha256").update(visibleItemIds.join(",")).digest("hex").slice(0, 16);

      // Skip if a daily summary with the same fingerprint was already sent
      // recently. This prevents both duplicate sends within the same day AND
      // sending unchanged summaries day after day when no requests have moved.
      const recentSummaries = await db
        .select({ metadata: auditLog.metadata })
        .from(auditLog)
        .where(
          and(
            eq(auditLog.tenantId, tenant.id),
            eq(auditLog.entityId, user.id),
            eq(auditLog.action, AuditAction.EMAIL_SENT)
          )
        )
        .orderBy(desc(auditLog.createdAt))
        .limit(5);

      const alreadySentThisFingerprint = recentSummaries.some((e) => {
        const meta = e.metadata as Record<string, unknown> | null;
        return meta?.templateType === "dailySummary" && meta?.summaryFingerprint === fingerprint;
      });
      if (alreadySentThisFingerprint) continue;

      const adminName = user.firstName ?? user.email.split("@")[0];
      const dashboardUrl = `${appUrl}/t/${tenant.slug}/admin`;

      const html = dailySummaryEmail(
        tenant.name,
        adminName,
        visibleSections,
        dashboardUrl,
        ops
          ? {
              queueDepth: ops.queueDepthByTenant.get(tenant.id) ?? 0,
              sentToday: ops.sentToday,
            }
          : undefined
      );

      try {
        await withTenant(tenant.id, async (tx) => {
          await sendEmail(
            user.email,
            `Daily Summary - ${tenant.name}`,
            html,
            emailConfig,
            undefined,
            {
              tx,
              tenantId: tenant.id,
              entityType: AuditEntityType.MEMBER,
              entityId: user.id,
              actorId: null,
              extraMetadata: { summaryFingerprint: fingerprint },
            },
            "dailySummary"
          );
        });

        recipientsSent++;
        sectionsIncluded += visibleSections.length;
      } catch (err) {
        console.error(`Failed to send daily summary to ${user.email}:`, err);
      }
    }
  }

  return { recipientsSent, sectionsIncluded };
}
