import { setup, createActor } from "xstate";
import { RequestStatus, RequestType } from "./enums";

// Events that drive the request workflow
type RequestEvent =
  | { type: "PAYMENT_REQUIRED" }
  | { type: "PAYMENT_EXEMPT" }
  | { type: "PAYMENT_RECEIVED" }
  | { type: "REQUEST_EXEMPTION"; reason: string }
  | { type: "APPROVE_EXEMPTION"; approvedBy: string }
  | { type: "REJECT_EXEMPTION"; rejectedBy: string; reason: string }
  | { type: "APPROVE"; approvedBy: string; accessLevelId?: string }
  | { type: "REJECT"; rejectedBy: string; reason: string }
  | { type: "HOLD"; heldBy: string; reason: string }
  | { type: "RESUME"; resumedBy: string }
  | { type: "PROGRAM"; programmedBy: string; serialNumber: string }
  | { type: "SET_PICKUP"; pickupLocationId: string }
  | { type: "ISSUE"; issuedBy: string }
  | { type: "CANCEL"; cancelledBy: string; reason: string }
  | { type: "REOPEN"; reopenedBy: string; reason: string };

// States that support HOLD (all non-final, non-hold states)
const HOLDABLE_STATES = [
  RequestStatus.SUBMITTED,
  RequestStatus.AWAITING_PAYMENT,
  RequestStatus.AWAITING_EXEMPTION_REVIEW,
  RequestStatus.AWAITING_APPROVAL,
  RequestStatus.AWAITING_PROGRAMMING,
  RequestStatus.PROGRAMMED,
  RequestStatus.AWAITING_PICKUP,
] as const;

// Build HOLD transition for a given state
function holdTransition(fromState: RequestStatus) {
  return {
    target: RequestStatus.ON_HOLD,
    actions: ({ context }: { context: { previousState: string | null } }) => {
      context.previousState = fromState;
    },
  };
}

// Build RESUME transitions for ON_HOLD - one per possible previous state
function buildResumeTransitions() {
  return HOLDABLE_STATES.map((state) => ({
    target: state,
    guard: ({ context }: { context: { previousState: string | null } }) =>
      context.previousState === state,
  }));
}

export const requestMachine = setup({
  types: {
    context: {} as {
      requestId: string;
      previousState: string | null;
    },
    events: {} as RequestEvent,
  },
}).createMachine({
  id: "fobRequest",
  initial: RequestStatus.SUBMITTED,
  context: {
    requestId: "",
    previousState: null,
  },
  states: {
    [RequestStatus.SUBMITTED]: {
      on: {
        PAYMENT_REQUIRED: { target: RequestStatus.AWAITING_PAYMENT },
        PAYMENT_EXEMPT: { target: RequestStatus.AWAITING_APPROVAL },
        PAYMENT_RECEIVED: { target: RequestStatus.AWAITING_APPROVAL },
        REQUEST_EXEMPTION: { target: RequestStatus.AWAITING_EXEMPTION_REVIEW },
        HOLD: holdTransition(RequestStatus.SUBMITTED),
        CANCEL: { target: RequestStatus.CANCELLED },
      },
    },
    [RequestStatus.AWAITING_PAYMENT]: {
      on: {
        PAYMENT_RECEIVED: { target: RequestStatus.AWAITING_APPROVAL },
        // Admin override: skip the payment requirement directly. Reason is
        // recorded in exemption_reason and captured in the audit trail.
        PAYMENT_EXEMPT: { target: RequestStatus.AWAITING_APPROVAL },
        REQUEST_EXEMPTION: { target: RequestStatus.AWAITING_EXEMPTION_REVIEW },
        HOLD: holdTransition(RequestStatus.AWAITING_PAYMENT),
        CANCEL: { target: RequestStatus.CANCELLED },
      },
    },
    [RequestStatus.AWAITING_EXEMPTION_REVIEW]: {
      on: {
        APPROVE_EXEMPTION: { target: RequestStatus.AWAITING_APPROVAL },
        REJECT_EXEMPTION: { target: RequestStatus.AWAITING_PAYMENT },
        HOLD: holdTransition(RequestStatus.AWAITING_EXEMPTION_REVIEW),
        CANCEL: { target: RequestStatus.CANCELLED },
      },
    },
    [RequestStatus.AWAITING_APPROVAL]: {
      on: {
        APPROVE: { target: RequestStatus.AWAITING_PROGRAMMING },
        REJECT: { target: RequestStatus.REJECTED },
        // Admin override: send an unpaid request back for payment (for
        // example an exemption granted in error, or a request that was
        // created as free and should have been charged). Creates the Stripe
        // intent and emails the member a payment link.
        PAYMENT_REQUIRED: { target: RequestStatus.AWAITING_PAYMENT },
        HOLD: holdTransition(RequestStatus.AWAITING_APPROVAL),
        CANCEL: { target: RequestStatus.CANCELLED },
      },
    },
    [RequestStatus.AWAITING_PROGRAMMING]: {
      on: {
        PROGRAM: { target: RequestStatus.PROGRAMMED },
        HOLD: holdTransition(RequestStatus.AWAITING_PROGRAMMING),
        CANCEL: { target: RequestStatus.CANCELLED },
      },
    },
    [RequestStatus.PROGRAMMED]: {
      on: {
        SET_PICKUP: { target: RequestStatus.AWAITING_PICKUP },
        HOLD: holdTransition(RequestStatus.PROGRAMMED),
        CANCEL: { target: RequestStatus.CANCELLED },
      },
    },
    [RequestStatus.AWAITING_PICKUP]: {
      on: {
        ISSUE: { target: RequestStatus.ISSUED },
        HOLD: holdTransition(RequestStatus.AWAITING_PICKUP),
        CANCEL: { target: RequestStatus.CANCELLED },
      },
    },
    [RequestStatus.ON_HOLD]: {
      on: {
        RESUME: buildResumeTransitions(),
        CANCEL: { target: RequestStatus.CANCELLED },
      },
    },
    [RequestStatus.ISSUED]: {
      type: "final" as const,
    },
    [RequestStatus.REJECTED]: {
      on: {
        REOPEN: { target: RequestStatus.AWAITING_APPROVAL },
      },
    },
    [RequestStatus.CANCELLED]: {
      on: {
        REOPEN: { target: RequestStatus.AWAITING_APPROVAL },
      },
    },
  },
});

/**
 * Get all valid events from the current state
 */
export function getValidEvents(currentStatus: string): string[] {
  const stateConfig =
    requestMachine.config.states?.[currentStatus as RequestStatus];
  if (!stateConfig || !("on" in stateConfig)) return [];
  return Object.keys(stateConfig.on ?? {});
}

/**
 * Request types that require payment (unless exempted by club config)
 */
export const PAYMENT_REQUIRED_REQUEST_TYPES: readonly RequestType[] = [
  RequestType.NEW,
  RequestType.REPLACEMENT_LOST,
  RequestType.REPLACEMENT_DAMAGED,
  RequestType.ADDITIONAL,
];

/**
 * Request types that are auto-approved
 */
export const AUTO_APPROVED_REQUEST_TYPES: readonly RequestType[] = [
  RequestType.RETURN,
];

/**
 * Request types that never produce (or modify) a credential record.
 * - access_update: only the member's access level changes (on the membership,
 *   never the credential). Credential expiry is driven solely by the membership
 *   season and must not be touched by this flow.
 * - replacement_lost / replacement_damaged: deactivation requests for an
 *   existing fob; the paired replacement is a separate "new" request.
 */
const NON_CREDENTIAL_REQUEST_TYPES: readonly RequestType[] = [
  RequestType.ACCESS_UPDATE,
  RequestType.REPLACEMENT_LOST,
  RequestType.REPLACEMENT_DAMAGED,
];

/**
 * Whether a request type produces a credential, and therefore carries a
 * credential expiry through the request pipeline. False for access_update:
 * an access change can never set or alter a credential's expiry date.
 */
export function requestProducesCredential(requestType: string): boolean {
  return !NON_CREDENTIAL_REQUEST_TYPES.includes(requestType as RequestType);
}
