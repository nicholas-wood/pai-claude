import { notFound, redirect } from "next/navigation";
import { eq, desc } from "drizzle-orm";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import { RequestStatusBadge } from "@/components/status-badge";
import { ProgressStepper } from "@/components/progress-stepper";
import { BackButton } from "@/components/back-button";
import { AuditTrail } from "@/components/audit-trail";
import { getAuthUser } from "@/lib/auth";
import { resolveTenant } from "@/lib/tenant";
import { withTenant } from "@/lib/with-tenant";
import { fobRequests, credentialTypes, auditLog, users, pickupLocations } from "@accessbuddy/db";
import { RequestStatus, requestRequiresCollection } from "@accessbuddy/shared";
import { CancelButton } from "./cancel-button";
import { ConfirmReceiptForm } from "./confirm-receipt-form";
import { isAutoClosedReturn } from "@/lib/request-display";

export default async function RequestDetailPage({
  params,
  searchParams,
}: {
  params: Promise<{ slug: string; id: string }>;
  searchParams?: Promise<Record<string, string | string[] | undefined>>;
}) {
  const { slug, id } = await params;
  const query = (await searchParams) ?? {};
  const openConfirm = query.confirm === "1";
  const [auth, tenant] = await Promise.all([
    getAuthUser(),
    resolveTenant(slug),
  ]);
  if (!auth) redirect("/sign-in");
  if (!tenant) notFound();

  const data = await withTenant(tenant.id, async (tx) => {
    const [request] = await tx
      .select()
      .from(fobRequests)
      .where(eq(fobRequests.id, id))
      .limit(1);

    if (!request) return null;

    let credType = null;
    if (request.credentialTypeId) {
      const [ct] = await tx
        .select()
        .from(credentialTypes)
        .where(eq(credentialTypes.id, request.credentialTypeId))
        .limit(1);
      credType = ct ?? null;
    }

    // Member-facing location details only. `instructions` is admin-only.
    let pickupLocation: { name: string; memberMessage: string | null; confirmReceiptEnabled: boolean } | null = null;
    if (request.pickupLocationId) {
      const [loc] = await tx
        .select({
          name: pickupLocations.name,
          memberMessage: pickupLocations.memberMessage,
          confirmReceiptEnabled: pickupLocations.confirmReceiptEnabled,
        })
        .from(pickupLocations)
        .where(eq(pickupLocations.id, request.pickupLocationId))
        .limit(1);
      pickupLocation = loc ?? null;
    }

    const trail = await tx
      .select({
        action: auditLog.action,
        fromState: auditLog.fromState,
        toState: auditLog.toState,
        actorType: auditLog.actorType,
        actorFirstName: users.firstName,
        actorLastName: users.lastName,
        metadata: auditLog.metadata,
        createdAt: auditLog.createdAt,
      })
      .from(auditLog)
      .leftJoin(users, eq(auditLog.actorId, users.id))
      .where(eq(auditLog.entityId, id))
      .orderBy(desc(auditLog.createdAt));

    return { request, credentialType: credType, pickupLocation, auditTrail: trail };
  });

  if (!data) notFound();

  const { request, credentialType, pickupLocation, auditTrail } = data;

  // Members can only see their own requests (by ID or email for orphaned requests)
  const isOwner =
    request.requesterId === auth.user.id ||
    (request.orphanEmail && request.orphanEmail === auth.user.email);
  if (!isOwner) notFound();

  const FINAL_STATES = [
    RequestStatus.ISSUED,
    RequestStatus.CANCELLED,
    RequestStatus.REJECTED,
  ];
  // A post-issue payment demand sits in awaiting_payment but the credential
  // is already in hand: show it as issued, and no member cancel.
  const postIssueDemand = !!request.paymentReturnStatus;
  const displayStatus = postIssueDemand ? request.paymentReturnStatus! : request.status;
  const canCancel =
    !postIssueDemand && !FINAL_STATES.includes(request.status as typeof FINAL_STATES[number]);
  const isAwaitingCollection =
    request.status === RequestStatus.AWAITING_PICKUP && request.requestType !== "return";
  // Exchanges (change_type) and returns need the old fob handed in, so the
  // member's word alone cannot close them; no self-report for those.
  const canConfirmReceipt =
    isAwaitingCollection &&
    !requestRequiresCollection(request.requestType) &&
    !!pickupLocation?.confirmReceiptEnabled;

  function formatDate(date: Date | string | null) {
    if (!date) return "-";
    return new Date(date).toLocaleDateString("en-AU", {
      timeZone: "Australia/Melbourne",
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  return (
    <div className="space-y-6">
      <BackButton fallback={`/t/${slug}/dashboard/requests`} />

      <Card>
        <CardContent className="pt-4 pb-2 space-y-2">
          <ProgressStepper status={displayStatus} paymentExempt={request.paymentExempt} requestType={request.requestType} autoClosed={isAutoClosedReturn(request)} />
          {postIssueDemand && (
            <p className="text-sm font-medium rounded bg-amber-50 text-amber-800 px-3 py-2">
              The club has requested a payment of ${((request.paymentAmountCents ?? 0) / 100).toFixed(2)} for this
              {" "}{credentialType?.name ?? "credential"}. Your credential stays active.{" "}
              <a href={`/t/${slug}/pay/${request.id}`} className="underline">Pay now</a>
            </p>
          )}
          {request.status === "awaiting_pickup" && request.requestType === "return" && (
            <p className="text-sm font-medium rounded bg-green-50 text-green-800 px-3 py-2">
              Your {credentialType?.name ?? "fob"}{request.serialNumber ? ` #${request.serialNumber}` : ""} has been
              deactivated. Please hand it in to the club to complete the return.
            </p>
          )}
          {isAwaitingCollection && (
            <div className="text-sm rounded bg-green-50 text-green-800 px-3 py-2 space-y-1">
              <p className="font-medium">
                Your fob is ready to be collected
                {pickupLocation ? ` from ${pickupLocation.name}` : ""}.
              </p>
              {pickupLocation?.memberMessage && (
                <p className="whitespace-pre-line">{pickupLocation.memberMessage}</p>
              )}
              <p className="text-green-700">Please bring valid identification when collecting it.</p>
            </div>
          )}
        </CardContent>
      </Card>

      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Request Detail</h1>
        <RequestStatusBadge status={request.status} requestType={request.requestType} autoClosed={isAutoClosedReturn(request)} paymentRequested={postIssueDemand} />
      </div>

      <Card>
        <CardContent className="space-y-3 pt-6 text-sm">
          <div className="flex justify-between">
            <span className="text-muted-foreground">Type</span>
            <span className="capitalize">{request.requestType.replace(/_/g, " ")}</span>
          </div>
          <div className="flex justify-between">
            <span className="text-muted-foreground">Fob or key</span>
            <span>{credentialType?.name ?? "-"}</span>
          </div>
          <div className="flex justify-between">
            <span className="text-muted-foreground">Submitted</span>
            <span>{formatDate(request.submittedAt)}</span>
          </div>
          {request.paidAt && (
            <div className="flex justify-between">
              <span className="text-muted-foreground">Paid</span>
              <span>{formatDate(request.paidAt)}</span>
            </div>
          )}
          {request.approvedAt && (
            <div className="flex justify-between">
              <span className="text-muted-foreground">Approved</span>
              <span>{formatDate(request.approvedAt)}</span>
            </div>
          )}
          {request.programmedAt && (
            <div className="flex justify-between">
              <span className="text-muted-foreground">Programmed</span>
              <span>{formatDate(request.programmedAt)}</span>
            </div>
          )}
          {request.issuedAt && (
            <div className="flex justify-between">
              <span className="text-muted-foreground">Issued</span>
              <span>{formatDate(request.issuedAt)}</span>
            </div>
          )}
          {request.holdReason && (
            <div className="flex justify-between">
              <span className="text-muted-foreground">Hold Reason</span>
              <span className="text-destructive">{request.holdReason}</span>
            </div>
          )}
          {request.cancelReason && (
            <div className="flex justify-between">
              <span className="text-muted-foreground">Cancel Reason</span>
              <span className="text-destructive">{request.cancelReason}</span>
            </div>
          )}
        </CardContent>
      </Card>

      {canConfirmReceipt && (
        <ConfirmReceiptForm tenantSlug={slug} requestId={request.id} autoOpen={openConfirm} />
      )}

      {canCancel && (
        <CancelButton tenantSlug={slug} requestId={request.id} returnTo={`/t/${slug}/dashboard`} />
      )}

      {/* Timeline */}
      <Card>
        <CardHeader>
          <CardTitle className="text-base">Timeline</CardTitle>
        </CardHeader>
        <CardContent>
          <AuditTrail
            entries={auditTrail.map((e) => ({
              ...e,
              actorName: e.actorFirstName ? `${e.actorFirstName} ${e.actorLastName ?? ""}`.trim() : null,
              createdAt: typeof e.createdAt === "string" ? e.createdAt : (e.createdAt as Date).toISOString(),
              metadata: e.metadata as Record<string, unknown> | null,
            }))}
            slug={slug}
          />
        </CardContent>
      </Card>
    </div>
  );
}
