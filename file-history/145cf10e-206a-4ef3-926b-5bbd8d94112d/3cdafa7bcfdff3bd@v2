  const expiryLine = expiryDate
    ? `<p style="margin: 0; color: #166534; font-size: 13px;"><strong>Expires:</strong> ${expiryDate}</p>`
    : "";
  const body = `
    <h1 style="${heading()}">Your ${typeLower} is active again</h1>
    <p style="${bodyText()}">
      Dear ${memberName.split(" ")[0]},
    </p>
    <p style="${bodyText()}">
