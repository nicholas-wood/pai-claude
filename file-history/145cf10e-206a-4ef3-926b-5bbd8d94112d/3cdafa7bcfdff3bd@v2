const REQUEST_TYPE_LABELS: Record<string, string> = {
  new: "new fob or key",
  replacement_lost: "lost fob or key replacement",
  replacement_damaged: "damaged fob or key replacement",
  additional: "additional fob or key",
  return: "fob or key return",
  change_type: "fob or key type change",
  access_update: "access update",
};

function formatRequestType(requestType: string): string {
  return REQUEST_TYPE_LABELS[requestType] ?? requestType
    .replace(/_/g, " ")
    .toLowerCase()
    .replace(/^\w/, (c) => c.toUpperCase());
}
