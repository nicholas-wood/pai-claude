/**
 * Shared pay / cancel call-to-action block. The pay button is only rendered
 * when a URL is supplied so older call sites keep their behaviour; the cancel
 * line gives the member a no-sign-in way out so an unwanted request does not
 * sit in awaiting payment forever.
 */
function paymentActions(paymentUrl?: string, cancelUrl?: string): string {
  const payButton = paymentUrl
    ? `<div style="margin: 16px 0; text-align: center;">
        <a href="${paymentUrl}" style="${buttonStyle()}">Pay Now</a>
      </div>`
    : "";
  const cancelLine = cancelUrl
    ? `<p style="${mutedText()}">
        No longer need this? <a href="${cancelUrl}" style="color: ${getPrimaryColour()};">Cancel this request</a> and no payment will be taken.
      </p>`
    : "";
  return `${payButton}${cancelLine}`;
}

