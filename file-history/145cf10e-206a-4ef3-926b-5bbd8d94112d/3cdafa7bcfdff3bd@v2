// ---- Daily Summary template ----

export type SummarySection = {
  title: string; // e.g., "New Requests Awaiting Approval"
  count: number;
  items: { label: string; detail: string }[];
};

export type SummaryEmailOps = {
  /** Emails waiting in the outbound queue for this tenant. */
  queueDepth: number;
  /** Total emails sent across the platform so far today. */
  sentToday: number;
};

export function dailySummaryEmail(
  clubName: string,
  adminName: string,
  sections: SummarySection[],
  dashboardUrl: string,
  ops?: SummaryEmailOps
): string {
  const sectionRows = sections
    .map(
      (section) => `
      <tr>
        <td style="padding: 0 0 24px;">
          <h3 style="margin: 0 0 8px; font-size: 15px; color: #18181b;">${section.title} <span style="color: ${getPrimaryColour()}; font-weight: 600;">(${section.count})</span></h3>
          <table width="100%" cellpadding="0" cellspacing="0" style="border: 1px solid #e4e4e7; border-radius: 6px; overflow: hidden;">
            <tr style="background-color: #f4f4f5;">
              <td style="padding: 8px 12px; font-size: 12px; font-weight: 600; color: #71717a; border-bottom: 1px solid #e4e4e7;">Item</td>
              <td style="padding: 8px 12px; font-size: 12px; font-weight: 600; color: #71717a; border-bottom: 1px solid #e4e4e7;">Detail</td>
            </tr>
            ${section.items
              .map(
                (item, idx) => `
            <tr${idx % 2 === 1 ? ' style="background-color: #fafafa;"' : ""}>
              <td style="padding: 8px 12px; font-size: 13px; color: #3f3f46; border-bottom: 1px solid #f4f4f5;">${item.label}</td>
              <td style="padding: 8px 12px; font-size: 13px; color: #3f3f46; border-bottom: 1px solid #f4f4f5;">${item.detail}</td>
            </tr>`
              )
              .join("")}
          </table>
        </td>
      </tr>`
    )
    .join("");

  const totalCount = sections.reduce((sum, s) => sum + s.count, 0);

  const queueNote =
    ops && ops.queueDepth > 0
      ? " (bulk mail is spread across days to stay within the daily sending limit)"
      : "";
  const opsLine = ops
    ? `
    <p style="margin: 8px 0 0; color: #71717a; font-size: 12px;">
      Email delivery: ${ops.queueDepth} queued${queueNote} &middot; ${ops.sentToday} sent today.
    </p>`
    : "";

  const body = `
    <h2 style="margin: 0 0 8px; font-size: 18px; color: #18181b;">Daily Summary</h2>
    <p style="margin: 0 0 20px; color: #3f3f46; font-size: 14px; line-height: 1.6;">
      Hi ${adminName}, there ${totalCount === 1 ? "is" : "are"} ${totalCount} outstanding request${totalCount !== 1 ? "s" : ""} requiring action.
    </p>
    <table width="100%" cellpadding="0" cellspacing="0">
      ${sectionRows}
    </table>${opsLine}
    <div style="margin: 16px 0 0; text-align: center;">
      <a href="${dashboardUrl}" style="${buttonStyle()}">View in AccessBuddy</a>
    </div>`;
  return layout(clubName, body);
}

