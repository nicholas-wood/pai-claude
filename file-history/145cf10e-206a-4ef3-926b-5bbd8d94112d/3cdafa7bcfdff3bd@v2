/**
 * Prose noun for a credential type name: "Wristband - Large" -> "wristband",
 * "Key Fob" -> "key fob". The full type name still appears in the callout.
 */
export function credentialNoun(credentialType: string): string {
  return credentialType.split(" - ")[0].trim().toLowerCase() || "credential";
}

export function credentialReactivatedEmail(
  clubName: string,
  memberName: string,
  credentialType: string,
  serialNumber: string,
  expiryDate: string | null,
  season: string | null
): string {
  const typeLower = credentialNoun(credentialType);
  const thanks = season
    ? `Thanks for updating your membership for the ${season} Season.`
    : "Thanks for updating your membership.";
  const contact = _branding.replyToEmail
    ? `If you have any questions or issues, please email <a href="mailto:${_branding.replyToEmail}" style="color: ${getPrimaryColour()};">${_branding.replyToEmail}</a>.`
