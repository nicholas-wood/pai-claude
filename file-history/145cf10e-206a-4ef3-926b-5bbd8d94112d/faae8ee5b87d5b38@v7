import { describe, it, expect, beforeAll } from "vitest";
import {
  signCancelToken,
  verifyCancelToken,
  buildPaymentLinks,
  formatAmountCents,
  CANCEL_TOKEN_TTL_MS,
} from "../lib/payment-links";

const TENANT = "11111111-1111-1111-1111-111111111111";
const REQUEST = "22222222-2222-2222-2222-222222222222";
const OTHER_REQUEST = "33333333-3333-3333-3333-333333333333";

beforeAll(() => {
  process.env.SESSION_SIGNING_SECRET = "test-session-signing-secret-at-least-32-chars-long";
  process.env.NEXT_PUBLIC_APP_URL = "https://accessbuddy.example";
});

describe("cancel token", () => {
  it("round-trips a freshly signed token", () => {
    const token = signCancelToken({ tenantId: TENANT, requestId: REQUEST });
    expect(verifyCancelToken({ token, tenantId: TENANT, requestId: REQUEST })).toEqual({ valid: true });
  });

  it("rejects a token issued for a different request", () => {
    const token = signCancelToken({ tenantId: TENANT, requestId: REQUEST });
    expect(verifyCancelToken({ token, tenantId: TENANT, requestId: OTHER_REQUEST })).toEqual({
      valid: false,
      reason: "invalid",
    });
  });

  it("rejects a token issued for a different tenant", () => {
    const token = signCancelToken({ tenantId: TENANT, requestId: REQUEST });
    expect(verifyCancelToken({ token, tenantId: OTHER_REQUEST, requestId: REQUEST })).toEqual({
      valid: false,
      reason: "invalid",
    });
  });

  it("rejects a tampered signature", () => {
    const token = signCancelToken({ tenantId: TENANT, requestId: REQUEST });
    const [exp, sig] = token.split(".");
    const flipped = sig[0] === "a" ? "b" : "a";
    const tampered = `${exp}.${flipped}${sig.slice(1)}`;
    expect(verifyCancelToken({ token: tampered, tenantId: TENANT, requestId: REQUEST })).toEqual({
      valid: false,
      reason: "invalid",
    });
  });

  it("rejects a token whose expiry has been moved", () => {
    const token = signCancelToken({ tenantId: TENANT, requestId: REQUEST });
    const [exp, sig] = token.split(".");
    const extended = `${Number(exp) + 1000}.${sig}`;
    expect(verifyCancelToken({ token: extended, tenantId: TENANT, requestId: REQUEST })).toEqual({
      valid: false,
      reason: "invalid",
    });
  });

  it("rejects an expired token", () => {
    const expiresAt = Date.now() - 1;
    const token = signCancelToken({ tenantId: TENANT, requestId: REQUEST, expiresAt });
    expect(verifyCancelToken({ token, tenantId: TENANT, requestId: REQUEST })).toEqual({
      valid: false,
      reason: "expired",
    });
  });

  it("rejects malformed tokens", () => {
    for (const bad of ["", "abc", "123", "notanumber.sig", "1.2.3"]) {
      expect(verifyCancelToken({ token: bad, tenantId: TENANT, requestId: REQUEST }).valid).toBe(false);
    }
  });

  it("defaults to a 30 day expiry", () => {
    const before = Date.now();
    const token = signCancelToken({ tenantId: TENANT, requestId: REQUEST });
    const exp = Number(token.split(".")[0]);
    expect(exp).toBeGreaterThanOrEqual(before + CANCEL_TOKEN_TTL_MS - 5);
    expect(exp).toBeLessThanOrEqual(Date.now() + CANCEL_TOKEN_TTL_MS + 5);
  });
});

describe("buildPaymentLinks", () => {
  it("builds the public pay URL and a cancel URL carrying a verifiable token", () => {
    const { paymentUrl, cancelUrl } = buildPaymentLinks({
      tenantSlug: "smlsc",
      tenantId: TENANT,
      requestId: REQUEST,
    });
    expect(paymentUrl).toBe(`https://accessbuddy.example/t/smlsc/pay/${REQUEST}`);
    expect(cancelUrl.startsWith(`${paymentUrl}?cancel=`)).toBe(true);

    const token = decodeURIComponent(cancelUrl.split("?cancel=")[1]);
    expect(verifyCancelToken({ token, tenantId: TENANT, requestId: REQUEST })).toEqual({ valid: true });
  });
});

describe("formatAmountCents", () => {
  it("formats cents as dollars", () => {
    expect(formatAmountCents(2500)).toBe("$25.00");
    expect(formatAmountCents(5)).toBe("$0.05");
    expect(formatAmountCents(null)).toBe("$0.00");
  });
});
