import { NextResponse } from "next/server";
import { randomBytes } from "crypto";
import { requireCronSecret } from "@/lib/cron-auth";
import { db } from "@accessbuddy/db";
import { credentials, tenantMemberships, users, fobRequests, attestationRequests, tenants, pickupLocations, auditLog } from "@accessbuddy/db";
import { eq, and, lt, or, isNotNull, gte, isNull, desc, inArray } from "drizzle-orm";
import { CredentialStatus, RequestStatus, AuditEntityType, AuditAction } from "@accessbuddy/shared";
import type { TenantSettings } from "@accessbuddy/shared";
import {
  shouldAutoResend,
  nextTokenExpiry,
  latestPerUserSeason,
} from "@/lib/attestation-resend-logic";
import { clientEnv } from "@/env";
import { createAuditEntry } from "@/lib/services/audit";
import { evaluateRules } from "@/lib/services/rules";
import { sendDailySummaryEmails, sendTemplatedEmail, buildEmailConfig } from "@/lib/services/email";
import {
  drainEmailQueue,
  enqueueEmail,
  getQueueDepthByTenant,
  getTodaysSendCount,
  hasEmailForEntityInWindow,
} from "@/lib/services/email-queue";
import { classifyExpiryWindow } from "@/lib/email-queue-logic";
import { withTenant } from "@/lib/with-tenant";
import { formatExpiryDate } from "@/lib/format-date";

export const dynamic = "force-dynamic";

export async function GET(request: Request) {
  const unauthorised = requireCronSecret(request, "daily");
  if (unauthorised) return unauthorised;

  const now = new Date();
  const results = {
    expiredPermissions: 0,
    expiredCredentials: 0,
    accessLevelChanges: 0,
    expiredAttestations: 0,
    attestationsAutoResent: 0,
    expiredCredentialEmailsQueued: 0,
    paymentReminders: 0,
    expiryWarningsQueued: 0,
    pickupReminders: 0,
    dailySummaryRecipients: 0,
    dailySummarySections: 0,
    queueDrained: 0,
    queueRemaining: 0,
    queueBudgetLeft: 0,
  };

  try {
    // 0. Drain the outbound email queue first: yesterday's backlog goes out
    // against a fresh daily budget before today's work enqueues more. New
    // rows enqueued below are picked up by the 2-hourly drain scheduler.
    const drainStats = await drainEmailQueue(now);
    results.queueDrained = drainStats.drained;
    results.queueRemaining = drainStats.remaining;
    results.queueBudgetLeft = drainStats.budgetLeft;

    // 1a. Expired officer/board permissions
    const expiredOfficers = await db
      .select()
      .from(tenantMemberships)
      .where(
        or(
          and(
            eq(tenantMemberships.isOfficer, true),
            isNotNull(tenantMemberships.officerExpiresAt),
            lt(tenantMemberships.officerExpiresAt, now)
          ),
          and(
            eq(tenantMemberships.isBoardMember, true),
            isNotNull(tenantMemberships.boardExpiresAt),
            lt(tenantMemberships.boardExpiresAt, now)
          )
        )
      );

    for (const membership of expiredOfficers) {
      await db.transaction(async (tx) => {
        const updates: Record<string, unknown> = { updatedAt: now };
        const changes: string[] = [];

        if (membership.isOfficer && membership.officerExpiresAt && membership.officerExpiresAt < now) {
          updates.isOfficer = false;
          updates.officerExpiresAt = null;
          changes.push("officer expired");
        }
        if (membership.isBoardMember && membership.boardExpiresAt && membership.boardExpiresAt < now) {
          updates.isBoardMember = false;
          updates.boardExpiresAt = null;
          changes.push("board expired");
        }

        await tx
          .update(tenantMemberships)
          .set(updates)
          .where(eq(tenantMemberships.id, membership.id));

        // Re-evaluate rules for the updated member
        const [user] = await tx
          .select({ dateOfBirth: users.dateOfBirth })
          .from(users)
          .where(eq(users.id, membership.userId))
          .limit(1);

        let age: number | null = null;
        if (user?.dateOfBirth) {
          const dob = new Date(user.dateOfBirth);
          age = now.getFullYear() - dob.getFullYear();
          if (
            now.getMonth() < dob.getMonth() ||
            (now.getMonth() === dob.getMonth() && now.getDate() < dob.getDate())
          ) {
            age--;
          }
        }

        const updatedOfficer =
          membership.isOfficer && membership.officerExpiresAt && membership.officerExpiresAt < now
            ? false
            : membership.isOfficer;
        const updatedBoard =
          membership.isBoardMember && membership.boardExpiresAt && membership.boardExpiresAt < now
            ? false
            : membership.isBoardMember;

        const match = await evaluateRules(tx, membership.tenantId, {
          membershipCategory: membership.membershipCategory,
          isOfficer: updatedOfficer,
          isBoardMember: updatedBoard,
          isStaff: membership.isStaff,
          age,
        });

        // Update membership access level and flag credentials for reprogramming
        if (match) {
          // Update membership access level directly
          await tx
            .update(tenantMemberships)
            .set({ accessLevelId: match.accessLevelId, updatedAt: now })
            .where(eq(tenantMemberships.id, membership.id));

          const activeCredentials = await tx
            .select()
            .from(credentials)
            .where(
              and(
                eq(credentials.ownerId, membership.userId),
                eq(credentials.tenantId, membership.tenantId),
                eq(credentials.status, CredentialStatus.ACTIVE)
              )
            );

          for (const cred of activeCredentials) {
            // Recalculate expiry for credentials that previously had no expiry (board/staff)
            const needsExpiryUpdate = !cred.expiresAt && !membership.isStaff;
            let newExpiry: Date | null = null;
            if (needsExpiryUpdate) {
              const year = now.getFullYear();
              const month = now.getMonth();
              newExpiry = month >= 6 ? new Date(year + 1, 8, 1) : new Date(year, 8, 1);
            }

            const programmingReason = `Permission expired (${changes.join(", ")}). Access level: ${match.accessLevelName}${newExpiry ? ". Expiry updated." : ""}`;

            // Flag credential for reprogramming
            await tx
              .update(credentials)
              .set({
                programmingRequired: true,
                programmingReason,
                programmingRequestedAt: now,
                ...(newExpiry ? { expiresAt: newExpiry } : {}),
                updatedAt: now,
              })
              .where(eq(credentials.id, cred.id));

            await createAuditEntry(tx, {
              tenantId: membership.tenantId,
              entityType: AuditEntityType.CREDENTIAL,
              entityId: cred.id,
              action: AuditAction.UPDATE,
              actorType: "system",
              metadata: {
                action: "permission_expiry_reprogramming",
                previousAccessLevelId: cred.accessLevelId,
                newAccessLevelId: match.accessLevelId,
                newAccessLevelName: match.accessLevelName,
                expiredPermissions: changes,
                programmingRequired: true,
                ...(newExpiry ? { newExpiresAt: newExpiry.toISOString() } : {}),
              },
            });
            results.accessLevelChanges++;
          }
        }

        await createAuditEntry(tx, {
          tenantId: membership.tenantId,
          entityType: AuditEntityType.MEMBER,
          entityId: membership.userId,
          action: AuditAction.UPDATE,
          actorType: "system",
          metadata: { action: "permission_expired", changes },
        });

        results.expiredPermissions++;
      });
    }

    // 1b. Expired attestation requests. attestation_requests is FORCE
    // row-level security (migration 0011, re-asserted in 0014), so a
    // context-free batch update matches ZERO rows once RLS binds for the
    // app role — links would silently never expire. Run per tenant inside
    // withTenant instead. The tenants table itself is not tenant-scoped,
    // so listing it without context is fine. Soft-deleted tenants are
    // skipped, matching resolveTenant.
    const allTenants = await db
      .select({ id: tenants.id, slug: tenants.slug, settings: tenants.settings })
      .from(tenants)
      .where(isNull(tenants.deletedAt));
    for (const t of allTenants) {
      const expiredAttestationRows = await withTenant(t.id, (tx) =>
        tx
          .update(attestationRequests)
          .set({ status: "expired", updatedAt: now })
          .where(
            and(
              eq(attestationRequests.tenantId, t.id),
              eq(attestationRequests.status, "pending"),
              lt(attestationRequests.tokenExpiresAt, now)
            )
          )
          .returning({ id: attestationRequests.id })
      );
      results.expiredAttestations += expiredAttestationRows.length;

      // 1b2. Auto-resend lapsed attestations. A member whose latest
      // attestation for the season they were renewed into has lapsed gets a
      // fresh one (new token, new expiry) and the email is queued again, so
      // they are re-asked every attestationTokenExpiryDays until they
      // complete it. Runs after 1b so a token that lapsed overnight is
      // replaced in the same run. Previous rows stay `expired`; the new row
      // reuses the original initiator because initiated_by is NOT NULL and
      // there is no system user. Eligibility rules live in
      // lib/attestation-resend-logic.ts.
      const tenantSettings = (t.settings ?? {}) as Partial<TenantSettings>;
      const tokenExpiryDays = tenantSettings.attestationTokenExpiryDays ?? 7;
      const autoResendEnabled = tenantSettings.attestationAutoResend;

      const resentForTenant = await withTenant(t.id, async (tx) => {
        const attestationRows = await tx
          .select({
            id: attestationRequests.id,
            userId: attestationRequests.userId,
            season: attestationRequests.season,
            status: attestationRequests.status,
            tokenExpiresAt: attestationRequests.tokenExpiresAt,
            initiatedBy: attestationRequests.initiatedBy,
            createdAt: attestationRequests.createdAt,
          })
          .from(attestationRequests)
          .where(eq(attestationRequests.tenantId, t.id));

        const latest = latestPerUserSeason(attestationRows);
        if (latest.size === 0) return 0;

        const candidateUserIds = Array.from(
          new Set(Array.from(latest.values()).map((v) => v.latest.userId))
        );

        const [membershipRows, userRows, credentialRows] = await Promise.all([
          tx
            .select({
              userId: tenantMemberships.userId,
              currentSeason: tenantMemberships.currentSeason,
              status: tenantMemberships.status,
            })
            .from(tenantMemberships)
            .where(
              and(
                eq(tenantMemberships.tenantId, t.id),
                inArray(tenantMemberships.userId, candidateUserIds)
              )
            ),
          tx
            .select({
              id: users.id,
              email: users.email,
              firstName: users.firstName,
              lastName: users.lastName,
            })
            .from(users)
            .where(inArray(users.id, candidateUserIds)),
          tx
            .select({ ownerId: credentials.ownerId })
            .from(credentials)
            .where(
              and(
                eq(credentials.tenantId, t.id),
                inArray(credentials.ownerId, candidateUserIds),
                inArray(credentials.status, [
                  CredentialStatus.ACTIVE,
                  CredentialStatus.EXPIRED,
                ])
              )
            ),
        ]);

        const membershipByUser = new Map(membershipRows.map((m) => [m.userId, m]));
        const userById = new Map(userRows.map((u) => [u.id, u]));
        const attestableCount = new Map<string, number>();
        for (const c of credentialRows) {
          if (!c.ownerId) continue;
          attestableCount.set(c.ownerId, (attestableCount.get(c.ownerId) ?? 0) + 1);
        }

        let resent = 0;
        for (const { latest: prev, cycle } of latest.values()) {
          const membership = membershipByUser.get(prev.userId);
          const user = userById.get(prev.userId);
          if (!membership || !user) continue;

          const decision = shouldAutoResend({
            latestStatus: prev.status,
            latestTokenExpiresAt: prev.tokenExpiresAt,
            attestationSeason: prev.season,
            membershipSeason: membership.currentSeason ?? null,
            membershipStatus: membership.status,
            attestableCredentialCount: attestableCount.get(prev.userId) ?? 0,
            email: user.email,
            autoResendEnabled,
            now,
          });
          if (!decision.resend) continue;

          const token = randomBytes(32).toString("hex");
          const [fresh] = await tx
            .insert(attestationRequests)
            .values({
              tenantId: t.id,
              userId: prev.userId,
              season: prev.season,
              token,
              tokenExpiresAt: nextTokenExpiry(now, tokenExpiryDays),
              status: "pending",
              initiatedBy: prev.initiatedBy,
            })
            .returning({ id: attestationRequests.id });

          const attestUrl = `${clientEnv.NEXT_PUBLIC_APP_URL}/t/${t.slug}/attest/${token}`;
          await enqueueEmail(tx, {
            tenantId: t.id,
            templateType: "attestationRequested",
            recipient: user.email,
            variables: {
              memberName: `${user.firstName} ${user.lastName}`.trim() || "Member",
              attestUrl,
            },
            entityType: AuditEntityType.MEMBER,
            entityId: prev.userId,
          });

          await createAuditEntry(tx, {
            tenantId: t.id,
            entityType: AuditEntityType.MEMBER,
            entityId: prev.userId,
            action: AuditAction.UPDATE,
            actorType: "system",
            metadata: {
              action: "attestation_auto_resent",
              season: prev.season,
              previousAttestationId: prev.id,
              attestationId: fresh.id,
              // 1 = the original request; this row is reminder number cycle.
              cycle: cycle + 1,
              tokenExpiryDays,
            },
          });
          resent++;
        }
        return resent;
      });
      results.attestationsAutoResent += resentForTenant;
    }

    // 1c. Expired credentials
    const expiredCreds = await db
      .select()
      .from(credentials)
      .where(
        and(
          lt(credentials.expiresAt, now),
          eq(credentials.status, CredentialStatus.ACTIVE)
        )
      );

    for (const cred of expiredCreds) {
      await withTenant(cred.tenantId, async (tx) => {
        await tx
          .update(credentials)
          .set({
            status: CredentialStatus.EXPIRED,
            deactivatedAt: now,
            updatedAt: now,
          })
          .where(eq(credentials.id, cred.id));

        await createAuditEntry(tx, {
          tenantId: cred.tenantId,
          entityType: AuditEntityType.CREDENTIAL,
          entityId: cred.id,
          action: AuditAction.STATUS_CHANGE,
          fromState: CredentialStatus.ACTIVE,
          toState: CredentialStatus.EXPIRED,
          actorType: "system",
          metadata: {
            reason: "Credential expired",
            expiresAt: cred.expiresAt?.toISOString(),
          },
        });

        // Queue the credential expired email to the owner. Bulk mail is
        // enqueued (priority 2) rather than sent inline so the drain can
        // spread it across days under the daily Resend budget. Dedupe: skip
        // if an expired email for this credential was already sent or
        // queued since the expiry date.
        if (cred.ownerId) {
          const [owner] = await tx
            .select({ email: users.email, firstName: users.firstName, lastName: users.lastName })
            .from(users)
            .where(eq(users.id, cred.ownerId))
            .limit(1);

          if (owner?.email) {
            const memberName = `${owner.firstName} ${owner.lastName}`.trim() || "Member";

            try {
              const alreadyHandled = await hasEmailForEntityInWindow({
                tenantId: cred.tenantId,
                entityType: AuditEntityType.CREDENTIAL,
                entityId: cred.id,
                templateType: "credentialExpired",
                windowStart: cred.expiresAt ?? now,
              });

              if (!alreadyHandled) {
                await enqueueEmail(tx, {
                  tenantId: cred.tenantId,
                  templateType: "credentialExpired",
                  recipient: owner.email,
                  variables: { memberName, serialNumber: cred.serialNumber ?? "N/A" },
                  entityType: AuditEntityType.CREDENTIAL,
                  entityId: cred.id,
                });
                results.expiredCredentialEmailsQueued++;
              }
            } catch (err) {
              console.error("Failed to queue credential expired email:", err);
            }
          }
        }

        results.expiredCredentials++;
      });
    }
    // 1d. Payment reminders for unpaid requests older than 3 days
    const threeDaysAgo = new Date(now.getTime() - 3 * 24 * 60 * 60 * 1000);
    const unpaidRequests = await db
      .select({
        id: fobRequests.id,
        tenantId: fobRequests.tenantId,
        requesterId: fobRequests.requesterId,
        orphanEmail: fobRequests.orphanEmail,
        orphanFirstName: fobRequests.orphanFirstName,
        orphanLastName: fobRequests.orphanLastName,
        isOrphaned: fobRequests.isOrphaned,
        paymentAmountCents: fobRequests.paymentAmountCents,
      })
      .from(fobRequests)
      .where(
        and(
          eq(fobRequests.status, RequestStatus.AWAITING_PAYMENT),
          eq(fobRequests.paymentExempt, false),
          isNull(fobRequests.paidAt),
          lt(fobRequests.createdAt, threeDaysAgo)
        )
      );

    for (const req of unpaidRequests) {
      try {
        let recipientEmail: string | null = null;
        let memberName = "Member";

        if (req.requesterId) {
          const [owner] = await db
            .select({ email: users.email, firstName: users.firstName, lastName: users.lastName })
            .from(users)
            .where(eq(users.id, req.requesterId))
            .limit(1);
          if (owner?.email) {
            recipientEmail = owner.email;
            memberName = `${owner.firstName} ${owner.lastName}`.trim() || "Member";
          }
        } else if (req.isOrphaned && req.orphanEmail) {
          recipientEmail = req.orphanEmail;
          memberName = [req.orphanFirstName, req.orphanLastName].filter(Boolean).join(" ") || "Member";
        }

        if (recipientEmail) {
          const [tenantRow] = await db
            .select({ name: tenants.name, settings: tenants.settings, logoUrl: tenants.logoUrl })
            .from(tenants)
            .where(eq(tenants.id, req.tenantId))
            .limit(1);

          if (tenantRow) {
            const emailConfig = buildEmailConfig(tenantRow);
            const amountCents = req.paymentAmountCents ?? 0;
            const amount = `$${(amountCents / 100).toFixed(2)}`;

            await withTenant(req.tenantId, async (tx) => {
              await sendTemplatedEmail(
                recipientEmail!,
                "paymentReminder",
                { memberName, amount },
                emailConfig,
                undefined,
                {
                  tx,
                  tenantId: req.tenantId,
                  entityType: AuditEntityType.FOB_REQUEST,
                  entityId: req.id,
                  actorId: null,
                }
              );
            });
            results.paymentReminders++;
          }
        }
      } catch (err) {
        console.error("Failed to send payment reminder:", err);
      }
    }

    // 1e. Expiry warning emails - queued in two windows: 30-24 days and
    // 7-2 days before expiry. Windows are ranges (not exact days) so anyone
    // missed on a budget-capped day is backfilled on a later day within the
    // same window; window dedupe guarantees at most one warning per window.
    // Get active credentials that expire within the next 31 days
    const activeCredsWithExpiry = await db
      .select({
        id: credentials.id,
        tenantId: credentials.tenantId,
        ownerId: credentials.ownerId,
        serialNumber: credentials.serialNumber,
        expiresAt: credentials.expiresAt,
        pendingExpiresAt: credentials.pendingExpiresAt,
      })
      .from(credentials)
      .where(
        and(
          eq(credentials.status, CredentialStatus.ACTIVE),
          isNotNull(credentials.expiresAt),
          // Only look at credentials expiring within the next 31 days
          lt(credentials.expiresAt, new Date(now.getTime() + 31 * 24 * 60 * 60 * 1000)),
          gte(credentials.expiresAt, now)
        )
      );

    for (const cred of activeCredsWithExpiry) {
      if (!cred.expiresAt || !cred.ownerId) continue;

      // Skip credentials whose renewal is already staged: a pending expiry in
      // the future means the member has renewed and programming will extend
      // the fob. Warning them to renew again is confusing and wrong.
      if (cred.pendingExpiresAt && cred.pendingExpiresAt > now) continue;

      // Which warning window (if any) is this credential in?
      const expiryDate = new Date(cred.expiresAt);
      const warningWindow = classifyExpiryWindow(expiryDate, now);
      if (!warningWindow) continue;

      try {
        // Dedupe within the window: skip if a warning for this credential
        // was already sent (audit) or queued since the window opened.
        const alreadyHandled = await hasEmailForEntityInWindow({
          tenantId: cred.tenantId,
          entityType: AuditEntityType.CREDENTIAL,
          entityId: cred.id,
          templateType: "credentialExpiryWarning",
          windowStart: warningWindow.windowStart,
        });
        if (alreadyHandled) continue;

        const [owner] = await db
          .select({ email: users.email, firstName: users.firstName, lastName: users.lastName })
          .from(users)
          .where(eq(users.id, cred.ownerId))
          .limit(1);

        if (owner?.email) {
          const [tenantRow] = await db
            .select({ timezone: tenants.timezone })
            .from(tenants)
            .where(eq(tenants.id, cred.tenantId))
            .limit(1);

          if (tenantRow) {
            const memberName = `${owner.firstName} ${owner.lastName}`.trim() || "Member";
            const expiresAtFormatted = formatExpiryDate(expiryDate, tenantRow.timezone);

            await withTenant(cred.tenantId, async (tx) => {
              await enqueueEmail(tx, {
                tenantId: cred.tenantId,
                templateType: "credentialExpiryWarning",
                recipient: owner.email!,
                variables: {
                  memberName,
                  serialNumber: cred.serialNumber ?? "N/A",
                  expiresAt: expiresAtFormatted,
                },
                entityType: AuditEntityType.CREDENTIAL,
                entityId: cred.id,
              });
            });
            results.expiryWarningsQueued++;
          }
        }
      } catch (err) {
        console.error("Failed to queue expiry warning:", err);
      }
    }

    // 1f. Pickup reminders - weekly for requests awaiting pickup 7+ days
    const sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
    const pickupRequests = await db
      .select({
        id: fobRequests.id,
        tenantId: fobRequests.tenantId,
        requesterId: fobRequests.requesterId,
        orphanEmail: fobRequests.orphanEmail,
        orphanFirstName: fobRequests.orphanFirstName,
        orphanLastName: fobRequests.orphanLastName,
        isOrphaned: fobRequests.isOrphaned,
        pickupLocationId: fobRequests.pickupLocationId,
      })
      .from(fobRequests)
      .where(
        and(
          eq(fobRequests.status, RequestStatus.AWAITING_PICKUP),
          lt(fobRequests.updatedAt, sevenDaysAgo)
        )
      );

    const appUrl = process.env.NEXT_PUBLIC_APP_URL || "http://localhost:3000";

    for (const req of pickupRequests) {
      try {
        // Skip if a pickup reminder was already sent in the last 7 days.
        // Check recent email_sent audit entries for this request and look
        // for templateType: "pickupReminder" in metadata.
        const recentEmails = await db
          .select({ metadata: auditLog.metadata })
          .from(auditLog)
          .where(
            and(
              eq(auditLog.entityId, req.id),
              eq(auditLog.action, AuditAction.EMAIL_SENT),
              gte(auditLog.createdAt, sevenDaysAgo)
            )
          );

        const hasRecentReminder = recentEmails.some((entry) => {
          const meta = entry.metadata as Record<string, unknown> | null;
          return meta?.templateType === "pickupReminder";
        });
        if (hasRecentReminder) continue;

        let recipientEmail: string | null = null;
        let memberName = "Member";

        if (req.requesterId) {
          const [owner] = await db
            .select({ email: users.email, firstName: users.firstName, lastName: users.lastName })
            .from(users)
            .where(eq(users.id, req.requesterId))
            .limit(1);
          if (owner?.email) {
            recipientEmail = owner.email;
            memberName = `${owner.firstName} ${owner.lastName}`.trim() || "Member";
          }
        } else if (req.isOrphaned && req.orphanEmail) {
          recipientEmail = req.orphanEmail;
          memberName = [req.orphanFirstName, req.orphanLastName].filter(Boolean).join(" ") || "Member";
        }

        if (!recipientEmail) continue;

        const [tenantRow] = await db
          .select({ name: tenants.name, slug: tenants.slug, settings: tenants.settings, logoUrl: tenants.logoUrl })
          .from(tenants)
          .where(eq(tenants.id, req.tenantId))
          .limit(1);
        if (!tenantRow) continue;

        let pickupLocation = "See club for details";
        if (req.pickupLocationId) {
          const [loc] = await db
            .select({ name: pickupLocations.name })
            .from(pickupLocations)
            .where(eq(pickupLocations.id, req.pickupLocationId))
            .limit(1);
          if (loc) pickupLocation = loc.name;
        }

        const emailConfig = buildEmailConfig(tenantRow);
        const requestUrl = `${appUrl}/t/${tenantRow.slug}/dashboard/requests/${req.id}`;

        await withTenant(req.tenantId, async (tx) => {
          await sendTemplatedEmail(
            recipientEmail!,
            "pickupReminder",
            { memberName, pickupLocation, requestUrl },
            emailConfig,
            undefined,
            {
              tx,
              tenantId: req.tenantId,
              entityType: AuditEntityType.FOB_REQUEST,
              entityId: req.id,
              actorId: null,
            }
          );
        });
        results.pickupReminders++;
      } catch (err) {
        console.error("Failed to send pickup reminder:", err);
      }
    }

    // 2. Send daily summary emails for all queued notifications, with
    // email-delivery visibility (queue depth + today's send count) so admins
    // can see bulk mail being spread across days under the daily cap.
    const [sentToday, queueDepthByTenant] = await Promise.all([
      getTodaysSendCount(now),
      getQueueDepthByTenant(),
    ]);
    const summaryResult = await sendDailySummaryEmails({ sentToday, queueDepthByTenant });
    results.dailySummaryRecipients = summaryResult.recipientsSent;
    results.dailySummarySections = summaryResult.sectionsIncluded;
  } catch (err) {
    console.error("Cron daily error:", err);
    return NextResponse.json(
      { error: "Processing failed", details: String(err) },
      { status: 500 }
    );
  }

  console.log(`Cron daily completed: ${JSON.stringify(results)}`);
  return NextResponse.json({
    success: true,
    processed: results,
    timestamp: now.toISOString(),
  });
}
