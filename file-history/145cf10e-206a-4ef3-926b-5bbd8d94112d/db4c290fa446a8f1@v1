// ============================================================
// Payment Determination
// ============================================================
describe("Payment Determination", () => {
  const baseSettings = {
    credentialExpiryMonths: 12,
    membershipRolloverMonth: 7,
    credentialRolloverMonth: 9,
    paymentExemptMembershipCategories: ["Life Member", "Junior"],
    paymentExemptRequestTypes: [RequestType.RETURN, RequestType.CHANGE_TYPE, RequestType.ACCESS_UPDATE] as RequestType[],
    allowSelfServiceLostReport: true,
    allowFobCreationAtProgramming: false,
    splitPickupFromProgramming: false,
    maxActiveCredentialsPerMember: 3,
    membershipCategories: [],
    issuedEmailAttachmentUrls: [],
    seasons: [],
    attestationTokenExpiryDays: 7,
    attestationAutoResend: true,
    sendEmails: true,
  };

  it("requires payment for new fob from regular member", () => {
    const result = determinePayment({
      requestType: RequestType.NEW,
      membershipCategory: "Active",
      tenantSettings: baseSettings,
      credentialPriceCents: 5000,
    });
    expect(result.required).toBe(true);
    expect(result.amountCents).toBe(5000);
  });

  it("exempts payment for exempt membership category", () => {
    const result = determinePayment({
      requestType: RequestType.NEW,
      membershipCategory: "Life Member",
      tenantSettings: baseSettings,
      credentialPriceCents: 5000,
    });
    expect(result.required).toBe(false);
  });

  it("exempts payment for exempt request type", () => {
    const result = determinePayment({
      requestType: RequestType.RETURN,
      membershipCategory: "Active",
      tenantSettings: baseSettings,
      credentialPriceCents: 5000,
    });
    expect(result.required).toBe(false);
  });

  it("exempts payment for access_update", () => {
    const result = determinePayment({
      requestType: RequestType.ACCESS_UPDATE,
      membershipCategory: "Active",
      tenantSettings: baseSettings,
      credentialPriceCents: 5000,
    });
    expect(result.required).toBe(false);
  });

  it("requires payment for replacement_lost from regular member", () => {
    const result = determinePayment({
      requestType: RequestType.REPLACEMENT_LOST,
      membershipCategory: "Active",
      tenantSettings: baseSettings,
      credentialPriceCents: 5000,
    });
    expect(result.required).toBe(true);
  });

  it("requires payment for additional fob", () => {
    const result = determinePayment({
      requestType: RequestType.ADDITIONAL,
      membershipCategory: "Active",
      tenantSettings: baseSettings,
      credentialPriceCents: 5000,
    });
    expect(result.required).toBe(true);
  });

  it("no payment when credential price is 0", () => {
    const result = determinePayment({
      requestType: RequestType.NEW,
      membershipCategory: "Active",
      tenantSettings: baseSettings,
      credentialPriceCents: 0,
    });
    expect(result.required).toBe(true);
    expect(result.amountCents).toBe(0);
  });

  it("no payment with null membership category but category-exempt config", () => {
    const result = determinePayment({
      requestType: RequestType.NEW,
      membershipCategory: null,
      tenantSettings: baseSettings,
      credentialPriceCents: 5000,
    });
    expect(result.required).toBe(true);
  });
});

// ============================================================
// Auto-approval
// ============================================================
describe("Auto-approval", () => {
  it("auto-approves return requests", () => {
    expect(shouldAutoApprove(RequestType.RETURN)).toBe(true);
  });

  it("does not auto-approve new requests", () => {
    expect(shouldAutoApprove(RequestType.NEW)).toBe(false);
  });

  it("does not auto-approve replacement_lost", () => {
    expect(shouldAutoApprove(RequestType.REPLACEMENT_LOST)).toBe(false);
  });

  it("does not auto-approve additional", () => {
    expect(shouldAutoApprove(RequestType.ADDITIONAL)).toBe(false);
  });
});

