// ============================================================
// State Machine Flow Validation
// ============================================================
describe("State Machine Flow Validation", () => {
  describe("new fob request happy path", () => {
    it("SUBMITTED -> PAYMENT_REQUIRED -> AWAITING_PAYMENT", () => {
      const events = getValidEvents(RequestStatus.SUBMITTED);
      expect(events).toContain("PAYMENT_REQUIRED");
    });

    it("SUBMITTED -> PAYMENT_RECEIVED -> AWAITING_APPROVAL (direct pay)", () => {
      const events = getValidEvents(RequestStatus.SUBMITTED);
      expect(events).toContain("PAYMENT_RECEIVED");
    });

    it("AWAITING_APPROVAL -> APPROVE -> AWAITING_PROGRAMMING", () => {
      const events = getValidEvents(RequestStatus.AWAITING_APPROVAL);
      expect(events).toContain("APPROVE");
    });

    it("AWAITING_PROGRAMMING -> PROGRAM -> PROGRAMMED", () => {
      const events = getValidEvents(RequestStatus.AWAITING_PROGRAMMING);
      expect(events).toContain("PROGRAM");
    });

    it("PROGRAMMED -> SET_PICKUP -> AWAITING_PICKUP", () => {
      const events = getValidEvents(RequestStatus.PROGRAMMED);
      expect(events).toContain("SET_PICKUP");
    });

    it("AWAITING_PICKUP -> ISSUE -> ISSUED", () => {
      const events = getValidEvents(RequestStatus.AWAITING_PICKUP);
      expect(events).toContain("ISSUE");
    });

    it("ISSUED is final", () => {
      expect(getValidEvents(RequestStatus.ISSUED)).toEqual([]);
    });
  });

  describe("exemption flow", () => {
    it("SUBMITTED -> REQUEST_EXEMPTION -> AWAITING_EXEMPTION_REVIEW", () => {
      const events = getValidEvents(RequestStatus.SUBMITTED);
      expect(events).toContain("REQUEST_EXEMPTION");
    });

    it("AWAITING_PAYMENT -> REQUEST_EXEMPTION -> AWAITING_EXEMPTION_REVIEW", () => {
      const events = getValidEvents(RequestStatus.AWAITING_PAYMENT);
      expect(events).toContain("REQUEST_EXEMPTION");
    });

    it("AWAITING_EXEMPTION_REVIEW -> APPROVE_EXEMPTION -> AWAITING_APPROVAL", () => {
      const events = getValidEvents(RequestStatus.AWAITING_EXEMPTION_REVIEW);
      expect(events).toContain("APPROVE_EXEMPTION");
    });

    it("AWAITING_EXEMPTION_REVIEW -> REJECT_EXEMPTION -> AWAITING_PAYMENT", () => {
      const events = getValidEvents(RequestStatus.AWAITING_EXEMPTION_REVIEW);
      expect(events).toContain("REJECT_EXEMPTION");
    });
  });

  describe("hold/resume", () => {
    const holdableStates = [
      RequestStatus.SUBMITTED,
      RequestStatus.AWAITING_PAYMENT,
      RequestStatus.AWAITING_EXEMPTION_REVIEW,
      RequestStatus.AWAITING_APPROVAL,
      RequestStatus.AWAITING_PROGRAMMING,
      RequestStatus.PROGRAMMED,
      RequestStatus.AWAITING_PICKUP,
    ];

    for (const state of holdableStates) {
      it(`${state} can be held`, () => {
        expect(getValidEvents(state)).toContain("HOLD");
      });
    }

    it("ON_HOLD can resume", () => {
      expect(getValidEvents(RequestStatus.ON_HOLD)).toContain("RESUME");
    });

    it("ON_HOLD can cancel", () => {
      expect(getValidEvents(RequestStatus.ON_HOLD)).toContain("CANCEL");
    });
  });

  describe("cancellation", () => {
    const cancellableStates = [
      RequestStatus.SUBMITTED,
      RequestStatus.AWAITING_PAYMENT,
      RequestStatus.AWAITING_EXEMPTION_REVIEW,
      RequestStatus.AWAITING_APPROVAL,
      RequestStatus.AWAITING_PROGRAMMING,
      RequestStatus.PROGRAMMED,
      RequestStatus.AWAITING_PICKUP,
      RequestStatus.ON_HOLD,
    ];

    for (const state of cancellableStates) {
      it(`${state} can be cancelled`, () => {
        expect(getValidEvents(state)).toContain("CANCEL");
      });
    }

    it("final states cannot be cancelled", () => {
      expect(getValidEvents(RequestStatus.ISSUED)).not.toContain("CANCEL");
      expect(getValidEvents(RequestStatus.REJECTED)).not.toContain("CANCEL");
      expect(getValidEvents(RequestStatus.CANCELLED)).not.toContain("CANCEL");
    });
  });
});

