import { describe, expect, it } from "vitest";
import { pickContactDestination } from "@/lib/services/contact-destination";

describe("pickContactDestination", () => {
  it("prefers the CONTACT_EMAIL env override over everything else", () => {
    expect(
      pickContactDestination({
        envEmail: "ops@example.com",
        landingEmail: "landing@example.com",
        globalAdminEmails: ["admin@example.com"],
      })
    ).toEqual({ to: ["ops@example.com"], source: "env" });
  });

  it("uses the landing setting when no env override is set", () => {
    expect(
      pickContactDestination({
        envEmail: undefined,
        landingEmail: "  landing@example.com ",
        globalAdminEmails: ["admin@example.com"],
      })
    ).toEqual({ to: ["landing@example.com"], source: "landing" });
  });

  it("falls back to global admins when the landing setting is blank", () => {
    // This is the production regression: the shipped default is "" and an
    // admin can save it blank, which used to switch the form off entirely.
    expect(
      pickContactDestination({
        envEmail: "",
        landingEmail: "   ",
        globalAdminEmails: ["Admin@Example.com", "second@example.com"],
      })
    ).toEqual({
      to: ["admin@example.com", "second@example.com"],
      source: "global-admins",
    });
  });

  it("de-duplicates global admins assigned in more than one tenant", () => {
    expect(
      pickContactDestination({
        globalAdminEmails: ["a@example.com", "A@example.com ", "", "a@example.com"],
      })
    ).toEqual({ to: ["a@example.com"], source: "global-admins" });
  });

  it("returns null only when nothing at all resolves", () => {
    expect(pickContactDestination({})).toBeNull();
    expect(
      pickContactDestination({ envEmail: " ", landingEmail: "", globalAdminEmails: [] })
    ).toBeNull();
  });
});
