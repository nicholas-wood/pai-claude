        <div class="col" title="2022/23: 1,097 cases"><div class="cv">1,097</div><div class="stick" style="height:65%"></div><div class="cl">22/23</div></div>
        <div class="col" title="2023/24: 1,510 cases"><div class="cv">1,510</div><div class="stick" style="height:89.5%"></div><div class="cl">23/24</div></div>
        <div class="col" title="2024/25: 1,688 cases"><div class="cv">1,688</div><div class="stick" style="height:100%"></div><div class="cl">24/25</div></div>
