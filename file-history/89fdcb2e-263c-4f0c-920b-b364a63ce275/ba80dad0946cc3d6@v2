import { NextRequest, NextResponse } from "next/server";
import { z } from "zod";
import { getMemberByEmail } from "@/lib/members";
import { generateOtpCode, setOtp } from "@/lib/otp-store";
import { checkRateLimitIpAndEmail, getClientIp } from "@/lib/rate-limit";
import { sendVerificationCodeEmail } from "@/lib/email";
import { resendConfigured } from "@/env";

export const dynamic = "force-dynamic";

const schema = z.object({ email: z.string().email() });

/** Email-code send, ported from AccessBuddy. Requires a configured mailer. */
export async function POST(request: NextRequest) {
  if (!resendConfigured()) return NextResponse.json({ error: "Code sign-in is not enabled" }, { status: 404 });
  const body = await request.json().catch(() => null);
  const parsed = schema.safeParse(body);
  if (!parsed.success) return NextResponse.json({ error: "Valid email required" }, { status: 400 });

  const email = parsed.data.email.toLowerCase().trim();
  const ip = getClientIp(request);
  const rl = await checkRateLimitIpAndEmail("auth.send-otp", ip, email, { windowSeconds: 60, maxPerIp: 10, maxPerEmail: 5 });
  if (!rl.ok) {
    return NextResponse.json({ error: "Too many requests, please wait a moment and try again." }, { status: 429, headers: { "Retry-After": String(rl.retryAfter) } });
  }

  const member = await getMemberByEmail(email);
  if (!member) return NextResponse.json({ sent: true });

  const code = generateOtpCode();
  await setOtp(email, code);
  if (process.env.NODE_ENV !== "production") {
    console.log(`[DEV] Sign-in code for ${email}: ${code}`);
    return NextResponse.json({ sent: true, devCode: code });
  }
  const result = await sendVerificationCodeEmail(email, code);
  if (!result.sent) return NextResponse.json({ error: "We could not send your sign-in code right now. Please try again in a few minutes." }, { status: 502 });
  return NextResponse.json({ sent: true });
}
