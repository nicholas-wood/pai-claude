import { NextRequest, NextResponse } from "next/server";
import { getAdminAuth } from "@/lib/firebase-admin";
import { getAuthUser } from "@/lib/auth";
import { clientEnv } from "@/env";
import { memberClaims } from "@/lib/claims";

export const dynamic = "force-dynamic";

/**
 * Mint a Firebase custom token for the holder of a valid session cookie so
 * the browser Firestore SDK can authenticate when it has no Firebase session
 * of its own (OTP sign-in, cleared site data). The claims mirror what
 * members.ts sets, so rules see the app-scoped `poc_oss` claim immediately.
 *
 * POST only, same-origin only, never cached.
 */
export async function POST(request: NextRequest) {
  const origin = request.headers.get("origin");
  if (!origin || origin !== new URL(clientEnv.NEXT_PUBLIC_APP_URL).origin) {
    return NextResponse.json({ error: "Forbidden" }, { status: 403 });
  }
  const user = await getAuthUser();
  if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  const token = await getAdminAuth().createCustomToken(user.uid, memberClaims(user.role, user.displayName));
  return NextResponse.json({ token }, { headers: { "Cache-Control": "no-store" } });
}
