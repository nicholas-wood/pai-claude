  const wx = [], gaps = [];
  for (const [, regions] of weatherRegions()) for (const r of regions) for (const d of days) {
    const w = S.weather[d]?.regions?.[r];
    if (!w || !w.max) { gaps.push(`${r} weather ${nice(d)}`); continue; }
    const mx = parseFloat(w.max), wind = Math.max(...String(w.wind || "").split(/[^0-9]+/).map(Number).filter(n => !isNaN(n)), 0), uv = parseFloat(w.uv), rain = parseFloat(String(w.rain).replace("<", ""));
