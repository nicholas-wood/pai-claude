/* ---------- executive summary: counts per service type, then events in date order ---------- */
const SUM_CATS = [["Air", "Air Services"], ["RPAS", "RPAS Services"], ["RWC", "RWC Services"], ["Lifeguard", "Lifeguard Services"], ["Club", "Club Services"]];
function unitPeriodStatus(u, days) {
  const rs = days.map(d => resolve(u, d));
  if (rs.some(r => r.status === "Online")) return "Online";
  if (rs.some(r => r.status === "Recall")) return "On Call";
  if (rs.some(r => r.status === "Offline")) return "Offline";
  return "Not Rostered";
}
function summaryText(days, units) {
  const out = [];
  for (const [c, title] of SUM_CATS) {
    const us = units.filter(u => u.category === c); if (!us.length) continue;
    const n = {}; for (const u of us) { const s = unitPeriodStatus(u, days); n[s] = (n[s] || 0) + 1; }
    out.push(`${title} (${us.length}): ` + ["Online", "On Call", "Offline", "Not Rostered"].filter(s => n[s]).map(s => `${n[s]} ${s}`).join(", "));
  }
  const evs = Object.values(S.events).filter(e => evInFilter(e) && days.some(d => covers(e, d))).sort((a, b) => (a.from + (a.start || "")).localeCompare(b.from + (b.start || "")));
  const lines = [out.join("\n")];
  if (evs.length) lines.push("Events:\n" + evs.map((e, i) => `${i + 1}. ${nice(e.from)}${e.to && e.to !== e.from ? " to " + nice(e.to) : ""}${e.start ? " " + e.start + (e.end ? "-" + e.end : "") : ""}: ${e.name}${eventPlace(e) ? " (" + eventPlace(e) + ")" : ""}`).join("\n"));
  else lines.push("Events: none.");
  return lines.join("\n\n");
}

async function exportDocx() {
  const days = range(S.filters.from, S.filters.to); if (!days.length) return toast("Pick a period first.");
  const kind = days.length === 4 && dow(days[0]) === 5 ? "fri" : days.length === 4 && dow(days[0]) === 2 ? "tue" : "";
  if (!kind) return exportDocxPlain();
  if (!window.JSZip) return toast("The Word library did not load. Check your connection and reload the page.");
  try {
    const { blob, dropped } = await exportFromTemplate(days, kind);
    const d0 = D(days[0]); const area = S.filters.sub || [...S.filters.areas].join(" ");
    const fname = `${DOWL[dow(days[0])]} - ${DOWL[dow(days.at(-1))]} Operational Summary ${String(d0.getUTCDate()).padStart(2, "0")} ${MON[d0.getUTCMonth()]} ${String(d0.getUTCFullYear()).slice(2)}${area ? " - " + area : ""}.docx`;
    if (await saveBlob(fname, blob)) toast("Summary ready: " + fname + (dropped.length ? `. Not in the site, left out: ${dropped.join(", ")}.` : ""));
