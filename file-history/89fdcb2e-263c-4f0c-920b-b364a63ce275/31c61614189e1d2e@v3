  const groups = [...new Set(units.map(u => u.category + "|" + u.group))];
  const unconf = groups.filter(g => !S.confirmations[confKey(g)]);
  return { text: summaryText(days, units), gaps: { weather: gaps, unconfirmed: unconf, empty: units.filter(u => days.every(d => resolve(u, d).status === "None")).map(u => u.label) } };
