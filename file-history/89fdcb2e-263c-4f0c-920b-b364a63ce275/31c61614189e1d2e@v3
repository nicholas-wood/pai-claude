<script>
"use strict";
/* ---------- state ---------- */
const S = { units: {}, events: {}, weather: {}, settings: null, contacts: null, confirmations: {}, summaries: {},
  db: null, user: null, me: null, view: "services", selected: null,
  filters: { from: "", to: "", areas: new Set(), cats: new Set(), sub: "" }, sumDirty: false, loaded: { units: false } };
const CATS = ["Air", "RPAS", "RWC", "Lifeguard", "Club"];
const CAT_TITLE = { Air: "Air Services", RPAS: "RPAS Services", RWC: "Rescue Watercraft", Lifeguard: "Lifeguard Services", Club: "Club Services" };
const AREAS = ["Central", "East", "West", "Vic Wide"];
const DOW = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const DOWL = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const WX_ROWS = [["min", "Min Temp"], ["max", "Max Temp"], ["wind", "Wind (KM/h)"], ["windDir", "Wind Direction"], ["rain", "Rain (mm)"], ["uv", "Max UV"]];
const $ = (s, el = document) => el.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

/* ---------- dates (all as YYYY-MM-DD strings, UTC maths) ---------- */
const D = s => new Date(s + "T00:00:00Z");
const iso = d => d.toISOString().slice(0, 10);
const addDays = (s, n) => { const d = D(s); d.setUTCDate(d.getUTCDate() + n); return iso(d); };
const dow = s => D(s).getUTCDay();
const range = (a, b) => { const out = []; if (!a || !b || a > b) return out; for (let s = a; s <= b && out.length < 62; s = addDays(s, 1)) out.push(s); return out; };
const dmy = s => { const d = D(s); return `${String(d.getUTCDate()).padStart(2, "0")}/${String(d.getUTCMonth() + 1).padStart(2, "0")}/${d.getUTCFullYear()}`; };
const dm = s => dmy(s).slice(0, 5);
const nice = s => `${DOW[dow(s)]} ${dm(s)}`;
function todayMelb() { try { return new Intl.DateTimeFormat("en-CA", { timeZone: "Australia/Melbourne" }).format(new Date()); } catch { return iso(new Date()); } }
const nextDow = (from, target) => { let s = addDays(from, 1); while (dow(s) !== target) s = addDays(s, 1); return s; };
const ph = s => S.settings?.publicHolidays?.[s] || "";
const hhmm = t => (t || "").replace(":", "");
const toTime = t => t && t.length === 4 ? t.slice(0, 2) + ":" + t.slice(2) : "";
const daysText = days => { if (!days || !days.length) return "Every day"; const n = days.filter(d => d !== "PH").map(Number);
  const order = [1, 2, 3, 4, 5, 6, 0]; const sorted = order.filter(d => n.includes(d));
  let t = sorted.length === 7 ? "Every day" : sorted.join() === "1,2,3,4,5" ? "Weekdays" : sorted.join() === "6,0" ? "Weekends" : sorted.map(d => DOW[d]).join(", ");
  if (days.includes("PH")) t += (sorted.length ? " + " : "") + "public holidays"; return t; };

/* ---------- the rules: offline > adjusted (instead / in addition) > ongoing schedule ---------- */
function covers(r, d) { return (!r.from || r.from <= d) && (!r.to || d <= r.to); }
function dayMatch(r, d) { const days = r.days || []; if (!days.length) return true; if (ph(d) && days.includes("PH")) return true; return days.includes(dow(d)); }
function resolve(u, d, noEvents) {
  u = host(u);
  const off = (u.offline || []).find(o => covers(o, d));
  if (off) return { status: "Offline", hours: "", location: u.location, source: "offline", reason: off.reason || "Offline" };
  const evo = !noEvents && eventOff(u, d);
