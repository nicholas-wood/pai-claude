  const lines = [];
  lines.push(`${DOWL[dow(days[0])]} ${dmy(days[0])} to ${DOWL[dow(days.at(-1))]} ${dmy(days.at(-1))}, ${areaTxt}.`);
  const hols = days.filter(ph); if (hols.length) lines.push(`Public holiday${hols.length > 1 ? "s" : ""}: ${hols.map(d => `${ph(d)} (${nice(d)})`).join(", ")}.`);
