function parseBom(text, days) {
  // Best effort for the BOM text-only forecast: split on day names, read Min/Max, rain, UV and wind.
  const out = {}; const names = DOWL.join("|");
  const parts = text.split(new RegExp(`(?=\\b(?:${names})\\b)`, "i"));
  for (const p of parts) {
    const m = p.match(new RegExp(`^(${names})\\b[^\\n]*?(\\d{1,2})?(?:\\s+(${MON.join("|")}|January|February|March|April|May|June|July|August|September|October|November|December))?`, "i"));
    if (!m) continue;
    const dname = m[1].toLowerCase(); const date = days.find(d => DOWL[dow(d)].toLowerCase() === dname && (!m[2] || D(d).getUTCDate() === +m[2]));
    if (!date || out[date]) continue;
    const rec = {};
    const mn = p.match(/\bmin(?:imum)?\.?\s*:?\s*(-?\d+)/i), mx = p.match(/\bmax(?:imum)?\.?\s*:?\s*(-?\d+)/i);
    if (mn) rec.min = mn[1]; if (mx) rec.max = mx[1];
