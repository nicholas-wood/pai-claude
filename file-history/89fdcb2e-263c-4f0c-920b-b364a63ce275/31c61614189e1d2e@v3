    offs.push(`${u.label} (${o.reason || "no reason given"}${o.to ? `, back ${nice(addDays(o.to, 1))}` : ", no return date"})`);
  for (const u of units) for (const e of Object.values(S.events)) if (days.some(d => covers(e, d)) && evUnits(e).some(x => x.offline && groupCodes(host(u)).includes(x.code)))
    offs.push(`${u.label} (at ${e.name}, ${e.to && e.to !== e.from ? nice(e.from) + " to " + nice(e.to) : nice(e.from)})`);
