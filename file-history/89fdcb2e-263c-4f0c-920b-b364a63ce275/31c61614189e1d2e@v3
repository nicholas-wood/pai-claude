    const what = (a.mode === "replace" ? (a.start ? `${a.start}${a.end ? "-" + a.end : ""}` : notOp(a) ? "not operating" : "normal hours") : `extra hours ${a.start}${a.end ? "-" + a.end : ""}`) + (a.location ? " at " + a.location : "");
    adjs.push(`${u.label} ${(a.type || "Adjusted Hours").toLowerCase()}, ${what}, ${when}${a.reason ? ` (${a.reason})` : ""}`);
  }
  if (adjs.length) lines.push("Variations: " + adjs.join("; ") + ".");
  // events
  const evs = Object.values(S.events).filter(e => evInFilter(e) && days.some(d => covers(e, d)));
  if (evs.length) lines.push(`Events (${evs.length}): ` + evs.sort((a, b) => a.from.localeCompare(b.from)).map(e => `${e.name} ${nice(e.from)}${e.start ? " " + e.start : ""}`).join("; ") + ".");
