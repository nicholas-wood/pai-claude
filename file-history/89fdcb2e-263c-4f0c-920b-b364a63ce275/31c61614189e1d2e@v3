  const coll = name => ({ docs: [...store].filter(([k]) => k.split("/").length === 2 && k.startsWith(name + "/")).map(([k, v]) => ({ id: k.split("/")[1], exists: true, data: () => JSON.parse(JSON.stringify(v)) })) });
  return { _all: () => Object.fromEntries(store), _load(docs) { store.clear(); Object.entries(docs).forEach(([k, v]) => store.set(k, v)); subs.forEach(f => f()); },
    collection: n => ({ onSnapshot(cb) { const f = () => cb(coll(n)); subs.add(f); setTimeout(f, 0); return () => subs.delete(f); } }),
    doc: p => ({ set: async d => { store.set(p, d); setTimeout(fire, 0); }, delete: async () => { store.delete(p); setTimeout(fire, 0); },
      onSnapshot(cb) { const f = () => cb({ exists: store.has(p), data: () => store.get(p) }); subs.add(f); setTimeout(f, 0); return () => subs.delete(f); } }) };
}
function allDocs() {
  const docs = {};
  for (const [k, v] of Object.entries(S.units)) docs["units/" + k] = v;
  for (const [k, v] of Object.entries(S.events)) docs["events/" + k] = v;
  for (const [k, v] of Object.entries(S.weather)) docs["weather/" + k] = v;
  for (const [k, v] of Object.entries(S.confirmations)) docs["confirmations/" + k] = v;
  for (const [k, v] of Object.entries(S.summaries)) docs["summaries/" + k] = v;
  if (S.settings) docs["config/settings"] = S.settings; if (S.contacts) docs["config/contacts"] = S.contacts;
  return docs;
}
async function saveBlob(filename, blob) {
  if (S.downloads) { try { await S.downloads.save({ filename, data: blob }); return true; } catch (e) { toast(e?.code === "declined" ? "Download cancelled." : "The download did not start: " + (e?.message || e)); return false; } }
  if (S.standalone) { const a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = filename; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000); return true; }
  toast("Downloads are not available in this view."); return false;
}
async function saveDataFile() {
  const body = JSON.stringify({ format: "lsv-operational-service-summary", version: 1, exportedAt: new Date().toISOString(), docs: allDocs() }, null, 1);
  const name = `Operational Service Summary data ${todayMelb()}.json`;
  if (await saveBlob(name, new Blob([body], { type: "application/json" }))) { S.fileDirty = false; toast("Data file saved: " + name); }
}
async function openDataFile(file) {
  let data; try { data = JSON.parse(await file.text()); } catch { return toast("That file is not a data file from this page."); }
  if (data?.format !== "lsv-operational-service-summary" || !data.docs) return toast("That file is not a data file from this page.");
  if (S.standalone) { S.db._load(data.docs); S.fileDirty = false; $("#filebar-msg").textContent = `Opened ${file.name} (saved ${new Date(data.exportedAt).toLocaleString("en-AU", { dateStyle: "medium", timeStyle: "short" })}). Download it again when you finish.`; return; }
  const msg = $("#df-msg");
  if (!msg.dataset.sure) { msg.dataset.sure = 1; S.pendingFile = data; msg.innerHTML = `This replaces the shared data for everyone with ${Object.keys(data.docs).length} records from ${esc(file.name)}. <button class="btn danger" data-applyfile="1">Replace shared data</button>`; return; }
}
async function applyPendingFile() {
  const data = S.pendingFile; if (!data) return; const msg = $("#df-msg"); msg.textContent = "Writing…";
  for (const [path, doc] of Object.entries(data.docs)) { if (/^(units|events|weather|confirmations|summaries|config)\/[A-Za-z0-9_\-.~:@+]+$/.test(path)) await dbSet(path, doc); }
  S.pendingFile = null; delete msg.dataset.sure; msg.textContent = "Data replaced from the file.";
}
$("#file-open").onchange = e => { const f = e.target.files[0]; if (f) openDataFile(f); e.target.value = ""; };
window.addEventListener("beforeunload", e => { if (S.standalone && S.fileDirty) { e.preventDefault(); e.returnValue = ""; } });

/* ---------- db helpers ---------- */
const queue = {};
function stamp(rec) { return { ...rec, updatedAt: new Date().toISOString(), updatedBy: S.me || "" }; }
function guard(p) { return p.catch(e => { toast(e?.code === "not_granted" ? "You can view this page but not change it. Ask the owner for edit access." : "Not saved: " + (e?.message || e)); throw e; }); }
function dbSet(path, data) { if (!S.db) { toast("Saving is not available in this view."); return Promise.reject(); } return (queue[path] = (queue[path] || Promise.resolve()).catch(() => {}).then(() => guard(S.db.doc(path).set(data)))); }
function dbDelete(path) { if (!S.db) return Promise.reject(); return guard(S.db.doc(path).delete()); }
function saveUnit(code, patch) { const u = S.units[code]; const next = stamp({ ...u, ...patch }); delete next._id; S.units[code] = next; rerender(); return dbSet("units/" + code, next).then(() => toast("Saved.")); }
async function resolveNames(root) {
  if (!S.user) return; const els = [...root.querySelectorAll("[data-uid]")]; const ids = [...new Set(els.map(e => e.dataset.uid).filter(Boolean))];
  if (!ids.length) return; let ps = {}; try { ps = await S.user.profiles(ids); } catch {}
  els.forEach(e => e.textContent = "by " + ((ps[e.dataset.uid]?.name) || "a member"));
}
let toastT; function toast(m) { const r = $("#overlay-root"); let el = $(".toast"); if (!el) { el = document.createElement("div"); el.className = "toast"; el.setAttribute("role", "status"); document.body.appendChild(el); } el.textContent = m; clearTimeout(toastT); toastT = setTimeout(() => el.remove(), 4200); }

/* ---------- routing & wiring ---------- */
const VIEWS = ["home", "services", "weather", "events", "report", "setup"];
function setView(v) {
  if (!VIEWS.includes(v)) v = "home";
  document.body.classList.toggle("on-home", v === "home");
  S.view = v; document.querySelectorAll(".view[id^=view-]").forEach(el => el.hidden = el.id !== "view-" + v);
  document.querySelectorAll("nav.tabs a").forEach(a => a.setAttribute("aria-current", a.dataset.view === v ? "page" : "false"));
  if (v !== "services") closeDrawer();
  rerender();
}
function rerender() {
  if (S.view === "report") { renderReport(); refreshSummary(); }
  if (S.view === "services") renderServices();
  if (S.view === "events") renderEvents();
  if (S.view === "weather") renderWeather();
  if (S.view === "setup") renderSetup();
}
function filtersChanged() { S.sumDirty = false; try { localStorage.setItem("oss-area", [...S.filters.areas][0] || ""); } catch {} rerender(); }
document.addEventListener("click", async e => {
  const cell = e.target.closest("td[data-cell], button[data-cell]"); if (cell) { const [code, d] = cell.dataset.cell.split("|"); openDay(code, d); return; }
  const row = e.target.closest("tr[data-event]"); if (row) { openEvent(row.dataset.event); return; }
  const b = e.target.closest("button, a, div[data-closedrawer]"); if (!b) return;
  const d = b.dataset;
  if (d.closedrawer) closeDrawer();
  else if (d.svc) openService(d.svc);
  else if (d.preset) { [S.filters.from, S.filters.to] = d.preset.split("|"); S.showCustom = false; filtersChanged(); }
  else if (d.custom) { S.showCustom = true; $("#r-custom").hidden = false; $("#r-from").focus(); }
  else if (d.sweek !== undefined) { if (sMode === "day") sDay = +d.sweek ? addDays(sDay, Math.sign(+d.sweek)) : todayMelb(); else sStart = +d.sweek ? addDays(sStart, +d.sweek) : mondayOf(todayMelb()); renderServices(); }
  else if (d.smode) { sMode = d.smode; if (sMode === "day" && !range(sStart, addDays(sStart, 6)).includes(sDay)) sDay = range(sStart, addDays(sStart, 6)).includes(todayMelb()) ? todayMelb() : sStart; else if (sMode === "week") sStart = mondayOf(sDay); try { localStorage.setItem("oss-smode", sMode); } catch {} renderServices(); }
  else if (d.new) openForm(d.new);
  else if (d.edit) { const [k, id] = d.edit.split(":"); openForm(k, id); }
  else if (d.del) {
    if (!b.dataset.sure) { b.dataset.sure = 1; b.textContent = "Select again to remove"; return; }
    const [k, id] = d.del.split(":"); const u = S.units[S.selected]; await saveUnit(u.code, { [FIELD_ARR[k]]: (u[FIELD_ARR[k]] || []).filter(x => x.id !== id) });
  }
  else if (d.unlink) { const [c, act] = d.unlink.split("|"); if (act === "ask") { S.unlinking = c; renderDrawer(); } else if (act === "cancel") { S.unlinking = null; renderDrawer(); } else await unlinkUnit(c, act === "keep"); }
  else if (d.savefile) saveDataFile();
  else if (d.applyfile) applyPendingFile();
  else if (d.cdel !== undefined) { const cs = readContacts(); cs.splice(+d.cdel, 1); S.contacts = { contacts: cs }; renderSetup(); }
});
document.addEventListener("keydown", e => {
  if (e.key === "Escape") { if ($("#overlay-root").innerHTML) $("#overlay-root").innerHTML = ""; else if (S.drawer) closeDrawer(); return; }
  if (e.key === "Enter" || e.key === " ") { const t = e.target.closest?.("td[data-cell], tr[data-event]"); if (t) { e.preventDefault(); t.click(); return; } }
  if (S.view === "services" && !S.drawer && !$("#overlay-root").innerHTML && !e.target.closest("input,select,textarea")) {
    if (e.key === "ArrowLeft" && !e.target.closest("td")) { if (sMode === "day") sDay = addDays(sDay, -1); else sStart = addDays(sStart, -7); renderServices(); }
    if (e.key === "ArrowRight" && !e.target.closest("td")) { if (sMode === "day") sDay = addDays(sDay, 1); else sStart = addDays(sStart, 7); renderServices(); }
  }
});
window.addEventListener("hashchange", () => setView(location.hash.slice(1)));
$("#r-from").onchange = e => { S.filters.from = e.target.value; if (S.filters.to < S.filters.from) S.filters.to = S.filters.from; filtersChanged(); };
$("#r-to").onchange = e => { S.filters.to = e.target.value; filtersChanged(); };
$("#r-area").onchange = e => { S.filters.areas.clear(); S.filters.sub = ""; if (e.target.value) S.filters.areas.add(e.target.value); filtersChanged(); };
$("#r-sub").onchange = e => { S.filters.sub = e.target.value; filtersChanged(); };
$("#r-summary").oninput = () => { S.sumDirty = true; saveSummarySoon(); };
$("#r-regen").onclick = () => { refreshSummary(true); saveSummarySoon(); };
$("#r-export").onclick = () => exportDocx();
$("#s-search").oninput = () => renderServices();
$("#s-sort").onchange = e => { sSort = e.target.value; try { localStorage.setItem("oss-ssort", sSort); } catch {} renderServices(); };
$("#s-type").onchange = e => { sType = e.target.value; try { localStorage.setItem("oss-stype", sType); } catch {} renderServices(); };
$("#s-status").addEventListener("change", e => { const i = e.target; if (i.checked) sStatus.add(i.value); else sStatus.delete(i.value); renderServices(); });
$("#s-status-clear").onclick = () => { sStatus.clear(); renderServices(); };
document.addEventListener("click", e => { const m = $("#s-status"); if (m.open && !m.contains(e.target)) m.open = false; });
$("#s-sub").onchange = e => { sSub = e.target.value; try { localStorage.setItem("oss-ssub", sSub); } catch {} renderServices(); };
$("#s-area").onchange = e => { sArea = e.target.value; sSub = ""; try { localStorage.setItem("oss-sarea", sArea); } catch {} renderServices(); };
$("#ossd-open").onchange = e => { const f = e.target.files[0]; if (f) importOssd(f); e.target.value = ""; };
$("#e-add").onclick = () => openEvent(null);
$("#e-past").onchange = () => renderEvents();
$("#w-grid").addEventListener("input", e => { const i = e.target.closest("[data-wx]"); if (i) { const [d, r, k] = i.dataset.wx.split("|"); markManual(d, r, k, i.value.trim() !== ""); saveWeatherDay(d); } });
$("#w-refresh").onclick = async e => {
  if (!S.refreshWeather) return; const b = e.currentTarget; b.disabled = true; $("#w-state").textContent = "Fetching the BOM forecast…";
  try { const r = await S.refreshWeather(); $("#w-state").textContent = r.ok ? "Saved" : "Changes save as you type"; toast(r.message); }
  catch (err) { $("#w-state").textContent = "Changes save as you type"; toast("BOM refresh failed: " + (err?.message || err)); }
  finally { b.disabled = false; }
};
$("#w-bomtoggle").onclick = () => { const p = $("#w-bom"); p.hidden = !p.hidden; $("#w-bomtoggle").setAttribute("aria-expanded", String(!p.hidden)); if (!p.hidden) $("#w-feedtext").focus(); };
$("#w-feedtext").addEventListener("input", () => fillFromFeed());
$("#w-bm").setAttribute("href", BOM_BOOKMARKLET);
$("#w-bm").onclick = e => { e.preventDefault(); toast("Drag this button to your bookmarks bar."); };
$("#w-bmcopy").onclick = async () => { try { await navigator.clipboard.writeText(BOM_BOOKMARKLET); toast("Copied. Make a new bookmark and paste this as its address."); } catch (e) { prompt("Copy this and paste it as a new bookmark's address:", BOM_BOOKMARKLET); } };
$("#c-add").onclick = () => { S.contacts = { contacts: [...readContacts(), { position: "", phone: "" }] }; renderSetup(); };
$("#c-save").onclick = async () => { await dbSet("config/contacts", stamp({ contacts: readContacts().filter(c => c.position) })); toast("Contacts saved."); };
$("#h-save").onclick = async () => {
  const hol = {}; for (const line of $("#h-text").value.split("\n")) { const m = line.trim().match(/^(\d{4}-\d{2}-\d{2})\s+(.+)$/); if (m) hol[m[1]] = m[2]; }
  await dbSet("config/settings", stamp({ ...S.settings, publicHolidays: hol })); toast("Public holidays saved.");
};
$("#o-blankoff").onchange = async e => { await dbSet("config/settings", stamp({ ...S.settings, blankAsOffline: e.target.checked })); };

/* ---------- boot ---------- */
(function boot() {
  const t = todayMelb(); const p = presets(); const pick = [1, 4].includes(dow(t)) ? p[1] : p[0]; S.filters.from = pick[1]; S.filters.to = pick[2]; // Mon and Thu are when the next summary is written
  try { const a = localStorage.getItem("oss-area"); if (a) S.filters.areas.add(a); sArea = localStorage.getItem("oss-sarea") || ""; sType = localStorage.getItem("oss-stype") || ""; sSub = localStorage.getItem("oss-ssub") || ""; sMode = localStorage.getItem("oss-smode") || "week"; sSort = localStorage.getItem("oss-ssort") || "cat"; } catch {}
  setView(location.hash.slice(1) || "home");
  const status = m => { $("#status-line").hidden = !m; $("#status-line").textContent = m || ""; };
  const timer = setTimeout(() => { if (!S.loaded.units) status("Service data has not loaded. Reload the page, or log out and sign in again."); }, 10000);
  (async () => {
    // Hosted: /vendor/bridge.js signs this member in to the shared database and exposes it as window.OSS_BACKEND
    // (db, user, downloads, refreshWeather). Opened as a plain file: fall back to the in-browser store and data files.
    const hosted = !!window.OSS_BACKEND_READY;
    const backend = hosted ? await window.OSS_BACKEND_READY.catch(() => null) : null;
    let db = backend ? backend.db : null;
    if (!db) {
      S.standalone = true; let cached = {}; try { cached = JSON.parse(localStorage.getItem("oss-data") || "{}"); } catch {}
      db = localStore(cached); $("#filebar").hidden = false;
      if (hosted) $("#filebar-msg").textContent = "Shared data is not available right now. Reload the page, or work from a data file.";
      else if (Object.keys(cached).length) $("#filebar-msg").textContent = "Showing the data last used in this browser. Open the latest data file if someone else has made changes.";
    }
    if (backend) {
      S.user = backend.user; try { S.me = await S.user.id(); } catch {}
      S.downloads = backend.downloads;
      S.refreshWeather = backend.refreshWeather; $("#w-refresh").hidden = false;
    }
    S.db = db;
    (async () => { let n = window.OSS_USER_NAME || ""; if (!n && S.user && S.me) { try { n = (await S.user.profiles([S.me]))[S.me]?.name || ""; } catch {} }
      $("#home-hi").textContent = n ? "Welcome " + n.split(/\s+/)[0] : "Welcome"; })();
    if (window.OSS_LOGOUT_URL) { $("#home-out").href = window.OSS_LOGOUT_URL; $("#home-out").hidden = false; }
    const err = e => status("Could not load data: " + (e?.message || e?.code || e));
    const coll = (name, target, after) => db.collection(name).onSnapshot(snap => { S[target] = {}; snap.docs.forEach(d => S[target][d.id] = { ...d.data() }); after?.(); rerender(); }, err);
    coll("units", "units", () => {
      S.loaded.units = true; clearTimeout(timer);
      status(Object.keys(S.units).length ? "" : (S.standalone ? "No data yet. Use Open data file to load the latest copy." : "No services loaded yet. Use Settings, Import OSSD spreadsheet."));
    });
    coll("events", "events"); coll("weather", "weather"); coll("confirmations", "confirmations"); coll("summaries", "summaries");
    db.doc("config/settings").onSnapshot(s => { S.settings = s.exists ? s.data() : {}; rerender(); }, err);
    db.doc("config/contacts").onSnapshot(s => { S.contacts = s.exists ? s.data() : { contacts: [] }; rerender(); }, err);
  })();
})();
</script>
