    const max = Math.max(...perDay); const best = days[perDay.indexOf(max)];
    cov.push(max ? `${CAT_TITLE[c]}: up to ${max} of ${us.length} operating (peak ${nice(best)})` : `${CAT_TITLE[c]}: none rostered`);
  }
