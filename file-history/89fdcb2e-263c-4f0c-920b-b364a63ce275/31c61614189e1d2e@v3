    if (rain) rec.rain = rain[2] ? `${rain[1].replace(/\s/g, "")}-${rain[2]}` : rain[1].replace(/\s/g, "");
    const uv = p.match(/UV Index (?:predicted to reach|of)?\s*(\d+)/i); if (uv) rec.uv = uv[1];
    const wind = p.match(/winds?\s*:?\s*([a-z\s/-]*?)\s*(\d+)\s*(?:to|-)\s*(\d+)\s*km\/h/i);
    if (wind) { rec.wind = `${wind[2]}-${wind[3]}`; rec.windDir = compass(wind[1]); }
    if (Object.keys(rec).length) out[date] = rec;
  }
