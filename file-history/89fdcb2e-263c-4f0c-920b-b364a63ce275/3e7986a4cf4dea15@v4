import { NextResponse, type NextRequest } from "next/server";

/**
 * Edge gate, same shape as the platform host template: anything that is not
 * a sign-in surface needs a `__session` cookie to exist. The cookie is
 * verified properly by the access gate in each handler; this keeps anonymous
 * requests away from page, data and the vendored script files.
 */
const PUBLIC_EXACT = ["/sign-in", "/sign-out", "/logout", "/api/health"];
const PUBLIC_PREFIXES = ["/auth/", "/api/auth/", "/api/jobs/", "/_next/"];

export function middleware(request: NextRequest) {
  const path = request.nextUrl.pathname;
  if (PUBLIC_EXACT.includes(path) || PUBLIC_PREFIXES.some((p) => path.startsWith(p))) return NextResponse.next();
  if (request.cookies.get("__session")?.value) return NextResponse.next();
  if (path.startsWith("/api/")) return NextResponse.json({ error: "Unauthorized" }, { status: 401, headers: { "Cache-Control": "private, no-store" } });
  // From the configured origin: behind Firebase Hosting the request carries the Cloud Run hostname.
  const origin = process.env.NEXT_PUBLIC_APP_URL || request.nextUrl.origin;
  const res = NextResponse.redirect(`${origin}/sign-in`, { status: 303 });
  res.headers.set("Cache-Control", "private, no-store");
  return res;
}

export const config = { matcher: ["/((?!_next/static|_next/image).*)"] };
