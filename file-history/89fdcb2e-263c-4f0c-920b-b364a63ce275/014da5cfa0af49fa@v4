variable "project_id" {
  type    = string
  default = "lsv-oss-prod"
}

variable "region" {
  type    = string
  default = "australia-southeast1"
}

variable "environment" {
  type    = string
  default = "prod"
}

variable "domain" {
  description = "Host the app is served on. The app itself lives under /lsv/dailysummary."
  type        = string
  default     = "service-summary.nicholaswood.com.au"
}

variable "github_repository" {
  description = "owner/name of the GitHub repo allowed to deploy via WIF"
  type        = string
  default     = "nicholas-wood/lsv-service-summary"
}

variable "initial_image" {
  description = "Image for the first apply; CI replaces it on every release and Terraform ignores the drift."
  type        = string
  default     = "us-docker.pkg.dev/cloudrun/container/hello"
}

variable "manage_dns" {
  description = "Create a Cloud DNS zone for the domain. Off: DNS stays at GoDaddy, which only needs the two Firebase Hosting records."
  type        = bool
  default     = false
}

variable "cloud_run_domain_ipv4" {
  description = "A records from `gcloud beta run domain-mappings describe` once the domain is verified."
  type        = list(string)
  default     = []
}

variable "cloud_run_domain_ipv6" {
  type    = list(string)
  default = []
}

variable "resend_api_key" {
  description = "Optional. Empty disables Resend; Firebase then sends magic links itself and the code sign-in is hidden."
  type        = string
  default     = ""
  sensitive   = true
}

variable "resend_from" {
  type    = string
  default = ""
}

variable "app_url_override" {
  description = "Serve from this origin instead of https://<domain> (interim Cloud Run URL before the domain is live). Empty = use the domain."
  type        = string
  default     = ""
}
