import type { NextConfig } from "next";

// Same headers as the LSV POC platform host template. The Service Summary
// page itself is served by src/app/route.ts with its own per-request nonce
// policy. SIGN_IN_CSP must stay identical to vendor/poc-auth's (a test checks).
const SIGN_IN_CSP =
  "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";

const nextConfig: NextConfig = {
  output: "standalone",
  poweredByHeader: false,
  transpilePackages: ["@lsv-poc/poc-auth"],
  serverExternalPackages: ["firebase-admin", "jwks-rsa", "google-auth-library"],
  env: { NEXT_PUBLIC_APP_VERSION: process.env.APP_VERSION || "dev" },
  async headers() {
    const prod = process.env.NODE_ENV === "production";
    return [
      ...(prod ? ["/sign-in", "/sign-out", "/auth/:path*"].map((source) => ({ source, headers: [{ key: "Content-Security-Policy", value: SIGN_IN_CSP }] })) : []),
      // Firebase Hosting's CDN sits in front; nothing behind sign-in may be stored by it.
      { source: "/api/:path*", headers: [{ key: "Cache-Control", value: "private, no-store" }] },
      { source: "/vendor/:path*", headers: [{ key: "Cache-Control", value: "private, max-age=3600" }] },
      {
        source: "/:path*",
        headers: [
          { key: "X-Content-Type-Options", value: "nosniff" },
          { key: "X-Frame-Options", value: "DENY" },
          { key: "X-Robots-Tag", value: "noindex, nofollow" },
          { key: "Referrer-Policy", value: "strict-origin-when-cross-origin" },
          { key: "Permissions-Policy", value: "camera=(), microphone=(), geolocation=()" },
          { key: "Strict-Transport-Security", value: "max-age=31536000; includeSubDomains" },
        ],
      },
    ];
  },
};

export default nextConfig;
