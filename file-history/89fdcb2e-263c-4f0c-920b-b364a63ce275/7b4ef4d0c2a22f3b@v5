rules_version = '2';

// Firestore rules for the Service Summary's named database `poc-oss` on the
// LSV POC platform. Released by the platform (terraform/platform/rules/oss.rules);
// this file is the reviewed source.
//
// Deny by default. A caller is a member only when BOTH hold:
//   1. their Firebase token carries the app-scoped claim the hub issues,
//      poc_oss = "member" or "admin". A bare `member` claim, or a claim for
//      another POC, grants nothing.
//   2. the hub has not since lowered it: platformAccess/<uid> (written by the
//      hub into this database on every grant, downgrade and revoke) either
//      does not exist, or names a role. role == null means revoked, and takes
//      effect on the caller's next read or write, without waiting for their
//      token to refresh. A missing document means "no override", not revoked.
// The override can only lower access, never raise it: admin needs the claim
// AND (no override or override admin).
//
// Writes are shape checked: known collections only, the writer stamps itself
// (updatedBy is the caller's uid, updatedAt an ISO string), documents stay
// under 256 KB.
service cloud.firestore {
  match /databases/{database}/documents {

    function claim() {
      return request.auth.token.get('poc_oss', '');
    }
    function overridePath() {
      return /databases/$(database)/documents/platformAccess/$(request.auth.uid);
    }
    function notRevoked() {
      return !exists(overridePath()) || get(overridePath()).data.role in ['member', 'admin'];
    }
    function isMember() {
      return request.auth != null && claim() in ['member', 'admin'] && notRevoked();
    }
    function isAdmin() {
      return request.auth != null && claim() == 'admin'
        && (!exists(overridePath()) || get(overridePath()).data.role == 'admin');
    }
    function stampedByCaller() {
      // The page stamps updatedAt as an ISO string (it reads it back as one), so the type is checked, not the clock.
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string;
    }
    function smallEnough() {
      return request.resource.size() < 262144;
    }

    match /units/{code} {
      allow read: if isMember();
      allow create, update: if isMember() && stampedByCaller() && smallEnough();
      allow delete: if isMember();
    }
    match /events/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && stampedByCaller() && smallEnough();
      allow delete: if isMember();
    }
    match /weather/{date} {
      allow read: if isMember();
      allow create, update: if isMember() && stampedByCaller() && smallEnough()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if isMember();
    }
    match /confirmations/{key} {
      allow read: if isMember();
      allow create, update: if isMember() && stampedByCaller() && smallEnough();
      allow delete: if isMember();
    }
    match /summaries/{key} {
      allow read: if isMember();
      allow create, update: if isMember() && stampedByCaller() && smallEnough();
      allow delete: if isMember();
    }
    match /config/{doc} {
      allow read: if isMember();
      // weatherStatus is written by the scheduled job only.
      allow create, update: if isMember() && stampedByCaller() && smallEnough()
        && doc in ['settings', 'contacts'];
      allow delete: if isAdmin() && doc in ['settings', 'contacts'];
    }

    // Display names, written by the server at sign-in. Members may read them.
    match /profiles/{uid} {
      allow read: if isMember();
      allow write: if false;
    }

    // Server-only: the hub's access record and the rate limiter. Never readable or writable from a browser.
    match /platformAccess/{uid} { allow read, write: if false; }
    match /rateLimitBuckets/{doc} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
