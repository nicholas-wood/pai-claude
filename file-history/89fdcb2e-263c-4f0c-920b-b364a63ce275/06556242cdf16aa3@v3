"use client";

import { isSignInWithEmailLink, signInWithEmailLink, signOut } from "firebase/auth";
import { useEffect, useState } from "react";
import { auth } from "@/lib/firebase-client";
import { safeRedirect } from "@/lib/safe-redirect";

/**
 * Completes the email link and exchanges the ID token for the `__session`
 * cookie. Unlike a static POC, the browser keeps its Firebase session
 * afterwards: the page reads and writes Firestore directly, and the rules
 * check the member's own `poc_oss` claim. A refused exchange signs it out.
 */
export default function Callback() {
  const [message, setMessage] = useState("Completing sign-in…");
  const [failed, setFailed] = useState(false);

  useEffect(() => {
    (async () => {
      const fail = (m: string) => {
        setFailed(true);
        setMessage(m);
      };
      const href = window.location.href;
      if (!isSignInWithEmailLink(auth, href)) return fail("This sign-in link is not valid.");
      const email = window.localStorage.getItem("emailForSignIn") ?? window.prompt("Please enter your email to confirm sign-in:") ?? "";
      if (!email) return fail("Email required to complete sign-in.");
      try {
        const cred = await signInWithEmailLink(auth, email, href);
        window.localStorage.removeItem("emailForSignIn");
        const res = await fetch("/api/auth/session", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ idToken: await cred.user.getIdToken() }),
        });
        if (!res.ok) {
          await signOut(auth);
          if (res.status === 403) return fail("You do not have access to the Operational Service Summary. Ask the platform administrator to allocate it to you in the hub.");
          return fail("Sign-in failed. Try again.");
        }
        window.location.replace(safeRedirect(new URLSearchParams(window.location.search).get("redirect")));
      } catch {
        fail("This link has expired or was already used. Request a new one.");
      }
    })();
  }, []);

  return (
    <main className="auth-shell">
      <div className="auth-card sent">
        {!failed && <div className="spinner" />}
        <p className={failed ? "error" : "hint"}>{message}</p>
        {failed && (
          <p>
            <a href="/sign-in">Back to sign-in</a>
          </p>
        )}
      </div>
    </main>
  );
}
