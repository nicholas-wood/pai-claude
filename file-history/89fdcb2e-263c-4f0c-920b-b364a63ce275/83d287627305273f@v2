import { NextRequest, NextResponse } from "next/server";
import { z } from "zod";
import { getAdminAuth } from "@/lib/firebase-admin";
import { getMemberByEmail } from "@/lib/members";
import { checkRateLimitIpAndEmail, getClientIp } from "@/lib/rate-limit";
import { sendMagicLinkEmail } from "@/lib/email";
import { safeRedirect } from "@/lib/safe-redirect";
import { clientEnv, resendConfigured } from "@/env";

export const dynamic = "force-dynamic";

const schema = z.object({ email: z.string().email(), redirect: z.string().optional() });

/**
 * Magic-link send, rate limited 10/IP and 5/email per minute as in
 * AccessBuddy. With Resend configured the link is generated by Firebase Admin
 * and emailed from our domain; otherwise the response asks the client to let
 * Firebase send it. Never reveals whether an email is on the member list.
 */
export async function POST(request: NextRequest) {
  const body = await request.json().catch(() => null);
  const parsed = schema.safeParse(body);
  if (!parsed.success) return NextResponse.json({ error: "Valid email required" }, { status: 400 });

  const email = parsed.data.email.toLowerCase().trim();
  const ip = getClientIp(request);
  const rl = await checkRateLimitIpAndEmail("auth.send-magic-link", ip, email, { windowSeconds: 60, maxPerIp: 10, maxPerEmail: 5 });
  if (!rl.ok) {
    return NextResponse.json({ error: "Too many requests, please wait a moment and try again." }, { status: 429, headers: { "Retry-After": String(rl.retryAfter) } });
  }

  if (!resendConfigured()) {
    // Firebase mails the link from the client. Membership is enforced at
    // /api/auth/session, so a non-member gets an email but no session.
    return NextResponse.json({ sent: true, clientSend: true });
  }

  const member = await getMemberByEmail(email);
  if (!member) return NextResponse.json({ sent: true });

  const redirect = safeRedirect(parsed.data.redirect);
  const link = await getAdminAuth().generateSignInWithEmailLink(email, {
    url: `${clientEnv.NEXT_PUBLIC_APP_URL}${clientEnv.NEXT_PUBLIC_BASE_PATH}/auth/callback?redirect=${encodeURIComponent(redirect)}`,
    handleCodeInApp: true,
  });
  const result = await sendMagicLinkEmail(email, link);
  if (!result.sent) {
    return NextResponse.json({ error: "We could not send your sign-in link right now. Please try again in a few minutes." }, { status: 502 });
  }
  return NextResponse.json({ sent: true });
}
