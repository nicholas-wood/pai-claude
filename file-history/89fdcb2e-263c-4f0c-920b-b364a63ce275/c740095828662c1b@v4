#!/usr/bin/env bun
/**
 * Seed or restore Firestore from an Operational Service Summary data file.
 *
 *   bun run seed <path-to-data.json> [--replace] [--project lsv-poc] [--database poc-oss]
 *
 * Format: { format: "lsv-operational-service-summary", docs: { "units/SC40": {...}, ... } }
 * Idempotent: docs whose content is unchanged are skipped and counted.
 * --replace deletes docs in the app collections that are not in the file.
 * Who may sign in is allocated in the hub, not here.
 *
 * Auth: gcloud ADC with Firestore access to the named database.
 */
import { readFileSync } from "node:fs";
import { initializeApp, applicationDefault } from "firebase-admin/app";
import { getFirestore } from "firebase-admin/firestore";

const APP_COLLECTIONS = ["units", "events", "weather", "confirmations", "summaries", "config"];

function arg(flag: string): string | undefined {
  const i = process.argv.indexOf(flag);
  return i >= 0 ? process.argv[i + 1] : undefined;
}

const file = process.argv[2];
if (!file || file.startsWith("--")) {
  console.error("usage: bun run seed <data.json> [--replace] [--project id] [--database id]");
  process.exit(2);
}
const projectId = arg("--project") ?? process.env.FIREBASE_PROJECT_ID ?? process.env.NEXT_PUBLIC_FIREBASE_PROJECT_ID ?? process.env.GOOGLE_CLOUD_PROJECT ?? "lsv-poc";
const databaseId = arg("--database") ?? process.env.FIRESTORE_DATABASE ?? "poc-oss";
initializeApp({ credential: applicationDefault(), projectId });
const db = getFirestore(databaseId);
console.log(`target: project ${projectId}, database ${databaseId}`);

const raw = JSON.parse(readFileSync(file, "utf8")) as { format?: string; docs?: Record<string, Record<string, unknown>> };
if (raw.format !== "lsv-operational-service-summary" || !raw.docs) {
  console.error(`Not an lsv-operational-service-summary file: format=${raw.format}`);
  process.exit(2);
}

function stable(v: unknown): string {
  return JSON.stringify(v, (_k, val) => (val && typeof val === "object" && !Array.isArray(val) ? Object.fromEntries(Object.entries(val).sort()) : val));
}

let written = 0;
let unchanged = 0;
let deleted = 0;
const seen = new Set<string>();
const entries = Object.entries(raw.docs);
let batch = db.batch();
let inBatch = 0;
for (const [path, data] of entries) {
  const [col, id] = path.split("/");
  if (!APP_COLLECTIONS.includes(col) || !id) {
    console.warn(`skip ${path}: not an app collection`);
    continue;
  }
  seen.add(path);
  const ref = db.collection(col).doc(id);
  const snap = await ref.get();
  // Docs are written exactly as the file has them (updatedAt is an ISO string, updatedBy the original author).
  const incoming = data as Record<string, unknown>;
  const current = (snap.data() ?? {}) as Record<string, unknown>;
  // A doc with no stamp in the file gets one on write; ignore that stamp when comparing so reruns change nothing.
  const comparable = { ...current };
  if (incoming.updatedAt === undefined) delete comparable.updatedAt;
  if (incoming.updatedBy === undefined) delete comparable.updatedBy;
  if (snap.exists && stable(comparable) === stable(incoming)) {
    unchanged++;
    continue;
  }
  batch.set(ref, { ...incoming, updatedAt: incoming.updatedAt ?? new Date().toISOString(), updatedBy: incoming.updatedBy ?? "seed" });
  written++;
  if (++inBatch >= 400) {
    await batch.commit();
    batch = db.batch();
    inBatch = 0;
  }
}
if (inBatch) await batch.commit();

if (process.argv.includes("--replace")) {
  for (const col of APP_COLLECTIONS) {
    const snap = await db.collection(col).get();
    for (const d of snap.docs) {
      const path = `${col}/${d.id}`;
      if (col === "config" && d.id === "weatherStatus") continue;
      if (!seen.has(path)) {
        await d.ref.delete();
        deleted++;
      }
    }
  }
}

console.log(`seed complete: ${entries.length} docs in file, ${written} written, ${unchanged} unchanged, ${deleted} deleted`);
