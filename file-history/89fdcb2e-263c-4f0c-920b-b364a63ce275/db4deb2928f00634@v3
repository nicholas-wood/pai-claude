name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_call:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    name: Lint, Type Check, Test, Build
    runs-on: ubuntu-latest
    env:
      NEXT_PUBLIC_APP_URL: https://service-summary.nicholaswood.com.au
      NEXT_PUBLIC_FIREBASE_PROJECT_ID: lsv-oss-prod
      NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN: lsv-oss-prod.firebaseapp.com
      NEXT_PUBLIC_FIREBASE_API_KEY: ci-placeholder
      NEXT_PUBLIC_FIREBASE_APP_ID: ci-placeholder
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: 1.3.14
      - run: bun install --frozen-lockfile
      - run: bun run lint
      - run: bun run typecheck
      - run: bun run test
      - run: bun run build
