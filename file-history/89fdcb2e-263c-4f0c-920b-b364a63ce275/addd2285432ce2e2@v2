:root {
  --lsv-blue: #1d4ed8;
  --lsv-navy: #0f2a5f;
  --text: #1f2937;
  --muted: #6b7280;
  --border: #e5e7eb;
  --danger: #b91c1c;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: var(--text);
  background: #f3f4f6;
  min-height: 100vh;
}
.auth-shell {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
.auth-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 28px 24px;
  width: 100%;
  max-width: 400px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.04);
}
.auth-card h1 { font-size: 20px; margin: 0 0 4px; color: var(--lsv-navy); }
.auth-card p.sub { margin: 0 0 20px; color: var(--muted); font-size: 14px; }
.auth-card label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.auth-card input {
  width: 100%; padding: 10px 12px; font-size: 16px; border: 1px solid #cbd5e1; border-radius: 6px;
}
.auth-card input.code { text-align: center; font-size: 26px; letter-spacing: 0.4em; font-family: ui-monospace, monospace; }
.auth-card button.primary {
  width: 100%; margin-top: 14px; padding: 11px; font-size: 15px; font-weight: 600; color: #fff;
  background: var(--lsv-blue); border: 0; border-radius: 6px; cursor: pointer;
}
.auth-card button.primary:disabled { opacity: 0.6; cursor: default; }
.auth-card button.link {
  background: none; border: 0; color: var(--muted); font-size: 13px; cursor: pointer; text-decoration: underline; padding: 0; margin-top: 14px;
}
.auth-card .error { color: var(--danger); font-size: 14px; margin-top: 12px; }
.auth-card .hint { color: var(--muted); font-size: 12px; margin-top: 12px; text-align: center; }
.auth-card .sent { text-align: center; padding: 8px 0; }
.auth-card .sent .icon { font-size: 34px; }
.auth-card .row { display: flex; gap: 8px; justify-content: center; margin-top: 12px; }
.spinner {
  width: 28px; height: 28px; margin: 0 auto 10px; border-radius: 50%;
  border: 3px solid var(--lsv-blue); border-top-color: transparent; animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
