import { Resend } from "resend";
import { resendConfigured } from "@/env";

/**
 * Transactional email through Resend, the provider AccessBuddy uses. Only
 * active when RESEND_API_KEY and RESEND_FROM are set; otherwise callers fall
 * back to Firebase's own magic-link mailer and hide the code option.
 */
let _resend: Resend | null = null;
function getResend(): Resend | null {
  if (!resendConfigured()) return null;
  if (!_resend) _resend = new Resend(process.env.RESEND_API_KEY);
  return _resend;
}

export type EmailSendResult = { sent: boolean; error?: string };

async function send(to: string, subject: string, html: string, text: string): Promise<EmailSendResult> {
  const resend = getResend();
  if (!resend) return { sent: false, error: "Email provider not configured" };
  const result = await resend.emails.send({ from: process.env.RESEND_FROM!, to, subject, html, text });
  if (result.error) return { sent: false, error: result.error.message };
  return { sent: true };
}

export function sendMagicLinkEmail(to: string, link: string): Promise<EmailSendResult> {
  const text = `Sign in to the LSV Operational Service Summary:\n\n${link}\n\nThe link expires shortly and can be used once. If you did not request it, ignore this email.`;
  const html = `<p>Sign in to the LSV Operational Service Summary:</p><p><a href="${link}">Sign in</a></p><p style="color:#666;font-size:12px">The link expires shortly and can be used once. If you did not request it, ignore this email.</p>`;
  return send(to, "Your sign-in link", html, text);
}

export function sendVerificationCodeEmail(to: string, code: string): Promise<EmailSendResult> {
  const text = `Your LSV Operational Service Summary sign-in code is ${code}. It expires in 5 minutes.`;
  const html = `<p>Your sign-in code is</p><p style="font-size:28px;letter-spacing:0.3em;font-family:monospace">${code}</p><p style="color:#666;font-size:12px">It expires in 5 minutes.</p>`;
  return send(to, "Your sign-in code", html, text);
}
