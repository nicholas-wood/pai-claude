# Push to main: CI, then build the image and update the Service Summary's
# Cloud Run service in the shared LSV POC project. Authenticates through
# Workload Identity Federation: the provider (infra/modules/poc-app) admits
# only this repository's id, its owner's id and refs/heads/main, and the
# deploy account can push to this app's image repository and update this
# app's service, nothing else. Values are `terraform output` of infra/.
name: Deploy

on:
  push:
    branches: [main]

concurrency:
  group: deploy-production
  cancel-in-progress: false

permissions:
  contents: read
  id-token: write

env:
  APP_ID: oss
  GCP_PROJECT_ID: lsv-poc
  GCP_REGION: australia-southeast1
  CLOUD_RUN_SERVICE: poc-oss
  IMAGE: australia-southeast1-docker.pkg.dev/lsv-poc/oss/host
  APP_URL: https://service-summary.poc.nicholaswood.com.au
  WIF_PROVIDER: projects/182225939221/locations/global/workloadIdentityPools/github/providers/oss-gh
  DEPLOY_SERVICE_ACCOUNT: oss-deploy@lsv-poc.iam.gserviceaccount.com
  # Firebase web config: public identifiers, not secrets. The API key is a repository variable so secret scanners do not flag the repo.
  FIREBASE_API_KEY: ${{ vars.FIREBASE_API_KEY }}
  FIREBASE_APP_ID: 1:182225939221:web:4938f02dcd7bf46c9f971c

jobs:
  ci:
    uses: ./.github/workflows/ci.yml

  deploy:
    needs: [ci]
    runs-on: ubuntu-latest
    environment: production
    steps:
      - uses: actions/checkout@v4
      - uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ env.WIF_PROVIDER }}
          service_account: ${{ env.DEPLOY_SERVICE_ACCOUNT }}
      - uses: google-github-actions/setup-gcloud@v2
      - run: gcloud auth configure-docker ${{ env.GCP_REGION }}-docker.pkg.dev --quiet
      - name: Build and push
        run: |
          docker build --platform linux/amd64 \
            --build-arg NEXT_PUBLIC_APP_URL=${{ env.APP_URL }} \
            --build-arg NEXT_PUBLIC_FIREBASE_API_KEY=${{ env.FIREBASE_API_KEY }} \
            --build-arg NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${{ env.GCP_PROJECT_ID }}.firebaseapp.com \
            --build-arg NEXT_PUBLIC_FIREBASE_PROJECT_ID=${{ env.GCP_PROJECT_ID }} \
            --build-arg NEXT_PUBLIC_FIREBASE_APP_ID=${{ env.FIREBASE_APP_ID }} \
            --build-arg APP_VERSION=${{ github.sha }} \
            -t ${IMAGE}:${{ github.sha }} .
          docker push ${IMAGE}:${{ github.sha }}
      - name: Deploy to Cloud Run
        run: |
          gcloud run services update ${{ env.CLOUD_RUN_SERVICE }} --image=${IMAGE}:${{ github.sha }} \
            --region=${{ env.GCP_REGION }} --project=${{ env.GCP_PROJECT_ID }}
      - name: Verify deployed version
        run: |
          sleep 10
          curl -fsS ${{ env.APP_URL }}/api/health | tee /dev/stderr | grep -q '"version":"${{ github.sha }}"'
