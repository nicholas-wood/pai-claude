# --- views.js: per-value manual tracking in the weather sheet ---
patch("views.js", [
    (
        """const wxTimers = {};
function saveWeatherDay(d, source) {
  clearTimeout(wxTimers[d]);
  wxTimers[d] = setTimeout(async () => {
    const regions = { ...(S.weather[d]?.regions || {}) };""",
        """const wxTimers = {};
/* Which cells a member typed by hand: weather/<date>.manual is a list of "Area|field" keys. The scheduled BOM job
   never overwrites those; clearing a cell, or filling it from the BOM, hands it back to the BOM. */
const wxManual = {};
function markManual(d, r, k, on) { const m = (wxManual[d] ||= { add: new Set(), del: new Set() }); const key = r + "|" + k; (on ? m.add : m.del).add(key); (on ? m.del : m.add).delete(key); }
function manualKeys(w) {
  if (!w) return []; if (Array.isArray(w.manual)) return w.manual;
  if (/^BOM forecast issued/.test(w.source || "")) return [];
  // Days saved before tracking existed: treat every filled value as typed by a member.
  return Object.entries(w.regions || {}).flatMap(([r, rec]) => Object.entries(rec || {}).filter(([k, v]) => k !== "fire" && v != null && v !== "").map(([k]) => r + "|" + k));
}
function saveWeatherDay(d, source) {
  clearTimeout(wxTimers[d]);
  wxTimers[d] = setTimeout(async () => {
    const pend = wxManual[d] || { add: new Set(), del: new Set() }; delete wxManual[d];
    const manual = [...new Set([...manualKeys(S.weather[d]), ...pend.add])].filter(x => !pend.del.has(x)).sort();
    const regions = { ...(S.weather[d]?.regions || {}) };""",
    ),
    (
        """    S.weather[d] = { ...(S.weather[d] || {}), date: d, regions };""",
        """    S.weather[d] = { ...(S.weather[d] || {}), date: d, regions, manual };""",
    ),
    (
        """await dbSet("weather/" + d, stamp({ date: d, regions, source: source || S.weather[d]?.source || "Entered from BOM" }));""",
        """await dbSet("weather/" + d, stamp({ date: d, regions, manual, source: source || S.weather[d]?.source || "Entered from BOM" }));""",
    ),
    (
        """if (inp && v !== "") { inp.value = v; n++; touched.add(d); }""",
        """if (inp && v !== "") { inp.value = v; n++; touched.add(d); markManual(d, r, k, false); }""",
    ),
])

