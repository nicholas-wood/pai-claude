"""Apply the hosting changes to the pack's source parts. Every replacement is asserted."""
import sys, pathlib

ux = pathlib.Path(sys.argv[1])

def patch(name, pairs):
    p = ux / name
    s = p.read_text()
    for a, b in pairs:
        assert a in s, f"{name}: anchor not found: {a[:70]!r}"
        assert s.count(a) == 1, f"{name}: anchor not unique: {a[:70]!r}"
        s = s.replace(a, b)
    p.write_text(s)
    print("patched", name, len(pairs))

