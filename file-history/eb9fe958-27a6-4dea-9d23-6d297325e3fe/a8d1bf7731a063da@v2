const folderFor = (it) => `${OUT}/${it.p} - ${it.company} - ${it.role}`

const DRAFT_SCHEMA = {
  type: 'object',
  additionalProperties: false,
  required: ['resume','resumeRationale','resumeTweaks','coverBase','keyJdInsights','jdTargets','coverLetter','applyMethod','salaryGuidance','specialNotes'],
  properties: {
    resume: { type: 'string', description: 'resume-hybrid | resume-swe | resume-consulting' },
    resumeRationale: { type: 'string' },
    resumeTweaks: { type: 'string', description: 'specific suggested tweaks for THIS role, or "none needed"' },
    coverBase: { type: 'string', description: 'cover-letter-pm-base | base-cover-letter-senior-software-engineer' },
    keyJdInsights: { type: 'array', items: { type: 'string' }, description: 'key insights from the JD' },
    jdTargets: { type: 'array', items: { type: 'string' }, description: 'specific JD requirements/keywords the cover letter must hit' },
    coverLetter: { type: 'string', description: 'full cover letter in markdown, following all style rules' },
    applyMethod: { type: 'string' },
    salaryGuidance: { type: 'string' },
    specialNotes: { type: 'string', description: 'anything to particularly note for this job, incl portal questions and any CEO outreach message for SprintSuite' },
  },
}

const REVIEW_SCHEMA = {
  type: 'object',
  additionalProperties: false,
  required: ['verdict','reviewFindings','styleCheck','finalCoverLetter','assessmentExtras'],
  properties: {
    verdict: { type: 'string', description: 'PASS or NEEDS-FIX (after you apply fixes it should be PASS)' },
    reviewFindings: { type: 'array', items: { type: 'string' }, description: 'every issue you found and how you resolved it' },
    styleCheck: { type: 'string', description: 'confirm no em dashes/colons/semicolons, Australian English, no comparative language, word count, positioning guardrails honoured' },
    finalCoverLetter: { type: 'string', description: 'the corrected, final cover letter in markdown' },
    assessmentExtras: { type: 'string', description: 'any extra notes for the assessment file the writer should include (e.g. residual risks, CEO message if applicable)' },
  },
}

phase('Draft')
const results = await pipeline(
  items,
  // STAGE 1 — draft
  async (it) => {
    const draft = await agent(`${CTX}

You are drafting a job application package for Nick (Nicholas Wood). Read the JD file at ${it.jd} and the relevant context files above.

ROLE: ${it.company} — ${it.role}
SEEK URL: ${it.url}
Recommended resume (default unless the JD argues otherwise): ${it.resumeHint}
Recommended cover base: ${it.baseHint}
${it.isPm ? 'This is a PRODUCT-lane role — lead with product/strategy.' : 'This is an ENGINEERING-lane role — lead with engineering.'}
SPECIAL INSTRUCTIONS: ${it.special}

Produce: (1) which resume to use + rationale, (2) any specific resume tweaks for this role, (3) which cover base, (4) key JD insights, (5) the specific JD requirements to target, (6) a complete, submission-ready cover letter in Nick's voice following EVERY style rule and positioning guardrail above, (7) apply method, (8) salary guidance, (9) special notes (include any portal questions and, for SprintSuite, the CEO outreach message text).`,
      { label: `draft:${it.p}-${it.company}`, phase: 'Draft', schema: DRAFT_SCHEMA })
    return { it, draft }
  },
  // STAGE 2 — adversarial review
  async (prev) => {
    const { it, draft } = prev
    const review = await agent(`${CTX}

You are the senior reviewer. Adversarially review this cover-letter DRAFT for Nick's application to ${it.company} — ${it.role}. Read the JD at ${it.jd} and Nick's voice/style/positioning context files above, plus his recent shipped cover letters to match tone.

DRAFT COVER LETTER:
"""
${draft.coverLetter}
"""

DRAFT DECISIONS: resume=${draft.resume}; base=${draft.coverBase}; targets=${JSON.stringify(draft.jdTargets)}.

Review thoroughly for: (a) STYLE-RULE violations — scan character by character for em dashes, semicolons, colons in prose; non-Australian spelling; any comparative language; word count 350-420; correct closing line and sign-off. (b) POSITIONING guardrail breaches — AccessBuddy not "paying/commercial", LIMSOC "scaling strategy" not "product", no "non-traditional background", no formal-PM-tenure overclaim, tenure gap NOT in the body. (c) VOICE — does it sound like Nick (exec-ready, confident, specific, varied rhythm, paragraphs not bullets, no filler opener, no generic AI phrasing, no abrupt ending)? (d) JD ALIGNMENT — are the most important JD requirements actually hit with concrete evidence? (e) OVERCLAIMING — flag any tech/stack claim Nick can't back (e.g. deep Java if the role is Java but he is TS/Go).

Then APPLY your fixes and output the corrected final cover letter. List every finding and how you resolved it. Confirm the style check passes.`,
      { label: `review:${it.p}-${it.company}`, phase: 'Review', schema: REVIEW_SCHEMA })
    return { it, draft, review }
  },
  // STAGE 3 — finalize + write files
  async (prev) => {
    const { it, draft, review } = prev
    const folder = folderFor(it)
    const writeRes = await agent(`You are writing the two artefact files for Nick's application to ${it.company} — ${it.role}. Use the Write tool. Create the folder if needed.

Write EXACTLY two files into: ${folder}

FILE 1 — ${folder}/cover-letter.md
Write this cover letter verbatim (it is already finalised). Do not change a word:
"""
${review.finalCoverLetter}
"""

FILE 2 — ${folder}/assessment.md
Compose it in markdown with these sections, filled from the data below:
# ${it.p} - ${it.company} - ${it.role}
- **Priority:** ${it.p} of 9
- **Seek ad:** ${it.url}
- **Apply method:** ${draft.applyMethod}
- **Resume to use:** ${draft.resume} (rationale: ${draft.resumeRationale})
- **Cover letter base:** ${draft.coverBase}

## Key JD insights
${draft.keyJdInsights.map(s => '- ' + s).join('\n')}

## What to target from the JD
${draft.jdTargets.map(s => '- ' + s).join('\n')}

## Suggested resume tweaks
${draft.resumeTweaks}

## Reviewer findings (step 6)
${review.reviewFindings.map(s => '- ' + s).join('\n')}

Style check: ${review.styleCheck}

## Portal questions / salary
${draft.salaryGuidance}

## Notes for this job
${draft.specialNotes}

${review.assessmentExtras ? '## Reviewer extras\n' + review.assessmentExtras : ''}

Render that into clean markdown (expand bullets sensibly, keep the CEO outreach message if present as its own "## CEO outreach message" section). After writing both files, confirm the two paths.`,
      { label: `write:${it.p}-${it.company}`, phase: 'Write' })
    return { folder, company: it.company, role: it.role, p: it.p, resume: draft.resume, base: draft.coverBase, verdict: review.verdict, status: 'written', writeRes }
  },
)

const ok = results.filter(Boolean)
log(`Wrote ${ok.length}/9 application packages to ${OUT}`)
return ok.map(r => ({ p: r.p, folder: r.folder, resume: r.resume, base: r.base, verdict: r.verdict }))
