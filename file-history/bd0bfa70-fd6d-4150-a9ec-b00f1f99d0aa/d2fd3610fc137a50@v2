#!/usr/bin/env bash
# Creates the SLCO activity issues in REPO and adds each to user project #1.
# Usage: GH_TOKEN=... ./create-slco-issues.sh nicholas-wood/<repo> [label]
set -euo pipefail
export PATH=/opt/homebrew/bin:$PATH
REPO="${1:?repo required, e.g. nicholas-wood/lsv}"
LABEL="${2:-}"
JSON="$(dirname "$0")/slco-issues.json"
PROJECT_OWNER=nicholas-wood
PROJECT_NUM=1

COUNT=$(jq length "$JSON")
for i in $(seq 0 $((COUNT-1))); do
  TITLE=$(jq -r ".[$i].title" "$JSON")
  BODY=$(jq -r ".[$i].body" "$JSON")
  ARGS=(-R "$REPO" --title "$TITLE" --body "$BODY")
  [ -n "$LABEL" ] && ARGS+=(--label "$LABEL")
  URL=$(gh issue create "${ARGS[@]}")
  gh project item-add "$PROJECT_NUM" --owner "$PROJECT_OWNER" --url "$URL" >/dev/null
  echo "$URL  $TITLE"
done
