#!/usr/bin/env bash
set -uo pipefail
export PATH=/opt/homebrew/bin:$PATH
export GH_TOKEN=$(cat ~/.gh-token)
REPO=nicholas-wood/limsoc-poc
JSON=~/pai-tmp/slco-issues/batch2.json
PID=PVT_kwHOBBWuD84A-C-_
FID=PVTSSF_lAHOBBWuD84A-C-_zgxkWWQ
STATUS_NAME="Needs details"
OPT=$(gh project field-list 1 --owner nicholas-wood --format json -q ".fields[] | select(.name==\"Status\") | .options[] | select(.name==\"$STATUS_NAME\") | .id")
[ -z "$OPT" ] && { echo "no option id for $STATUS_NAME"; exit 1; }
OUT=~/pai-tmp/slco-issues/batch2-created.tsv
: > "$OUT"
BODY="Added 14 Sep 2026 from the SLCO task list. Details to follow."

create() {  # title -> prints "number<TAB>url<TAB>dbid"
  local URL NUM DBID
  URL=$(gh issue create -R "$REPO" --title "$1" --body "$BODY" 2>&1) || { echo "FAIL create: $1: $URL" >&2; return 1; }
  NUM=${URL##*/}
  DBID=$(gh api "repos/$REPO/issues/$NUM" -q .id)
  gh project item-add 1 --owner nicholas-wood --url "$URL" >/dev/null 2>&1 || echo "FAIL board-add #$NUM" >&2
  printf '%s\t%s\t%s\n' "$NUM" "$URL" "$DBID"
}

# parents and children
jq -c '.parents[]' "$JSON" | while read -r P; do
  PT=$(echo "$P" | jq -r .title)
  read -r PNUM PURL PDB < <(create "$PT") || continue
  echo -e "parent\t$PNUM\t$PT" | tee -a "$OUT"
  echo "$P" | jq -r '.children[]' | while read -r CT; do
    read -r CNUM CURL CDB < <(create "$CT") || continue
    gh api -X POST "repos/$REPO/issues/$PNUM/sub_issues" -F sub_issue_id="$CDB" >/dev/null 2>&1 && L=linked || L=LINK-FAIL
    echo -e "child\t$CNUM\t$CT\t-> #$PNUM $L" | tee -a "$OUT"
  done
done

# flat tasks
jq -r '.tasks[]' "$JSON" | while read -r T; do
  read -r NUM URL DB < <(create "$T") || continue
  echo -e "task\t$NUM\t$T" | tee -a "$OUT"
done

# set status on everything created
echo "--- status"
FIRST=$(awk -F'\t' 'NR==1{print $2}' "$OUT")
gh project item-list 1 --owner nicholas-wood --format json --limit 500 -q ".items[] | select(.content.number != null and .content.number >= $FIRST) | [.content.number, .id] | @tsv" | while read -r NUM IID; do
  gh project item-edit --project-id "$PID" --id "$IID" --field-id "$FID" --single-select-option-id "$OPT" >/dev/null 2>&1 && echo "#$NUM $STATUS_NAME" || echo "#$NUM STATUS-FAIL"
done
