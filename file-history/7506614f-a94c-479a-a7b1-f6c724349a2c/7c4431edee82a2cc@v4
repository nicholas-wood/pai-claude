/** ASSIGN directly to a member (no request). Same checks and email as approve. */
export async function assignLocker(
  tenant: Tenant,
  params: { lockerId: string; userId: string; actorId: string; overrideCleanout?: boolean }
) {
  const done = await withTenant(tenant.id, async (tx) => {
    const now = new Date();
    const locker = await lockLocker(tx, tenant.id, params.lockerId);
    const member = await resolveMember(tx, tenant.id, { userId: params.userId });
    if (!member) throw new LockerError(409, NOT_A_MEMBER_MESSAGE, "not_a_member");
    const { overrodeCleanout } = await assertAllocatable(
      tx,
      tenant.id,
      locker,
      params.overrideCleanout
    );
    const where = await lockerWithArea(tx, tenant.id, locker.id);

    const allocation = await insertAllocation(tx, {
      tenantId: tenant.id,
      lockerId: locker.id,
      requestId: null,
      allocatedAt: now,
      allocatedBy: params.actorId,
      ...holderSnapshot(member),
    });
    await tx
      .update(lockers)
      .set({
        labelUpdateRequired: true,
        ...(overrodeCleanout ? { cleanoutRequired: false, cleanoutDueAt: null } : {}),
        updatedAt: now,
      })
      .where(and(eq(lockers.id, locker.id), eq(lockers.tenantId, tenant.id)));
    await createAuditEntry(tx, {
      tenantId: tenant.id,
      entityType: AuditEntityType.LOCKER,
      entityId: locker.id,
      action: AuditAction.UPDATE,
      actorId: params.actorId,
      metadata: {
        action: "locker_assigned",
        allocationId: allocation.id,
        userId: member.userId,
        holderName: fullName(member.firstName, member.lastName),
        areaName: where?.areaName,
        number: locker.number,
        ...(overrodeCleanout ? { overrideCleanout: true } : {}),
      },
    });
    return { allocation, member, locker, where };
  });

  const email = await sendMemberLockerEmail({
    tenant,
    template: "lockerAllocated",
    to: done.member.email,
    variables: {
      memberName: fullName(done.member.firstName, done.member.lastName) || done.member.email,
      areaName: done.where?.areaName ?? "",
      number: done.locker.number,
      level: done.locker.level,
    },
    entityType: AuditEntityType.LOCKER,
    entityId: done.locker.id,
    actorId: params.actorId,
    attachPolicy: true,
  });
  return { allocationId: done.allocation.id, ...email };
}

/** REVOKE (admin): ends the allocation, flags both tasks, emails the holder. */
export async function revokeAllocation(
  tenant: Tenant,
  params: { allocationId: string; reason: string; actorId: string }
) {
  const done = await withTenant(tenant.id, async (tx) => {
    const now = new Date();
    const ended = await endAllocationGuarded(tx, {
      tenantId: tenant.id,
      allocationId: params.allocationId,
      endType: LockerEndType.REVOKED,
      reason: params.reason,
      endedBy: params.actorId,
      now,
    });
    if (!ended) throw await notActiveError(tx, tenant.id, params.allocationId);

    const closed = await flagVacatedLocker(tx, {
      tenantId: tenant.id,
      lockerId: ended.lockerId,
      cleanout: true,
      now,
      previousHolderName: fullName(ended.holderFirstName, ended.holderLastName),
    });
    await createAuditEntry(tx, {
      tenantId: tenant.id,
      entityType: AuditEntityType.LOCKER,
      entityId: ended.lockerId,
      action: AuditAction.UPDATE,
      actorId: params.actorId,
      metadata: {
        action: "locker_revoked",
        allocationId: ended.id,
        userId: ended.userId,
        holderName: fullName(ended.holderFirstName, ended.holderLastName),
        areaName: closed?.areaName,
        number: closed?.number,
        reason: params.reason,
      },
    });
    return { ended, closed };
  });

  const email = await sendMemberLockerEmail({
    tenant,
    template: "lockerRevoked",
    to: done.ended.holderEmail,
    variables: {
      memberName: fullName(done.ended.holderFirstName, done.ended.holderLastName) || "there",
      areaName: done.closed?.areaName ?? "",
      number: done.closed?.number ?? 0,
      level: done.closed?.level,
      reason: params.reason,
      removeBy: formatExpiryDate(done.closed?.cleanoutDueAt ?? new Date(Date.now() + 7 * 86400_000), tenant.timezone),
    },
    entityType: AuditEntityType.LOCKER,
    entityId: done.ended.lockerId,
    actorId: params.actorId,
    attachPolicy: true,
  });
  if (done.closed) {
    await notifyCleanoutRequired({ tenant, lockers: [done.closed], actorId: params.actorId });
  }
  return { allocationId: done.ended.id, ...email };
}

/**
 * MOVE a holder to another locker: ends the old allocation as `moved` and
 * creates the new one (copying holder, kept_for_season and request) in one
 * transaction. Both labels need updating; the old locker needs no clean-out.
 */
export async function moveAllocation(
  tenant: Tenant,
  params: {
    allocationId: string;
    targetLockerId: string;
    actorId: string;
    overrideCleanout?: boolean;
  }
) {
  const done = await withTenant(tenant.id, async (tx) => {
    const now = new Date();
    const ended = await endAllocationGuarded(tx, {
      tenantId: tenant.id,
      allocationId: params.allocationId,
      endType: LockerEndType.MOVED,
      reason: null,
      endedBy: params.actorId,
      now,
    });
    if (!ended) throw await notActiveError(tx, tenant.id, params.allocationId);
    if (ended.lockerId === params.targetLockerId) {
      throw new LockerError(400, "That member already holds this locker");
    }

    const target = await lockLocker(tx, tenant.id, params.targetLockerId);
    const { overrodeCleanout } = await assertAllocatable(
      tx,
      tenant.id,
      target,
      params.overrideCleanout
    );
    const targetInfo = await lockerWithArea(tx, tenant.id, target.id);
    const closedOld = await flagVacatedLocker(tx, {
      tenantId: tenant.id,
      lockerId: ended.lockerId,
      cleanout: false,
      now,
      previousHolderName: fullName(ended.holderFirstName, ended.holderLastName),
    });

    const allocation = await insertAllocation(tx, {
      tenantId: tenant.id,
      lockerId: target.id,
      userId: ended.userId,
      holderEmail: ended.holderEmail,
      holderFirstName: ended.holderFirstName,
      holderLastName: ended.holderLastName,
      holderPhone: ended.holderPhone,
      keptForSeason: ended.keptForSeason,
      requestId: ended.requestId,
      // A move preserves state (spec 13J): the holder keeps their original
      // "since" date. Stamping `now` would also hand a holder moved after the
      // cutoff the "allocated after the cutoff" exemption.
      allocatedAt: ended.allocatedAt,
      allocatedBy: params.actorId,
    });
    await tx
      .update(lockers)
      .set({
        labelUpdateRequired: true,
        ...(overrodeCleanout ? { cleanoutRequired: false, cleanoutDueAt: null } : {}),
        updatedAt: now,
      })
      .where(and(eq(lockers.id, target.id), eq(lockers.tenantId, tenant.id)));

    const holderName = fullName(ended.holderFirstName, ended.holderLastName);
    await createAuditEntry(tx, {
      tenantId: tenant.id,
      entityType: AuditEntityType.LOCKER,
      entityId: ended.lockerId,
      action: AuditAction.UPDATE,
      actorId: params.actorId,
      metadata: {
        action: "locker_moved_out",
        allocationId: ended.id,
        newAllocationId: allocation.id,
        userId: ended.userId,
        holderName,
        areaName: closedOld?.areaName,
        number: closedOld?.number,
        toLockerId: target.id,
        toAreaName: targetInfo?.areaName,
        toNumber: target.number,
      },
    });
    await createAuditEntry(tx, {
      tenantId: tenant.id,
      entityType: AuditEntityType.LOCKER,
      entityId: target.id,
      action: AuditAction.UPDATE,
      actorId: params.actorId,
      metadata: {
        action: "locker_moved_in",
        allocationId: allocation.id,
        previousAllocationId: ended.id,
        userId: ended.userId,
        holderName,
        areaName: targetInfo?.areaName,
        number: target.number,
        fromLockerId: ended.lockerId,
        fromAreaName: closedOld?.areaName,
        fromNumber: closedOld?.number,
        ...(overrodeCleanout ? { overrideCleanout: true } : {}),
      },
    });
    return { ended, allocation, target, targetInfo, closedOld, holderName };
  });

  const email = await sendMemberLockerEmail({
    tenant,
    template: "lockerAllocated",
    to: done.ended.holderEmail,
    variables: {
      memberName: done.holderName || "there",
      areaName: done.targetInfo?.areaName ?? "",
      number: done.target.number,
      level: done.target.level,
      replacesAreaName: done.closedOld?.areaName ?? null,
      replacesNumber: done.closedOld?.number ?? null,
    },
    entityType: AuditEntityType.LOCKER,
    entityId: done.target.id,
    actorId: params.actorId,
    attachPolicy: true,
  });
  return { allocationId: done.allocation.id, previousAllocationId: done.ended.id, ...email };
}
