/**
 * Lockers service: reads, request lifecycle (submit / approve / decline /
 * cancel) and allocation lifecycle (assign / revoke / move). Inventory and
 * tasks live in locker-inventory.ts; season confirmation and the cutoff in
 * locker-season.ts. Everything is re-exported from here for convenience.
 *
 * Rules that hold for every transition in these modules:
 *  - each one begins with a GUARDED write (WHERE status = 'pending' /
 *    WHERE ended_at IS NULL ... RETURNING) and stops on zero rows, so two
 *    racing callers cannot both act; a thrown LockerError rolls the whole
 *    transaction back, including the guarded write;
 *  - approve, assign, move and locker edits take SELECT ... FOR UPDATE on the
 *    locker row;
 *  - every query carries an explicit tenant filter, RLS is defence in depth;
 *  - member emails are sent AFTER the transaction commits, directly, with the
 *    policy attached where the spec says so. Only cron cutoff releases are
 *    enqueued.
 */

export * from "@/lib/services/locker-core";
export * from "@/lib/services/locker-inventory";
export * from "@/lib/services/locker-season";

type LockerRequestRow = typeof lockerRequests.$inferSelect;

