"use client";

import { useState } from "react";
import Link from "next/link";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Textarea } from "@/components/ui/textarea";
import { Separator } from "@/components/ui/separator";
import { Badge } from "@/components/ui/badge";
import { RequestType } from "@accessbuddy/shared";
import { PaymentStep } from "./payment-step";

// Internal step keys stay stable; this maps them to member-friendly display
// labels in the progress indicator (copy only, no logic).
const STEP_DISPLAY_LABELS: Record<string, string> = {
  Credential: "Fob or Key",
};

const ACCESS_UPDATE_REASONS = [
  { value: "appointed_officer", label: "I have been appointed as an officer" },
  { value: "stepped_down_officer", label: "I have stepped down as an officer" },
  { value: "elected_board", label: "I have been elected to the board" },
  { value: "stepped_down_board", label: "I have stepped down from the board" },
  { value: "turned_16", label: "I have turned 16" },
  { value: "category_changed", label: "My membership category has changed" },
  { value: "other", label: "Other (please describe)" },
] as const;

type CredentialType = {
  id: string;
  name: string;
  category: string;
  priceCents: number;
};

type MemberFob = {
  id: string;
  serialNumber: string | null;
  type: string | null;
  accessLevel?: string | null;
  status: string;
  expiresAt: string | null;
};

type LookupResult = {
  found: boolean;
  member?: { firstName: string; lastName: string; email: string; membershipCategory: string | null };
  fobs?: MemberFob[];
};

type AuthUserInfo = {
  firstName: string;
  lastName: string;
  email: string;
  membershipCategory: string | null;
  fobs: MemberFob[];
};

type Props = {
  tenantSlug: string;
  credentialTypes: CredentialType[];
  membershipCategories: string[];
  authUser?: AuthUserInfo;
  maxActiveCredentials?: number;
};

const REQUEST_TYPE_OPTIONS = [
  { value: RequestType.NEW, label: "Request a new fob or key", needsLookup: false },
  { value: RequestType.REPLACEMENT_LOST, label: "Report a lost fob", needsLookup: true },
  { value: RequestType.REPLACEMENT_DAMAGED, label: "Report a damaged fob", needsLookup: true },
  { value: RequestType.ADDITIONAL, label: "Request an additional fob", needsLookup: true },
  { value: RequestType.RETURN, label: "Return a fob", needsLookup: true },
  { value: RequestType.CHANGE_TYPE, label: "Change fob type", needsLookup: true },
  { value: RequestType.ACCESS_UPDATE, label: "Request an access update", needsLookup: true },
];

// Types that need the member to select existing fob(s)
// Return = multi-select, Change = single select
const NEEDS_FOB_SELECTION = [
  RequestType.RETURN,
  RequestType.CHANGE_TYPE,
];

// Lost/damaged - they pick the fob TYPE (not specific fob since they don't know the number)
const NEEDS_FOB_TYPE_ONLY = [
  RequestType.REPLACEMENT_LOST,
  RequestType.REPLACEMENT_DAMAGED,
];

// All lookup types require verification (OTP) to prove email ownership
// "Additional" also requires an existing account (can't be orphaned)
const REQUIRES_EXISTING_ACCOUNT = [
  RequestType.ADDITIONAL,
];

// Types that need replacement credential type selection
const NEEDS_REPLACEMENT_TYPE = [
  RequestType.NEW,
  RequestType.REPLACEMENT_LOST,
  RequestType.REPLACEMENT_DAMAGED,
  RequestType.ADDITIONAL,
  RequestType.CHANGE_TYPE,
];

type FormData = {
  requestType: string;
  credentialTypeId: string;
  firstName: string;
  lastName: string;
  email: string;
  phone: string;
  dateOfBirth: string;
  membershipCategory: string;
  selectedFobId: string;
  selectedFobIds: string[]; // For return (multi-select)
  lostFobType: string; // For lost/damaged - just the type name
  wantsReplacement: string;
  accessUpdateReason: string; // For access_update - what changed
  accessUpdateReasonOther: string; // Free text when "other" is selected
  readerBeeps: string; // beeps_no_access | nothing_happens | beeps_broken
  physicalDamageDescription: string; // Only when readerBeeps === beeps_broken
};

export function RequestForm({ tenantSlug, credentialTypes, membershipCategories, authUser, maxActiveCredentials = 3 }: Props) {
  const [step, setStep] = useState(0);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Payment state
  const [paymentData, setPaymentData] = useState<{
    clientSecret: string;
    amount: number;
    stripeAccountId: string | null;
  } | null>(null);
  const [requestId, setRequestId] = useState<string | null>(null);

  // Exemption state
  const [showExemption, setShowExemption] = useState(false);
  const [exemptionReason, setExemptionReason] = useState("");
  const [exemptionSubmitting, setExemptionSubmitting] = useState(false);
  const [exemptionSubmitted, setExemptionSubmitted] = useState(false);
  const [exemptionError, setExemptionError] = useState<string | null>(null);

  // Lookup and verification state
  const [lookupEmail, setLookupEmail] = useState("");
  const [lookingUp, setLookingUp] = useState(false);
  const [lookupResult, setLookupResult] = useState<LookupResult | null>(
    authUser
      ? { found: true, member: { firstName: authUser.firstName, lastName: authUser.lastName, email: authUser.email, membershipCategory: authUser.membershipCategory }, fobs: authUser.fobs }
      : null
  );
  const [codeSent, setCodeSent] = useState(false);
  const [verificationCode, setVerificationCode] = useState("");
  const [verifying, setVerifying] = useState(false);
  const [verified, setVerified] = useState(!!authUser);
  const [verifiedFobs, setVerifiedFobs] = useState<MemberFob[]>(authUser?.fobs ?? []);

  const [formData, setFormData] = useState<FormData>({
    requestType: "",
    credentialTypeId: "",
    firstName: authUser?.firstName ?? "",
    lastName: authUser?.lastName ?? "",
    email: authUser?.email ?? "",
    phone: "",
    dateOfBirth: "",
    membershipCategory: authUser?.membershipCategory ?? "",
    selectedFobId: "",
    selectedFobIds: [],
    lostFobType: "",
    wantsReplacement: "",
    accessUpdateReason: "",
    accessUpdateReasonOther: "",
    readerBeeps: "",
    physicalDamageDescription: "",
  });

  function update(field: keyof FormData, value: string) {
    setFormData((prev) => ({ ...prev, [field]: value }));
    setError(null);
  }

  function toggleFobId(fobId: string) {
    setFormData((prev) => ({
      ...prev,
      selectedFobIds: prev.selectedFobIds.includes(fobId)
        ? prev.selectedFobIds.filter((id) => id !== fobId)
        : [...prev.selectedFobIds, fobId],
    }));
  }

  function selectAllFobs() {
    setFormData((prev) => ({
      ...prev,
      selectedFobIds: activeFobs.map((f) => f.id),
    }));
  }

  const selectedOption = REQUEST_TYPE_OPTIONS.find((o) => o.value === formData.requestType);
  const needsLookup = selectedOption?.needsLookup ?? false;
  const needsFobSelection = (NEEDS_FOB_SELECTION as readonly string[]).includes(formData.requestType);
  const needsFobTypeOnly = (NEEDS_FOB_TYPE_ONLY as readonly string[]).includes(formData.requestType);
  const requiresExistingAccount = (REQUIRES_EXISTING_ACCOUNT as readonly string[]).includes(formData.requestType);
  const isAccessUpdate = formData.requestType === RequestType.ACCESS_UPDATE;
  const isDamaged = formData.requestType === RequestType.REPLACEMENT_DAMAGED;
  const isLostOrDamaged =
    formData.requestType === RequestType.REPLACEMENT_LOST ||
    formData.requestType === RequestType.REPLACEMENT_DAMAGED;
  const isReturn = formData.requestType === RequestType.RETURN;
  const needsReplacementType =
    (NEEDS_REPLACEMENT_TYPE as readonly string[]).includes(formData.requestType) &&
    (!isLostOrDamaged || formData.wantsReplacement === "yes");
  const memberFound = lookupResult?.found === true;

  // Use verified fobs if authenticated, otherwise lookup fobs
  const memberFobs = verified ? verifiedFobs : (lookupResult?.fobs ?? []);
  const activeFobsFromMember = memberFobs.filter((f) => f.status === "active");
  const inactiveFobs = memberFobs.filter((f) => f.status !== "active");

  // Determine if this request type normally requires payment (client-side heuristic)
  const paymentRequestTypes = ["new", "replacement_lost", "replacement_damaged", "additional"];
  const selectedCredType = credentialTypes.find((t) => t.id === formData.credentialTypeId);
  // Request types where payment is determined later by an admin, not shown upfront
  const paymentDeferredTypes = [RequestType.REPLACEMENT_DAMAGED, RequestType.RETURN, RequestType.ACCESS_UPDATE, RequestType.CHANGE_TYPE];
  const isPaymentDeferred = (paymentDeferredTypes as string[]).includes(formData.requestType);
  const mayRequirePayment = !isPaymentDeferred && paymentRequestTypes.includes(formData.requestType) && selectedCredType && selectedCredType.priceCents > 0;

  // Build dynamic steps
  const steps: string[] = ["Type"];
  if (needsLookup && !authUser) steps.push("Account");
  if (isAccessUpdate && verified) steps.push("Change");
  if ((needsFobSelection || (needsFobTypeOnly && verified)) && verified) steps.push("Select Fob");
  if (needsFobTypeOnly && !verified) steps.push("Fob Type");
  if (isLostOrDamaged) steps.push("Replacement");
  if (!memberFound && needsLookup && !requiresExistingAccount && !authUser) steps.push("Details");
  if (!needsLookup && !authUser) steps.push("Details");
  if (needsReplacementType) steps.push("Credential");
  steps.push("Review");
  // Payment step appears after server confirms payment is required, before final confirmation
  if (paymentData) steps.push("Payment");

  const currentStepName = step >= 0 && step < steps.length ? steps[step] : null;

  async function handleLookup() {
    setLookingUp(true);
    setError(null);
    try {
      const res = await fetch(`/api/v1/t/${tenantSlug}/members/lookup`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: lookupEmail }),
      });
      const data = await res.json();
      setLookupResult(data);
      update("email", lookupEmail);

      // If account found, auto-send the verification code
      if (data.found) {
        try {
          const codeRes = await fetch(`/api/v1/t/${tenantSlug}/auth/send-code`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: lookupEmail }),
          });
          const codeData = await codeRes.json();
          if (codeRes.ok) {
            setCodeSent(true);
            if (codeData.devCode) setVerificationCode(codeData.devCode);
          }
        } catch { /* non-critical - user can still proceed */ }
      }
    } catch {
      setError("Failed to look up account");
    } finally {
      setLookingUp(false);
    }
  }

  async function handleVerify() {
    setVerifying(true);
    setError(null);
    try {
      const res = await fetch(`/api/v1/t/${tenantSlug}/auth/verify-code`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: lookupEmail, code: verificationCode }),
      });
      const data = await res.json();
      if (!res.ok) {
        setError(data.error ?? "Verification failed");
        return;
      }
      setVerified(true);
      setVerifiedFobs(data.fobs ?? []);
      // Update form data with verified member info
      if (data.member) {
        update("firstName", data.member.firstName);
        update("lastName", data.member.lastName);
        update("email", data.member.email);
        update("membershipCategory", data.member.membershipCategory ?? "");
      }
    } catch {
      setError("Verification failed");
    } finally {
      setVerifying(false);
    }
  }

  function canAdvance(): boolean {
    switch (currentStepName) {
      case "Type": return !!formData.requestType;
      case "Sign In": return true; // Always advanceable - user can continue without signing in
      case "Account":
        if (memberFound) return verified; // Must verify with OTP if member found
        if (requiresExistingAccount) return false; // Additional requires existing account
        return lookupResult !== null; // Orphaned - can proceed after lookup fails
      case "Change":
        if (!formData.accessUpdateReason) return false;
        if (formData.accessUpdateReason === "other" && !formData.accessUpdateReasonOther.trim()) return false;
        return true;
      case "Select Fob":
        return isReturn ? formData.selectedFobIds.length > 0 : !!formData.selectedFobId;
      case "Fob Type": return !!formData.lostFobType;
      case "Replacement":
        if (isDamaged) {
          if (!formData.readerBeeps) return false;
          // Dead-end: fob is working, just no access. Cannot submit.
          if (formData.readerBeeps === "beeps_no_access") return false;
          if (formData.readerBeeps === "beeps_broken" && formData.physicalDamageDescription.trim().length < 10) return false;
        }
        if (!formData.wantsReplacement) return false;
        return true;
      case "Details": return !!(formData.firstName && formData.lastName && formData.email && formData.phone && formData.dateOfBirth && formData.membershipCategory);
      case "Credential": return !!formData.credentialTypeId;
      case "Review": return true;
      default: return false;
    }
  }

  async function handleSubmit() {
    setSubmitting(true);
    setError(null);
    try {
      const res = await fetch(`/api/v1/t/${tenantSlug}/requests/submit`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          requestType: formData.requestType,
          // Deactivate-only lost/damaged reports must not carry a credential
          // type: both submit (isLostDamagedWithReplacement) and link-member
          // (needsPair) treat its presence as "wants a replacement".
          credentialTypeId:
            isLostOrDamaged && formData.wantsReplacement !== "yes"
              ? undefined
              : formData.credentialTypeId || undefined,
          firstName: formData.firstName,
          lastName: formData.lastName,
          email: formData.email,
          phone: formData.phone || undefined,
          dateOfBirth: formData.dateOfBirth || undefined,
          membershipCategory: formData.membershipCategory || undefined,
          replacesCredentialId: formData.selectedFobId || undefined,
          selectedFobIds: formData.selectedFobIds.length > 0 ? formData.selectedFobIds : undefined,
          lostFobType: formData.lostFobType || undefined,
          readerBeeps: formData.readerBeeps || undefined,
          physicalDamageDescription: formData.physicalDamageDescription.trim() || undefined,
          accessUpdateReason: formData.accessUpdateReason
            ? (formData.accessUpdateReason === "other"
              ? formData.accessUpdateReasonOther
              : ACCESS_UPDATE_REASONS.find((r) => r.value === formData.accessUpdateReason)?.label ?? formData.accessUpdateReason)
            : undefined,
          isOrphaned: needsLookup && !memberFound,
        }),
      });
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error ?? "Failed to submit request");
      }
      const result = await res.json();
      if (result.request?.id) setRequestId(result.request.id);
      if (result.isOrphaned) {
        setStep(-1); // Special "done" step
      } else if (result.paymentRequired && result.stripeClientSecret) {
        setPaymentData({
          clientSecret: result.stripeClientSecret,
          amount: result.paymentAmount,
          stripeAccountId: result.stripeAccountId ?? null,
        });
        // Advance to the Payment step in the stepper
        const paymentIdx = steps.indexOf("Payment");
        if (paymentIdx >= 0) {
          setStep(paymentIdx);
        } else {
          // Fallback: payment step wasn't predicted, use legacy behaviour
          setStep(-2);
        }
      } else {
        setStep(-3); // Special "success" step
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : "Something went wrong");
    } finally {
      setSubmitting(false);
    }
  }

  const selectedFob = memberFobs.find((f) => f.id === formData.selectedFobId);
  const activeFobs = activeFobsFromMember;

  return (
    <Card>
      <CardHeader>
        <div className="flex justify-between text-sm">
          {steps.map((label, i) => (
            <div key={`${label}-${i}`} className={`flex items-center gap-1.5 ${i <= step ? "text-foreground" : "text-muted-foreground"}`}>
              <span className={`flex h-6 w-6 items-center justify-center rounded-full text-xs font-medium ${
                i < step ? "bg-primary text-primary-foreground" : i === step ? "border-2 border-primary text-primary" : "border border-muted-foreground"
              }`}>
                {i < step ? "\u2713" : i + 1}
              </span>
              <span className="hidden sm:inline">{STEP_DISPLAY_LABELS[label] ?? label}</span>
            </div>
          ))}
        </div>
      </CardHeader>

      <CardContent className="min-h-[320px]">
        {/* Step: Type */}
        {currentStepName === "Type" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">What would you like to do?</CardTitle>
            {authUser && (
              <p className="text-sm text-muted-foreground">
                Logged in as {authUser.firstName} {authUser.lastName}
                {" \u00B7 "}
                <button
                  type="button"
                  className="text-primary hover:underline"
                  onClick={async () => {
                    await fetch("/api/auth/session", { method: "DELETE" });
                    document.cookie = "dev_login_email=; path=/; max-age=0";
                    window.location.reload();
                  }}
                >
                  Sign out
                </button>
              </p>
            )}
            <div className="space-y-2">
              {REQUEST_TYPE_OPTIONS
                .filter((opt) => !authUser || opt.value !== RequestType.NEW)
                .filter((opt) => {
                  if (opt.value !== RequestType.ADDITIONAL) return true;
                  if (!authUser) return false;
                  const activeCount = authUser.fobs.filter((f) => f.status === "active").length;
                  return activeCount < maxActiveCredentials;
                })
                .map((opt) => (
                <button key={opt.value} type="button"
                  onClick={() => {
                    update("requestType", opt.value);
                    update("selectedFobId", "");
                    update("wantsReplacement", "");
                    update("credentialTypeId", "");
                    update("readerBeeps", "");
                    if (!authUser) {
                      setLookupResult(null);
                      setLookupEmail("");
                    }
                  }}
                  className={`w-full rounded-lg border p-3 text-left text-sm transition-colors ${
                    formData.requestType === opt.value ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                  }`}
                >{opt.label}</button>
              ))}
            </div>
          </div>
        )}

        {/* Step: Damaged fob sign-in prompt (unauthenticated only) */}
        {currentStepName === "Sign In" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">Sign in recommended</CardTitle>
            <div className="rounded-lg border border-primary/20 bg-primary/5 p-4 space-y-3">
              <p className="text-sm">
                We recommend signing in first so we can look up your existing fobs and keys and process your damaged fob report more quickly.
              </p>
              <Link
                href={`/sign-in?redirect=/t/${tenantSlug}/request`}
                className="inline-flex h-9 items-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80"
              >
                Sign in to your account
              </Link>
            </div>
            <p className="text-xs text-muted-foreground">
              If you do not have an account or cannot sign in, you can still submit your report.
            </p>
          </div>
        )}

        {/* Step: Account lookup + verification */}
        {currentStepName === "Account" && (
          <div className="space-y-4">
            {!verified ? (
              <>
                {!codeSent ? (
                  <>
                    <CardTitle className="text-lg">Verify your identity</CardTitle>
                    <p className="text-sm text-muted-foreground">
                      Enter the email you used when you first requested your fob. We will send you a verification code.
                    </p>
                    <div className="flex gap-2">
                      <Input
                        type="email"
                        value={lookupEmail}
                        onChange={(e) => { setLookupEmail(e.target.value); setLookupResult(null); setCodeSent(false); }}
                        placeholder="your@email.com"
                        className="flex-1"
                        onKeyDown={(e) => e.key === "Enter" && handleLookup()}
                      />
                      <Button onClick={async () => {
                        await handleLookup();
                      }} disabled={lookingUp || !lookupEmail}>
                        {lookingUp ? "..." : "Find"}
                      </Button>
                    </div>

                    {lookupResult && !codeSent && !lookupResult.found && (
                      <div className="rounded-lg border border-primary/20 bg-primary/5 p-3 space-y-2">
                        <p className="text-sm text-muted-foreground">
                          If you have an account, a verification code will be sent to your email.
                        </p>
                        {requiresExistingAccount ? (
                          <p className="text-xs text-amber-600">
                            This request type requires an existing account. Please check your email address or contact an administrator.
                          </p>
                        ) : (
                          <button
                            type="button"
                            className="text-sm text-primary hover:underline"
                            onClick={() => {
                              update("email", lookupEmail);
                            }}
                          >
                            Continue as guest
                          </button>
                        )}
                      </div>
                    )}
                  </>
                ) : (
                  <>
                    <CardTitle className="text-lg">Enter verification code</CardTitle>
                    <p className="text-sm text-muted-foreground">
                      We sent a 6-digit code to <strong>{lookupEmail}</strong>
                    </p>
                    <div className="flex gap-2">
                      <Input
                        value={verificationCode}
                        onChange={(e) => setVerificationCode(e.target.value.replace(/\D/g, "").slice(0, 6))}
                        placeholder="000000"
                        className="flex-1 text-center text-lg tracking-widest"
                        maxLength={6}
                        onKeyDown={(e) => {
                          if (e.key === "Enter" && verificationCode.length === 6) {
                            handleVerify();
                          }
                        }}
                      />
                      <Button onClick={handleVerify} disabled={verifying || verificationCode.length !== 6}>
                        {verifying ? "..." : "Verify"}
                      </Button>
                    </div>
                    <button
                      type="button"
                      onClick={() => { setCodeSent(false); setVerificationCode(""); }}
                      className="text-xs text-muted-foreground hover:text-foreground"
                    >
                      Use a different email
                    </button>
                  </>
                )}
              </>
            ) : (
              <div className="rounded-lg border border-primary/20 bg-primary/5 p-3 space-y-1">
                <p className="text-sm font-medium text-primary">Identity verified</p>
                <p className="text-sm">
                  {lookupResult?.member?.firstName} {lookupResult?.member?.lastName}
                </p>
                <p className="text-xs text-muted-foreground">{lookupResult?.member?.email}</p>
                {activeFobs.length > 0 && (
                  <p className="text-xs text-muted-foreground mt-1">
                    {activeFobs.length} active fob{activeFobs.length !== 1 ? "s" : ""}
                  </p>
                )}
              </div>
            )}
          </div>
        )}

        {/* Step: Access Update Reason */}
        {currentStepName === "Change" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">What has changed?</CardTitle>
            <p className="text-sm text-muted-foreground">
              Select the reason for your access update request.
            </p>
            <div className="space-y-2">
              {ACCESS_UPDATE_REASONS.map((opt) => (
                <button key={opt.value} type="button"
                  onClick={() => update("accessUpdateReason", opt.value)}
                  className={`w-full rounded-lg border p-3 text-left text-sm transition-colors ${
                    formData.accessUpdateReason === opt.value ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                  }`}
                >{opt.label}</button>
              ))}
            </div>
            {formData.accessUpdateReason === "other" && (
              <div className="space-y-2">
                <Label htmlFor="accessUpdateOther">Please describe the change *</Label>
                <Textarea
                  id="accessUpdateOther"
                  value={formData.accessUpdateReasonOther}
                  onChange={(e) => update("accessUpdateReasonOther", e.target.value)}
                  placeholder="Describe what has changed..."
                />
              </div>
            )}
          </div>
        )}

        {/* Step: Select Fob */}
        {currentStepName === "Select Fob" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">
              {isReturn ? "Which fob(s) are you returning?" : "Which fob is this about?"}
            </CardTitle>
            {activeFobs.length === 0 && inactiveFobs.length === 0 ? (
              <p className="text-sm text-muted-foreground">No fobs found on your account.</p>
            ) : (
              <div className="space-y-2">
                {activeFobs.length === 0 && (
                  <p className="text-sm text-muted-foreground">No active fobs found on your account.</p>
                )}
                {isReturn && activeFobs.length > 1 && (
                  <button type="button" onClick={selectAllFobs}
                    className="w-full rounded-lg border border-dashed p-2 text-center text-xs text-muted-foreground hover:bg-accent">
                    Select all ({activeFobs.length} fobs)
                  </button>
                )}
                {activeFobs.map((fob) => {
                  const isSelected = isReturn
                    ? formData.selectedFobIds.includes(fob.id)
                    : formData.selectedFobId === fob.id;
                  return (
                    <button key={fob.id} type="button"
                      onClick={() => {
                        if (isReturn) {
                          toggleFobId(fob.id);
                        } else {
                          update("selectedFobId", fob.id);
                          if (isLostOrDamaged && fob.type) {
                            update("lostFobType", fob.type);
                          }
                        }
                      }}
                      className={`flex w-full items-center justify-between rounded-lg border p-3 text-left text-sm transition-colors ${
                        isSelected ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                      }`}
                    >
                      <div className="flex items-center gap-2">
                        {isReturn && (
                          <div className={`h-4 w-4 rounded border ${isSelected ? "bg-primary border-primary" : "border-muted-foreground"} flex items-center justify-center`}>
                            {isSelected && <span className="text-[10px] text-primary-foreground">{"\u2713"}</span>}
                          </div>
                        )}
                        <div>
                          <span className="font-medium">#{fob.serialNumber ?? "?"}</span>
                          <span className="ml-2 text-muted-foreground">{fob.type}</span>
                        </div>
                      </div>
                      <Badge variant={fob.status === "active" ? "default" : "secondary"}>{fob.status}</Badge>
                    </button>
                  );
                })}
                {inactiveFobs.length > 0 && (
                  <>
                    {activeFobs.length > 0 && <Separator className="my-2" />}
                    <p className="text-xs text-muted-foreground pt-1">Other fobs on your account (not selectable):</p>
                    {inactiveFobs.map((fob) => (
                      <div key={fob.id}
                        className="flex w-full items-center justify-between rounded-lg border border-dashed p-3 text-sm opacity-60"
                      >
                        <div>
                          <span className="font-medium">#{fob.serialNumber ?? "?"}</span>
                          <span className="ml-2 text-muted-foreground">{fob.type}</span>
                        </div>
                        <Badge variant="secondary">{fob.status.replace(/_/g, " ")}</Badge>
                      </div>
                    ))}
                  </>
                )}
              </div>
            )}
          </div>
        )}

        {/* Step: Fob Type (for lost/damaged - they only know the type) */}
        {currentStepName === "Fob Type" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">What type of fob was it?</CardTitle>
            <p className="text-sm text-muted-foreground">
              Select the type of fob that was {formData.requestType === RequestType.REPLACEMENT_LOST ? "lost" : "damaged"}.
            </p>
            <div className="space-y-2">
              {credentialTypes.map((ct) => (
                <button key={ct.id} type="button" onClick={() => { update("lostFobType", ct.name); update("credentialTypeId", ct.id); }}
                  className={`w-full rounded-lg border p-3 text-left text-sm transition-colors ${
                    formData.lostFobType === ct.name ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                  }`}
                >{ct.name}</button>
              ))}
            </div>
          </div>
        )}

        {/* Step: Replacement */}
        {currentStepName === "Replacement" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">
              {formData.requestType === RequestType.REPLACEMENT_LOST ? "Lost fob" : "Damaged fob"}
            </CardTitle>

            {/* Reader beeps question (damaged fob only) */}
            {isDamaged && (
              <>
                <div className="space-y-2">
                  <Label className="text-sm font-medium">What happens when you swipe your fob at the reader?</Label>
                  <div className="space-y-2">
                    <button type="button" onClick={() => update("readerBeeps", "beeps_no_access")}
                      className={`w-full rounded-lg border p-3 text-left text-sm transition-colors ${
                        formData.readerBeeps === "beeps_no_access" ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                      }`}>The reader beeps but does not unlock</button>
                    <button type="button" onClick={() => update("readerBeeps", "nothing_happens")}
                      className={`w-full rounded-lg border p-3 text-left text-sm transition-colors ${
                        formData.readerBeeps === "nothing_happens" ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                      }`}>Nothing happens at all</button>
                    <button type="button" onClick={() => update("readerBeeps", "beeps_broken")}
                      className={`w-full rounded-lg border p-3 text-left text-sm transition-colors ${
                        formData.readerBeeps === "beeps_broken" ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                      }`}>The reader beeps but my fob is physically broken (e.g. wristband has snapped)</button>
                  </div>
                </div>

                {/* Dead-end: fob is working, member just lacks access */}
                {formData.readerBeeps === "beeps_no_access" && (
                  <div className="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm dark:border-amber-900/60 dark:bg-amber-950/30">
                    <p className="font-medium">Your fob is not broken.</p>
                    <p className="mt-1 text-muted-foreground">
                      A beep without unlocking means the fob is working, but you do not have access to this door.
                      Please make sure your membership is up to date.
                    </p>
                    <p className="mt-3">
                      <Link href={`/t/${tenantSlug}/dashboard`} className="font-medium text-primary underline underline-offset-2">
                        Log in to check the status of your fob
                      </Link>
                    </p>
                  </div>
                )}

                {/* Physical damage narrative */}
                {formData.readerBeeps === "beeps_broken" && (
                  <div className="space-y-2">
                    <Label htmlFor="physicalDamageDescription" className="text-sm font-medium">How did it break?</Label>
                    <Textarea
                      id="physicalDamageDescription"
                      rows={3}
                      placeholder="Please describe what happened (at least 10 characters)."
                      value={formData.physicalDamageDescription}
                      onChange={(e) => update("physicalDamageDescription", e.target.value)}
                    />
                    <p className="text-xs text-muted-foreground">
                      This will be reviewed to decide whether a replacement fee applies.
                    </p>
                  </div>
                )}

                {formData.readerBeeps && formData.readerBeeps !== "beeps_no_access" && <Separator />}
              </>
            )}

            {/* Replacement question - hidden when we've hit the dead-end */}
            {(!isDamaged || formData.readerBeeps !== "beeps_no_access") && (
              <>
                <p className="text-sm text-muted-foreground">
                  We will deactivate the affected fob. Would you like a replacement?
                </p>
                <div className="space-y-2">
                  <button type="button" onClick={() => update("wantsReplacement", "yes")}
                    className={`w-full rounded-lg border p-3 text-left text-sm transition-colors ${
                      formData.wantsReplacement === "yes" ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                    }`}>Yes, I would like a replacement</button>
                  <button type="button"
                    onClick={() => {
                      update("wantsReplacement", "no");
                      // Deactivate-only: clear any credential type picked at
                      // the Fob Type step so the server cannot treat this as
                      // a replacement and spawn a paired "new" request. If
                      // the member flips back to Yes, the Credential step
                      // reappears and collects the type again.
                      update("credentialTypeId", "");
                    }}
                    className={`w-full rounded-lg border p-3 text-left text-sm transition-colors ${
                      formData.wantsReplacement === "no" ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                    }`}>No, just deactivate it</button>
                </div>
              </>
            )}
          </div>
        )}

        {/* Step: Details (new fob or orphaned) */}
        {currentStepName === "Details" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">Your Details</CardTitle>
            <div className="grid gap-4 sm:grid-cols-2">
              <div className="space-y-2">
                <Label htmlFor="firstName">First Name *</Label>
                <Input id="firstName" value={formData.firstName} onChange={(e) => update("firstName", e.target.value)} />
              </div>
              <div className="space-y-2">
                <Label htmlFor="lastName">Last Name *</Label>
                <Input id="lastName" value={formData.lastName} onChange={(e) => update("lastName", e.target.value)} />
              </div>
            </div>
            <div className="space-y-2">
              <Label htmlFor="email">Email *</Label>
              <Input id="email" type="email" value={formData.email} onChange={(e) => update("email", e.target.value)} />
            </div>
            <div className="space-y-2">
              <Label htmlFor="phone">Phone *</Label>
              <Input id="phone" type="tel" value={formData.phone} onChange={(e) => update("phone", e.target.value)} />
            </div>
            <div className="space-y-2">
              <Label htmlFor="dob">Date of Birth *</Label>
              <Input id="dob" type="date" value={formData.dateOfBirth} onChange={(e) => update("dateOfBirth", e.target.value)} />
            </div>
            <div className="space-y-2">
              <Label>Membership Category *</Label>
              <Select value={formData.membershipCategory} onValueChange={(v) => update("membershipCategory", v ?? "")}>
                <SelectTrigger><SelectValue placeholder="Select category..." /></SelectTrigger>
                <SelectContent>
                  {membershipCategories.map((cat) => (
                    <SelectItem key={cat} value={cat} label={cat}>{cat}</SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
          </div>
        )}

        {/* Step: Credential type */}
        {currentStepName === "Credential" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">Select Fob or Key Type</CardTitle>
            <div className="space-y-2">
              {credentialTypes.map((ct) => (
                <button key={ct.id} type="button" onClick={() => update("credentialTypeId", ct.id)}
                  className={`flex w-full items-center justify-between rounded-lg border p-3 text-left text-sm transition-colors ${
                    formData.credentialTypeId === ct.id ? "border-primary bg-primary/5" : "border-border hover:bg-accent"
                  }`}>
                  <span>{ct.name}</span>
                  {!isPaymentDeferred && (
                    <span className="text-muted-foreground">{ct.priceCents > 0 ? `$${(ct.priceCents / 100).toFixed(2)}` : "Free"}</span>
                  )}
                </button>
              ))}
            </div>
          </div>
        )}

        {/* Step: Confirm */}
        {currentStepName === "Review" && (
          <div className="space-y-4">
            <CardTitle className="text-lg">Confirm Your Request</CardTitle>

            {needsLookup && !memberFound && (
              <div className="rounded-lg border border-amber-200 bg-amber-50 p-2 text-xs text-amber-700">
                This request will need to be linked to your account by an administrator.
              </div>
            )}

            <div className="space-y-3 text-sm">
              <div className="flex justify-between">
                <span className="text-muted-foreground">Request</span>
                <span>{selectedOption?.label}</span>
              </div>
              {memberFound && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Member</span>
                  <span>{lookupResult?.member?.firstName} {lookupResult?.member?.lastName}</span>
                </div>
              )}
              {!memberFound && formData.firstName && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Name</span>
                  <span>{formData.firstName} {formData.lastName}</span>
                </div>
              )}
              {formData.accessUpdateReason && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Reason</span>
                  <span className="text-right max-w-[60%]">
                    {formData.accessUpdateReason === "other"
                      ? formData.accessUpdateReasonOther
                      : ACCESS_UPDATE_REASONS.find((r) => r.value === formData.accessUpdateReason)?.label}
                  </span>
                </div>
              )}
              {selectedFob && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Fob</span>
                  <span>#{selectedFob.serialNumber} ({selectedFob.type})</span>
                </div>
              )}
              {isLostOrDamaged && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Replacement</span>
                  <span>{formData.wantsReplacement === "yes" ? "Yes" : "No"}</span>
                </div>
              )}
              {isDamaged && formData.readerBeeps && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Reader beeps</span>
                  <span>{formData.readerBeeps === "yes" ? "Yes, beeps but does not unlock" : "No, nothing happens"}</span>
                </div>
              )}
              {selectedCredType && (
                <>
                  <Separator />
                  <div className="flex justify-between">
                    <span className="text-muted-foreground">Fob or key</span>
                    <span>{selectedCredType.name}</span>
                  </div>
                  {selectedCredType.priceCents > 0 && !isPaymentDeferred && (
                    <div className="flex justify-between font-medium">
                      <span>Amount</span>
                      <span>${(selectedCredType.priceCents / 100).toFixed(2)}</span>
                    </div>
                  )}
                </>
              )}
            </div>
          </div>
        )}

        {/* Submitted confirmation (orphaned) */}
        {step === -1 && (
          <div className="space-y-4 text-center py-8">
            <div className="mx-auto h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-2xl text-primary">
              {"\u2713"}
            </div>
            <CardTitle className="text-lg">Request Submitted</CardTitle>
            <p className="text-sm text-muted-foreground">
              Your request has been submitted. An administrator will review it and link it to your account.
              You will receive an email once your request has been processed.
            </p>
            <Button variant="outline" onClick={() => window.location.reload()}>
              Submit Another Request
            </Button>
          </div>
        )}

        {/* Payment step */}
        {(currentStepName === "Payment" || step === -2) && paymentData && (
          <>
            {exemptionSubmitted ? (
              <div className="space-y-4 text-center py-8">
                <div className="mx-auto h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-2xl text-primary">
                  {"\u2713"}
                </div>
                <CardTitle className="text-lg">Exemption Request Submitted</CardTitle>
                <p className="text-sm text-muted-foreground">
                  Your exemption request has been submitted. You will be notified when it is reviewed.
                </p>
                <div className="flex justify-center gap-3 pt-2">
                  <Link
                    href={`/t/${tenantSlug}/dashboard`}
                    className="inline-flex h-9 items-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80"
                  >
                    Go to Dashboard
                  </Link>
                  <Button variant="outline" onClick={() => window.location.reload()}>
                    Submit Another Request
                  </Button>
                </div>
              </div>
            ) : showExemption ? (
              <div className="space-y-4">
                <CardTitle className="text-lg">Request Payment Exemption</CardTitle>
                <p className="text-sm text-muted-foreground">
                  Please explain why you believe you should be exempt from payment.
                </p>
                <Textarea
                  value={exemptionReason}
                  onChange={(e) => { setExemptionReason(e.target.value); setExemptionError(null); }}
                  placeholder="Reason for exemption..."
                  rows={4}
                />
                {exemptionError && (
                  <p className="text-sm text-destructive">{exemptionError}</p>
                )}
                <div className="flex gap-2">
                  <Button
                    onClick={async () => {
                      if (!requestId || !exemptionReason.trim()) return;
                      setExemptionSubmitting(true);
                      setExemptionError(null);
                      try {
                        const res = await fetch(
                          `/api/v1/t/${tenantSlug}/requests/${requestId}/request-exemption`,
                          {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ reason: exemptionReason }),
                          }
                        );
                        if (!res.ok) {
                          const data = await res.json();
                          throw new Error(data.error ?? "Failed to submit exemption request");
                        }
                        setExemptionSubmitted(true);
                      } catch (err) {
                        setExemptionError(err instanceof Error ? err.message : "Something went wrong");
                      } finally {
                        setExemptionSubmitting(false);
                      }
                    }}
                    disabled={exemptionSubmitting || !exemptionReason.trim()}
                  >
                    {exemptionSubmitting ? "Submitting..." : "Submit Exemption Request"}
                  </Button>
                  <Button variant="outline" onClick={() => setShowExemption(false)}>
                    Back to Payment
                  </Button>
                </div>
              </div>
            ) : (
              <>
                <PaymentStep
                  clientSecret={paymentData.clientSecret}
                  amount={paymentData.amount}
                  tenantSlug={tenantSlug}
                  stripeAccountId={paymentData.stripeAccountId}
                />
                {requestId && (
                  <div className="mt-4 pt-4 border-t text-center">
                    <button
                      type="button"
                      onClick={() => setShowExemption(true)}
                      className="text-sm text-muted-foreground hover:text-foreground underline"
                    >
                      I believe I should be exempt from payment
                    </button>
                  </div>
                )}
              </>
            )}
          </>
        )}

        {/* Success confirmation */}
        {step === -3 && (
          <div className="space-y-4 text-center py-8">
            <div className="mx-auto h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-2xl text-primary">
              {"\u2713"}
            </div>
            <CardTitle className="text-lg">Request Submitted</CardTitle>
            <p className="text-sm text-muted-foreground">
              Your request has been submitted successfully.
              {authUser ? " You can track its progress from your dashboard." : " Sign in or create an account to track its progress."}
            </p>
            <div className="flex justify-center gap-3 pt-2">
              <Link
                href={`/t/${tenantSlug}/dashboard`}
                className="inline-flex h-9 items-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80"
              >
                Go to Dashboard
              </Link>
              <Button variant="outline" onClick={() => window.location.reload()}>
                Submit Another Request
              </Button>
            </div>
          </div>
        )}

        {error && (
          <div className="mt-4 space-y-2">
            <p className="text-sm text-destructive">{error}</p>
            {error.toLowerCase().includes("sign in") && (
              <Link
                href="/sign-in"
                className="inline-flex h-8 items-center rounded-lg border border-primary px-3 text-sm font-medium text-primary hover:bg-primary/5"
              >
                Sign in to your account
              </Link>
            )}
          </div>
        )}
      </CardContent>

      {step >= 0 && currentStepName !== "Payment" && (
      <CardFooter className="flex justify-between">
        <Button variant="outline" onClick={() => setStep((s) => s - 1)} disabled={step === 0}>Back</Button>
        {currentStepName === "Review" ? (
          <Button onClick={handleSubmit} disabled={submitting}>
            {submitting ? "Submitting..." : mayRequirePayment && !isDamaged ? "Proceed to Payment" : "Submit Request"}
          </Button>
        ) : currentStepName === "Sign In" ? (
          <Button variant="outline" onClick={() => setStep((s) => s + 1)}>
            Continue without signing in
          </Button>
        ) : (
          <Button onClick={() => setStep((s) => s + 1)} disabled={!canAdvance()}>Continue</Button>
        )}
      </CardFooter>
      )}
    </Card>
  );
}
