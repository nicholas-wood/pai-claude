// Run: bun run generate-docs.ts
// Output: ~/OneDrive/06_Lifesaving/SLSA/2026/Honours-Nominations/
import {
  Document, Packer, Paragraph, TextRun, HeadingLevel, AlignmentType,
  Table, TableRow, TableCell, WidthType, BorderStyle,
} from "docx";
import { writeFileSync } from "fs";
import { homedir } from "os";

const OUT = process.env.HONOURS_OUT || `${homedir()}/OneDrive/06_Lifesaving/SLSA/2026/Honours-Nominations`;

// ---------- helpers ----------
const H1 = (t: string) => new Paragraph({ text: t, heading: HeadingLevel.HEADING_1, spacing: { after: 120 } });
const H2 = (t: string) => new Paragraph({ text: t, heading: HeadingLevel.HEADING_2, spacing: { before: 200, after: 80 } });
const H3 = (t: string) => new Paragraph({ text: t, heading: HeadingLevel.HEADING_3, spacing: { before: 140, after: 60 } });
const P = (t: string) => new Paragraph({ children: [new TextRun(t)], spacing: { after: 120 } });
const Pi = (t: string) => new Paragraph({ children: [new TextRun({ text: t, italics: true, color: "595959" })], spacing: { after: 120 } });
const subtitle = (t: string) => new Paragraph({ children: [new TextRun({ text: t, bold: true, color: "1F3864", size: 26 })], spacing: { after: 200 } });
// bullet: bold lead (date/label) + rest
const B = (lead: string, rest: string) =>
  new Paragraph({
    bullet: { level: 0 },
    spacing: { after: 60 },
    children: lead
      ? [new TextRun({ text: `${lead}  `, bold: true }), new TextRun(rest)]
      : [new TextRun(rest)],
  });
const plainBullet = (t: string) => new Paragraph({ bullet: { level: 0 }, spacing: { after: 60 }, children: [new TextRun(t)] });

function twoColTable(rows: [string, string][]) {
  const cell = (t: string, bold = false) =>
    new TableCell({
      width: { size: 32, type: WidthType.PERCENTAGE },
      margins: { top: 40, bottom: 40, left: 80, right: 80 },
      children: [new Paragraph({ children: [new TextRun({ text: t, bold })] })],
    });
  return new Table({
    width: { size: 100, type: WidthType.PERCENTAGE },
    rows: rows.map(([k, v]) => new TableRow({ children: [cell(k, true), cell(v)] })),
  });
}

function rosterTable(rows: string[][]) {
  const header = ["Member", "Member ID", "Club", "Role"];
  const hcell = (t: string) =>
    new TableCell({ shading: { fill: "1F3864" }, margins: { top: 40, bottom: 40, left: 80, right: 80 },
      children: [new Paragraph({ children: [new TextRun({ text: t, bold: true, color: "FFFFFF" })] })] });
  const cell = (t: string) =>
    new TableCell({ margins: { top: 40, bottom: 40, left: 80, right: 80 },
      children: [new Paragraph({ children: [new TextRun(t)] })] });
  return new Table({
    width: { size: 100, type: WidthType.PERCENTAGE },
    rows: [
      new TableRow({ tableHeader: true, children: header.map(hcell) }),
      ...rows.map((r) => new TableRow({ children: r.map(cell) })),
    ],
  });
}

function buildDoc(children: any[]) {
  return new Document({
    styles: {
      default: { document: { run: { font: "Calibri", size: 22 } } },
      paragraphStyles: [
        { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal",
          run: { font: "Calibri", size: 32, bold: true, color: "1F3864" }, paragraph: { spacing: { after: 120 } } },
        { id: "Heading2", name: "Heading 2", basedOn: "Normal", next: "Normal",
          run: { font: "Calibri", size: 26, bold: true, color: "1F3864" } },
        { id: "Heading3", name: "Heading 3", basedOn: "Normal", next: "Normal",
          run: { font: "Calibri", size: 23, bold: true, color: "2E4A7A" } },
      ],
    },
    sections: [{ properties: { page: { margin: { top: 1135, bottom: 1135, left: 1135, right: 1135 } } }, children }],
  });
}

async function write(name: string, children: any[]) {
  const buf = await Packer.toBuffer(buildDoc(children));
  writeFileSync(`${OUT}/${name}`, buf);
  console.log("wrote", name);
}

