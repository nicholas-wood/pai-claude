// Isolated overlay-close probes: fresh page each scenario.
import puppeteer from "puppeteer";

const BASE = "http://127.0.0.1:8899";
const out = {};

async function signIn(page) {
  await page.goto(`${BASE}/`, { waitUntil: "networkidle0" });
  if (page.url().includes("/signin")) {
    await page.waitForSelector('input[type="password"]');
    await page.type('input[type="password"]', "1234");
    await page.click('button[type="submit"]');
    await page.waitForNavigation({ waitUntil: "networkidle0" }).catch(() => {});
  }
}

async function openAddBudget(page) {
  await page.waitForFunction(
    () => [...document.querySelectorAll("button")].some((b) => b.textContent.trim() === "Add budget"),
    { timeout: 15000 },
  );
  await page.evaluate(() => {
    [...document.querySelectorAll("button")].find((b) => b.textContent.trim() === "Add budget").click();
  });
  await page.waitForSelector('[role="dialog"]', { timeout: 5000 });
}

const dialogOpen = (page) => page.evaluate(() => Boolean(document.querySelector('[role="dialog"]')));

const browser = await puppeteer.launch({ headless: "new", args: ["--no-sandbox"] });
try {
  // Scenario A: open modal, click overlay immediately (no dropdown interaction).
  const a = await browser.newPage();
  await a.setViewport({ width: 1280, height: 900 });
  await signIn(a);
  await openAddBudget(a);
  await a.mouse.click(8, 8);
  await new Promise((r) => setTimeout(r, 400));
  out.A_overlayOnly = { dialogClosed: !(await dialogOpen(a)) };

  // Scenario B: open modal, open+close a dropdown via trigger re-click, wait 1s,
  // then click overlay.
  const b = await browser.newPage();
  await b.setViewport({ width: 1280, height: 900 });
  await signIn(b);
  await openAddBudget(b);
  const c = await b.evaluate(() => {
    const dlg = document.querySelector('[role="dialog"]');
    const el = dlg.querySelectorAll('[role="combobox"]')[1];
    const r = el.getBoundingClientRect();
    return { x: r.x + r.width / 2, y: r.y + r.height / 2 };
  });
  await b.mouse.click(c.x, c.y);
  await new Promise((r) => setTimeout(r, 300));
  await b.mouse.click(c.x, c.y);
  await new Promise((r) => setTimeout(r, 1000));
  out.B_dropdownOpenAfter = await b.evaluate(() => Boolean(document.querySelector('[role="listbox"]')));
  await b.mouse.click(8, 8);
  await new Promise((r) => setTimeout(r, 400));
  out.B_overlayAfterDropdownCycle = { dialogClosed: !(await dialogOpen(b)) };

  // Scenario C: short modal (Move money) on desktop — no internal scrollbar.
  const d = await browser.newPage();
  await d.setViewport({ width: 1280, height: 900 });
  await signIn(d);
  await d.waitForFunction(
    () => [...document.querySelectorAll("button")].some((b2) => b2.textContent.trim().includes("Move money")),
    { timeout: 15000 },
  ).catch(() => {});
  const opened = await d.evaluate(() => {
    const btn = [...document.querySelectorAll("button")].find((b2) => b2.textContent.trim().includes("Move money"));
    if (btn) { btn.click(); return true; }
    return false;
  });
  if (opened) {
    await d.waitForSelector('[role="dialog"]', { timeout: 5000 });
    out.C_shortModal = await d.evaluate(() => {
      const dlg = document.querySelector('[role="dialog"]');
      return { scrollable: dlg.scrollHeight > dlg.clientHeight + 1, height: dlg.getBoundingClientRect().height };
    });
  } else {
    out.C_shortModal = { note: "Move money button not found on this page" };
  }
} finally {
  console.log("RESULTS:", JSON.stringify(out, null, 2));
  await browser.close();
}
