/**
 * Sync orchestration unit tests:
 *   - runSync reads the last-sync bookmark and sends it as updated_since (ISC-5),
 *     then advances the bookmark after a successful drain
 *   - syncWithFailureTracking raises an alert only on the second consecutive
 *     failure and resets on success (ISC-8)
 *
 * The Store and (for the failure case) the client are faked in-memory.
 */

import { describe, test, expect } from "bun:test";
import { runSync, syncWithFailureTracking } from "./sync.ts";
import { PocketSmithClient, type FetchFn, type PocketSmithTransaction } from "./client.ts";
import type { Alerter, FailureTracker } from "./alert.ts";
import type { Store, Tx, Envelope, LedgerEvent } from "../platform/store.ts";
import type { UserId } from "../platform/auth.ts";

/** Minimal in-memory Store for sync tests; only the methods sync touches are live. */
class FakeStore implements Store {
  lastSync: string | null = null;
  upserts: Tx[] = [];
  events: LedgerEvent[] = [];
  setLastSyncCalls: string[] = [];

  async migrate(): Promise<void> {}
  async withTransaction<T>(fn: () => Promise<T>): Promise<T> {
    return fn();
  }
  async upsertTransactions(_u: UserId, txs: readonly Tx[]): Promise<void> {
    this.upserts.push(...txs);
  }
  /** Rows the prune sees via listTransactions; seed pendings here. */
  rows: Tx[] = [];
  deleteCalls: string[][] = [];
  async listTransactions(): Promise<Tx[]> {
    return this.rows;
  }
  async deletePendingTransactions(_u: UserId, ids: readonly string[]): Promise<number> {
    this.deleteCalls.push([...ids]);
    const before = this.rows.length;
    this.rows = this.rows.filter((r) => !(r.isPending && ids.includes(r.id)));
    return before - this.rows.length;
  }
  async upsertEnvelope(_u: UserId, _e: Envelope): Promise<void> {}
  async listEnvelopes(): Promise<Envelope[]> {
    return [];
  }
  async appendEvent(_u: UserId, e: LedgerEvent): Promise<void> {
    this.events.push(e);
  }
  async listEventsByKind(_u: UserId, kind: string): Promise<LedgerEvent[]> {
    return this.events.filter((e) => e.kind === kind).sort((a, b) => b.ts - a.ts || b.id.localeCompare(a.id));
  }
  async writeDailySnapshot(): Promise<void> {}
  async getLastSyncAt(): Promise<string | null> {
    return this.lastSync;
  }
  async setLastSyncAt(_u: UserId, iso: string): Promise<void> {
    this.lastSync = iso;
    this.setLastSyncCalls.push(iso);
  }
  async close(): Promise<void> {}
}

function recordingClient(urls: string[]): PocketSmithClient {
  const fetchFn: FetchFn = async (url) => {
    urls.push(url);
    const body: PocketSmithTransaction[] = [{ id: 1, amount: -1, date: "2026-06-01" }];
    return new Response(JSON.stringify(body), { status: 200 });
  };
  return PocketSmithClient.withKey("k", { fetchFn });
}

describe("runSync (ISC-5)", () => {
  test("sends updated_since equal to the last successful sync timestamp", async () => {
    const store = new FakeStore();
    store.lastSync = "2026-06-25T19:30:00.000Z";
    const urls: string[] = [];
    const client = recordingClient(urls);

    const result = await runSync({
      store,
      client,
      userId: "u1",
      pocketsmithUserId: 42,
      now: () => new Date("2026-06-26T05:30:00.000Z"),
    });

    const url = new URL(urls[0]!);
    expect(url.searchParams.get("updated_since")).toBe("2026-06-25T19:30:00.000Z");
    expect(result.updatedSince).toBe("2026-06-25T19:30:00.000Z");
    // Bookmark advanced to the run's completion time.
    expect(store.lastSync).toBe("2026-06-26T05:30:00.000Z");
    expect(store.events.at(-1)?.kind).toBe("ingest.sync.completed");
  });

  test("first run with no bookmark omits updated_since", async () => {
    const store = new FakeStore(); // lastSync null
    const urls: string[] = [];
    const client = recordingClient(urls);

    const result = await runSync({ store, client, userId: "u1", pocketsmithUserId: 7 });

    const url = new URL(urls[0]!);
    expect(url.searchParams.has("updated_since")).toBe(false);
    expect(result.updatedSince).toBeNull();
  });
});

class CountingTracker implements FailureTracker {
  count = 0;
  async recordSuccess(): Promise<void> {
    this.count = 0;
  }
  async recordFailure(): Promise<number> {
    this.count += 1;
    return this.count;
  }
}

class CapturingAlerter implements Alerter {
  messages: string[] = [];
  async alert(message: string): Promise<void> {
    this.messages.push(message);
  }
}

/** A client whose pagination always throws, to drive the failure path. */
function failingClient(): PocketSmithClient {
  const fetchFn: FetchFn = async () => {
    throw new Error("network down");
  };
  return PocketSmithClient.withKey("k", { fetchFn });
}

describe("syncWithFailureTracking (ISC-8)", () => {
  test("alerts only on the second consecutive failure", async () => {
    const tracker = new CountingTracker();
    const alerter = new CapturingAlerter();
    const opts = {
      store: new FakeStore(),
      client: failingClient(),
      userId: "u1",
      pocketsmithUserId: 42,
    };

    const first = await syncWithFailureTracking(opts, { failures: tracker, alerter });
    expect(first.ok).toBe(false);
    expect(first.consecutiveFailures).toBe(1);
    expect(first.alerted).toBe(false);
    expect(alerter.messages.length).toBe(0);

    const second = await syncWithFailureTracking(opts, { failures: tracker, alerter });
    expect(second.ok).toBe(false);
    expect(second.consecutiveFailures).toBe(2);
    expect(second.alerted).toBe(true);
    expect(alerter.messages.length).toBe(1);
    expect(alerter.messages[0]).toContain("2 times in a row");
  });

  test("a success resets the consecutive-failure counter", async () => {
    const tracker = new CountingTracker();
    const alerter = new CapturingAlerter();
    const store = new FakeStore();

    await syncWithFailureTracking(
      { store, client: failingClient(), userId: "u1", pocketsmithUserId: 42 },
      { failures: tracker, alerter },
    );
    expect(tracker.count).toBe(1);

    const urls: string[] = [];
    const ok = await syncWithFailureTracking(
      { store, client: recordingClient(urls), userId: "u1", pocketsmithUserId: 42 },
      { failures: tracker, alerter },
    );
    expect(ok.ok).toBe(true);
    expect(tracker.count).toBe(0);
    expect(alerter.messages.length).toBe(0);
  });
});

/** Tx factory for prune scenarios. */
function tx(id: string, date: string, pending: boolean): Tx {
  return {
    id,
    date,
    amountCents: -1000,
    accountId: "acc-1",
    categoryId: null,
    envelopeId: null,
    payee: `payee-${id}`,
    isTransfer: false,
    isPending: pending,
    rawJson: "{}",
  };
}

/**
 * Client whose fetch routes on the query: the incremental drain (updated_since
 * present, or the very first no-bookmark pull) returns `drainPage`; the prune's
 * window re-fetch (start_date present, no updated_since) returns `windowPage`.
 */
function routingClient(
  drainPage: readonly PocketSmithTransaction[],
  windowPage: readonly PocketSmithTransaction[],
  calls: { drain: number; window: number; windowUrls: string[] },
): PocketSmithClient {
  const fetchFn: FetchFn = async (url) => {
    const u = new URL(url);
    const isWindow = u.searchParams.has("start_date") && !u.searchParams.has("updated_since");
    if (isWindow) {
      calls.window += 1;
      calls.windowUrls.push(url);
      return new Response(JSON.stringify(windowPage), { status: 200 });
    }
    calls.drain += 1;
    return new Response(JSON.stringify(drainPage), { status: 200 });
  };
  return PocketSmithClient.withKey("k", { fetchFn });
}

describe("runSync stale-pending prune (ISC-248..255)", () => {
  const baseOpts = (store: FakeStore, client: PocketSmithClient) => ({
    store,
    client,
    userId: "u1",
    pocketsmithUserId: 42,
    now: () => new Date("2026-08-13T00:00:00.000Z"),
  });

  test("deletes a local pending PocketSmith no longer lists; keeps one it still lists (ISC-248/252)", async () => {
    const store = new FakeStore();
    store.lastSync = "2026-08-12T00:00:00.000Z";
    store.rows = [tx("900", "2026-07-12", true), tx("901", "2026-08-10", true)];
    const calls = { drain: 0, window: 0, windowUrls: [] as string[] };
    const client = routingClient([], [{ id: 901, amount: -1, date: "2026-08-10", status: "pending" }], calls);

    const result = await runSync(baseOpts(store, client));

    expect(result.prunedPending).toBe(1);
    expect(store.rows.map((r) => r.id)).toEqual(["901"]);
    expect(store.deleteCalls).toEqual([["900"]]);
  });

  test("never deletes posted rows, even when absent from the window (ISC-251)", async () => {
    const store = new FakeStore();
    store.lastSync = "2026-08-12T00:00:00.000Z";
    store.rows = [tx("posted-1", "2026-07-01", false), tx("stale-1", "2026-07-12", true)];
    const calls = { drain: 0, window: 0, windowUrls: [] as string[] };
    const client = routingClient([], [{ id: 999, amount: -2, date: "2026-07-20", status: "posted" }], calls);

    const result = await runSync(baseOpts(store, client));

    expect(result.prunedPending).toBe(1);
    expect(store.rows.map((r) => r.id)).toEqual(["posted-1"]);
    // Only the pending id was even offered to the store.
    expect(store.deleteCalls).toEqual([["stale-1"]]);
  });

  test("with no local pendings the prune makes no window call (ISC-254)", async () => {
    const store = new FakeStore();
    store.lastSync = "2026-08-12T00:00:00.000Z";
    store.rows = [tx("posted-1", "2026-07-01", false)];
    const calls = { drain: 0, window: 0, windowUrls: [] as string[] };
    const client = routingClient([], [], calls);

    const result = await runSync(baseOpts(store, client));

    expect(result.prunedPending).toBe(0);
    expect(calls.window).toBe(0);
  });

  test("window spans oldest pending −14d through newest pending +7d (or today) (ISC-249)", async () => {
    const store = new FakeStore();
    store.lastSync = "2026-08-12T00:00:00.000Z";
    store.rows = [tx("910", "2026-07-12", true), tx("911", "2026-08-12", true)];
    const calls = { drain: 0, window: 0, windowUrls: [] as string[] };
    const client = routingClient(
      [],
      [
        { id: 910, amount: -1, date: "2026-07-12", status: "pending" },
        { id: 911, amount: -1, date: "2026-08-12", status: "pending" },
      ],
      calls,
    );

    await runSync(baseOpts(store, client));

    expect(calls.window).toBe(1);
    const u = new URL(calls.windowUrls[0]!);
    expect(u.searchParams.get("start_date")).toBe("2026-06-28");
    expect(u.searchParams.get("end_date")).toBe("2026-08-19");
  });

  test("a failed window fetch fails the sync run; nothing deleted, bookmark not advanced (ISC-255)", async () => {
    const store = new FakeStore();
    store.lastSync = "2026-08-12T00:00:00.000Z";
    store.rows = [tx("stale-1", "2026-07-12", true)];
    const fetchFn: FetchFn = async (url) => {
      const u = new URL(url);
      if (u.searchParams.has("start_date") && !u.searchParams.has("updated_since")) {
        return new Response("boom", { status: 500 });
      }
      return new Response(JSON.stringify([]), { status: 200 });
    };
    const client = PocketSmithClient.withKey("k", { fetchFn });

    await expect(runSync(baseOpts(store, client))).rejects.toThrow();
    expect(store.rows.length).toBe(1);
    expect(store.deleteCalls.length).toBe(0);
    expect(store.setLastSyncCalls.length).toBe(0);
  });

  test("the completion event payload carries the pruned count (ISC-256)", async () => {
    const store = new FakeStore();
    store.lastSync = "2026-08-12T00:00:00.000Z";
    store.rows = [tx("stale-1", "2026-07-12", true)];
    const calls = { drain: 0, window: 0, windowUrls: [] as string[] };
    const client = routingClient([], [{ id: 999, amount: -2, date: "2026-07-20", status: "posted" }], calls);

    await runSync(baseOpts(store, client));

    const event = store.events.find((e) => e.kind === "ingest.sync.completed");
    expect(event).toBeDefined();
    const payload = JSON.parse(event!.payloadJson);
    expect(payload.prunedPending).toBe(1);
    // Every pruned row's identifying fields are recorded for post-mortem.
    expect(payload.prunedRows).toEqual([
      { id: "stale-1", accountId: "acc-1", date: "2026-07-12", amountCents: -1000, payee: "payee-stale-1" },
    ]);
  });

  test("a zero-transaction window with local pendings SKIPS the prune (degraded-feed safety valve)", async () => {
    const store = new FakeStore();
    store.lastSync = "2026-08-12T00:00:00.000Z";
    store.rows = [tx("p1", "2026-07-12", true), tx("p2", "2026-08-10", true)];
    const calls = { drain: 0, window: 0, windowUrls: [] as string[] };
    const client = routingClient([], [], calls);

    const result = await runSync(baseOpts(store, client));

    expect(calls.window).toBe(1);
    expect(result.prunedPending).toBe(0);
    expect(store.rows.length).toBe(2);
    expect(store.deleteCalls.length).toBe(0);
  });
});
