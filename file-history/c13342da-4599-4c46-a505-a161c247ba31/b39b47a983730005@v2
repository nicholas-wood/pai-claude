// Focus-tracking probe: where does focus go between search keystrokes?
import puppeteer from "puppeteer";

const BASE = "http://127.0.0.1:8899";
const out = {};

async function signIn(page) {
  await page.goto(`${BASE}/`, { waitUntil: "networkidle0" });
  if (page.url().includes("/signin")) {
    await page.waitForSelector('input[type="password"]');
    await page.type('input[type="password"]', "1234");
    await page.click('button[type="submit"]');
    await page.waitForNavigation({ waitUntil: "networkidle0" }).catch(() => {});
  }
}

async function openAddBudget(page) {
  await page.waitForFunction(
    () => [...document.querySelectorAll("button")].some((b) => b.textContent.trim() === "Add budget"),
    { timeout: 15000 },
  );
  await page.evaluate(() => {
    [...document.querySelectorAll("button")].find((b) => b.textContent.trim() === "Add budget").click();
  });
  await page.waitForSelector('[role="dialog"]', { timeout: 5000 });
}

const focusInfo = (page) =>
  page.evaluate(() => {
    const a = document.activeElement;
    const listbox = document.querySelector('[role="listbox"]');
    return {
      active: a ? `${a.tagName}${a.getAttribute("role") ? `[${a.getAttribute("role")}]` : ""}${a.tagName === "INPUT" ? `(value=${a.value})` : ""}` : null,
      optionCount: listbox?.querySelectorAll('[role="option"]').length ?? null,
    };
  });

const browser = await puppeteer.launch({ headless: "new", args: ["--no-sandbox"] });
try {
  const page = await browser.newPage();
  await page.setViewport({ width: 1280, height: 900 });
  await signIn(page);
  await openAddBudget(page);
  const box = await page.evaluate(() => {
    const dlg = document.querySelector('[role="dialog"]');
    const el = dlg.querySelectorAll('[role="combobox"]')[0];
    const r = el.getBoundingClientRect();
    return { x: r.x + r.width / 2, y: r.y + r.height / 2 };
  });
  await page.mouse.click(box.x, box.y);
  await new Promise((r) => setTimeout(r, 400));
  out.afterOpen = await focusInfo(page);
  for (const ch of ["g", "r", "o"]) {
    await page.keyboard.press(ch);
    await new Promise((r) => setTimeout(r, 150));
    out[`after_${ch}`] = await focusInfo(page);
  }
  // trigger text with selected option always-mounted
  out.triggerText = await page.evaluate(() => {
    const dlg = document.querySelector('[role="dialog"]');
    return dlg?.querySelectorAll('[role="combobox"]')[0]?.textContent?.trim();
  });
  // Enter fast-path (programmatic select)
  await page.keyboard.press("Enter");
  await new Promise((r) => setTimeout(r, 300));
  out.afterEnter = await page.evaluate(() => {
    const dlg = document.querySelector('[role="dialog"]');
    return {
      listboxClosed: !document.querySelector('[role="listbox"]'),
      dialogOpen: Boolean(dlg),
      triggerText: dlg?.querySelectorAll('[role="combobox"]')[0]?.textContent?.trim(),
    };
  });

  // Advisor probe 1: arrow to a LATER option, Enter selects the FOCUSED one,
  // not the first match.
  const box2 = await page.evaluate(() => {
    const dlg = document.querySelector('[role="dialog"]');
    const el = dlg.querySelectorAll('[role="combobox"]')[0];
    const r = el.getBoundingClientRect();
    return { x: r.x + r.width / 2, y: r.y + r.height / 2 };
  });
  await page.mouse.click(box2.x, box2.y);
  await new Promise((r) => setTimeout(r, 400));
  await page.keyboard.press("ArrowDown"); // from input into list (first option)
  await new Promise((r) => setTimeout(r, 150));
  await page.keyboard.press("ArrowDown"); // second option
  await page.keyboard.press("ArrowDown"); // third option
  await new Promise((r) => setTimeout(r, 150));
  const focusedText = await page.evaluate(() => document.activeElement?.textContent?.trim());
  await page.keyboard.press("Enter");
  await new Promise((r) => setTimeout(r, 300));
  out.arrowEnter = await page.evaluate((ft) => {
    const dlg = document.querySelector('[role="dialog"]');
    return {
      focusedBeforeEnter: ft,
      listboxClosed: !document.querySelector('[role="listbox"]'),
      triggerText: dlg?.querySelectorAll('[role="combobox"]')[0]?.textContent?.trim(),
    };
  }, focusedText);

  // Advisor probe 2: focus restoration after imperative outside-close.
  await page.mouse.click(box2.x, box2.y);
  await new Promise((r) => setTimeout(r, 400));
  await page.mouse.click(8, 8); // outside press → wrapper closes the select
  await new Promise((r) => setTimeout(r, 400));
  out.focusAfterOutsideClose = await page.evaluate(() => {
    const a = document.activeElement;
    return a ? `${a.tagName}${a.getAttribute("role") ? `[${a.getAttribute("role")}]` : ""}` : null;
  });
} finally {
  console.log("RESULTS:", JSON.stringify(out, null, 2));
  await browser.close();
}
