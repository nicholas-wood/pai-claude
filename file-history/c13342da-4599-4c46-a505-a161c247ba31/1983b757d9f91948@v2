      <SelectPrimitive.ItemIndicator>
        <Check className="h-4 w-4" />
      </SelectPrimitive.ItemIndicator>
    </span>
    <SelectPrimitive.ItemText>{children}</SelectPrimitive.ItemText>
  </SelectPrimitive.Item>
));
SelectItem.displayName = SelectPrimitive.Item.displayName;

// --- Searchable, alphabetically sorted select content ------------------------

export interface SearchableSelectOption {
  readonly value: string;
  /** Plain-text label — drives search matching and alphabetical sorting. */
  readonly label: string;
  /** Optional richer display (amounts, suffixes); defaults to the label. */
  readonly render?: React.ReactNode;
  /** Sentinels: "top" pins above the sorted list, "bottom" below it. */
  readonly pin?: "top" | "bottom";
  /** Options sort alphabetically WITHIN their group; group blocks keep their
   *  first-appearance order (e.g. categories block, then incomes block). */
  readonly group?: string;
  readonly disabled?: boolean;
}

interface SearchableSelectContentProps
  extends React.ComponentPropsWithoutRef<typeof SelectPrimitive.Content> {
  options: readonly SearchableSelectOption[];
  /** Alphabetical (locale-aware) sorting of non-pinned options. Default true. */
  sort?: boolean;
  /** The search box appears when the list has at least this many options. */
  searchThreshold?: number;
  searchPlaceholder?: string;
}

const labelCompare = (a: SearchableSelectOption, b: SearchableSelectOption) =>
  a.label.localeCompare(b.label, undefined, { sensitivity: "base", numeric: true });

/**
 * Drop-in SelectContent for dynamic entity lists (categories, envelopes,
 * accounts): options arrive as data, render alphabetically sorted with pinned
 * sentinels, and a search box filters the list once it is long enough to need
 * one. Keystrokes stay contained to the search input (Radix typeahead would
 * otherwise hijack them); ArrowDown hands focus to the list; Enter picks the
 * first visible option; Escape still closes the dropdown. The input autofocuses
 * on fine-pointer devices only, so phones never get a surprise keyboard.
 */
const SearchableSelectContent = React.forwardRef<
  React.ElementRef<typeof SelectPrimitive.Content>,
  SearchableSelectContentProps
>(({ options, sort = true, searchThreshold = 6, searchPlaceholder = "Search…", className, position = "popper", ...props }, ref) => {
  const { open, value: selectedValue, select } = React.useContext(SelectRootContext);
  const [query, setQuery] = React.useState("");
  const inputRef = React.useRef<HTMLInputElement>(null);
  const listRef = React.useRef<HTMLDivElement>(null);
  const showSearch = options.length >= searchThreshold;

  const { visible, matchedCount } = React.useMemo(() => {
    const q = query.trim().toLowerCase();
    const matches = (o: SearchableSelectOption) => !q || o.label.toLowerCase().includes(q);
    // The SELECTED option is exempt from the filter and never unmounts:
    // Radix renders the trigger's value from the selected item's text (so an
    // unmount would blank the trigger), and remounting it mid-open steals
    // focus from the search input.
    const keep = (o: SearchableSelectOption) => matches(o) || o.value === selectedValue;
    const tops = options.filter((o) => o.pin === "top" && keep(o));
    const bottoms = options.filter((o) => o.pin === "bottom" && keep(o));
    let mids = options.filter((o) => !o.pin && keep(o));
    if (sort) {
      const groupOrder = [...new Set(options.filter((o) => !o.pin).map((o) => o.group ?? ""))];
      mids = groupOrder.flatMap((g) => mids.filter((o) => (o.group ?? "") === g).sort(labelCompare));
    }
    return {
      visible: [...tops, ...mids, ...bottoms],
      matchedCount: options.filter(matches).length,
    };
  }, [options, query, sort, selectedValue]);

  // The component stays mounted while closed, so reset the query per close:
  // reopening always shows the full list.
  React.useEffect(() => {
    if (!open) setQuery("");
  }, [open]);

  // Autofocus the search box on EACH open, fine pointers only — on touch the
  // on-screen keyboard would cover the options the user came to tap. Radix
  // runs its own focus pass on open, so claim focus after it (with one retry).
  React.useEffect(() => {
    if (!open || !showSearch || window.matchMedia("(pointer: coarse)").matches) return;
    const timers = [50, 200].map((ms) =>
      setTimeout(() => {
        if (document.activeElement !== inputRef.current) inputRef.current?.focus();
      }, ms),
    );
    return () => timers.forEach(clearTimeout);
  }, [open, showSearch]);

  // Typing must never lose focus mid-word: when a query change remounts the
  // selected item (it moves between the visible list and the hidden slot),
  // Radix's selected-item mount logic steals focus — take it back. This
  // parent effect runs after the item's, in the same commit.
  React.useEffect(() => {
    if (open && showSearch && query && document.activeElement !== inputRef.current) inputRef.current?.focus();
  }, [open, showSearch, query]);

  const focusOption = (last: boolean) => {
    const items = listRef.current?.querySelectorAll<HTMLElement>('[role="option"]:not([data-disabled]):not(.hidden)');
    if (items && items.length > 0) items[last ? items.length - 1 : 0]?.focus();
  };

  const onSearchKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === "Escape") return; // Radix closes the dropdown
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      e.stopPropagation();
      focusOption(e.key === "ArrowUp");
      return;
    }
    if (e.key === "Enter") {
      e.preventDefault();
      e.stopPropagation();
      // Fast path: with a query typed, Enter commits the first match. Only
      // options the query actually matched qualify — the always-mounted
      // selected option does not (it is already selected anyway).
      const q = query.trim().toLowerCase();
      if (!q) return;
      const first = visible.find((o) => !o.disabled && o.label.toLowerCase().includes(q));
      if (first) select(first.value);
      return;
    }
    // Everything else is typing — keep it away from Radix's typeahead.
    e.stopPropagation();
  };

  return (
    <SelectPrimitive.Portal>
      <SelectPrimitive.Content
        ref={ref}
        className={cn(
          "relative z-50 flex max-h-[min(24rem,var(--radix-select-content-available-height))] min-w-[8rem] flex-col overflow-hidden rounded-md border bg-popover text-popover-foreground shadow-md",
          position === "popper" && "data-[side=bottom]:translate-y-1",
          className
        )}
        position={position}
        {...props}
      >
        {showSearch && (
          <div className="flex shrink-0 items-center gap-2 border-b px-3 py-2" onKeyDown={onSearchKeyDown}>
            <Search className="h-4 w-4 shrink-0 opacity-50" />
            <input
              ref={inputRef}
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder={searchPlaceholder}
              aria-label="Search options"
              // 16px on phones so iOS does not zoom the page on focus.
              className="w-full bg-transparent text-base outline-none placeholder:text-muted-foreground sm:text-sm"
            />
          </div>
        )}
        <SelectPrimitive.Viewport
          ref={listRef}
          className={cn("flex-1 overflow-y-auto p-1", position === "popper" && "w-full min-w-[var(--radix-select-trigger-width)]")}
        >
          {matchedCount === 0 && <div className="py-4 text-center text-sm text-muted-foreground">No matches</div>}
          {visible.map((o) => (
            <SelectItem key={o.value} value={o.value} disabled={o.disabled ?? false}>
              {o.render ?? o.label}
            </SelectItem>
          ))}
        </SelectPrimitive.Viewport>
      </SelectPrimitive.Content>
    </SelectPrimitive.Portal>
  );
});
SearchableSelectContent.displayName = "SearchableSelectContent";

export { Select, SelectGroup, SelectValue, SelectTrigger, SelectContent, SelectItem, SearchableSelectContent };
