// Bug A deep probe: touch taps + element-at-point diagnostics.
import puppeteer from "puppeteer";

const BASE = "http://127.0.0.1:8899";

async function signIn(page) {
  await page.goto(`${BASE}/`, { waitUntil: "networkidle0" });
  if (page.url().includes("/signin")) {
    await page.waitForSelector('input[type="password"]');
    await page.type('input[type="password"]', "1234");
    await page.click('button[type="submit"]');
    await page.waitForNavigation({ waitUntil: "networkidle0" }).catch(() => {});
  }
}

async function openAddBudget(page) {
  await page.waitForFunction(
    () => [...document.querySelectorAll("button")].some((b) => b.textContent.trim() === "Add budget"),
    { timeout: 15000 },
  );
  await page.evaluate(() => {
    [...document.querySelectorAll("button")].find((b) => b.textContent.trim() === "Add budget").click();
  });
  await page.waitForSelector('[role="dialog"]', { timeout: 5000 });
}

async function comboBox(page, idx) {
  return page.evaluate((i) => {
    const dlg = document.querySelector('[role="dialog"]');
    const el = dlg?.querySelectorAll('[role="combobox"]')[i];
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return { x: r.x + r.width / 2, y: r.y + r.height / 2 };
  }, idx);
}

const atPoint = (page, x, y) =>
  page.evaluate(
    (px, py) => {
      const el = document.elementFromPoint(px, py);
      return el
        ? { tag: el.tagName, role: el.getAttribute("role"), cls: (el.className || "").toString().slice(0, 60), bodyPE: getComputedStyle(document.body).pointerEvents }
        : { tag: null, bodyPE: getComputedStyle(document.body).pointerEvents };
    },
    x,
    y,
  );

const state = (page) =>
  page.evaluate(() => ({
    dialog: Boolean(document.querySelector('[role="dialog"]')),
    listbox: Boolean(document.querySelector('[role="listbox"]')),
  }));

const browser = await puppeteer.launch({ headless: "new", args: ["--no-sandbox"] });
const out = {};
try {
  // ---- Touch tap sequence on mobile viewport ----
  const m = await browser.newPage();
  await m.setViewport({ width: 375, height: 667, isMobile: true, hasTouch: true });
  await signIn(m);
  await openAddBudget(m);
  // Period combobox (index 1 when creating an expense)
  let c = await comboBox(m, 1);
  await m.touchscreen.tap(c.x, c.y);
  await new Promise((r) => setTimeout(r, 500));
  out.afterFirstTap = await state(m);
  // Where is the trigger point now? (is the popper covering it?)
  out.elementAtTriggerWhileOpen = await atPoint(m, c.x, c.y);
  await m.touchscreen.tap(c.x, c.y);
  await new Promise((r) => setTimeout(r, 500));
  out.afterSecondTap = await state(m);

  // ---- Same with the Parent/category dropdown (index 0, longer list) ----
  const m2 = await browser.newPage();
  await m2.setViewport({ width: 375, height: 667, isMobile: true, hasTouch: true });
  await signIn(m2);
  await openAddBudget(m2);
  c = await comboBox(m2, 0);
  await m2.touchscreen.tap(c.x, c.y);
  await new Promise((r) => setTimeout(r, 500));
  out.parent_afterFirstTap = await state(m2);
  out.parent_elementAtTrigger = await atPoint(m2, c.x, c.y);
  await m2.touchscreen.tap(c.x, c.y);
  await new Promise((r) => setTimeout(r, 500));
  out.parent_afterSecondTap = await state(m2);

  // ---- Desktop, but check element under cursor when open ----
  const d = await browser.newPage();
  await d.setViewport({ width: 1280, height: 800 });
  await signIn(d);
  await openAddBudget(d);
  c = await comboBox(d, 1);
  await d.mouse.click(c.x, c.y);
  await new Promise((r) => setTimeout(r, 400));
  out.desktop_open = await state(d);
  out.desktop_elementAtTrigger = await atPoint(d, c.x, c.y);
} finally {
  console.log("RESULTS:", JSON.stringify(out, null, 2));
  await browser.close();
}
