import * as React from "react";
import { RefreshCw } from "lucide-react";
import { Button } from "@/components/ui/button";

declare const __APP_VERSION__: string;

/**
 * Stale-client detection (2026-08-12). The PWA keeps tabs open across deploys;
 * a page running old JavaScript against a newer server misbehaves in subtle
 * ways (broken portal layering, failed chunk imports surfacing as native
 * navigations). The health endpoint reports the server's build version; when
 * it differs from the version this bundle was built with, a fixed banner
 * offers a one-click reload. Checks on load, on window focus, and every 5
 * minutes; network failures are ignored (offline is not skew).
 */
export function VersionSkewBanner() {
  const [serverVersion, setServerVersion] = React.useState<string | null>(null);

  React.useEffect(() => {
    let cancelled = false;
    const check = async () => {
      try {
        const res = await fetch("/api/health", { cache: "no-store" });
        if (!res.ok) return;
        const body = (await res.json()) as { version?: string };
        if (!cancelled && typeof body.version === "string") setServerVersion(body.version);
      } catch {
        /* offline / transient — not skew */
      }
    };
    void check();
    const onFocus = () => void check();
    window.addEventListener("focus", onFocus);
    const timer = window.setInterval(() => void check(), 5 * 60 * 1000);
    return () => {
      cancelled = true;
      window.removeEventListener("focus", onFocus);
      window.clearInterval(timer);
    };
  }, []);

  // __APP_VERSION__ is "v1.16.2" (display-prefixed); the server sends the bare
  // package.json semver. Normalise both sides before comparing (the mismatch
  // showed the banner to a perfectly current client as "running vv1.16.2").
  const bare = (v: string) => v.replace(/^v/, "");
  if (serverVersion === null || bare(serverVersion) === bare(__APP_VERSION__)) return null;

  return (
    <div className="fixed inset-x-0 top-0 z-[100] flex items-center justify-center gap-3 border-b border-warning/40 bg-warning/15 px-4 py-2 text-sm backdrop-blur">
      <span>
        BudgetBuddy v{bare(serverVersion)} is available — this window is running v
        {bare(__APP_VERSION__)} and may misbehave.
      </span>
      <Button size="sm" onClick={() => window.location.reload()}>
        <RefreshCw className="h-3.5 w-3.5" /> Reload
      </Button>
    </div>
  );
}
