/**
 * Incremental sync (ISC-5, ISC-7, ISC-8, ISC-12, ISC-17).
 *
 * Daily pull-only refresh. Asks PocketSmith only for transactions changed since
 * the last successful run (updated_since = last sync timestamp, ISC-5), pages to
 * completion, and upserts base fields through the Store. The verbatim source
 * JSON is retained on every row (ISC-12).
 *
 * Non-destructive (ISC-17): like backfill, this refreshes base fields via the
 * Store's ON CONFLICT DO UPDATE and never touches transaction_overrides, so a
 * re-sync never destroys a user's overlay. It only ever refreshes base facts.
 *
 * Failure alerting (ISC-8): syncWithFailureTracking wraps runSync, counting
 * consecutive failures across runs and raising a Pulse/Telegram alert once two
 * in a row occur. A success resets the count.
 *
 * Pull-only (ISC-9): the only PocketSmith traffic is GET pagination. No webhook,
 * listener, or push path exists.
 */

import type { Store } from "../platform/store.ts";
import type { UserId } from "../platform/auth.ts";
import { PocketSmithClient, type TransactionQuery } from "./client.ts";
import { toStoreTxs } from "./map.ts";
import {
  ALERT_AFTER_CONSECUTIVE_FAILURES,
  type Alerter,
  type FailureTracker,
} from "./alert.ts";

export interface SyncOptions {
  readonly store: Store;
  readonly client: PocketSmithClient;
  /** Penny tenant id (the authenticated user_id every store call is scoped by). */
  readonly userId: UserId;
  /** PocketSmith user id. Resolved via GET /me when omitted. */
  readonly pocketsmithUserId?: number;
  /** Clock injection for deterministic tests; defaults to now. */
  readonly now?: () => Date;
}

export interface SyncResult {
  readonly pages: number;
  readonly transactions: number;
  /** Stale pending rows deleted because PocketSmith no longer lists them (ISC-248). */
  readonly prunedPending: number;
  /** The updated_since the run sent, or null on a first run with no bookmark. */
  readonly updatedSince: string | null;
  readonly completedAt: string;
}

/** Shift an ISO date (YYYY-MM-DD) by whole days, in UTC — date arithmetic only. */
function shiftDays(isoDate: string, days: number): string {
  const d = new Date(`${isoDate}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

/**
 * Prune local PENDING rows PocketSmith no longer lists (ISC-248). An
 * updated_since sync can never observe a deletion: a pending the bank drops
 * (usually re-posted under a NEW id) simply stops appearing, so its local row
 * lingered forever. This re-fetches PocketSmith's CURRENT view of the window
 * the local pendings span — padded 14 days back and 7 days forward (ISC-249),
 * which also covers UTC-vs-local "today" boundary effects — and deletes local
 * pendings whose ids are absent. Posted rows are untouchable by construction
 * (the store method deletes is_pending rows only, ISC-250/251). Runs AFTER the
 * drain, so a pending that posted under the same id was already flipped by the
 * upsert and no longer counts as pending (ISC-253). With no local pendings it
 * makes no PocketSmith call at all (ISC-254); a failed window fetch throws
 * before any delete, failing the sync with nothing pruned (ISC-255).
 */
/** What the prune removed, for the audit event (identifying fields, no rawJson). */
export interface PrunedRow {
  readonly id: string;
  readonly accountId: string;
  readonly date: string;
  readonly amountCents: number;
  readonly payee: string;
}

async function pruneStalePendings(
  opts: SyncOptions,
  pocketsmithUserId: number,
  today: string,
): Promise<PrunedRow[]> {
  const all = await opts.store.listTransactions(opts.userId);
  const pendings = all.filter((t) => t.isPending);
  if (pendings.length === 0) return [];

  const dates = pendings.map((p) => p.date).filter((d) => d !== "").sort();
  const startDate = shiftDays(dates[0] ?? today, -14);
  const newestPlus = shiftDays(dates[dates.length - 1] ?? today, 7);
  const endDate = newestPlus > today ? newestPlus : today;

  const current = await opts.client.listAllTransactions(pocketsmithUserId, { startDate, endDate });
  // Safety valve: local pendings exist, yet PocketSmith reports NO transactions
  // at all in a window that spans them (posted or pending). That is a degraded
  // feed, not a legitimate state — deleting everything on it would be the
  // mass-delete failure mode. Skip the prune; a healthy later run catches up.
  if (current.length === 0) {
    console.warn(
      `[sync] prune skipped: PocketSmith returned 0 transactions for ${startDate}..${endDate} while ${pendings.length} local pendings exist`,
    );
    return [];
  }
  const liveIds = new Set(current.map((t) => String(t.id)));
  const stale = pendings.filter((p) => !liveIds.has(p.id));
  if (stale.length === 0) return [];
  await opts.store.deletePendingTransactions(
    opts.userId,
    stale.map((s) => s.id),
  );
  return stale.map((s) => ({
    id: s.id,
    accountId: s.accountId,
    date: s.date,
    amountCents: s.amountCents,
    payee: s.payee,
  }));
}

/**
 * Run one incremental sync. ISC-5: updated_since equals the last successful sync
 * timestamp. On the very first run (no bookmark yet) it pulls everything, which
 * is the correct behaviour if a backfill has not seeded the bookmark.
 */
export async function runSync(opts: SyncOptions): Promise<SyncResult> {
  const now = opts.now ?? (() => new Date());
  const correlationId = crypto.randomUUID();

  // ISC-5: the bookmark is the last successful run's timestamp.
  const updatedSince = await opts.store.getLastSyncAt(opts.userId);

  const pocketsmithUserId =
    opts.pocketsmithUserId ?? (await resolvePocketSmithUserId(opts.client));

  const query: TransactionQuery =
    updatedSince !== null ? { updatedSince } : {};

  let pages = 0;
  let transactions = 0;

  // ISC-4: drain to completion.
  for await (const page of opts.client.paginate(pocketsmithUserId, query)) {
    pages += 1;
    const txs = toStoreTxs(page);
    if (txs.length > 0) {
      // ISC-17: base-field refresh only; overlay untouched.
      await opts.store.upsertTransactions(opts.userId, txs);
      transactions += txs.length;
    }
  }

  // Stale-pending prune (ISC-248): after the drain so same-id postings were
  // already flipped by the upsert. A throw here fails the whole sync run —
  // nothing was deleted, and the bookmark below never advances.
  const prunedRows = await pruneStalePendings(
    opts,
    pocketsmithUserId,
    now().toISOString().slice(0, 10),
  );
  const prunedPending = prunedRows.length;

  const completedAt = now().toISOString();

  // ISC-15: append a sync event. Every pruned row's identifying fields are
  // recorded (capped) so a wrong deletion is diagnosable and recoverable.
  await opts.store.appendEvent(opts.userId, {
    id: crypto.randomUUID(),
    ts: Date.parse(completedAt),
    actor: "sync",
    correlationId,
    kind: "ingest.sync.completed",
    payloadJson: JSON.stringify({
      updatedSince,
      pages,
      transactions,
      prunedPending,
      ...(prunedPending > 0 ? { prunedRows: prunedRows.slice(0, 100) } : {}),
    }),
  });

  // Advance the bookmark only after a fully successful drain (ISC-5).
  await opts.store.setLastSyncAt(opts.userId, completedAt);

  return { pages, transactions, prunedPending, updatedSince, completedAt };
}

export interface TrackedSyncDeps {
  readonly failures: FailureTracker;
  readonly alerter: Alerter;
}

export interface TrackedSyncOutcome {
  readonly ok: boolean;
  readonly result?: SyncResult;
  readonly error?: unknown;
  /** Consecutive failures after this run (0 on success). */
  readonly consecutiveFailures: number;
  /** Whether an alert was raised on this run. */
  readonly alerted: boolean;
}

/**
 * Run a sync with consecutive-failure tracking and alerting (ISC-8). A success
 * resets the counter; two consecutive failures raise a Pulse/Telegram alert.
 * Never throws — the cron entry inspects the outcome and sets its exit code.
 */
export async function syncWithFailureTracking(
  opts: SyncOptions,
  deps: TrackedSyncDeps,
): Promise<TrackedSyncOutcome> {
  try {
    const result = await runSync(opts);
    await deps.failures.recordSuccess();
    return { ok: true, result, consecutiveFailures: 0, alerted: false };
  } catch (error) {
    const consecutiveFailures = await deps.failures.recordFailure();
    let alerted = false;
    if (consecutiveFailures >= ALERT_AFTER_CONSECUTIVE_FAILURES) {
      await deps.alerter.alert(
        `PocketSmith sync failed ${consecutiveFailures} times in a row for user ${opts.userId}. Last error: ${describeError(error)}`,
      );
      alerted = true;
    }
    return { ok: false, error, consecutiveFailures, alerted };
  }
}

function describeError(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}

async function resolvePocketSmithUserId(client: PocketSmithClient): Promise<number> {
  const me = await client.getAuthenticatedUser();
  if (me.id === undefined || me.id === null) {
    throw new Error("PocketSmith /me returned no user id");
  }
  return me.id;
}
