// BudgetBuddy dropdown/modal reproduction harness (ISC-213, ISC-220..222).
// Runs headless Chrome against the isolated dev instance on :8899.
import puppeteer from "puppeteer";

const BASE = "http://127.0.0.1:8899";
const results = {};

async function signIn(page) {
  await page.goto(`${BASE}/`, { waitUntil: "networkidle0" });
  if (page.url().includes("/signin")) {
    await page.waitForSelector('input[type="password"]');
    await page.type('input[type="password"]', "1234");
    await page.click('button[type="submit"]');
    await page.waitForNavigation({ waitUntil: "networkidle0" }).catch(() => {});
  }
}

async function openAddBudget(page) {
  // Master page "Add budget" button.
  await page.waitForFunction(
    () => [...document.querySelectorAll("button")].some((b) => b.textContent.trim() === "Add budget"),
    { timeout: 15000 },
  );
  await page.evaluate(() => {
    [...document.querySelectorAll("button")].find((b) => b.textContent.trim() === "Add budget").click();
  });
  await page.waitForSelector('[role="dialog"]', { timeout: 5000 });
}

const dialogOpen = (page) => page.evaluate(() => Boolean(document.querySelector('[role="dialog"]')));
const listboxOpen = (page) => page.evaluate(() => Boolean(document.querySelector('[role="listbox"]')));

// Click a combobox trigger INSIDE the dialog by index using real mouse coords —
// synthetic .click() bypasses the pointer-events state we're testing.
async function mouseClickCombobox(page, idx) {
  const box = await page.evaluate((i) => {
    const dlg = document.querySelector('[role="dialog"]');
    const el = dlg.querySelectorAll('[role="combobox"]')[i];
    const r = el.getBoundingClientRect();
    return { x: r.x + r.width / 2, y: r.y + r.height / 2 };
  }, idx);
  await page.mouse.click(box.x, box.y);
  await new Promise((r) => setTimeout(r, 400));
}

const browser = await puppeteer.launch({ headless: "new", args: ["--no-sandbox"] });
try {
  // ---- Probe 1 (ISC-213/214): trigger re-click must not close the dialog ----
  const page = await browser.newPage();
  await page.setViewport({ width: 1280, height: 800 });
  page.on("console", (m) => {
    if (m.text().includes("[dialog-guard]")) console.log("CONSOLE:", m.text());
  });
  await signIn(page);
  await openAddBudget(page);
  await mouseClickCombobox(page, 1); // Period select — open
  const openedDropdown = await listboxOpen(page);
  await mouseClickCombobox(page, 1); // Period select — close by re-click
  const dropdownAfter = await listboxOpen(page);
  const dialogAfter = await dialogOpen(page);
  results.probe1 = { openedDropdown, dropdownAfter, dialogAfter };

  // ---- Probe 2 (ISC-216): overlay click with nothing open still closes ----
  if (!dialogAfter) {
    await openAddBudget(page);
  }
  await page.mouse.click(8, 8); // top-left corner = overlay
  await new Promise((r) => setTimeout(r, 400));
  results.probe2 = { dialogClosedByOverlay: !(await dialogOpen(page)) };

  // ---- Probe 3 (ISC-220..222): mobile scroll ----
  const m = await browser.newPage();
  await m.setViewport({ width: 375, height: 667, isMobile: true, hasTouch: true });
  await signIn(m);
  await openAddBudget(m);
  results.probe3 = await m.evaluate(() => {
    const dlg = document.querySelector('[role="dialog"]');
    const r = dlg.getBoundingClientRect();
    const buttons = [...dlg.querySelectorAll("button")];
    const submit = buttons[buttons.length - 1].getBoundingClientRect();
    return {
      dialogTop: r.top,
      dialogBottom: r.bottom,
      viewportH: window.innerHeight,
      scrollable: dlg.scrollHeight > dlg.clientHeight + 1,
      overflowY: getComputedStyle(dlg).overflowY,
      submitBottom: submit.bottom,
      submitReachableWithoutScroll: submit.bottom <= window.innerHeight && submit.top >= 0,
    };
  });

  // Desktop no-scrollbar check (ISC-222)
  results.probe4 = await page.evaluate(() => {
    const dlg = document.querySelector('[role="dialog"]');
    if (!dlg) return { note: "dialog not open (reopen skipped)" };
    return { desktopScrollable: dlg.scrollHeight > dlg.clientHeight + 1 };
  });
} finally {
  console.log("RESULTS:", JSON.stringify(results, null, 2));
  await browser.close();
}
