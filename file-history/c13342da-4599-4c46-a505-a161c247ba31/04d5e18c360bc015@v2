// Post-fix probes: Escape layering (ISC-217), search behaviour (ISC-225/226/228/231/245),
// pinned sentinel (ISC-227), reset-on-close (ISC-232), no-autofocus-on-touch (ISC-242).
import puppeteer from "puppeteer";

const BASE = "http://127.0.0.1:8899";
const out = {};

async function signIn(page) {
  await page.goto(`${BASE}/`, { waitUntil: "networkidle0" });
  if (page.url().includes("/signin")) {
    await page.waitForSelector('input[type="password"]');
    await page.type('input[type="password"]', "1234");
    await page.click('button[type="submit"]');
    await page.waitForNavigation({ waitUntil: "networkidle0" }).catch(() => {});
  }
}

async function openAddBudget(page) {
  await page.waitForFunction(
    () => [...document.querySelectorAll("button")].some((b) => b.textContent.trim() === "Add budget"),
    { timeout: 15000 },
  );
  await page.evaluate(() => {
    [...document.querySelectorAll("button")].find((b) => b.textContent.trim() === "Add budget").click();
  });
  await page.waitForSelector('[role="dialog"]', { timeout: 5000 });
}

// Seed a few envelopes via the API so the parent picker is a real list.
async function seedEnvelopes(page) {
  await page.evaluate(async () => {
    const names = ["Zebra Fund", "Groceries", "alpha utilities", "Mortgage", "Car", "Holidays", "Beach Gear"];
    for (const name of names) {
      await fetch("/api/envelopes", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, type: "expense", parentId: null, rolloverRule: "roll_carry", budgetedCents: 1000, period: "monthly" }),
      });
    }
  });
}

const state = (page) =>
  page.evaluate(() => ({
    dialog: Boolean(document.querySelector('[role="dialog"]')),
    listbox: Boolean(document.querySelector('[role="listbox"]')),
  }));

async function combo(page, idx) {
  return page.evaluate((i) => {
    const dlg = document.querySelector('[role="dialog"]');
    const el = dlg?.querySelectorAll('[role="combobox"]')[i];
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return { x: r.x + r.width / 2, y: r.y + r.height / 2 };
  }, idx);
}

const browser = await puppeteer.launch({ headless: "new", args: ["--no-sandbox"] });
try {
  const page = await browser.newPage();
  await page.setViewport({ width: 1280, height: 900 });
  await signIn(page);
  await seedEnvelopes(page);
  await page.reload({ waitUntil: "networkidle0" });

  // --- Escape layering (ISC-217) ---
  await openAddBudget(page);
  let c = await combo(page, 1);
  await page.mouse.click(c.x, c.y);
  await new Promise((r) => setTimeout(r, 300));
  await page.keyboard.press("Escape");
  await new Promise((r) => setTimeout(r, 300));
  out.escape1 = await state(page); // want dialog true, listbox false
  await page.keyboard.press("Escape");
  await new Promise((r) => setTimeout(r, 300));
  out.escape2 = await state(page); // want dialog false

  // --- Search behaviour on the Parent/category picker ---
  await openAddBudget(page);
  c = await combo(page, 0); // parent picker
  await page.mouse.click(c.x, c.y);
  await new Promise((r) => setTimeout(r, 400));
  out.search = await page.evaluate(() => {
    const listbox = document.querySelector('[role="listbox"]');
    const input = listbox?.querySelector("input");
    const items = () => [...listbox.querySelectorAll('[role="option"]')].map((o) => o.textContent.trim());
    return {
      hasSearchInput: Boolean(input),
      inputFocused: document.activeElement === input,
      order: items(),
    };
  });
  // type a query
  await page.keyboard.type("gro");
  await new Promise((r) => setTimeout(r, 250));
  out.filtered = await page.evaluate(() => {
    const listbox = document.querySelector('[role="listbox"]');
    return {
      items: [...listbox.querySelectorAll('[role="option"]')].map((o) => o.textContent.trim()),
      dialogStillOpen: Boolean(document.querySelector('[role="dialog"]')),
    };
  });
  // Enter selects first visible (ISC-245)
  await page.keyboard.press("Enter");
  await new Promise((r) => setTimeout(r, 300));
  out.afterEnter = await page.evaluate(() => {
    const dlg = document.querySelector('[role="dialog"]');
    const trigger = dlg?.querySelectorAll('[role="combobox"]')[0];
    return {
      listboxClosed: !document.querySelector('[role="listbox"]'),
      dialogOpen: Boolean(dlg),
      triggerText: trigger?.textContent?.trim(),
    };
  });

  // --- No matches + reset on close (ISC-231/232) ---
  c = await combo(page, 0);
  await page.mouse.click(c.x, c.y);
  await new Promise((r) => setTimeout(r, 300));
  await page.keyboard.type("zzzz");
  await new Promise((r) => setTimeout(r, 250));
  out.noMatches = await page.evaluate(() => {
    const listbox = document.querySelector('[role="listbox"]');
    return { text: listbox?.textContent?.includes("No matches"), optionCount: listbox?.querySelectorAll('[role="option"]').length };
  });
  await page.keyboard.press("Escape");
  await new Promise((r) => setTimeout(r, 300));
  c = await combo(page, 0);
  await page.mouse.click(c.x, c.y);
  await new Promise((r) => setTimeout(r, 300));
  out.afterReopen = await page.evaluate(() => {
    const listbox = document.querySelector('[role="listbox"]');
    return {
      inputValue: listbox?.querySelector("input")?.value,
      optionCount: listbox?.querySelectorAll('[role="option"]').length,
      firstItem: listbox?.querySelector('[role="option"]')?.textContent?.trim(),
    };
  });
  await page.keyboard.press("Escape");

  // --- Touch: no autofocus (ISC-242) + the ORIGINAL bug on the searchable picker ---
  const m = await browser.newPage();
  await m.setViewport({ width: 375, height: 667, isMobile: true, hasTouch: true });
  await signIn(m);
  await openAddBudget(m);
  c = await combo(m, 0);
  await m.touchscreen.tap(c.x, c.y);
  await new Promise((r) => setTimeout(r, 400));
  out.touchOpen = await m.evaluate(() => {
    const listbox = document.querySelector('[role="listbox"]');
    const input = listbox?.querySelector("input");
    return { listbox: Boolean(listbox), inputFocused: document.activeElement === input };
  });
  await m.touchscreen.tap(c.x, c.y); // the original bug gesture
  await new Promise((r) => setTimeout(r, 500));
  out.touchSecondTap = await state(m); // WANT: dialog true, listbox false
  // overlay tap with nothing open still closes (ISC-216, touch)
  await m.touchscreen.tap(10, 10);
  await new Promise((r) => setTimeout(r, 400));
  out.touchOverlayTap1 = await state(m); // want dialog true (gesture closed the select earlier) or listbox false
  await m.touchscreen.tap(10, 10);
  await new Promise((r) => setTimeout(r, 400));
  out.touchOverlayTap2 = await state(m); // want dialog false (second tap closes the dialog)
} finally {
  console.log("RESULTS:", JSON.stringify(out, null, 2));
  await browser.close();
}
