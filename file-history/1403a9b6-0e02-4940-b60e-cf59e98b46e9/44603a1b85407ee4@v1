import { NextRequest, NextResponse } from "next/server";
import { eq, and } from "drizzle-orm";
import {
  Permission,
  AuditEntityType,
  AuditAction,
  CredentialStatus,
} from "@accessbuddy/shared";
import { credentials } from "@accessbuddy/db";
import { getAuthUser } from "@/lib/auth";
import { resolveTenant } from "@/lib/tenant";
import { checkPermission } from "@/lib/permissions";
import { withTenant } from "@/lib/with-tenant";
import { createAuditEntry } from "@/lib/services/audit";

export async function POST(
  _request: NextRequest,
  { params }: { params: Promise<{ slug: string; id: string }> }
) {
  try {
    const auth = await getAuthUser();
    if (!auth) {
      return NextResponse.json(
        { error: "Authentication required" },
        { status: 401 }
      );
    }

    const { slug, id: credentialId } = await params;
    const tenant = await resolveTenant(slug);
    if (!tenant) {
      return NextResponse.json(
        { error: "Organisation not found" },
        { status: 404 }
      );
    }

    const permResult = checkPermission(auth, tenant.id, Permission.PROGRAM);
    if (!permResult.granted) {
      return NextResponse.json(
        { error: permResult.reason },
        { status: 403 }
      );
    }

    const result = await withTenant(tenant.id, async (tx) => {
      const [cred] = await tx
        .select()
        .from(credentials)
        .where(
          and(
            eq(credentials.id, credentialId),
            eq(credentials.tenantId, tenant.id)
          )
        )
        .limit(1);

      if (!cred) return null;

      if (!cred.programmingRequired) {
        throw new Error("Credential does not require programming");
      }

      const now = new Date();
      // Promote any staged expiry. The attestation flow (and legacy imports)
      // stash the new expiry in pending_expires_at so that the live
      // expiresAt is not updated until a programmer confirms the access
      // control system has been updated.
      const promotedExpiresAt = cred.pendingExpiresAt;

      // When promoting a future expiry, also reactivate an expired credential
      // — the programmer has confirmed the access control system now holds
      // the new expiry, so the credential is effectively active again.
      const shouldReactivate =
        cred.status === CredentialStatus.EXPIRED &&
        promotedExpiresAt &&
        promotedExpiresAt > now;

      await tx
        .update(credentials)
        .set({
          programmingRequired: false,
          programmingReason: null,
          programmingRequestedAt: null,
          ...(promotedExpiresAt ? { expiresAt: promotedExpiresAt } : {}),
          ...(shouldReactivate ? { status: CredentialStatus.ACTIVE } : {}),
          pendingExpiresAt: null,
          updatedAt: now,
        })
        .where(eq(credentials.id, credentialId));

      await createAuditEntry(tx, {
        tenantId: tenant.id,
        entityType: AuditEntityType.CREDENTIAL,
        entityId: credentialId,
        action: shouldReactivate
          ? AuditAction.STATUS_CHANGE
          : AuditAction.UPDATE,
        fromState: shouldReactivate ? CredentialStatus.EXPIRED : undefined,
        toState: shouldReactivate ? CredentialStatus.ACTIVE : undefined,
        actorId: auth.user.id,
        metadata: {
          action: "confirm_programming",
          previousReason: cred.programmingReason,
          reactivated: shouldReactivate,
          ...(promotedExpiresAt
            ? {
                previousExpiresAt: cred.expiresAt?.toISOString() ?? null,
                newExpiresAt: promotedExpiresAt.toISOString(),
              }
            : {}),
        },
      });

      return {
        ...cred,
        programmingRequired: false,
        programmingReason: null,
        status: shouldReactivate ? CredentialStatus.ACTIVE : cred.status,
        expiresAt: promotedExpiresAt ?? cred.expiresAt,
        pendingExpiresAt: null,
      };
    });

    if (!result) {
      return NextResponse.json(
        { error: "Credential not found" },
        { status: 404 }
      );
    }

    return NextResponse.json({ credential: result });
  } catch (err) {
    const message =
      err instanceof Error ? err.message : "Internal server error";
    const status = message.includes("does not require") ? 400 : 500;
    return NextResponse.json({ error: message }, { status });
  }
}
