/**
 * Look up an email event by ID.
 */
export function getEmailEvent(id: string): EmailEvent | undefined {
  return EMAIL_EVENTS.find((e) => e.id === id);
}

/**
 * Get all configurable events (those with defaultBlocks).
 * System emails without blocks are not configurable beyond enable/disable.
 */
export function getConfigurableEvents(): EmailEvent[] {
  return EMAIL_EVENTS.filter((e) => e.defaultBlocks !== null);
}
