/**
 * Email Event Registry
 *
 * Code-defined registry of all email events in the system.
 * Each event maps to a notification that can be sent, with metadata about
 * its trigger, recipient, and available template variables.
 *
 * Tenant-specific overrides (enable/disable, subject, blocks) are stored
 * in the `email_configurations` table and take precedence over defaults.
 */

export type EmailBlock =
  | { type: "heading"; content: string }
  | { type: "paragraph"; content: string }
  | { type: "button"; label: string; urlVariable: string }
  | { type: "callout"; content: string; variant?: "info" | "warning" | "error" | "success" }
  | { type: "divider" };

export type EmailVariable = {
  key: string;
  label: string;
  example: string;
};

export type EmailEventCategory = "member" | "admin" | "system";
export type EmailRecipientType = "member" | "admins_with_permission" | "specific";

export type EmailEvent = {
  id: string;
  name: string;
  description: string;
  category: EmailEventCategory;
  defaultRecipient: EmailRecipientType;
  defaultRecipientPermission?: string;
  variables: EmailVariable[];
  timeCritical: boolean;
  defaultEnabled: boolean;
  defaultSubject: string;
  defaultBlocks: EmailBlock[] | null; // null = complex template, code-managed only
};

