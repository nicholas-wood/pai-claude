import { Database } from "bun:sqlite";
const db = new Database(`${process.env.HOME}/.penny/penny.db`, { readonly: true });
const q = (sql: string, ...p: unknown[]) => db.query(sql).all(...(p as never[]));

console.log("== USERS ==");
console.log(q("SELECT id FROM users"));

console.log("\n== INCOME ENVELOPES ==");
console.log(q(`SELECT id, name, budgeted_cents, actual_cents, carryover_cents, rollover_start, expected_day, target_cents FROM income_envelopes`));

console.log("\n== TEMPLATE LINES FOR INCOME ENVELOPES ==");
console.log(q(`SELECT bt.envelope_id, ie.name, bt.id AS line_id, bt.amount_cents, bt.period, bt.effective_from, bt.effective_to
  FROM budget_template bt JOIN income_envelopes ie ON ie.id = bt.envelope_id AND ie.user_id = bt.user_id
  ORDER BY ie.name, bt.effective_from`));

console.log("\n== BUDGET HISTORY AUG 2026 ==");
console.log(q(`SELECT bh.ts, datetime(bh.ts/1000,'unixepoch','+10 hours') AS t, bh.envelope_id,
    COALESCE(ie.name, e.name, bh.envelope_id) AS name, bh.before_cents, bh.after_cents, bh.scope, bh.actor
  FROM budget_history bh
  LEFT JOIN income_envelopes ie ON ie.id = bh.envelope_id AND ie.user_id = bh.user_id
  LEFT JOIN envelopes e ON e.id = bh.envelope_id AND e.user_id = bh.user_id
  WHERE bh.ts >= 1753970400000 -- 2026-08-01T00:00+10
  ORDER BY bh.ts`));
