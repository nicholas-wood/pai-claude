import { Database } from "bun:sqlite";
import { SqliteStore } from "/home/nicholas-wood/Documents/workspace/projects/envelope-os/src/store/sqlite.ts";
import { EnvelopeService } from "/home/nicholas-wood/Documents/workspace/projects/envelope-os/src/envelope/service.ts";
import { PocketSmithClient } from "/home/nicholas-wood/Documents/workspace/projects/envelope-os/src/ingest/client.ts";
import { LocalSecretStore } from "/home/nicholas-wood/Documents/workspace/projects/envelope-os/src/platform/secrets/local.ts";
import { currentPeriod } from "/home/nicholas-wood/Documents/workspace/projects/envelope-os/src/platform/time.ts";

const SNAP = "/home/nicholas-wood/.claude/jobs/b65b1bed/tmp/netpos.db";
await Bun.$`rm -f ${SNAP}`.quiet();
const src = new Database(`${process.env.HOME}/.penny/penny.db`, { readonly: true });
src.run(`VACUUM INTO '${SNAP}'`);
src.close();

const store = new SqliteStore(SNAP);
await store.migrate();
const svc = new EnvelopeService(store, { holdingEnvelopeId: null, nabCardAccountIds: ["acc-nab"] }, { timezone: "Australia/Melbourne" });

const secrets = new LocalSecretStore();
const client = await PocketSmithClient.forUser(secrets, "local");
const user = await client.getAuthenticatedUser();
const accounts = await client.listTransactionAccounts(user.id!);
const toCents = (a: number | undefined | null) => (a === undefined || a === null || Number.isNaN(a) ? 0 : Math.round(a * 100));
let cashOnHandCents = 0, cardBalanceCents = 0;
const cardIds = new Set<string>();
for (const a of accounts) {
  const isCard = (a.type ?? "").toLowerCase().includes("credit");
  if (isCard) { cardBalanceCents += toCents(a.current_balance); cardIds.add(String(a.id)); }
  else cashOnHandCents += toCents(a.current_balance);
  console.log(`account ${a.id} ${a.name ?? ""} type=${a.type} balance=${toCents(a.current_balance)}`);
}
const cardOwedCents = Math.abs(cardBalanceCents);

const grid = await svc.getGrid("local", currentPeriod("Australia/Melbourne"));
const topLevel = grid.rows.filter((r: { parentId: string | null }) => r.parentId === null);
const leafLeftCents = topLevel.reduce((s: number, r: { leftCents: number }) => s + r.leftCents, 0);
const incomeLeftCents = grid.income.reduce((s: number, i: { carryoverCents: number; varianceCents: number }) => s + i.carryoverCents + i.varianceCents, 0);
const totalLeftCents = leafLeftCents + incomeLeftCents;
const awaitingIncomeCents = grid.income.reduce((s: number, i: { awaitingCents?: number }) => s + (i.awaitingCents ?? 0), 0);
const reconciledDeltaCents = cashOnHandCents - cardOwedCents - (totalLeftCents - awaitingIncomeCents);
const uncategorisedActivityCents = grid.unresolvedActivityCents ?? 0;
const unexplainedDeltaCents = reconciledDeltaCents - uncategorisedActivityCents;

console.log(JSON.stringify({ cashOnHandCents, cardOwedCents, leafLeftCents, incomeLeftCents, totalLeftCents, awaitingIncomeCents, reconciledDeltaCents, uncategorisedActivityCents, unexplainedDeltaCents }, null, 1));
console.log("income rows:", JSON.stringify(grid.income.map((i: { id: string; carryoverCents: number; varianceCents: number; awaitingCents?: number }) => ({ id: i.id, carry: i.carryoverCents, variance: i.varianceCents, awaiting: i.awaitingCents }))));
process.exit(0);
