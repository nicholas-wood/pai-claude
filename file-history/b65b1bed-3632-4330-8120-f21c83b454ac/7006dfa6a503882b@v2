import { Database } from "bun:sqlite";
const db = new Database(`${process.env.HOME}/.penny/penny.db`, { readonly: true });
const q = (sql: string, ...p: unknown[]) => db.query(sql).all(...(p as never[]));
const out: string[] = [];
const log = (t: string, v: unknown) => out.push(`== ${t} ==\n${JSON.stringify(v, null, 1)}`);

log("MONEY MOVEMENTS Aug-Sep", q(`SELECT datetime(ts/1000,'unixepoch','+10 hours') t, from_envelope_id, to_envelope_id, amount_cents
  FROM money_movements WHERE ts >= 1754316000000 ORDER BY ts`));

// Programmatic Aug vs Sep allocation diff
const rows = q(`SELECT period, envelope_id, SUM(amount_cents) c FROM allocations
  WHERE period IN ('2026-08','2026-09') GROUP BY period, envelope_id`) as { period: string; envelope_id: string; c: number }[];
const aug = new Map(rows.filter(r => r.period === "2026-08").map(r => [r.envelope_id, r.c]));
const sep = new Map(rows.filter(r => r.period === "2026-09").map(r => [r.envelope_id, r.c]));
const diffs: Record<string, { aug: number | null; sep: number | null }> = {};
for (const [id, c] of aug) if (sep.get(id) !== c) diffs[id] = { aug: c, sep: sep.get(id) ?? null };
for (const [id, c] of sep) if (!aug.has(id)) diffs[id] = { aug: null, sep: c };
log("ALLOCATION DIFF Aug vs Sep (only changed rows)", diffs);

log("EVENT KINDS ALL TIME", q(`SELECT kind, COUNT(*) n, datetime(MIN(ts)/1000,'unixepoch','+10 hours') first, datetime(MAX(ts)/1000,'unixepoch','+10 hours') last FROM events GROUP BY kind`));

log("EVENTS MENTIONING 2026-09", q(`SELECT datetime(ts/1000,'unixepoch','+10 hours') t, kind, substr(payload_json,1,160) p
  FROM events WHERE payload_json LIKE '%2026-09%' ORDER BY ts LIMIT 20`));

log("BUDGET_HISTORY actor=sync any", q(`SELECT COUNT(*) n FROM budget_history WHERE actor = 'sync'`));

await Bun.write(`${process.env.HOME}/.claude/jobs/b65b1bed/tmp/out5.txt`, out.join("\n\n"));
process.exit(0);
