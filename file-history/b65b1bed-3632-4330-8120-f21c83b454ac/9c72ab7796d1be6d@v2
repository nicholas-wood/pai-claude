import { Database } from "bun:sqlite";
const db = new Database(`${process.env.HOME}/.penny/penny.db`, { readonly: true });
const q = (sql: string, ...p: unknown[]) => db.query(sql).all(...(p as never[]));
const out: string[] = [];
const log = (t: string, v: unknown) => out.push(`== ${t} ==\n${JSON.stringify(v, null, 1)}`);

log("POSITIVE INFLOWS >= $200 Aug-Sep (posted+pending, non-transfer)", q(`
  SELECT t.txn_date, t.amount_cents, t.payee, COALESCE(c.name,'(uncategorised)') cat, t.is_pending
  FROM transactions t LEFT JOIN categories c ON c.id = t.category_id AND c.user_id = t.user_id
  WHERE t.txn_date >= '2026-08-01' AND t.is_transfer = 0 AND t.amount_cents >= 20000
  ORDER BY t.txn_date`));

log("SEPT ALLOCATION ROW IDS for the 4 missing (any period)", q(`
  SELECT envelope_id, period, amount_cents FROM allocations
  WHERE envelope_id IN ('419a2c55-495f-457d-aefe-41aa1f191e70','d1fe1684-d183-4c0b-a06e-4aca0ef61490','cd2e2e51-7ca9-40cc-ab4a-fa3f9ba18bfa','da98c2f1-249a-446d-ac2e-e18e2c88303a')
  ORDER BY envelope_id, period`));

await Bun.write(`${process.env.HOME}/.claude/jobs/b65b1bed/tmp/out4.txt`, out.join("\n\n"));
process.exit(0);
